+diff --git a/bin/omarchy-toggle-animations b/bin/omarchy-toggle-animations
+--- a/bin/omarchy-toggle-animations
++++ b/bin/omarchy-toggle-animations
+@@ -4,18 +4,46 @@
+ # omarchy:args=[toggle|on|off]
+ # omarchy:examples=omarchy toggle animations | omarchy toggle animations off | omarchy toggle animations on
+ 
+-# The flag records animations being off, so on and off swap on the way through.
++# Try Omarchy starts a session that renders on the CPU (tryomarchy.render=cpu)
++# with animations off, from the QEMU profile in ~/.config/hypr/monitors.lua.
++# Turning them on there is remembered for later sessions too, with the flag
++# Omarchy uses upstream, and has to be in place before the toggle reloads.
++without_gpu="$HOME/.local/state/omarchy/toggles/animations-without-gpu"
++
++# Off by the toggle, or by that profile or the user's own looknfeel.lua.
++animations_off() {
++  omarchy-hyprland-toggle-enabled no-animations ||
++    [[ $(hyprctl -j getoption animations:enabled 2>/dev/null | jq -r '.bool' 2>/dev/null) == "false" ]]
++}
++
+ case ${1:-toggle} in
+-toggle) omarchy-hyprland-toggle no-animations toggle ;;
+-on) omarchy-hyprland-toggle no-animations off ;;
+-off) omarchy-hyprland-toggle no-animations on ;;
++toggle)
++  if animations_off; then
++    animations=on
++  else
++    animations=off
++  fi
++  ;;
++on | off) animations=$1 ;;
+ *)
+   echo "Usage: omarchy-toggle-animations [toggle|on|off]" >&2
+   exit 1
+   ;;
+ esac
+ 
+-if omarchy-hyprland-toggle-enabled no-animations; then
++# The flag records animations being off, so on and off swap on the way through.
++if [[ $animations == "on" ]]; then
++  if [[ " $(</proc/cmdline) " == *" tryomarchy.render=cpu "* ]]; then
++    mkdir -p "${without_gpu%/*}"
++    touch "$without_gpu"
++  fi
++  omarchy-hyprland-toggle no-animations off
++else
++  rm -f "$without_gpu"
++  omarchy-hyprland-toggle no-animations on
++fi
++
++if animations_off; then
+   omarchy-notification-send -g 󰗘 "$(omarchy-i18n animations.disabled)"
+ else
+   omarchy-notification-send -g 󰗘 "$(omarchy-i18n animations.enabled)"
