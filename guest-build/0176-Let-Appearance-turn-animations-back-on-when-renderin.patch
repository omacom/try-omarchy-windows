diff --git a/guest/tests/test_cpu_animations.py b/guest/tests/test_cpu_animations.py
new file mode 100644
index 0000000..69a6ada
--- /dev/null
+++ b/guest/tests/test_cpu_animations.py
@@ -0,0 +1,201 @@
+"""Appearance > Animations works both ways on CPU rendering and is remembered."""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+PATCH = GUEST / 'patches/omarchy/cpu-animations-toggle.patch'
+UPSTREAM_TOGGLE = GUEST / 'tests/fixtures/omarchy-4.5.0/bin/omarchy-toggle-animations'
+FRAGMENT = GUEST / 'fragments/hypr-monitors-qemu.append.lua'
+FLAG = '.local/state/omarchy/toggles/animations-without-gpu'
+CPU = 'root=/dev/vda omarchy.qemu=1 tryomarchy.render=cpu quiet'
+GPU = 'root=/dev/vda omarchy.qemu=1 tryomarchy.render=gpu quiet'
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def backport():
+    spec = json.loads((GUEST / 'spec.json').read_text())
+    return next(entry for entry in spec['authenticity']['backports'] if entry['id'] == 'cpu-animations-toggle')
+
+
+# Hyprland as the toggle sees it: each reload evaluates the QEMU profile, then
+# the user's looknfeel.lua choice (LOOKNFEEL), then the no-animations flag.
+FAKES = {
+    'hyprctl': '''#!/bin/bash
+[[ $* == "-j getoption animations:enabled" ]] || exit 2
+printf '{"option":"animations:enabled","bool":%s}\\n' "$(cat "$STATE")"
+''',
+    'omarchy-hyprland-toggle': '''#!/bin/bash
+flag=$HOME/.local/state/omarchy/toggles/hypr/$1.lua
+case $2 in on) mkdir -p "${flag%/*}"; : >"$flag" ;; off) rm -f "$flag" ;; *) exit 2 ;; esac
+enabled=true
+if [[ " $(cat "$CMDLINE") " == *" tryomarchy.render=cpu "* && ! -e $HOME/.local/state/omarchy/toggles/animations-without-gpu ]]; then
+  enabled=false
+fi
+[[ -z ${LOOKNFEEL:-} ]] || enabled=$LOOKNFEEL
+[[ ! -e $flag ]] || enabled=false
+echo "$enabled" >"$STATE"
+''',
+    'omarchy-hyprland-toggle-enabled': '''#!/bin/bash
+[[ -f $HOME/.local/state/omarchy/toggles/hypr/$1.lua ]]
+''',
+    'omarchy-i18n': '#!/bin/bash\necho "$1"\n',
+    'omarchy-notification-send': '#!/bin/bash\necho "${!#}" >>"$NOTIFIED"\n',
+}
+
+
+class BackportTests(unittest.TestCase):
+    def test_backport_is_reviewed_against_omarchy_4_5_0(self):
+        entry = backport()
+        self.assertEqual(entry['patchSha256'], digest(PATCH))
+        targets = {target['path']: target for target in entry['targets']}
+        self.assertEqual(set(targets), {'bin/omarchy-toggle-animations', 'default/omarchy/omarchy-menu.jsonc'})
+        self.assertEqual(targets['bin/omarchy-toggle-animations']['beforeSha256'], digest(UPSTREAM_TOGGLE))
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            (root / 'bin').mkdir()
+            shutil.copy(UPSTREAM_TOGGLE, root / 'bin/omarchy-toggle-animations')
+            toggle_only = PATCH.read_text().split('diff --git a/default/', 1)[0]
+            applied = subprocess.run(['git', 'apply', '--no-index', '--unidiff-zero', '--whitespace=error', '-'],
+                                     input=toggle_only, text=True, cwd=root, capture_output=True)
+            self.assertEqual(applied.returncode, 0, applied.stderr)
+            self.assertEqual(digest(root / 'bin/omarchy-toggle-animations'),
+                             targets['bin/omarchy-toggle-animations']['afterSha256'])
+
+    def test_menu_offers_the_choice_that_changes_the_real_state(self):
+        menu = [line[1:] for line in PATCH.read_text().splitlines()
+                if line.startswith('+  "appearance.animations-')]
+        self.assertEqual(len(menu), 2)
+        on = json.loads('{' + menu[0].rstrip(',') + '}')['appearance.animations-on']['when']
+        off = json.loads('{' + menu[1].rstrip(',') + '}')['appearance.animations-off']['when']
+        self.assertEqual(off, '! { ' + on + '; }')
+        self.assertIn('getoption animations:enabled', on)
+
+
+class ToggleTests(unittest.TestCase):
+    def setUp(self):
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name)
+        self.home = self.root / 'home'
+        self.home.mkdir()
+        bin_dir = self.root / 'bin'
+        bin_dir.mkdir()
+        for name, body in FAKES.items():
+            (bin_dir / name).write_text(body)
+            (bin_dir / name).chmod(0o755)
+        shutil.copy(UPSTREAM_TOGGLE, self.root / 'toggle')
+        toggle_only = PATCH.read_text().split('diff --git a/default/', 1)[0]
+        applied = subprocess.run(['git', 'apply', '--no-index', '--unidiff-zero', '-'],
+                                 input=toggle_only.replace('bin/omarchy-toggle-animations', 'toggle'),
+                                 text=True, cwd=self.root, capture_output=True)
+        self.assertEqual(applied.returncode, 0, applied.stderr)
+        script = (self.root / 'toggle').read_text()
+        self.assertIn('/proc/cmdline', script)
+        self.cmdline = self.root / 'cmdline'
+        (self.root / 'toggle').write_text(script.replace('/proc/cmdline', str(self.cmdline)))
+        self.state = self.root / 'state'
+        self.notified = self.root / 'notified'
+        self.env = {'PATH': f'{bin_dir}:/usr/bin:/bin', 'HOME': str(self.home), 'STATE': str(self.state),
+                    'CMDLINE': str(self.cmdline), 'NOTIFIED': str(self.notified)}
+
+    def boot(self, cmdline, looknfeel=None):
+        self.cmdline.write_text(cmdline + '\n')
+        if looknfeel is None:
+            self.env.pop('LOOKNFEEL', None)
+        else:
+            self.env['LOOKNFEEL'] = looknfeel
+        # A new session loads the config once, as a reload would.
+        enabled = 'true'
+        if 'tryomarchy.render=cpu' in cmdline.split() and not (self.home / FLAG).exists():
+            enabled = 'false'
+        enabled = looknfeel or enabled
+        if (self.home / '.local/state/omarchy/toggles/hypr/no-animations.lua').exists():
+            enabled = 'false'
+        self.state.write_text(enabled + '\n')
+
+    def toggle(self, *args):
+        ran = subprocess.run(['bash', str(self.root / 'toggle'), *args], env=self.env,
+                             text=True, capture_output=True, timeout=10)
+        self.assertEqual(ran.returncode, 0, ran.stderr)
+        return self.state.read_text().strip(), self.notified.read_text().splitlines()[-1]
+
+    def test_cpu_rendering_toggles_both_ways_and_remembers_on(self):
+        self.boot(CPU)
+        self.assertEqual(self.state.read_text().strip(), 'false')
+        self.assertEqual(self.toggle(), ('true', 'animations.enabled'))
+        self.assertTrue((self.home / FLAG).exists())
+        self.assertEqual(self.toggle(), ('false', 'animations.disabled'))
+        self.assertFalse((self.home / FLAG).exists())
+        self.assertEqual(self.toggle(), ('true', 'animations.enabled'))
+        # The next CPU session keeps them on.
+        self.boot(CPU)
+        self.assertEqual(self.state.read_text().strip(), 'true')
+        self.assertEqual(self.toggle('off'), ('false', 'animations.disabled'))
+        self.boot(CPU)
+        self.assertEqual(self.state.read_text().strip(), 'false')
+        self.assertEqual(self.toggle('on'), ('true', 'animations.enabled'))
+
+    def test_gpu_rendering_keeps_omarchy_s_toggle(self):
+        self.boot(GPU)
+        self.assertEqual(self.toggle(), ('false', 'animations.disabled'))
+        self.assertTrue((self.home / '.local/state/omarchy/toggles/hypr/no-animations.lua').exists())
+        self.assertEqual(self.toggle(), ('true', 'animations.enabled'))
+        self.assertFalse((self.home / FLAG).exists())
+
+    def test_looknfeel_choice_wins_and_the_notification_says_so(self):
+        self.boot(CPU, looknfeel='false')
+        self.assertEqual(self.toggle(), ('false', 'animations.disabled'))
+        self.boot(CPU, looknfeel='true')
+        self.assertEqual(self.state.read_text().strip(), 'true')
+        self.assertEqual(self.toggle(), ('false', 'animations.disabled'))
+        self.assertEqual(self.toggle(), ('true', 'animations.enabled'))
+
+
+@unittest.skipUnless(shutil.which('lua'), 'lua is not installed')
+class ProfileTests(unittest.TestCase):
+    HARNESS = '''
+local real_open = io.open
+io.open = function(path, mode)
+  if path == "/proc/cmdline" then return real_open(CMDLINE, mode) end
+  return real_open(path, mode)
+end
+local animations = "unset"
+hl = { config = function(t) if t.animations then animations = tostring(t.animations.enabled) end end,
+       monitor = function() end }
+o = { exec_on_start = function() end }
+CHUNK
+io.write(animations)
+'''
+
+    def profile(self, cmdline, flag):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            (root / 'cmdline').write_text(cmdline + '\n')
+            if flag:
+                (root / FLAG).parent.mkdir(parents=True)
+                (root / FLAG).touch()
+            source = self.HARNESS.replace('CMDLINE', repr(str(root / 'cmdline'))).replace(
+                'CHUNK', FRAGMENT.read_text())
+            ran = subprocess.run(['lua', '-'], input=source, text=True, capture_output=True,
+                                 env=dict(os.environ, HOME=str(root), XDG_RUNTIME_DIR=str(root)))
+            self.assertEqual(ran.returncode, 0, ran.stderr)
+            return ran.stdout
