++  "appearance.animations-off": {"icon":"󰗘","label":"Animations Off","when":"! { omarchy-hyprland-toggle-enabled no-animations || [[ $(hyprctl -j getoption animations:enabled 2>/dev/null | jq -r .bool 2>/dev/null) == false ]]; }","action":"omarchy-toggle-animations"},
