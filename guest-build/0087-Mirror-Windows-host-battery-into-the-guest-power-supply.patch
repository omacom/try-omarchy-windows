@@ -121,6 +121,9 @@ compat_paths=(
   etc/systemd/system/sysinit.target.wants/try-omarchy-host-locale.service
   etc/systemd/system/try-omarchy-agent.service
   etc/systemd/system/multi-user.target.wants/try-omarchy-agent.service
