+class BatteryTests(OverlayCase):
+    def test_snapshot_validation_offline_and_absent_battery(self) -> None:
+        state = self.root / "state"
+        cache = self.root / "battery.json"
+        env = dict(self.env, TRY_OMARCHY_BATTERY_STATE_FILE=str(state),
+                   TRY_OMARCHY_BATTERY_CACHE_FILE=str(cache))
+        value = {"type": "state", "present": True, "percentage": 57,
+                 "state": "discharging", "acConnected": False,
+                 "timeToEmptySeconds": 8100, "timeToFullSeconds": None}
+        def apply(snapshot: dict) -> subprocess.CompletedProcess:
+            return subprocess.run([str(BATTERY_APPLY)], input=json.dumps(snapshot),
+                                  env=env, capture_output=True, text=True, timeout=5)
+        result = apply(value)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(state.read_text(), "present=1 status=discharging capacity=57 ac=0 time_to_empty=8100 time_to_full=-1\n")
+        for bad in (dict(value, percentage=101), dict(value, percentage=True),
+                    dict(value, state="shutdown"), dict(value, extra="unexpected")):
+            self.assertEqual(apply(bad).returncode, 1)
+            self.assertEqual(state.read_text(), "present=1 status=discharging capacity=57 ac=0 time_to_empty=8100 time_to_full=-1\n")
+        result = subprocess.run([str(BATTERY_APPLY), "--offline"], env=env, capture_output=True, text=True, timeout=5)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(state.read_text(), "present=1 status=unknown capacity=57 ac=0 time_to_empty=-1 time_to_full=-1\n")
+        absent = dict(value, present=False, percentage=None, state="unknown", acConnected=True,
+                      timeToEmptySeconds=None)
+        self.assertEqual(apply(absent).returncode, 0)
+        self.assertEqual(state.read_text(), "present=0 ac=1\n")
+
