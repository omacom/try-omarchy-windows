diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/battery-apply b/guest/factory-overlay/usr/local/lib/try-omarchy/battery-apply
new file mode 100755
index 0000000..72a1e1a
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/battery-apply
@@ -0,0 +1,76 @@
+#!/usr/bin/python3
+"""Apply a bounded host power snapshot to the guest BAT0/ADP0 device."""
+
+import json
+import os
+from pathlib import Path
+import sys
+
+STATE = Path(os.environ.get("TRY_OMARCHY_BATTERY_STATE_FILE", "/sys/devices/platform/try-omarchy-battery/state"))
+CACHE = Path(os.environ.get("TRY_OMARCHY_BATTERY_CACHE_FILE", "/run/try-omarchy/battery.json"))
+STATES = {"charging", "discharging", "full", "not-charging", "unknown"}
+KEYS = {"type", "present", "percentage", "state", "acConnected", "timeToEmptySeconds", "timeToFullSeconds"}
+
+
+def decode(raw: bytes) -> dict:
+    if len(raw) > 4096:
+        raise ValueError("battery message is too large")
+    value = json.loads(raw)
+    if not isinstance(value, dict) or set(value) != KEYS or value["type"] != "state":
+        raise ValueError("invalid battery snapshot")
+    if type(value["present"]) is not bool or type(value["acConnected"]) is not bool:
+        raise ValueError("invalid power flags")
+    if value["state"] not in STATES:
+        raise ValueError("invalid battery state")
+    percent = value["percentage"]
+    if value["present"]:
+        if type(percent) is not int or not 0 <= percent <= 100:
+            raise ValueError("invalid battery percentage")
+    elif percent is not None:
+        raise ValueError("battery is absent but carries a percentage")
+    for key in ("timeToEmptySeconds", "timeToFullSeconds"):
+        seconds = value[key]
+        if seconds is not None and (type(seconds) is not int or seconds < 0):
+            raise ValueError("invalid battery time")
+    return value
+
+
+def render(value: dict) -> str:
+    ac = int(value["acConnected"])
+    if not value["present"]:
+        return f"present=0 ac={ac}\n"
+    empty = value["timeToEmptySeconds"]
+    full = value["timeToFullSeconds"]
+    return (f"present=1 status={value['state']} capacity={value['percentage']} ac={ac} "
+            f"time_to_empty={-1 if empty is None else empty} "
+            f"time_to_full={-1 if full is None else full}\n")
+
+
+def main() -> int:
+    try:
+        if sys.argv[1:] == ["--offline"]:
+            try:
+                previous = decode(CACHE.read_bytes())
+            except (OSError, ValueError):
+                return 0
+            previous["state"] = "unknown"
+            previous["timeToEmptySeconds"] = None
+            previous["timeToFullSeconds"] = None
+            STATE.write_text(render(previous))
+            return 0
+        if sys.argv[1:]:
+            return 2
+        value = decode(sys.stdin.buffer.read(4097))
+        STATE.write_text(render(value))
+        CACHE.parent.mkdir(parents=True, exist_ok=True)
+        temporary = CACHE.with_suffix(".part")
+        temporary.write_text(json.dumps(value, separators=(",", ":")))
+        temporary.replace(CACHE)
+        return 0
+    except (OSError, ValueError, json.JSONDecodeError) as error:
+        print(f"battery snapshot rejected: {error}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/guest/factory-overlay/usr/src/try-omarchy-battery-1.0.0/Makefile b/guest/factory-overlay/usr/src/try-omarchy-battery-1.0.0/Makefile
