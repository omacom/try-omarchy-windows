         and "etc/skel/.config/nvim/lua/plugins/theme.lua" in compat_paths
@@ -298,7 +298,8 @@ def main() -> None:
     )
     check(
         "usr/local/bin/try-omarchy-drop" in compat_paths
-        and '"drop' in read(GUEST / "factory-overlay/usr/local/lib/try-omarchy/agent")
+        and "valid_drop_point" in read(GUEST / "factory-overlay/usr/local/bin/file-transfer")
+        and "'--point'" in read(GUEST / "factory-overlay/usr/local/bin/file-transfer")
         and (GUEST / "factory-overlay/usr/local/bin/try-omarchy-drop").stat().st_mode & stat.S_IXUSR != 0,
