From 25739168fe018e3fbd5a1473cf0201157d3839ae Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Wed, 2 Sep 2026 13:57:33 -0400
Subject: [PATCH] Add try-omarchy-export for carrying a trial to a real install

Archives ~/.config and the other home configuration, the current theme,
and the packages added beyond the factory image (split into repository and
AUR lists), with a restore.sh that replays them on a bare-metal Omarchy
install. Writes to the Windows share when mounted. Keys, password stores,
browser profiles, and caches stay out.
---
 .../usr/local/bin/try-omarchy-export          | 157 ++++++++++++++++++
 guest/tests/verify.py                         |  10 ++
 2 files changed, 167 insertions(+)
 create mode 100755 guest/factory-overlay/usr/local/bin/try-omarchy-export

diff --git a/guest/factory-overlay/usr/local/bin/try-omarchy-export b/guest/factory-overlay/usr/local/bin/try-omarchy-export
new file mode 100755
index 0000000..cca469b
--- /dev/null
+++ b/guest/factory-overlay/usr/local/bin/try-omarchy-export
@@ -0,0 +1,157 @@
+#!/bin/bash
+# Export the parts of this trial worth carrying to a real Omarchy install:
+# configuration under the home directory, the current theme, and the packages
+# added on top of the factory image. Writes one archive with a restore script
+# inside it, to the shared Windows folder when one is mounted, otherwise to
+# the home directory. Secrets are left out on purpose.
+#
+# Usage: try-omarchy-export [DESTINATION-DIRECTORY]
+set -euo pipefail
+
+usage() {
+  echo "Usage: try-omarchy-export [DESTINATION-DIRECTORY]"
+  echo "Default destination: /mnt/host when the Windows share is mounted, else \$HOME."
+}
+
+fail() {
+  echo "try-omarchy-export: $*" >&2
+  exit 1
+}
+
+case ${1:-} in
+  -h | --help)
+    usage
+    exit 0
+    ;;
+esac
+
+destination=${1:-}
+if [[ -z $destination ]]; then
+  if mountpoint -q /mnt/host && [[ -w /mnt/host ]]; then
+    destination=/mnt/host
+  else
+    destination=$HOME
+  fi
+fi
+[[ -d $destination && -w $destination ]] || fail "destination is not a writable directory: $destination"
+
+factory_lock=/usr/share/try-omarchy/packages.lock.txt
+[[ -f $factory_lock ]] || fail "factory package list not found: $factory_lock"
+
+stamp=$(date +%Y%m%d-%H%M%S)
+name="omarchy-export-$stamp"
+work=$(mktemp -d)
+trap 'rm -rf "$work"' EXIT
+stage="$work/$name"
+mkdir -p "$stage/home" "$stage/packages"
+
+# Configuration. Everything under ~/.config and ~/.local/share/omarchy, the
+# shell dotfiles, and the user's local binaries. Never ~/.ssh, ~/.gnupg,
+# browser profiles, password stores, or caches: those either hold secrets or
+# are rebuilt on the new machine.
+copy_home() {
+  local relative=$1
+  [[ -e $HOME/$relative ]] || return 0
+  mkdir -p "$stage/home/$(dirname "$relative")"
+  cp -a "$HOME/$relative" "$stage/home/$relative"
+}
+for item in .config .local/share/omarchy .local/bin .bashrc .bash_profile .zshrc .zprofile .profile .gitconfig .tmux.conf .vimrc .inputrc; do
+  copy_home "$item"
+done
+for secret in .config/gcloud .config/op .config/1Password .config/chromium .config/BraveSoftware .config/google-chrome .config/Signal .config/discord .config/Bitwarden .config/keepassxc .config/Code/User/globalStorage .config/herdr/secrets; do
+  rm -rf "$stage/home/$secret"
+done
+find "$stage/home" -type d \( -name Cache -o -name cache -o -name 'Service Worker' -o -name GPUCache \) -prune -exec rm -rf {} + 2>/dev/null || true
+
+# Theme name, so restore can select it without depending on symlink layout.
+theme=""
+if [[ -f $HOME/.local/state/omarchy/current/theme.name ]]; then
+  theme=$(<"$HOME/.local/state/omarchy/current/theme.name")
+elif command -v omarchy-theme-current >/dev/null; then
+  theme=$(omarchy-theme-current 2>/dev/null || true)
+  theme=${theme//$'\n'/}
+fi
+printf '%s\n' "$theme" >"$stage/theme"
+
+# Packages the user added beyond the factory image, split into the ones the
+# repositories provide and the ones that came from the AUR.
+pacman -Qqe 2>/dev/null | LC_ALL=C sort >"$work/explicit"
+awk '{print $1}' "$factory_lock" | LC_ALL=C sort >"$work/factory"
+LC_ALL=C comm -23 "$work/explicit" "$work/factory" >"$work/added"
+# pacman exits nonzero when nothing is foreign; that is the common case here.
+{ pacman -Qqm 2>/dev/null || true; } | LC_ALL=C sort >"$work/foreign"
+LC_ALL=C comm -23 "$work/added" "$work/foreign" >"$stage/packages/repo.txt"
+LC_ALL=C comm -12 "$work/added" "$work/foreign" >"$stage/packages/aur.txt"
+
+cat >"$stage/manifest.json" <<EOF
+{
+  "kind": "try-omarchy-export",
+  "schemaVersion": 1,
+  "created": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
+  "omarchyVersion": "$(cat /usr/share/omarchy/version 2>/dev/null || echo unknown)",
+  "user": "$(id -un)",
+  "theme": "$theme",
+  "repoPackages": $(wc -l <"$stage/packages/repo.txt"),
+  "aurPackages": $(wc -l <"$stage/packages/aur.txt")
+}
+EOF
+
+cat >"$stage/restore.sh" <<'RESTORE'
+#!/bin/bash
+# Restore a Try Omarchy export on a real Omarchy install. Run it as the user
+# who should receive the configuration, from the extracted export directory.
+# It backs up anything it replaces under ~/.omarchy-restore-backup/<time>.
+set -euo pipefail
+here=$(cd "$(dirname "$0")" && pwd)
+backup="$HOME/.omarchy-restore-backup/$(date +%Y%m%d-%H%M%S)"
+mkdir -p "$backup"
+
+# Dotfiles are replaced as units. ~/.config and ~/.local/share are merged one
+# application directory at a time, so the real install keeps configuration
+# for apps the trial never touched.
+entries() {
+  find "$here/home" -mindepth 1 -maxdepth 1 ! -name .config ! -name .local -print0
+  [[ -d $here/home/.config ]] && find "$here/home/.config" -mindepth 1 -maxdepth 1 -print0
+  [[ -d $here/home/.local/share ]] && find "$here/home/.local/share" -mindepth 1 -maxdepth 1 -print0
+  [[ -e $here/home/.local/bin ]] && printf '%s\0' "$here/home/.local/bin"
+  return 0
+}
+
+echo "Restoring configuration into $HOME (backups in $backup)"
+while IFS= read -r -d '' path; do
+  relative=${path#"$here/home/"}
+  target="$HOME/$relative"
+  if [[ -e $target || -L $target ]]; then
+    mkdir -p "$backup/$(dirname "$relative")"
+    mv "$target" "$backup/$relative"
+  fi
+  mkdir -p "$(dirname "$target")"
+  cp -a "$path" "$target"
+  echo "  restored $relative"
+done < <(entries)
+
+if [[ -s $here/packages/repo.txt ]]; then
+  echo "Installing repository packages"
+  sudo pacman -S --needed --noconfirm - <"$here/packages/repo.txt" || echo "Some repository packages did not install; review packages/repo.txt" >&2
+fi
+if [[ -s $here/packages/aur.txt ]] && command -v yay >/dev/null; then
+  echo "Installing AUR packages"
+  yay -S --needed --noconfirm - <"$here/packages/aur.txt" || echo "Some AUR packages did not install; review packages/aur.txt" >&2
+fi
+
+theme=$(<"$here/theme")
+if [[ -n $theme ]] && command -v omarchy-theme-set >/dev/null; then
+  echo "Selecting theme $theme"
+  omarchy-theme-set "$theme" || echo "Theme $theme is not installed here; pick it from the Omarchy menu" >&2
+fi
+echo "Done. Log out and back in to load the restored configuration."
+RESTORE
+chmod 0755 "$stage/restore.sh"
+
+archive="$destination/$name.tar.gz"
+tar -C "$work" -czf "$archive" "$name"
+echo "Exported to $archive"
+echo "  theme: ${theme:-unknown}"
+echo "  repository packages added: $(wc -l <"$stage/packages/repo.txt")"
+echo "  AUR packages added: $(wc -l <"$stage/packages/aur.txt")"
+echo "On a real Omarchy install: extract it and run $name/restore.sh"
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index a304319..2159022 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -142,6 +142,16 @@ def main() -> None:
         "the sshd request is per boot and leaves sshd configuration alone",
     )
 
+    exporter = GUEST / "factory-overlay/usr/local/bin/try-omarchy-export"
+    export_text = read(exporter)
+    check(
+        exporter.stat().st_mode & stat.S_IXUSR != 0
+        and "packages.lock.txt" in export_text
+        and "restore.sh" in export_text
+        and ".ssh" not in export_text.replace("Never ~/.ssh", ""),
+        "the export command carries configuration and added packages but no keys",
+    )
+
     finalizer = read(GUEST / "scripts/finalize-rootfs.sh")
     check("factory" in finalizer and "x86_64" in finalizer, "finalizer enforces the native factory contract")
     check("systemd-growfs-root.service" in finalizer, "factory disk grows on first boot")
-- 
2.55.0

