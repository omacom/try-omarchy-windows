@@ -128,3 +128,29 @@ Server = file://{self.local}
         self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
         self.repositories(); self.pacman('-Su')
         self.assert_version('0.16.0-1', 15)
+
+
+    def test_rebuild_moves_to_the_new_soname_with_hyprland_and_the_runtime(self):
+        # The Omarchy 4.5.0 image re-pins the rebuild on Arch's next release:
+        # Arch offers aquamarine 0.16.0-1 with a new SONAME and a Hyprland
+        # built against it, the local repository offers 0.16.0-1.1 and a
+        # runtime that requires it. pacman takes Arch's upgrade first, so the
+        # plain upgrade fails with the warning the conflict handler looks for,
+        # and its retry naming the rebuild moves all three together.
+        self.pacman('-Su'); self.assert_version('0.15.1-1.1')
+        self.pacman('-D', '--asdeps', 'aquamarine')
+        self.package(self.remote, 'aquamarine', '0.16.0-1', 15)
+        self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
+        self.package(self.local, 'aquamarine', '0.16.0-1.1', 15)
+        self.package(self.local, 'try-omarchy-runtime', '4.5.0-1', runtime=True, minimum='0.16.0-1.1')
+        self.repositories()
+        plain = subprocess.run(['pacman', '--noconfirm', '--config', str(self.config), '--root', str(self.root),
+                                '--dbpath', str(self.root / 'var/lib/pacman'), '-Su'],
+                               text=True, capture_output=True, env=dict(os.environ, LC_ALL='C'))
+        self.assertNotEqual(plain.returncode, 0)
+        self.assertIn('warning: cannot resolve "aquamarine>=0.16.0-1.1", a dependency of "try-omarchy-runtime"\n', plain.stderr)
+        self.pacman('-Su', 'try-omarchy/aquamarine')
+        self.assert_version('0.16.0-1.1', 15)
+        self.assertIn('Installed as a dependency', self.pacman('-Qi', 'aquamarine'))
+        self.assertEqual(self.pacman('-Q', 'try-omarchy-runtime').strip(), 'try-omarchy-runtime 4.5.0-1')
+        self.assertFalse((self.root / 'usr/lib/libaquamarine.so.14').exists())
diff --git a/guest/tests/test_local_rebuild_upgrade.py b/guest/tests/test_local_rebuild_upgrade.py
new file mode 100644
index 0000000..b236865
--- /dev/null
+++ b/guest/tests/test_local_rebuild_upgrade.py
@@ -0,0 +1,96 @@
+"""The update's conflict handler names the aquamarine rebuild only when it must."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+# The handler disks receive through the night light payload before they update.
+LEGACY = GUEST / 'factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-update-system-pkgs-when-conflicted'
+MISSING = 'warning: cannot resolve "aquamarine>=0.16.0-1.1", a dependency of "try-omarchy-runtime"'
+
+
+class LocalRebuildUpgradeTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.bin = self.root / 'bin'
+        self.bin.mkdir()
+        self.log = self.root / 'calls'
+        record = 'printf "%s\\n" "$(basename "$0") $*" >>"$CALLS"\n'
+        self.fake('sudo', record + 'exec "$@"')
+        self.fake('pacman', record + '[[ $1 == -Qo ]] && exit 1\nexit "${PACMAN_STATUS:-0}"')
+        self.fake('omarchy-update-pacman', record + 'exec pacman "$@"')
+        self.fake('omarchy-update-system-pkgs', record + 'exit 0')
+        self.fake('omarchy-lifecycle-dispatch', 'exit 0')
+        self.handlers = {'4.0.4': LEGACY}
+
+    def fake(self, name, body):
+        command = self.bin / name
+        command.write_text('#!/bin/bash\n' + body + '\n')
+        command.chmod(0o755)
+
+    def run_handler(self, handler, rows, **env):
+        report = self.root / 'errors'
+        report.write_text('\n'.join(rows) + '\n')
+        self.log.unlink(missing_ok=True)
+        environment = dict(os.environ, PATH=f'{self.bin}:{os.environ["PATH"]}', OMARCHY_UPDATE_CONFLICT='1',
+                           OMARCHY_REPLACED_DIR=str(self.root / 'replaced'), CALLS=str(self.log), **env)
+        result = subprocess.run(['bash', str(handler), str(report)], env=environment,
+                                capture_output=True, text=True, timeout=5)
+        calls = self.log.read_text().splitlines() if self.log.exists() else []
+        return result, [call for call in calls if call.startswith('pacman ')]
+
+    def test_unmet_runtime_minimum_retries_with_the_rebuild(self):
+        for name, handler in self.handlers.items():
+            with self.subTest(handler=name):
+                result, calls = self.run_handler(handler, [MISSING, 'error: failed to prepare transaction (could not satisfy dependencies)'])
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(calls, ["pacman -Syu --noconfirm --overwrite /usr/share/omarchy/* try-omarchy/aquamarine"])
+                # pacman colors the warning prefix even when stderr is a file.
+                colored = MISSING.replace('warning: ', '\x1b[1;33mwarning: \x1b[0m')
+                result, calls = self.run_handler(handler, [colored])
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(calls, ["pacman -Syu --noconfirm --overwrite /usr/share/omarchy/* try-omarchy/aquamarine"])
+                result, calls = self.run_handler(handler, [MISSING], PACMAN_STATUS='1')
+                self.assertNotEqual(result.returncode, 0)
+                self.assertEqual(len(calls), 1)
+
+    def test_files_the_retry_trips_on_are_adopted_and_the_rebuild_named_again(self):
+        # The first named retry stops on the night-light files catch-up delivered.
+        # sudo runs these fakes, so nothing on this machine moves.
+        conflict = ('try-omarchy-runtime: /usr/local/bin/omarchy-native-nightlight exists in filesystem\n'
+                    'try-omarchy-runtime: /usr/local/share/try-omarchy/nightlight.frag exists in filesystem\n')
+        count, report = self.root / 'syu', self.root / 'conflict'
+        report.write_text(conflict)
+        self.fake('pacman', 'printf "%s\\n" "$(basename "$0") $*" >>"$CALLS"\n[[ $1 == -Qo ]] && exit 1\n'
+                  f'n=$(($(cat {count} 2>/dev/null || echo 0) + 1)); echo $n >{count}\n'
+                  f'if ((n == 1)); then cat {report} >&2; exit 1; fi\nexit 0')
+        for name in ('mv', 'mkdir'):
+            self.fake(name, 'printf "%s\\n" "$(basename "$0") $*" >>"$CALLS"')
+        for name, handler in self.handlers.items():
+            with self.subTest(handler=name):
+                count.unlink(missing_ok=True)
+                result, calls = self.run_handler(handler, [MISSING])
+                self.assertEqual(result.returncode, 0, result.stderr)
+                retry = "pacman -Syu --noconfirm --overwrite /usr/share/omarchy/* try-omarchy/aquamarine"
+                self.assertEqual([call for call in calls if '-Syu' in call], [retry, retry])
+                moves = [call for call in self.log.read_text().splitlines() if call.startswith('mv ')]
+                self.assertEqual(len(moves), 2, moves)
+                self.assertNotIn('omarchy-update-system-pkgs', self.log.read_text())
+
+    def test_other_failures_never_name_the_rebuild(self):
+        for name, handler in self.handlers.items():
+            for rows in (['warning: cannot resolve "aquamarine>=0.16.0-1.1", a dependency of "hyprland"'],
+                         ['warning: cannot resolve "libaquamarine.so=16-64", a dependency of "try-omarchy-runtime"'],
+                         ['error: failed to prepare transaction (could not satisfy dependencies)']):
+                with self.subTest(handler=name, rows=rows):
+                    result, calls = self.run_handler(handler, rows)
+                    self.assertNotEqual(result.returncode, 0)
+                    self.assertFalse(any('try-omarchy/aquamarine' in call for call in calls), calls)
+
+
+if __name__ == '__main__':
+    unittest.main()
