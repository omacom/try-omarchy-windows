From a02f6b1614563606c99bb007bbb2774c6b91cb24 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sun, 8 Nov 2026 01:03:23 -0500
Subject: [PATCH] Upgrade with the aquamarine rebuild when Arch's build blocks
 the runtime

pacman takes an upgrade from the first repository that has the package,
and Arch comes before the guest's local repository. A disk with the
0.15.1 rebuild picks Arch's aquamarine 0.16.0-1, which cannot meet
runtime 4.0.4-13's aquamarine>=0.16.0-1.1, and Update stops. The night
light payload now brings a conflict handler that retries naming
try-omarchy/aquamarine. If unowned files stop that retry, such as the
night light files catch-up delivered, it takes them over as before and
names the rebuild again.
---
 .../usr/local/lib/try-omarchy/catch-up        |  5 +-
 ...omarchy-update-system-pkgs-when-conflicted | 31 ++++++
 .../try-omarchy/nightlight/manifest.json      |  5 +-
 .../local-rebuild-upgrade.patch               | 48 ++++++++++
 guest/tests/test_aquamarine_upgrade.py        | 30 +++++-
 guest/tests/test_local_rebuild_upgrade.py     | 96 +++++++++++++++++++
 guest/tests/test_native_nightlight.py         |  4 +-
 7 files changed, 212 insertions(+), 7 deletions(-)
 create mode 100644 guest/tests/fixtures/nightlight-upgrades/local-rebuild-upgrade.patch
 create mode 100644 guest/tests/test_local_rebuild_upgrade.py

diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
index efeabe2..e2abff1 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
@@ -48,9 +48,10 @@ if [[ -x $battery_installer ]] && { [[ ! $previous_revision =~ ^[0-9]+$ ]] || ((
 fi
 
 # Upgrade reviewed night-light defaults and their package-conflict recovery,
-# preserving custom commands and services.
+# preserving custom commands and services. Revision 68 teaches the recovery to
+# name the aquamarine rebuild, which disks with the 0.15.1 rebuild need.
 nightlight_installer=${TRY_OMARCHY_NIGHTLIGHT_INSTALLER:-/usr/local/lib/try-omarchy/install-nightlight}
-if [[ -x $nightlight_installer ]] && { [[ ! $previous_revision =~ ^[0-9]+$ ]] || (( previous_revision < 55 )); }; then
+if [[ -x $nightlight_installer ]] && { [[ ! $previous_revision =~ ^[0-9]+$ ]] || (( previous_revision < 68 )); }; then
   "$nightlight_installer" --homes "$homes"
 fi
 
diff --git a/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-update-system-pkgs-when-conflicted b/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-update-system-pkgs-when-conflicted
index d78952c..8e7f30b 100644
--- a/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-update-system-pkgs-when-conflicted
+++ b/guest/factory-overlay/usr/share/try-omarchy/nightlight/bin_omarchy-update-system-pkgs-when-conflicted
@@ -81,6 +81,30 @@ if grep -q 'unresolvable package conflicts detected' "$errors"; then
   exit 0
 fi
 
+rebuild=()
+# The guest's local repository rebuilds aquamarine under its Arch name for the
+# hardware cursor, and the runtime asks for that build. pacman upgrades a
+# package from the first repository that has it, and Arch comes first, so when
+# Arch and the rebuild move to a new release together the minimum cannot be
+# met. Name the rebuild for this one upgrade. Whenever Arch is ahead of the
+# rebuild the minimum is met, this never runs, and Arch's package wins.
+# pacman colors its warnings even in the report, so the colors come off first.
+if sed 's/\x1b\[[0-9;]*m//g' "$errors" | grep -qxP 'warning: cannot resolve "aquamarine>=[^"]+", a dependency of "try-omarchy-runtime"'; then
+  echo -e "\e[33m\nUpgrading with the Try Omarchy build of aquamarine:\e[0m"
+  retry=$(mktemp)
+  if sudo env LC_ALL=C OMARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm --overwrite '/usr/share/omarchy/*' try-omarchy/aquamarine 2>"$retry"; then
+    cat "$retry" >&2
+    rm -f "$retry"
+    exit 0
+  fi
+  cat "$retry" >&2
+  # Files pacman doesn't own can still stop it; the cleanup below reads this
+  # report instead, and the last retry names the rebuild again.
+  cat "$retry" >"$errors"
+  rm -f "$retry"
+  rebuild=(try-omarchy/aquamarine)
+fi
+
 # Paths one of these packages installs that pacman doesn't own. Moving them out
 # of the way is what lets the upgrade through, and works on a leftover directory
 # as well as a file.
@@ -109,6 +133,13 @@ for path in "${leftovers[@]}"; do
 done
 echo
 
+if ((${#rebuild[@]})); then
+  if sudo env LC_ALL=C OMARCHY_UPDATE_PACMAN=1 pacman -Syu --noconfirm --overwrite '/usr/share/omarchy/*' "${rebuild[@]}"; then
+    moved=()
+    exit 0
+  fi
+  exit 1
+fi
 if OMARCHY_UPDATE_RETRY=1 omarchy-update-system-pkgs; then
   moved=()
   exit 0
