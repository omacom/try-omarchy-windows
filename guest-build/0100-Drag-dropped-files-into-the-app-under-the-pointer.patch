+    def receive_onto_app(self, delivered):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            state = root / 'try-omarchy-clipboard'
+            state.mkdir()
+            request = state / 'incoming-drop-test'
+            request.write_text('{}')
+            downloads = root / 'Downloads'
+            found = {'client': client('0xapp', [0, 0], [800, 600], cls='chromium'),
+                     'point': (100, 100), 'monitor': {'width': 800, 'height': 600}}
+            fake = SimpleNamespace(read_metadata=Mock(return_value={}),
+                valid_ticket=Mock(return_value=True), can_receive_into=Mock(return_value=True),
+                download_into=Mock(return_value=[downloads / 'file']))
+            with patch.dict(os.environ, {'XDG_RUNTIME_DIR': str(root)}), \
+                 patch.object(module, 'drop_target', return_value=found), \
+                 patch.object(module, 'downloads_folder', return_value=downloads), \
+                 patch.object(module, 'deliver_to_app', return_value=delivered) as deliver, \
+                 patch.object(module, 'notify') as notify, \
+                 patch.object(importlib.machinery.SourceFileLoader, 'exec_module',
+                              side_effect=lambda loaded: loaded.__dict__.update(vars(fake))):
+                module.receive_ticket(request, (1, 1, 10, 10))
+            deliver.assert_called_once_with([downloads / 'file'], found)
+            fake.download_into.assert_called_once_with({}, downloads)
+            return notify
+
+    def test_app_under_the_pointer_gets_the_files_without_a_downloads_notice(self):
+        self.receive_onto_app(True).assert_not_called()
+
+    def test_a_refused_app_drag_still_reports_downloads(self):
+        self.receive_onto_app(False).assert_called_once_with('Files saved to Downloads', '1 item(s) received from Windows.')
+
+    def test_tablet_position_follows_scale_and_monitor_size(self):
+        monitor = {'width': 2560, 'height': 1440, 'scale': 2, 'x': 0, 'y': 0}
+        self.assertEqual(module.tablet_position(0, 0, monitor), (0, 0))
+        self.assertEqual(module.tablet_position(1280, 720, monitor), (32767, 32767))
+        self.assertEqual(module.tablet_position(640, 360, monitor), (round(1280 * 32767 / 2559), round(720 * 32767 / 1439)))
+
+    def test_source_sits_beside_the_drop_point_inside_the_monitor(self):
+        monitor = {'width': 1000, 'height': 800, 'scale': 1, 'x': 0, 'y': 0}
+        self.assertEqual(module.source_position(500, 400, monitor), (410, 400))
+        self.assertEqual(module.source_position(50, 400, monitor), (140, 400))
+
+    def test_deliver_to_app_reports_the_helper_result(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            helper = Path(tmp) / 'drop-drag'
+            for final, expected in (('dropped', True), ('cancelled', False)):
+                helper.write_text(f'#!/bin/sh\necho ready\nsleep 0.3\necho {final}\n')
+                helper.chmod(0o755)
+                found = {'point': (500, 400), 'monitor': {'width': 1000, 'height': 800}}
+                with patch.object(module, 'DRAG_HELPER', helper), \
+                     patch.object(module, 'LAYER_SHELL', helper), \
+                     patch.object(module, 'ask_host_to_drag', return_value=True) as ask:
+                    self.assertEqual(module.deliver_to_app([Path('/tmp/file')], found), expected)
+                ask.assert_called_once_with(*module.tablet_position(410, 400, found['monitor']))
+            with patch.object(module, 'DRAG_HELPER', helper), \
+                 patch.object(module, 'LAYER_SHELL', helper), \
+                 patch.object(module, 'ask_host_to_drag', return_value=False):
+                self.assertFalse(module.deliver_to_app([Path('/tmp/file')], found))
+
