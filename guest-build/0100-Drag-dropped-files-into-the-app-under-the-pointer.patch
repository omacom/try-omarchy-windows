+DRAG_HELPER = Path('/usr/local/lib/try-omarchy/drop-drag')
+LAYER_SHELL = Path('/usr/lib/libgtk4-layer-shell.so')
+TABLET_MAX = 32767
+SOURCE_OFFSET = 90
+
+
+def tablet_position(x, y, monitor):
+    """Layout coordinates to the absolute units of QEMU's virtual tablet."""
+    scale = monitor.get('scale', 1) or 1
+    width, height = monitor['width'], monitor['height']
+    tx = round((x - monitor.get('x', 0)) * scale * TABLET_MAX / max(1, width - 1))
+    ty = round((y - monitor.get('y', 0)) * scale * TABLET_MAX / max(1, height - 1))
+    return min(TABLET_MAX, max(0, tx)), min(TABLET_MAX, max(0, ty))
+
+
+def source_position(x, y, monitor):
+    """Put the drag source beside the drop point, inside the monitor."""
+    scale = monitor.get('scale', 1) or 1
+    left = monitor.get('x', 0)
+    right = left + monitor['width'] / scale
+    sx = x - SOURCE_OFFSET if x - SOURCE_OFFSET >= left + 30 else x + SOURCE_OFFSET
+    return int(min(right - 30, max(left + 30, sx))), int(y)
+
+
+def ask_host_to_drag(tx, ty):
+    import socket
+    with socket.create_connection(('10.0.2.2', 4451), timeout=3) as connection:
+        connection.sendall(f'drop-drag {tx} {ty}\n'.encode('ascii'))
+        return connection.makefile('r').readline() == 'ok\n'
+
+
+def deliver_to_app(paths, found):
+    """Drag received files into the app under the drop point. True when it took them."""
+    import os
+    import select
+    if not paths or not DRAG_HELPER.exists() or not LAYER_SHELL.exists():
+        return False
+    monitor = found['monitor']
+    sx, sy = source_position(*found['point'], monitor)
+    environment = dict(os.environ, LD_PRELOAD=str(LAYER_SHELL))
+    helper = subprocess.Popen([str(DRAG_HELPER), str(sx), str(sy), *[str(p) for p in paths]],
+                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
+                              stderr=subprocess.DEVNULL, env=environment, text=True)
+
+    def line(timeout):
+        if select.select([helper.stdout], [], [], timeout)[0]:
+            return helper.stdout.readline().strip()
+        return ''
+
+    try:
+        if line(5) != 'ready':
+            return False
+        # Let the compositor map the overlay before the press arrives.
+        import time
+        time.sleep(0.2)
+        if not ask_host_to_drag(*tablet_position(sx, sy, monitor)):
+            return False
+        return line(10) == 'dropped'
+    except (OSError, ValueError):
+        return False
+    finally:
+        if helper.poll() is None:
+            helper.terminate()
+            try:
+                helper.wait(timeout=2)
+            except subprocess.TimeoutExpired:
+                helper.kill()
+
+
