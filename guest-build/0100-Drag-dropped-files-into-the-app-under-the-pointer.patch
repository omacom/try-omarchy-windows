diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/drop-drag b/guest/factory-overlay/usr/local/lib/try-omarchy/drop-drag
new file mode 100755
index 0000000..f7b8f31
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/drop-drag
@@ -0,0 +1,81 @@
+#!/usr/bin/python3
+"""Offer received files as a Wayland drag source next to a Windows drop point.
+
+try-omarchy-drop starts this with LD_PRELOAD set to gtk4-layer-shell, which
+must load before GTK connects to Wayland. It shows a small overlay that never
+takes keyboard focus at the logical position X, Y and prints "ready". The
+launcher then presses on it through the virtual tablet and drags to the drop
+point, so the app there receives an ordinary drop of the files. It prints
+"dropped" when the app accepted the drop, "cancelled" otherwise, and gives up
+after a few seconds.
+
+usage: drop-drag X Y FILE...
+"""
+
+import sys
+
+import gi
+
+gi.require_version("Gtk", "4.0")
+gi.require_version("Gtk4LayerShell", "1.0")
+from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402
+from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402
+
+SIZE = 48
+TIMEOUT_SECONDS = 8
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) < 4:
+        return 2
+    x, y = int(argv[1]), int(argv[2])
+    files = [Gio.File.new_for_path(path) for path in argv[3:]]
+    result = {"state": "cancelled"}
+    app = Gtk.Application(application_id="org.tryomarchy.DropDrag", flags=Gio.ApplicationFlags.NON_UNIQUE)
+
+    def finish(state: str) -> None:
+        if result["state"] == "cancelled" or state == "dropped":
+            result["state"] = state
+        app.quit()
+
+    def activate(application: Gtk.Application) -> None:
+        window = Gtk.Window(application=application)
+        LayerShell.init_for_window(window)
+        LayerShell.set_layer(window, LayerShell.Layer.OVERLAY)
+        LayerShell.set_namespace(window, "try-omarchy-drop-drag")
+        LayerShell.set_keyboard_mode(window, LayerShell.KeyboardMode.NONE)
+        LayerShell.set_exclusive_zone(window, -1)
+        LayerShell.set_anchor(window, LayerShell.Edge.TOP, True)
+        LayerShell.set_anchor(window, LayerShell.Edge.LEFT, True)
+        LayerShell.set_margin(window, LayerShell.Edge.LEFT, max(0, x - SIZE // 2))
+        LayerShell.set_margin(window, LayerShell.Edge.TOP, max(0, y - SIZE // 2))
+        window.set_default_size(SIZE, SIZE)
+        area = Gtk.Box()
+        area.set_size_request(SIZE, SIZE)
+        source = Gtk.DragSource(actions=Gdk.DragAction.COPY)
+        source.set_content(Gdk.ContentProvider.new_for_value(Gdk.FileList.new_from_list(files)))
+        cancelled = {"value": False}
+
+        def on_cancel(_source, _drag, _reason):
+            cancelled["value"] = True
+            return False
+
+        def on_end(_source, _drag, _delete):
+            finish("cancelled" if cancelled["value"] else "dropped")
+
+        source.connect("drag-cancel", on_cancel)
+        source.connect("drag-end", on_end)
+        area.add_controller(source)
+        window.set_child(area)
+        window.present()
+        print("ready", flush=True)
+        GLib.timeout_add_seconds(TIMEOUT_SECONDS, lambda: finish("cancelled") or False)
+
+    app.connect("activate", activate)
+    app.run([])
+    print(result["state"], flush=True)
+    return 0 if result["state"] == "dropped" else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
