diff --git a/guest/tests/test_windows_hello_broker.py b/guest/tests/test_windows_hello_broker.py
new file mode 100644
index 0000000..153d009
--- /dev/null
+++ b/guest/tests/test_windows_hello_broker.py
@@ -0,0 +1,107 @@
+"""Security checks for the guest side of Windows Hello sudo."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import importlib.machinery
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+BROKER_PATH = Path(__file__).resolve().parents[1] / "factory-overlay/usr/local/lib/try-omarchy/windows-hello-broker"
+broker = importlib.machinery.SourceFileLoader("windows_hello_broker", str(BROKER_PATH)).load_module()
+
+
+class HelloBrokerTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.directory = tempfile.TemporaryDirectory()
+        private = Path(cls.directory.name) / "key.pem"
+        subprocess.run(
+            ["openssl", "genpkey", "-algorithm", "RSA", "-pkeyopt", "rsa_keygen_bits:2048", "-out", str(private)],
+            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True,
+        )
+        cls.private = private
+        cls.public = subprocess.run(
+            ["openssl", "pkey", "-in", str(private), "-pubout", "-outform", "DER"],
+            capture_output=True, check=True,
+        ).stdout
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        cls.directory.cleanup()
+
+    def request_and_response(self) -> tuple[dict[str, object], dict[str, object]]:
+        request = broker.make_request(
+            "sudo", "a" * 64, user="root", requesting_user="omarchy", tty="/dev/pts/3",
+        )
+        response = {
+            **request, "type": "authorization-result", "approved": True,
+            "issuedAt": 1000, "expiresAt": 1015,
+            "keyId": hashlib.sha256(self.public).hexdigest(),
+            "publicKey": base64.b64encode(self.public).decode("ascii"),
+            "signature": "",
+        }
+        signature = subprocess.run(
+            ["openssl", "dgst", "-sha256", "-sign", str(self.private)],
+            input=broker.payload(request, response), capture_output=True, check=True,
+        ).stdout
+        response["signature"] = base64.b64encode(signature).decode("ascii")
+        return request, response
+
+    def test_signed_sudo_request_and_context_binding(self) -> None:
+        request, response = self.request_and_response()
+        encoded = json.dumps(response).encode("ascii")
+        parsed = broker.parse_response(encoded, request)
+        key, padding = broker.verify_approval(request, parsed, now=1005)
+        self.assertEqual(key, self.public)
+        self.assertEqual(padding, "pkcs1")
+        self.assertEqual(broker.verify_approval(request, parsed, pinned=(key, padding), now=1005), (key, padding))
+
+        for field, value in (
+            ("requestId", "c1d0243d-705e-4b64-a5c3-458d4e2b1f9d"),
+            ("challenge", "b" * 64),
+            ("user", "omarchy"),
+            ("requestingUser", "root"),
+            ("tty", "/dev/pts/4"),
+        ):
+            changed = dict(response, **{field: value})
+            with self.subTest(field=field), self.assertRaises(broker.ApprovalError):
+                broker.parse_response(json.dumps(changed).encode("ascii"), request)
+
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(request, parsed, pinned=(self.public, "pss"), now=1005)
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(request, parsed, now=1016)
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(request, parsed, pinned=(b"other key", "pkcs1"), now=1005)
+
+    def test_denial_and_duplicate_fields_cannot_authorize(self) -> None:
+        request, response = self.request_and_response()
+        denial = dict(response, approved=False, issuedAt=0, expiresAt=0, keyId="", publicKey="", signature="")
+        parsed = broker.parse_response(json.dumps(denial).encode("ascii"), request)
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(request, parsed, now=1005)
+        denial["signature"] = response["signature"]
+        with self.assertRaises(broker.ApprovalError):
+            broker.parse_response(json.dumps(denial).encode("ascii"), request)
+        duplicate = json.dumps(response).replace('"approved": true', '"approved": true, "approved": true')
+        with self.assertRaises(broker.ApprovalError):
+            broker.parse_response(duplicate.encode("ascii"), request)
+
+    def test_invalid_pam_scope_never_makes_request(self) -> None:
+        for context in (
+            {"user": "root", "requesting_user": "omarchy", "tty": "/dev/ttyUSB0"},
+            {"user": "root", "requesting_user": "omarchy;id", "tty": "/dev/pts/3"},
+            {"user": "root", "requesting_user": "omarchy", "tty": ""},
+        ):
+            with self.subTest(context=context), self.assertRaises(broker.ApprovalError):
+                broker.make_request("sudo", "a" * 64, **context)
+
+
+if __name__ == "__main__":
+    unittest.main()
