++
++-- Hyprland 0.57 plays a sound for every terminal bell (tab-completion misses,
++-- TUI alerts). Mute it, as Omarchy does upstream; older Hyprland releases
++-- reject the unknown option, so only set it where it exists.
++local hyprland_major, hyprland_minor = hl.version():match("^(%d+)%.(%d+)")
++if hyprland_major and (tonumber(hyprland_major) > 0 or tonumber(hyprland_minor) >= 57) then
++  hl.config({ misc = { bell_sound = "none" } })
++end
