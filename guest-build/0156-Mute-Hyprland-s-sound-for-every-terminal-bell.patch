--- /dev/null
+++ b/guest/tests/test_terminal_bell.py
@@ -0,0 +1,47 @@
+"""Hyprland 0.57 plays a sound for every terminal bell; the guest mutes it."""
+import json
+from pathlib import Path
+import shutil
+import subprocess
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+PATCH = GUEST / 'patches/omarchy/mute-terminal-bell.patch'
+
+
+def added_lua() -> str:
+    lines = PATCH.read_text().splitlines()
+    return '\n'.join(line[1:] for line in lines if line.startswith('+') and not line.startswith('+++'))
+
+
+class TerminalBellTests(unittest.TestCase):
+    def test_backport_is_recorded_after_the_existing_ones(self):
+        spec = json.loads((GUEST / 'spec.json').read_text())
+        backports = spec['authenticity']['backports']
+        self.assertEqual(backports[-1]['id'], 'mute-terminal-bell')
+        self.assertEqual([target['path'] for target in backports[-1]['targets']], ['default/hypr/looknfeel.lua'])
+        self.assertIn('default', spec['authenticity']['backportedRuntimeTrees'])
+        self.assertNotIn('default', spec['authenticity']['verbatimRuntimeTrees'])
+
+    @unittest.skipUnless(shutil.which('lua'), 'lua is not installed')
+    def test_bell_is_muted_only_where_hyprland_knows_the_option(self):
+        harness = '''
+local calls = {}
+hl = { version = function() return VERSION end, config = function(t) calls[#calls + 1] = t end }
+CHUNK
+local muted = false
+for _, call in ipairs(calls) do
+  if call.misc and call.misc.bell_sound == "none" then muted = true end
+end
+io.write(muted and "muted" or "unchanged", " ", #calls)
+'''
+        for version, expected in (('0.56.2', 'unchanged 0'), ('0.57.0', 'muted 1'),
+                                  ('0.57.1', 'muted 1'), ('0.60.0', 'muted 1'), ('1.0.0', 'muted 1')):
+            source = harness.replace('VERSION', repr(version)).replace('CHUNK', added_lua())
+            result = subprocess.run(['lua', '-'], input=source, text=True, capture_output=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(result.stdout, expected, version)
+
+
+if __name__ == '__main__':
+    unittest.main()
