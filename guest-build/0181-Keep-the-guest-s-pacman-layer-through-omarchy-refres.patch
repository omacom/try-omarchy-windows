@@ -0,0 +1,95 @@
+#!/bin/bash
+
+# omarchy:summary=Restore channel and regional pacman defaults in an installed target
+# omarchy:args=<stable|rc|edge> [target-root] | --render <stable|rc|edge> <output-dir> [target-root]
+# omarchy:requires-sudo=true
+# omarchy:hidden=true
+
+set -euo pipefail
+
+usage() {
+  echo "Usage: omarchy-apply-pacman <stable|rc|edge> [target-root]" >&2
+  echo "       omarchy-apply-pacman --render <stable|rc|edge> <output-dir> [target-root]" >&2
+  exit 1
+}
+
+# --render only builds the two files, so an unprivileged caller can hand root
+# nothing but plain copies of the finished result.
+render_dir=""
+if [[ ${1:-} == "--render" ]]; then
+  (( $# == 3 || $# == 4 )) || usage
+  channel="$2"
+  render_dir="$3"
+  [[ -d $render_dir ]] || { echo "Render directory not found: $render_dir" >&2; exit 1; }
+  etc="${4:-/}/etc"
+else
+  (( $# >= 1 && $# <= 2 )) || usage
+  channel="$1"
+  etc="${2:-/}/etc"
+fi
+
+case "$channel" in
+  stable|rc|edge) ;;
+  *) echo "Invalid pacman channel: $channel" >&2; exit 1 ;;
+esac
+
+# The ISO writes this plain-text marker before target finalization. Missing
+# markers keep existing installations global; never source it as shell code.
+region=global
+if [[ -e $etc/omarchy/region ]]; then
+  region=$(<"$etc/omarchy/region")
+fi
+case "$region" in
+  global|cn) ;;
+  *) echo "Unsupported region: $region (expected global or cn)" >&2; exit 1 ;;
+esac
+
+# Each platform has its own channel templates (install/helpers/pacman.sh).
+source "$OMARCHY_PATH/install/helpers/pacman.sh"
+platform=$(omarchy-hw-platform)
+templates=$(omarchy_pacman_templates "$platform")
+if [[ ! -f $templates/pacman-$channel.conf || ! -f $templates/mirrorlist-$channel ]]; then
+  echo "Omarchy has no $channel channel for $platform." >&2
+  exit 1
+fi
+
+# Build both files before replacing either. Explicit refreshes retain backups;
+# ordinary updates do not call this command or enforce regional defaults.
+if [[ -n $render_dir ]]; then
+  staging="$render_dir"
+else
+  staging=$(mktemp -d)
+  trap 'rm -rf "$staging"' EXIT
+fi
+# Regional profiles carry x86 mirrors only so far, so other platforms keep
+# their channel templates as they are.
+if [[ $region == "global" || $platform != "x86" ]]; then
+  cp "$templates/pacman-$channel.conf" "$staging/pacman.conf"
+  cp "$templates/mirrorlist-$channel" "$staging/mirrorlist"
+else
+  profile="$OMARCHY_PATH/default/regions/$region/pacman"
+  for fragment in "omarchy-$channel.prepend" "mirrorlist-$channel.prepend"; do
+    [[ -r $profile/$fragment ]] || { echo "Region $region lacks $profile/$fragment" >&2; exit 1; }
+  done
+  # pacman tries servers in order, so each regional mirror leads and the
+  # channel's own server stays as the fallback, for [omarchy] and for Arch.
+  awk -v fragment="$profile/omarchy-$channel.prepend" '
+    { print }
+    $0 == "[omarchy]" { while ((getline line < fragment) > 0) print line; found++ }
+    END { exit found == 1 ? 0 : 1 }
+  ' "$templates/pacman-$channel.conf" > "$staging/pacman.conf" ||
+    { echo "pacman-$channel.conf has no single [omarchy] section" >&2; exit 1; }
+  cat "$profile/mirrorlist-$channel.prepend" "$templates/mirrorlist-$channel" > "$staging/mirrorlist"
+fi
+
+if [[ -z $render_dir ]]; then
+  mkdir -p "$etc/pacman.d"
+  for file in pacman.conf pacman.d/mirrorlist; do
+    if [[ -e $etc/$file ]]; then
+      cp -f "$etc/$file" "$etc/$file.bak"
+    fi
+  done
+  # Copying over an existing file keeps its owner and mode, as refresh always has.
+  cp -f "$staging/pacman.conf" "$etc/pacman.conf"
+  cp -f "$staging/mirrorlist" "$etc/pacman.d/mirrorlist"
+fi
diff --git a/guest/tests/fixtures/omarchy-4.5.0/bin/omarchy-refresh-pacman b/guest/tests/fixtures/omarchy-4.5.0/bin/omarchy-refresh-pacman
new file mode 100755
index 0000000..26f3377
--- /dev/null
+++ b/guest/tests/fixtures/omarchy-4.5.0/bin/omarchy-refresh-pacman
@@ -0,0 +1,68 @@
+#!/bin/bash
+
+# omarchy:summary=Overwrite the package configuration for /etc/pacman with the Omarchy default of using its dedicated mirrors and repositories, then update all packages.
+# omarchy:requires-sudo=true
+
+set -e
+
+channel="${1:-}"
+if [[ -n $channel && $channel != "stable" && $channel != "rc" && $channel != "edge" ]]; then
+  echo "Invalid channel: $channel" >&2
+  exit 2
+fi
+
+source "$OMARCHY_PATH/install/helpers/pacman.sh"
+if ! platform=$(omarchy-hw-platform); then
+  echo "Cannot tell this machine's platform. No repository configuration changed." >&2
+  exit 1
+fi
+templates=$(omarchy_pacman_templates "$platform") || exit 1
+if [[ -z $channel ]]; then
+  channel=$(omarchy-channel-current) || exit 1
+  case "$channel" in
+    stable | rc | edge) ;;
+    # A linked checkout uses the edge packages, just like channel-set dev.
+    dev) channel=edge ;;
+    unknown) channel=$(omarchy_pacman_default_channel "$platform") || exit 1 ;;
+    *)
+      echo "Cannot tell this machine's channel. No repository configuration changed." >&2
+      exit 1
+      ;;
+  esac
+fi
+if [[ ! -f $templates/pacman-$channel.conf || ! -f $templates/mirrorlist-$channel ]]; then
+  echo "Omarchy has no $channel channel for $platform. No repository configuration changed." >&2
+  exit 1
+fi
+
+# Render the channel templates plus this machine's regional additions as the
+# caller, so root only copies finished files. The scratch directory goes on
+# every exit, including a failed render, a refused sudo prompt, or a signal.
+rendered=$(mktemp -d)
+trap 'rm -rf "$rendered"' EXIT
+"$OMARCHY_PATH/bin/omarchy-apply-pacman" --render "$channel" "$rendered"
+
+sudo cp -f /etc/pacman.conf /etc/pacman.conf.bak
+sudo cp -f /etc/pacman.d/mirrorlist /etc/pacman.d/mirrorlist.bak
+echo "Setting channel to $channel"
+sudo cp -f "$rendered/pacman.conf" /etc/pacman.conf
+sudo cp -f "$rendered/mirrorlist" /etc/pacman.d/mirrorlist
+rm -rf "$rendered"
+
+# Allow user customization of /etc/pacman.conf before the upgrade runs, so
+# custom repositories and IgnorePkg entries shape the downgrade-capable
+# transaction below.
+omarchy-hook pre-refresh-pacman
+
+# Stable and rc publish omarchy and omarchy-settings; the -dev pair is edge's.
+# A stable or rc repository can still list an old -dev build (stable's listed
+# 4.0.0.r1832 from August to October 2026), and -uu would move an edge machine
+# onto it here, before omarchy-channel-set swaps the pair, and leave the
+# machine on that old build. The -dev pair is left to the swap.
+ignore=()
+if [[ $channel == "stable" || $channel == "rc" ]]; then
+  ignore=(--ignore omarchy-dev,omarchy-settings-dev)
+fi
+
+# Reset all package DBs and then update
+omarchy-update-pacman -Syyuu --noconfirm "${ignore[@]}"
diff --git a/guest/tests/fixtures/omarchy-4.5.0/bin/omarchy-reinstall-pkgs b/guest/tests/fixtures/omarchy-4.5.0/bin/omarchy-reinstall-pkgs
