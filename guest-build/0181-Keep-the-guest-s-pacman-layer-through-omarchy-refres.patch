+# Before revision 71, omarchy refresh pacman (and so channel switches and
+# package reinstalls) replaced pacman.conf and the mirrorlist with Omarchy's
+# templates, then its transaction was refused. Such a disk was left on
+# Omarchy's stable mirror snapshot without the local repository or the kernel
+# hold. Put them back; a pacman.conf or mirrorlist set up some other way is
+# left alone. No package transaction runs here.
+pacman_layer=${TRY_OMARCHY_PACMAN_LAYER:-/usr/local/lib/try-omarchy/pacman-layer}
+if [[ -x $pacman_layer ]] && { [[ ! $previous_revision =~ ^[0-9]+$ ]] || (( previous_revision < 71 )); }; then
+  "$pacman_layer" repair || true
+fi
+
 # Hold linux-headers with the kernel. Disks from before revision 70 hold only
 # linux, so Update > Omarchy moved the headers past the kernel the launcher
 # boots and the DKMS hooks removed the camera and battery modules from it.
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer b/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer
new file mode 100755
index 0000000..eb97011
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer
@@ -0,0 +1,221 @@
+#!/bin/bash
+# Keeps the guest's own pacman layer when Omarchy resets pacman's files.
+#
+# `omarchy refresh pacman` (and so channel switches and package reinstalls)
+# copies Omarchy's channel templates over /etc/pacman.conf and the mirrorlist,
+# then runs a full -Syyuu that may downgrade packages. Those templates do not
+# know the guest: they drop the local [try-omarchy] repository that carries the
+# runtime and the patched aquamarine, the IgnorePkg hold that keeps linux and
+# linux-headers on the kernel the launcher boots, and the rolling Arch mirrors
+# the image was built against. The transaction was then refused, and the disk
+# was left on Omarchy's stable mirror snapshot without the local repository.
+#
+#   refresh  After Omarchy wrote its templates, put the guest's layer back:
+#            the kernel hold, [try-omarchy] after the Arch repositories, and
+#            the guest's Arch mirrorlist (the one Omarchy saved as .bak when it
+#            is the guest's own, otherwise the image's copy). Then refresh the
+#            package databases for that configuration.
+#   ignore   Print the installed managed rebuilds, comma separated, that a
+#            transaction allowed to downgrade must leave alone. The local
+#            repository comes after Arch, so -uu would replace the patched
+#            aquamarine with Arch's build of the same version, or an older one.
+#            A newer Arch release is not listed: it replaces the rebuild, as in
+#            an ordinary update, along with a Hyprland that needs it.
+#   repair   Before login: a disk that a refused refresh left on Omarchy's
+#            mirrors without [try-omarchy] gets its pacman.conf back (the .bak
+#            when it is the guest's own) and the guest's Arch mirrorlist.
+#            Anything else is left alone. No package transaction runs.
+set -euo pipefail
+
+config=${TRY_OMARCHY_PACMAN_CONF:-/etc/pacman.conf}
+mirrorlist=${TRY_OMARCHY_MIRRORLIST:-/etc/pacman.d/mirrorlist}
+arch_mirrors=${TRY_OMARCHY_ARCH_MIRRORLIST:-/usr/share/try-omarchy/arch-mirrorlist}
+repo=${TRY_OMARCHY_LOCAL_REPO:-/usr/share/try-omarchy/repo}
+pacman=${TRY_OMARCHY_PACMAN:-pacman}
+
+regular() {
+  [[ -f $1 && ! -L $1 ]]
+}
+
+# The active Server lines of a mirrorlist.
+servers() {
+  sed -n 's/^[[:space:]]*Server[[:space:]]*=[[:space:]]*//p' "$1"
+}
+
+# A mirrorlist that only names Omarchy's mirrors (stable-mirror, rc-mirror,
+# mirror, and the regional copies).
+omarchy_mirrors() {
+  local server count=0
+  regular "$1" || return 1
+  while IFS= read -r server; do
+    [[ $server =~ ^https?://([a-z0-9-]+\.)*omarchy\.(org|cn)/ ]] || return 1
+    count=$((count + 1))
+  done < <(servers "$1")
+  (( count > 0 ))
+}
+
+# A mirrorlist with Arch mirrors and none of Omarchy's.
+guest_mirrors() {
+  local server count=0
+  regular "$1" || return 1
+  while IFS= read -r server; do
+    [[ ! $server =~ ^https?://([a-z0-9-]+\.)*omarchy\.(org|cn)/ ]] || return 1
+    count=$((count + 1))
+  done < <(servers "$1")
+  (( count > 0 ))
+}
+
+has_local_repo() {
+  grep -q '^[[:space:]]*\[try-omarchy\][[:space:]]*$' "$1"
+}
+
+# Replace file with the text on stdin, keeping its owner and mode.
+replace() {
+  local file=$1 tmp
+  tmp=$(mktemp "$(dirname "$file")/.${file##*/}.XXXXXX")
+  cat >"$tmp"
+  chown --reference="$file" "$tmp"
+  chmod --reference="$file" "$tmp"
+  mv -f "$tmp" "$file"
+}
+
+# Hold linux and linux-headers in [options]: add the missing names to the
+# first IgnorePkg line there, or add a line after HoldPkg (or the header).
+hold_kernel() {
+  local text
+  text=$(awk '
+    function section(line) { return line ~ /^[[:space:]]*\[.*\][[:space:]]*$/ }
+    { lines[NR] = $0 }
+    section($0) { options = ($0 ~ /^[[:space:]]*\[options\][[:space:]]*$/); if (options && !header) header = NR; next }
+    options && /^[[:space:]]*IgnorePkg[[:space:]]*=/ {
+      value = $0; sub(/^[^=]*=/, "", value)
+      count = split(value, names, /[[:space:]]+/)
+      for (i = 1; i <= count; i++) held[names[i]] = 1
+      if (!ignore) ignore = NR
+    }
+    options && /^[[:space:]]*HoldPkg[[:space:]]*=/ { hold = NR }
+    END {
+      missing = ""
+      if (!("linux" in held)) missing = missing " linux"
+      if (!("linux-headers" in held)) missing = missing " linux-headers"
+      if (missing == "" || !header) { exit 1 }
+      for (n = 1; n <= NR; n++) {
+        line = lines[n]
+        if (n == ignore) { sub(/[[:space:]]*$/, missing, line) }
+        print line
+        if (!ignore && n == (hold ? hold : header)) {
+          print "# Try Omarchy: the launcher boots its own kernel; keep its modules and headers."
+          print "IgnorePkg =" missing
+        }
+      }
+    }
+  ' "$config") || return 0
+  printf '%s\n' "$text" | replace "$config"
+  echo "held linux and linux-headers in $config" >&2
+}
+
+add_local_repo() {
+  has_local_repo "$config" && return 0
+  { cat "$config"; cat <<EOF
+
+# Immutable packages assembled from the checksummed Try Omarchy build spec.
+[try-omarchy]
+SigLevel = Optional TrustAll
+Server = file://$repo
+EOF
+  } | replace "$config"
+  echo "added the Try Omarchy package repository to $config" >&2
+}
+
+# The guest's Arch mirrorlist: what Omarchy saved as .bak when it is the
+# guest's own (it may be an administrator's choice of Arch mirrors), or the
+# image's copy.
+mirror_source() {
+  if guest_mirrors "$mirrorlist.bak"; then
+    echo "$mirrorlist.bak"
+  elif guest_mirrors "$arch_mirrors"; then
+    echo "$arch_mirrors"
+  else
+    return 1
+  fi
+}
+
+restore_mirrors() {
+  local source=$1
+  cmp -s "$source" "$mirrorlist" && return 0
+  replace "$mirrorlist" <"$source"
+  echo "restored the Arch mirrors in $mirrorlist from $source" >&2
+}
+
+refresh() {
+  local source
+  regular "$config" || { echo "pacman-layer: $config is not a regular file" >&2; exit 1; }
+  regular "$mirrorlist" || { echo "pacman-layer: $mirrorlist is not a regular file" >&2; exit 1; }
+  source=$(mirror_source) || {
+    echo "pacman-layer: no Arch mirrorlist to restore; $mirrorlist.bak and $arch_mirrors are missing or name Omarchy's mirrors" >&2
+    exit 1
+  }
+  hold_kernel
+  add_local_repo
+  restore_mirrors "$source"
+  "$pacman" --config "$config" -Sy >&2
+}
+
+ignore() {
+  local database=$repo/try-omarchy.db names=() name version installed other
+  [[ -r $database ]] || return 0
+  while IFS=' ' read -r name version; do
+    [[ -n $name && $name != try-omarchy-* ]] || continue
+    installed=$("$pacman" --config "$config" -Q "$name" 2>/dev/null) || continue
+    [[ $installed == "$name $version" ]] || continue
+    # The version the first other repository offers, which -uu would take.
+    other=$(LC_ALL=C "$pacman" --config "$config" -Si "$name" 2>/dev/null | awk '
+      $1 == "Repository" { repository = $3 }
+      $1 == "Version" && repository != "try-omarchy" { print $3; exit }
+    ') || true
+    [[ -n $other ]] || continue
+    (( $(vercmp "$other" "$version") > 0 )) || names+=("$name")
+  done < <(tar -xzOf "$database" --wildcards '*/desc' 2>/dev/null | awk '
+    /^%NAME%$/ { getline name; next }
+    /^%VERSION%$/ { getline version; print name, version }
+  ')
+  (( ${#names[@]} )) || return 0
+  local IFS=,
+  echo "${names[*]}"
+}
+
+repair() {
+  local source
+  if ! regular "$config"; then
+    echo "left $config alone: not a regular file"
+    return 0
+  fi
+  has_local_repo "$config" && return 0
+  if ! omarchy_mirrors "$mirrorlist"; then
+    echo "left $config alone: it has no Try Omarchy repository, but the mirrorlist is not Omarchy's"
+    return 0
+  fi
+  if ! source=$(mirror_source); then
+    echo "left $config alone: no Arch mirrorlist to restore"
+    return 0
+  fi
+  # A refused refresh changed no packages, so put back what it replaced when
+  # Omarchy's backup is the guest's own.
+  if regular "$config.bak" && has_local_repo "$config.bak"; then
+    replace "$config" <"$config.bak"
+    echo "restored $config from $config.bak"
+  fi
+  hold_kernel 2>&1
+  add_local_repo 2>&1
+  restore_mirrors "$source" 2>&1
+}
+
+case ${1:-} in
+  refresh) refresh ;;
+  ignore) ignore ;;
+  repair) repair ;;
+  *)
+    echo "Usage: pacman-layer refresh|ignore|repair" >&2
+    exit 2
+    ;;
+esac
