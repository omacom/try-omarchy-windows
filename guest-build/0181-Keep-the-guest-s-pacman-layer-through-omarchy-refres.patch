+        self.assertEqual(repaired.returncode, 0, repaired.stderr)
+        self.assertEqual(self.config.read_text(), self.guest_conf)
+        self.assertEqual(self.mirrorlist.read_text(), self.arch_mirrors)
+        self.pacman('-Syu')
+        after = self.assert_nothing_downgraded()
+        self.assertEqual(after['aquamarine'], '0.16.0-1.1')
+
