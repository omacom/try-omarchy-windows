+    def package(self, repository, name, version, depends=None, provides=None):
+        stage = self.base / 'stage' / repository / f'{name}-{version}'
+        stage.mkdir(parents=True)
+        info = [f'pkgname = {name}', f'pkgver = {version}', 'pkgdesc = fixture', 'arch = x86_64', 'size = 1']
+        info += [f'depend = {depends}'] if depends else []
+        info += [f'provides = {provides}'] if provides else []
+        (stage / '.PKGINFO').write_text('\n'.join(info) + '\n')
+        archive = self.repos[repository] / f'{name}-{version}-x86_64.pkg.tar.gz'
+        with tarfile.open(archive, 'w:gz') as tar:
+            tar.add(stage / '.PKGINFO', arcname='.PKGINFO')
+        return archive
+
+    def publish(self):
+        # pacman -Sy fetches a file:// database only when it is newer than
+        # its copy, and these are written within the same second.
+        self.published = getattr(self, 'published', time.time()) + 10
+        names = {'rolling/extra': 'extra', 'snapshot/extra': 'extra', 'omarchy': 'omarchy', 'local': 'try-omarchy'}
+        for repository, path in self.repos.items():
+            for old in path.glob('*.db*'):
+                old.unlink()
+            archives = sorted(path.glob('*.pkg.tar.gz'))
+            database = path / f'{names[repository]}.db.tar.gz'
+            subprocess.run(['repo-add', '-q', str(database), *map(str, archives)], check=True, capture_output=True)
+            os.utime(database, (self.published, self.published))
+
+    def pacman(self, *args, config=None):
+        result = subprocess.run(['pacman', '--noconfirm', '--config', str(config or self.config), *args],
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        return result.stdout
+
+    def installed(self):
+        return dict(line.split() for line in self.pacman('-Q').splitlines())
+
+    def command(self, name, patch=True):
+        """Omarchy's command, patched or not, writing this fixture's /etc."""
+        directory = self.base / ('patched' if patch else 'upstream')
+        if patch:
+            patched(directory)
+        else:
+            (directory / 'bin').mkdir(parents=True, exist_ok=True)
+            shutil.copy(UPSTREAM / 'bin' / name, directory / 'bin' / name)
+        script = directory / 'bin' / name
+        text = script.read_text()
+        for before, after in [('/etc/pacman.d/mirrorlist', str(self.mirrorlist)), ('/etc/pacman.conf', str(self.config)),
+                              ('/usr/local/lib/try-omarchy/pacman-layer', str(LAYER))]:
+            text = text.replace(before, after)
+        script.write_text(text)
+        script.chmod(0o755)
+        # omarchy-reinstall-pkgs runs the refresh by name.
+        shutil.copy(script, self.bin / name)
+        return script
+
+    def run_command(self, name, patch=True):
+        if name != 'omarchy-refresh-pacman':
+            self.command('omarchy-refresh-pacman', patch)
+        return subprocess.run([str(self.command(name, patch))], env=self.env, text=True, capture_output=True)
+
+    def assert_nothing_downgraded(self):
+        log = (self.root / 'var/log/pacman.log').read_text()
+        self.assertNotIn('downgraded', log)
+        after = self.installed()
+        for name, version in self.before.items():
+            ran = subprocess.run(['vercmp', after[name], version], text=True, capture_output=True, check=True)
+            self.assertGreaterEqual(int(ran.stdout), 0, (name, version, after[name]))
+        return after
+
+    def assert_guest_layer(self):
+        text = self.config.read_text()
+        self.assertEqual(ignored(text), ['linux', 'linux-headers'])
+        self.assertEqual(sections(text), ['options', 'omarchy', 'extra', 'try-omarchy'])
+        self.assertEqual(self.mirrorlist.read_text(), self.arch_mirrors)
+
+    def test_upstream_refresh_is_refused_and_leaves_the_disk_rewritten(self):
