diff --git a/guest/tests/test_refresh_pacman.py b/guest/tests/test_refresh_pacman.py
new file mode 100644
index 0000000..8922acd
--- /dev/null
+++ b/guest/tests/test_refresh_pacman.py
@@ -0,0 +1,558 @@
+"""omarchy refresh pacman keeps the guest's pacman layer (#408).
+
+Omarchy's refresh copies its channel templates over pacman.conf and the
+mirrorlist and runs a downgrade-capable -Syyuu. On the guest that dropped the
+local [try-omarchy] repository, the kernel hold and the rolling Arch mirrors,
+and the transaction was refused, leaving the disk on Omarchy's stable mirror
+snapshot. These tests cover the reviewed patch to Omarchy's scripts, the
+pacman-layer helper, and the catch-up repair for disks a refused refresh
+already rewrote. The pacman tests run the patched refresh with real libalpm
+transactions on Arch builders and are skipped elsewhere.
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tarfile
+import tempfile
+import time
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / 'factory-overlay'
+LAYER = OVERLAY / 'usr/local/lib/try-omarchy/pacman-layer'
+CATCH_UP = OVERLAY / 'usr/local/lib/try-omarchy/catch-up'
+PATCH = GUEST / 'patches/omarchy/refresh-pacman-guest-layer.patch'
+UPSTREAM = GUEST / 'tests/fixtures/omarchy-4.5.0'
+
+# Omarchy 4.5.0's default/pacman/pacman-stable.conf and mirrorlist-stable.
+STABLE_CONF = '''# See the pacman.conf(5) manpage for option and repository directives
+
+[options]
+Color
+ILoveCandy
+VerbosePkgLists
+HoldPkg = pacman glibc
+Architecture = auto
+CheckSpace
+ParallelDownloads = 5
+DownloadUser = alpm
+
+# By default, pacman accepts packages signed by keys that its local keyring
+# trusts (see pacman-key and its man page), as well as unsigned packages.
+SigLevel = Required DatabaseOptional
+LocalFileSigLevel = Optional
+
+# pacman searches repositories in the order defined here
+[omarchy]
+Server = https://pkgs.omarchy.org/stable/$arch
+
+[core]
+Include = /etc/pacman.d/mirrorlist
+
+[extra]
+Include = /etc/pacman.d/mirrorlist
+
+[multilib]
+Include = /etc/pacman.d/mirrorlist
+'''
+STABLE_MIRRORS = 'Server = https://stable-mirror.omarchy.org/$repo/os/$arch\n'
+ARCH_MIRRORS = ('Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch\n'
+                'Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch\n')
+LOCAL_REPO = '''
+# Immutable packages assembled from the checksummed Try Omarchy build spec.
+[try-omarchy]
+SigLevel = Optional TrustAll
+Server = file:///usr/share/try-omarchy/repo
+'''
+# What a v0.15.0 image ships: the guest's pacman-x86_64.conf plus the local repository.
+GUEST_CONF = (GUEST / 'pacman-x86_64.conf').read_text() + LOCAL_REPO
+
+ALPM = os.geteuid() == 0 and all(shutil.which(x) for x in ('pacman', 'repo-add'))
+if os.environ.get('REQUIRE_ALPM_TESTS') == '1' and not ALPM:
+    raise RuntimeError('required Arch transaction tools unavailable')
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def ignored(config):
+    """Package names pacman ignores, read the way pacman reads [options]."""
+    names, options = [], False
+    for line in config.splitlines():
+        line = line.strip()
+        if line.startswith('['):
+            options = line == '[options]'
+        elif options and line.split('=')[0].strip() == 'IgnorePkg':
+            names += line.split('=', 1)[1].split()
+    return names
+
+
+def sections(config):
+    return [line.strip()[1:-1] for line in config.splitlines() if line.strip().startswith('[')]
+
+
+def patched(destination):
+    """Omarchy 4.5.0's refresh and reinstall commands with the reviewed patch."""
+    (destination / 'bin').mkdir(parents=True, exist_ok=True)
+    for name in ('omarchy-refresh-pacman', 'omarchy-reinstall-pkgs'):
+        shutil.copy(UPSTREAM / 'bin' / name, destination / 'bin' / name)
+    applied = subprocess.run(['git', 'apply', '--no-index', '--unidiff-zero', '--whitespace=error', str(PATCH)],
+                             cwd=destination, text=True, capture_output=True)
+    if applied.returncode:
+        raise AssertionError(applied.stderr)
+
+
+class BackportTests(unittest.TestCase):
+    def test_patch_is_reviewed_against_omarchy_4_5_0(self):
+        spec = json.loads((GUEST / 'spec.json').read_text())
+        entry = next(e for e in spec['authenticity']['backports'] if e['id'] == 'refresh-pacman-guest-layer')
+        self.assertEqual(entry['patch'], 'patches/omarchy/refresh-pacman-guest-layer.patch')
+        self.assertEqual(entry['patchSha256'], digest(PATCH))
+        targets = {t['path']: t for t in entry['targets']}
+        self.assertEqual(set(targets), {'bin/omarchy-refresh-pacman', 'bin/omarchy-reinstall-pkgs'})
