+        self.guest_conf = (options.replace('HoldPkg = pacman glibc\n', 'HoldPkg = pacman glibc\nIgnorePkg = linux linux-headers\n')
+                           + repositories + f'\n[try-omarchy]\nSigLevel = Optional TrustAll\nServer = file://{self.repos["local"]}\n')
+        self.config.write_text(self.guest_conf)
+        self.mirrorlist.write_text(self.arch_mirrors)
+
+        self.bin = self.base / 'bin'
+        self.bin.mkdir()
+        for name, body in FAKES.items():
+            (self.bin / name).write_text(body)
+            (self.bin / name).chmod(0o755)
+        self.env = {'PATH': f'{self.bin}:/usr/bin:/bin', 'HOME': str(self.base), 'OMARCHY_PATH': str(self.omarchy),
+                    'PACMAN_CONF': str(self.config), 'TRY_OMARCHY_PACMAN_CONF': str(self.config),
+                    'TRY_OMARCHY_MIRRORLIST': str(self.mirrorlist),
+                    'TRY_OMARCHY_ARCH_MIRRORLIST': str(self.base / 'arch-mirrorlist'),
+                    'TRY_OMARCHY_LOCAL_REPO': str(self.repos['local'])}
+
+        installed = [self.package('local', 'aquamarine', '0.16.0-1.1', provides='libaquamarine.so=15-64'),
+                     self.package('local', 'try-omarchy-runtime', '4.5.0-16', depends='aquamarine>=0.16.0-1'),
+                     self.package('rolling/extra', 'hyprland', '2-1', depends='libaquamarine.so=15-64'),
+                     self.package('rolling/extra', 'linux', '2-1'),
+                     self.package('rolling/extra', 'linux-headers', '2-1'),
