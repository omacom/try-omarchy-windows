+++ b/guest/tests/fixtures/omarchy-4.5.0/bin/omarchy-reinstall-pkgs
@@ -0,0 +1,25 @@
+#!/bin/bash
+
+# omarchy:summary=Reinstall all default Omarchy packages from the stable channel, or on Apple Silicon the edge channel
+# omarchy:requires-sudo=true
+
+set -e
+
+# Reinstall all default Omarchy packages from the platform's default channel
+# (stable, or edge on Apple Silicon) and downgrade any packages that are too new.
+
+# Set the package repository to the platform's default channel
+source "$OMARCHY_PATH/install/helpers/pacman.sh"
+platform=$(omarchy-hw-platform)
+channel=$(omarchy_pacman_default_channel "$platform")
+omarchy-refresh-pacman "$channel"
+
+# Downgrade any packages to that channel's setup
+omarchy-update-pacman -Suu --noconfirm
+
+# Ensure this platform's default packages are installed
+default_packages=$(omarchy-pkg-defaults)
+mapfile -t packages <<<"$default_packages"
+# --ask 4 accepts removing a stock package a default replaces, such as
+# power-profiles-daemon for omarchy-power-profiles-daemon.
+omarchy-update-pacman -Syu --noconfirm --ask 4 --needed "${packages[@]}"
diff --git a/guest/tests/fixtures/omarchy-4.5.0/install/helpers/pacman.sh b/guest/tests/fixtures/omarchy-4.5.0/install/helpers/pacman.sh
new file mode 100644
index 0000000..4ca3f42
--- /dev/null
+++ b/guest/tests/fixtures/omarchy-4.5.0/install/helpers/pacman.sh
@@ -0,0 +1,34 @@
+# Pacman repository templates. Every platform has a pacman.conf and mirrorlist
+# for each channel it offers, copied into place whole, as x86's always were:
+# x86's in default/pacman, each ARM platform's in a directory named for it.
+# Sourcing this file only defines functions; it never changes the system.
+
+# The directory holding <platform>'s pacman-<channel>.conf and
+# mirrorlist-<channel>. A channel without both files isn't offered there.
+omarchy_pacman_templates() {
+  case ${1:-} in
+    x86) echo "$OMARCHY_PATH/default/pacman" ;;
+    aarch64 | aarch64-apple) echo "$OMARCHY_PATH/default/pacman/$1" ;;
+    # Snapdragon, the N1x and the GB10 use Arch Linux ARM and Omarchy's aarch64
+    # repository like any other ARM machine, so they share its templates.
+    aarch64-qualcomm | aarch64-n1x | aarch64-gb10) echo "$OMARCHY_PATH/default/pacman/aarch64" ;;
+    *)
+      echo "Error: Unknown platform '${1:-}'." >&2
+      return 1
+      ;;
+  esac
+}
+
+# The channel a machine takes when none is named: stable, except on Apple
+# Silicon, whose machines have followed edge from the start and stay there
+# unless they choose another channel.
+omarchy_pacman_default_channel() {
+  case ${1:-} in
+    x86 | aarch64 | aarch64-qualcomm | aarch64-n1x | aarch64-gb10) echo stable ;;
+    aarch64-apple) echo edge ;;
+    *)
+      echo "Error: Unknown platform '${1:-}'." >&2
+      return 1
+      ;;
+  esac
+}
