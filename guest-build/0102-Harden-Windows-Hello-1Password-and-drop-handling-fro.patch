@@ -394,12 +415,61 @@ def disable() -> None:
     print("Windows Hello sudo disabled in this guest.")
 
 
+DENIALS = Path("/run/try-omarchy/windows-hello-denied")
+DENIAL_QUIET_SECONDS = 30
+
+
+def denial_marker(tty: str) -> Path:
+    return DENIALS / tty.removeprefix("/dev/").replace("/", "-")
+
+
+def recently_denied(tty: str) -> bool:
+    """sudo reruns PAM on every password attempt; do not prompt again right away."""
+    try:
+        return time.time() - denial_marker(tty).stat().st_mtime < DENIAL_QUIET_SECONDS
+    except (OSError, ValueError):
+        return False
+
+
+def remember_denial(tty: str) -> None:
+    try:
+        DENIALS.mkdir(mode=0o700, parents=True, exist_ok=True)
+        denial_marker(tty).touch()
+    except (OSError, ValueError):
+        pass
+
+
+def remote_session_tty(tty: str) -> bool:
+    """True when the terminal belongs to a remote login, such as SSH."""
+    if os.environ.get("PAM_RHOST"):
+        return True
+    name = tty.removeprefix("/dev/")
+    try:
+        listing = subprocess.run(["/usr/bin/loginctl", "list-sessions", "--no-legend", "--no-pager"],
+                                 capture_output=True, text=True, timeout=3, env={"PATH": "/usr/bin"})
+        for session in (line.split()[0] for line in listing.stdout.splitlines() if line.strip()):
+            shown = subprocess.run(["/usr/bin/loginctl", "show-session", session, "--property=TTY", "--property=Remote"],
+                                   capture_output=True, text=True, timeout=3, env={"PATH": "/usr/bin"})
+            fields = dict(line.split("=", 1) for line in shown.stdout.splitlines() if "=" in line)
+            if fields.get("TTY") == name and fields.get("Remote") == "yes":
+                return True
+    except (OSError, subprocess.SubprocessError):
+        return True
+    return False
+
+
 def authenticate_pam() -> bool:
     if os.getuid() != 0 or os.geteuid() != 0 or os.environ.get("PAM_TYPE") != "auth" or os.environ.get("PAM_SERVICE") != "sudo":
         return False
     user = os.environ.get("PAM_USER", "")
     requester = os.environ.get("PAM_RUSER", "") or user
     tty = os.environ.get("PAM_TTY", "")
+    if not TTY.fullmatch(tty) or recently_denied(tty):
+        return False
+    # The Windows prompt cannot show which terminal asked, so only a local
+    # session may ask; sudo over SSH uses the password.
+    if remote_session_tty(tty):
+        return False
     try:
         guest_id, credential_id, key = load_state()
         request = make_request("sudo", guest_id, credential_id=credential_id, user=user, requesting_user=requester, tty=tty)
@@ -407,6 +477,7 @@ def authenticate_pam() -> bool:
         verify_approval(request, exchange(request), key)
         return True
     except (ApprovalError, OSError, TimeoutError, ConnectionError, subprocess.SubprocessError):
+        remember_denial(tty)
         print("Windows Hello unavailable. Use your guest password.")
         return False
 
