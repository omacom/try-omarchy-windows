From 3b7c001ba1bfbefffafea5725ea906565fddd522 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sun, 8 Nov 2026 01:05:50 -0500
Subject: [PATCH] Require Arch's aquamarine release so updates go through

pacman upgrades aquamarine from the first repository that has it. Once Arch moved to 0.16.0-1, a disk with the 0.15.1-1.1 rebuild could never meet a runtime that requires the 0.16.0-1.1 rebuild, so Update > Omarchy failed. Require Arch's release instead. New images ship the rebuild; existing disks take Arch's release.
---
 guest/README.md                           | 10 +++---
 guest/scripts/register-omarchy-runtime.sh |  8 +++--
 guest/tests/test_aquamarine_upgrade.py    | 39 ++++++++++++++++++++++-
 guest/tests/test_runtime_package.py       |  4 +--
 4 files changed, 52 insertions(+), 9 deletions(-)

diff --git a/guest/README.md b/guest/README.md
index 9ae9727..36505fc 100644
--- a/guest/README.md
+++ b/guest/README.md
@@ -56,10 +56,12 @@ CMake and hyprwayland-scanner, retains Arch's versioned dependencies and
 `libaquamarine.so=15-64` provide, and checks that Hyprland loads afterward.
 Provenance records source/build pins and package/library digests.
 
-The local repository stays after Arch. Runtime `4.0.4-13` has a minimum
-`aquamarine>=0.16.0-1.1` dependency, so the first Update > Omarchy on an old disk
-selects the local rebuild if Arch has not moved. Further normal updates keep
-it while Arch is unchanged. A newer Arch package release or source version
+The local repository stays after Arch. Runtime `4.0.4-13` requires at least
+Arch's `aquamarine 0.16.0-1`, never the local rebuild: pacman upgrades a package
+from the first repository that has it, so after Arch moves past a disk's
+rebuild a rebuild-only minimum can never be met and every update fails. New
+images ship the rebuild and normal updates keep it while Arch is unchanged.
+Existing disks take Arch's release with their next update. A newer Arch package release or source version
 wins normally, including a coordinated Hyprland/SONAME update; there is no
 IgnorePkg, exact-version hold, custom provider or pre-transaction replacement.
 The patch can disappear after that bump, restoring the previous in-frame cursor
diff --git a/guest/scripts/register-omarchy-runtime.sh b/guest/scripts/register-omarchy-runtime.sh
index cbeb2c6..a6df4b3 100755
--- a/guest/scripts/register-omarchy-runtime.sh
+++ b/guest/scripts/register-omarchy-runtime.sh
@@ -172,8 +172,12 @@ component = spec.get("supplyChain", {}).get("aquamarine")
 if component:
     # A minimum, never an equality or a custom provider, lets newer Arch
     # aquamarine and its matching Hyprland upgrade in the same transaction.
-    version = component["packageVersion"]
-    if not re.fullmatch(r"[0-9]+(?:[.][0-9]+)*-[0-9]+[.]1", version):
+    # Require Arch's release, not the local rebuild: pacman upgrades from the
+    # first repository that has the package, so once Arch moves past a disk's
+    # rebuild, a rebuild-only minimum can never be met and every update fails.
+    # New images ship the rebuild, and an unchanged Arch release keeps it.
+    version = component["archVersion"]
+    if not re.fullmatch(r"[0-9]+(?:[.][0-9]+)*-[0-9]+", version):
         raise SystemExit("unsafe aquamarine minimum version")
     print(f"depend = aquamarine>={version}")
 for name in spec["upstream"].get("integrationDepends", []):
diff --git a/guest/tests/test_aquamarine_upgrade.py b/guest/tests/test_aquamarine_upgrade.py
index e30acf0..8b73a85 100644
--- a/guest/tests/test_aquamarine_upgrade.py
+++ b/guest/tests/test_aquamarine_upgrade.py
@@ -77,7 +77,7 @@ Server = file://{self.local}
             lib = stage / f'usr/lib/libaquamarine.so.{abi}'; lib.parent.mkdir(parents=True)
             self.library(lib, abi)
         if runtime:
-            info.append('depend = aquamarine>=0.15.1-1.1')
+            info.append(f'depend = aquamarine>={runtime if isinstance(runtime, str) else "0.15.1-1.1"}')
         (stage / '.PKGINFO').write_text('\n'.join(info) + '\n')
         archive = repository / f'{name}-{version}-x86_64.pkg.tar.gz'
         with tarfile.open(archive, 'w:gz') as tar:
@@ -128,3 +128,40 @@ Server = file://{self.local}
         self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
         self.repositories(); self.pacman('-Su')
         self.assert_version('0.16.0-1', 15)
+
+    def stage_repin(self, minimum):
+        self.pacman('-Su'); self.assert_version('0.15.1-1.1')
+        self.package(self.remote, 'aquamarine', '0.16.0-1', 15)
+        self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
+        self.package(self.local, 'aquamarine', '0.16.0-1.1', 15)
+        self.package(self.local, 'try-omarchy-runtime', '4.0.4-13', runtime=minimum)
+        for old in self.local.glob('try-omarchy-runtime-4.0.4-10-*'): old.unlink()
+        for old in self.local.glob('aquamarine-0.15.1-1.1-*'): old.unlink()
+        for db in self.local.glob('try-omarchy.db*'): db.unlink()
+        self.repositories()
+
+    def test_rebuild_only_minimum_cannot_be_met_after_arch_moves(self):
+        # pacman takes the upgrade from the first repository, Arch, so a
+        # runtime requiring the local rebuild leaves the update unsatisfiable.
+        self.stage_repin('0.16.0-1.1')
+        result = subprocess.run(['pacman', '--noconfirm', '--config', str(self.config), '--root', str(self.root),
+                                 '--dbpath', str(self.root / 'var/lib/pacman'), '-Su'], text=True, capture_output=True)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn('aquamarine>=0.16.0-1.1', result.stdout + result.stderr)
+
+    def test_repin_after_arch_moved_keeps_updates_working(self):
+        # A disk with the old rebuild meets Arch's next release and a runtime
+        # that requires Arch's release. The update goes through.
+        self.stage_repin('0.16.0-1')
+        self.pacman('-Su')
+        self.assertEqual(self.pacman('-Q', 'try-omarchy-runtime').strip(), 'try-omarchy-runtime 4.0.4-13')
+        self.assert_version('0.16.0-1', 15)
+
+    def test_new_image_keeps_the_rebuild_when_arch_is_unchanged(self):
+        self.package(self.remote, 'aquamarine', '0.16.0-1', 15)
+        self.package(self.remote, 'hyprland', '2-1', 15, consumer=True)
+        rebuild = self.package(self.local, 'aquamarine', '0.16.0-1.1', 15)
+        self.repositories()
+        self.pacman('-Udd', '--noscriptlet', str(rebuild))
+        self.pacman('-Su')
+        self.assert_version('0.16.0-1.1', 15)
diff --git a/guest/tests/test_runtime_package.py b/guest/tests/test_runtime_package.py
index 6516413..519966a 100644
--- a/guest/tests/test_runtime_package.py
+++ b/guest/tests/test_runtime_package.py
@@ -106,11 +106,11 @@ exit 0''')
 
     def test_aquamarine_dependency_has_a_minimum_and_no_version_hold(self):
         spec = json.loads(self.spec.read_text())
-        spec['supplyChain'] = {'aquamarine': {'packageVersion': '0.15.1-1.1'}}
+        spec['supplyChain'] = {'aquamarine': {'archVersion': '0.16.0-1', 'packageVersion': '0.16.0-1.1'}}
         self.spec.write_text(json.dumps(spec))
         result = self.run_builder()
         self.assertEqual(result.returncode, 0, result.stderr)
         with tarfile.open(self.capture) as archive:
             metadata = archive.extractfile('.PKGINFO').read().decode()
-        self.assertIn('depend = aquamarine>=0.15.1-1.1\n', metadata)
+        self.assertIn('depend = aquamarine>=0.16.0-1\n', metadata)
         self.assertNotIn('conflict = aquamarine', metadata)
