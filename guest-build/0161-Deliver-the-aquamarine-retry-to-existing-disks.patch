From 227a273e7defe2990c9f832eb71fdbdb7e5393ca Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sun, 8 Nov 2026 01:03:23 -0500
Subject: [PATCH] Deliver the aquamarine retry to existing disks

Compatibility revision 68 installs the new conflict handler before login, so the next Update reaches the aquamarine rebuild.
---
 guest/scripts/finalize-rootfs.sh         | 3 ++-
 guest/tests/test_aquamarine_contract.py  | 2 +-
 guest/tests/test_battery_details.py      | 2 +-
 guest/tests/test_clipboard_pull.py       | 2 +-
 guest/tests/test_compositor_health.py    | 2 +-
 guest/tests/test_guest_qol.py            | 2 +-
 guest/tests/test_live_update.py          | 2 +-
 guest/tests/test_native_nightlight.py    | 2 +-
 guest/tests/test_notification_privacy.py | 2 +-
 guest/tests/test_qt612_palette.py        | 2 +-
 guest/tests/test_snapper_guest.py        | 2 +-
 guest/tests/test_url_schemes.py          | 2 +-
 guest/tests/test_windows_volume_sync.py  | 2 +-
 guest/tests/verify.py                    | 2 +-
 14 files changed, 15 insertions(+), 14 deletions(-)

diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 944a683..46fb22a 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -256,7 +256,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 66 removes the Foot-only xdg-terminal-exec so the default terminal
 # setting applies.
 # Revision 67 offers aquamarine 0.16.0 with the cursor hotspot patch.
-compat_revision=67
+# Revision 68 lets the conflict handler name that rebuild, so Update can reach it.
+compat_revision=68
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
diff --git a/guest/tests/test_aquamarine_contract.py b/guest/tests/test_aquamarine_contract.py
index c2c008b..f9118e9 100644
--- a/guest/tests/test_aquamarine_contract.py
+++ b/guest/tests/test_aquamarine_contract.py
@@ -76,7 +76,7 @@ class AquamarineContractTests(unittest.TestCase):
         runtime = (GUEST / 'scripts/register-omarchy-runtime.sh').read_text()
         self.assertIn('depend = aquamarine>={version}', runtime)
         finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
-        self.assertIn('compat_revision=67', finalizer)
+        self.assertIn('compat_revision=68', finalizer)
         self.assertIn('cp /usr/share/try-omarchy/repo/*.pkg.tar.zst', finalizer)
         self.assertIn('usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua', finalizer)
         repo = (GUEST / 'scripts/register-local-repository.sh').read_text()
