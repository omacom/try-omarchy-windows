@@ -0,0 +1,118 @@
+#!/usr/bin/python3
+"""Deliver dropped files into the Omarchy window under a drop point.
+
+The Windows launcher transfers the files first, then asks the guest (through
+the agent) to deliver them here. Direct drops only work when the window under
+the point is running and can accept a file-list paste; every other case returns
+non-zero so the launcher can fall back to the transfer window.
+
+The decision logic is split into pure functions so the unprivileged test suite
+can exercise it without a compositor.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+from pathlib import Path
+from urllib.parse import quote
+
+# The transfer window is the fallback and must never be the paste target, or a
+# failed direct drop would just re-open it.
+TRANSFER_WINDOW_CLASS = "org.omarchy.FileTransfers"
+
+
+def clients() -> list[dict]:
+    result = subprocess.run(
+        ["hyprctl", "-j", "clients"], capture_output=True, text=True, timeout=10
+    )
+    if result.returncode != 0:
+        raise RuntimeError("hyprctl clients failed")
+    return json.loads(result.stdout or "[]")
+
+
+def contains(client: dict, x: int, y: int) -> bool:
+    at = client.get("at") or [0, 0]
+    size = client.get("size") or [0, 0]
+    return at[0] <= x < at[0] + size[0] and at[1] <= y < at[1] + size[1]
+
+
+def candidate(clients: list[dict], x: int, y: int) -> dict | None:
+    """Topmost drop target under (x, y), ignoring hidden and fallback windows."""
+    matches = []
+    for client in clients:
+        if client.get("hidden") or not client.get("mapped", True):
+            continue
+        if client.get("class") == TRANSFER_WINDOW_CLASS:
+            continue
+        if contains(client, x, y):
+            matches.append(client)
+    if not matches:
+        return None
+    # Hyprland reports focusHistoryID small for recently focused windows; the
+    # most recently focused match is the one visually on top.
+    return min(matches, key=lambda client: client.get("focusHistoryID", 1 << 30))
+
+
+def uri_list(paths: list[str]) -> str:
+    return "\r\n".join("file://" + quote(str(Path(path).resolve())) for path in paths) + "\r\n"
+
+
+def deliver(x: int, y: int, paths: list[str], run=subprocess.run) -> int:
+    for path in paths:
+        if not Path(path).is_absolute():
+            print("try-omarchy-drop: paths must be absolute", file=sys.stderr)
+            return 2
+    target = candidate(clients(), x, y)
+    if target is None:
+        print("try-omarchy-drop: no application window under the drop point", file=sys.stderr)
+        return 1
+    address = target.get("address")
+    if not address:
+        print("try-omarchy-drop: the target window has no address", file=sys.stderr)
+        return 1
+    if shutil.which("wl-copy") is None:
+        print("try-omarchy-drop: wl-copy is unavailable", file=sys.stderr)
+        return 1
+
+    # Put the file list on the clipboard as text/uri-list, then paste it into
+    # the target. Apps that accept a URI paste import the files in place.
+    run(["wl-copy", "--type", "text/uri-list", "--"], input=uri_list(paths), text=True, timeout=10)
+    run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"], timeout=10)
+    run(["hyprctl", "dispatch", "sendshortcut", "CTRL,V," + f"address:{address}"], timeout=10)
+    return 0
+
+
+def main(argv: list[str]) -> int:
+    if len(argv) >= 3 and argv[1] == "--json":
+        try:
+            request = json.loads(argv[2])
+        except (ValueError, IndexError):
+            print("try-omarchy-drop: invalid request", file=sys.stderr)
+            return 2
+        if (
+            not isinstance(request, dict)
+            or not isinstance(request.get("x"), int)
+            or not isinstance(request.get("y"), int)
+            or not isinstance(request.get("paths"), list)
+            or not all(isinstance(path, str) for path in request["paths"])
+            or not request["paths"]
+        ):
+            print("try-omarchy-drop: invalid request", file=sys.stderr)
+            return 2
+        return deliver(request["x"], request["y"], request["paths"])
+    if len(argv) < 4:
+        print("usage: try-omarchy-drop X Y FILE... | --json '{\"x\":..,\"y\":..,\"paths\":[..]}'", file=sys.stderr)
+        return 2
+    try:
+        x, y = int(argv[1]), int(argv[2])
+    except ValueError:
+        print("try-omarchy-drop: X and Y must be integers", file=sys.stderr)
+        return 2
+    return deliver(x, y, argv[3:])
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv))
