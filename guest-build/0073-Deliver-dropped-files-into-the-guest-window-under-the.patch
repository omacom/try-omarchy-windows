diff --git a/guest/tests/test_file_drop_target.py b/guest/tests/test_file_drop_target.py
new file mode 100644
index 0000000..f50d8f6
--- /dev/null
+++ b/guest/tests/test_file_drop_target.py
@@ -0,0 +1,68 @@
+"""Behavioral tests for the direct file-drop target selection."""
+
+import importlib.machinery
+import importlib.util
+from pathlib import Path
+import unittest
+
+
+SCRIPT = (
+    Path(__file__).resolve().parents[1]
+    / "factory-overlay/usr/local/bin/try-omarchy-drop"
+)
+loader = importlib.machinery.SourceFileLoader("try_omarchy_drop", str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+module = importlib.util.module_from_spec(spec)
+loader.exec_module(module)
+
+
+def client(address, at, size, *, focus=0, cls="org.gnome.Nautilus", hidden=False, mapped=True):
+    return {
+        "address": address,
+        "at": at,
+        "size": size,
+        "focusHistoryID": focus,
+        "class": cls,
+        "hidden": hidden,
+        "mapped": mapped,
+    }
+
+
+class DropTargetTests(unittest.TestCase):
+    def test_picks_the_window_under_the_point(self):
+        clients = [
+            client("0xa", [0, 0], [800, 600], focus=0),
+            client("0xb", [900, 0], [400, 300], focus=1),
+        ]
+        self.assertEqual(module.candidate(clients, 950, 100)["address"], "0xb")
+        self.assertEqual(module.candidate(clients, 10, 10)["address"], "0xa")
+
+    def test_returns_none_outside_every_window(self):
+        clients = [client("0xa", [0, 0], [800, 600])]
+        self.assertIsNone(module.candidate(clients, 900, 900))
+
+    def test_prefers_the_most_recently_focused_overlap(self):
+        clients = [
+            client("0xback", [0, 0], [800, 600], focus=5),
+            client("0xfront", [100, 100], [400, 300], focus=1),
+        ]
+        self.assertEqual(module.candidate(clients, 200, 200)["address"], "0xfront")
+
+    def test_ignores_hidden_unmapped_and_the_transfer_window(self):
+        clients = [
+            client("0xhidden", [0, 0], [800, 600], hidden=True),
+            client("0xunmapped", [0, 0], [800, 600], mapped=False),
+            client("0xfallback", [0, 0], [800, 600], cls=module.TRANSFER_WINDOW_CLASS),
+        ]
+        self.assertIsNone(module.candidate(clients, 10, 10))
+
+    def test_uri_list_is_percent_encoded(self):
+        value = module.uri_list(["/home/omarchy/My File.txt"])
+        self.assertEqual(value, "file:///home/omarchy/My%20File.txt\r\n")
+
+    def test_deliver_rejects_relative_paths(self):
+        self.assertEqual(module.deliver(0, 0, ["relative.txt"]), 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
