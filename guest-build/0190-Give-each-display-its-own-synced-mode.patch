diff --git a/guest/native-overlay/usr/local/bin/omarchy-native-display-sync b/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
index dfcfe19..e14ccfd 100755
--- a/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
+++ b/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
@@ -256,21 +256,35 @@ raise SystemExit(1)
 PY
 }
 
+# An explicit rule for this output in the user's monitors.lua outranks the
+# synced mode, as it does over Omarchy's catch-all rule.
+user_output_rule() {
+  local config=${OMARCHY_DISPLAY_SYNC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua}
+
+  [[ -r $config ]] || return 1
+  grep -Eq "^[^-]*output[[:space:]]*=[[:space:]]*\"$1\"" "$config"
+}
+
 apply_preferred_modes() {
   local connector
   local connector_name
+  local index
   local mode
   local output
   local preferred
   local response
   local rule
   local scale
+  local target
   local user_scale
   local applied=0
   local last_mode=""
   local last_scale=""
+  local -a modes=()
+  local -a outputs=()
+  local -a scales=()
 
-  # Several displays share the single catch-all rule, so read the file once.
+  # Several displays share the user's scale, so read the file once.
   user_scale=$(configured_scale)
   shopt -s nullglob
   for connector in "$drm_root"/card*-Virtual-*; do
@@ -284,17 +298,38 @@ apply_preferred_modes() {
     fi
     IFS=$'\t' read -r mode scale <<<"$preferred"
     [[ -n $mode && -n $scale ]] || continue
+    outputs+=("$output")
+    modes+=("$mode")
+    scales+=("$scale")
+  done
+  shopt -u nullglob
+
+  for index in "${!outputs[@]}"; do
+    output=${outputs[index]}
+    mode=${modes[index]}
+    scale=${scales[index]}
 
     # Aquamarine 0.14 does not refresh its mode cache when an existing DRM
     # connector's EDID or physical size changes. A complete modeline bypasses
     # the stale mode cache; an explicit scale calculated from the fresh EDID
     # avoids using the stale fullscreen dimensions for Hyprland's auto scale,
     # unless the user set a number, which comes first. Hyprland's Lua config
-    # parser requires eval instead of the legacy keyword command. Update
-    # Omarchy's single-output catch-all mode and scale; its placement, color,
-    # and other policy remain intact, while an explicit per-output user rule
-    # still wins.
-    rule="hl.monitor({ output = \"\", mode = \"$mode\", scale = \"$scale\" })"
+    # parser requires eval instead of the legacy keyword command.
+    #
+    # One display updates the mode and scale of Omarchy's catch-all rule; its
+    # placement, color, and other policy remain intact, while an explicit
+    # per-output user rule still wins. With several displays, each window has
+    # its own size, and the catch-all would leave every output at the last
+    # display's mode. QEMU then recreates the window of each output that
+    # changed, the launcher puts it back at its own size, and the EDID change
+    # that follows starts the next round. Give each output its own rule then;
+    # Hyprland merges it into any rule that output already has.
+    target=""
+    if (( ${#outputs[@]} > 1 )); then
+      user_output_rule "$output" && continue
+      target=$output
+    fi
+    rule="hl.monitor({ output = \"$target\", mode = \"$mode\", scale = \"$scale\" })"
     if ! response=$(hyprctl eval "$rule" 2>&1); then
       printf 'omarchy-native-display-sync: failed to apply %s to %s: %s\n' \
         "$mode" "$output" "$response" >&2
@@ -307,10 +342,10 @@ apply_preferred_modes() {
       last_scale=$scale
     fi
   done
-  shopt -u nullglob
-  # The rule is a catch-all, so one recorded mode only fits a single display.
-  # With several, drop the record and let reloads use Omarchy's own rule.
-  if (( applied == 1 )); then
+  # Reloads apply the recorded mode through the catch-all rule, so it only
+  # fits a single display. With several, drop the record and let reloads use
+  # Omarchy's own rule until the modes are applied again.
+  if (( ${#outputs[@]} == 1 && applied == 1 )); then
     record_mode "$last_mode" "$last_scale"
   else
     rm -f "$state_file"
