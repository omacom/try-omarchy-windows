-# Linux exposes that as a DRM hotplug change.
+# Linux exposes that as a DRM hotplug change. Hyprland has just loaded its
+# config, so no output has a rule from an earlier run.
+rm -f "$own_rules_file"
 apply_preferred_modes
 watch_config_reloads &
 while true; do
