-        "$mode" "$output" "$response" >&2
-    else
-      applied=$((applied + 1))
-      last_mode=$mode
-      last_scale=$scale
-    fi
+    outputs+=("$output")
+    modes+=("$mode")
+    scales+=("$scale")
+    triples+=("$output" "$mode" "$scale")
   done
   shopt -u nullglob
-  # The rule is a catch-all, so one recorded mode only fits a single display.
-  # With several, drop the record and let reloads use Omarchy's own rule.
-  if (( applied == 1 )); then
-    record_mode "$last_mode" "$last_scale"
-  else
-    rm -f "$state_file"
+  (( ${#outputs[@]} )) || { rm -f "$state_file"; return 0; }
+
+  # Aquamarine 0.16 still does not refresh its mode cache when an existing DRM
+  # connector's EDID or physical size changes. A complete modeline bypasses
+  # the stale mode cache; an explicit scale calculated from the fresh EDID
+  # avoids using the stale fullscreen dimensions for Hyprland's auto scale,
+  # unless the user set a number, which comes first. Hyprland's Lua config
+  # parser requires eval instead of the legacy keyword command.
+  if (( ${#outputs[@]} == 1 )); then
+    # One display updates the mode and scale of Omarchy's catch-all rule; its
+    # placement, color, and other policy remain intact, while an explicit
+    # per-output user rule still wins. A rule given to this output while
+    # there were several displays outranks the catch-all, so it follows too.
+    output=${outputs[0]}
+    mode=${modes[0]}
+    scale=${scales[0]}
+    if apply_rule "$output" "hl.monitor({ output = \"\", mode = \"$mode\", scale = \"$scale\" })"; then
+      record_mode "$mode" "$scale"
+    else
+      rm -f "$state_file"
+    fi
+    if [[ -r $own_rules_file ]] && grep -qxF "$output" "$own_rules_file"; then
+      apply_rule "$output" "hl.monitor({ output = \"$output\", mode = \"$mode\", scale = \"$scale\" })" || true
+    fi
+    return 0
+  fi
+
+  # With several displays each window has its own size, and the catch-all
+  # would leave every output at the last display's mode. QEMU then recreates
+  # the window of each output that changed, the launcher puts it back at its
+  # own size, and the EDID change that follows starts the next round. So each
+  # output gets a rule of its own, except one the user configured. Reloads
+  # apply the recorded mode through the catch-all rule, so drop the record and
+  # let reloads use Omarchy's own rule until the modes are applied again.
+  rm -f "$state_file"
+  if ! rules=$(configured_rules); then
+    printf 'omarchy-native-display-sync: could not follow the Hyprland config; leaving the displays alone\n' >&2
+    return 0
+  fi
+  if ! plan=$(plan_output_rules "$rules" "${triples[@]}"); then
+    printf 'omarchy-native-display-sync: could not plan the display rules; leaving the displays alone\n' >&2
+    return 0
+  fi
+  while IFS=$'\t' read -r output rule; do
+    [[ -n $output && -n $rule ]] || continue
+    if apply_rule "$output" "$rule"; then
+      remember_own_rule "$output"
+    fi
+  done <<<"$plan"
+}
+
+# The outputs this script gave a rule of their own since Hyprland last loaded
+# its config, which drops such rules.
+remember_own_rule() {
+  mkdir -p "${own_rules_file%/*}" || return 0
+  if ! grep -qxF "$1" "$own_rules_file" 2>/dev/null; then
+    printf '%s\n' "$1" >>"$own_rules_file" || true
   fi
 }
 
@@ -336,6 +711,7 @@ apply_after_config_reload() {
 
   while IFS= read -r line; do
     if [[ $line == configreloaded* ]]; then
+      rm -f "$own_rules_file"
       apply_preferred_modes
     fi
   done
@@ -400,7 +776,9 @@ if [[ ${1:-} == --config-reloads-from-stdin ]]; then
 fi
 
