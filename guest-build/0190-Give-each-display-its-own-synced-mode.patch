+# Which outputs the user's own Hyprland config already gives a rule, and the
+# settings of its catch-all rule. Hyprland cannot list its monitor rules, so
+# run the config the way Hyprland loads it, from the file it loads through
+# every user module it requires, with hl.monitor recording instead of
+# applying. Modules are found on the search path the running Hyprland uses,
+# asked for through eval; Omarchy's defaults are not run. Fails when the config
+# does something it cannot follow, and then no output gets a rule of its own.
+configured_rules() {
+  local entry=${HYPRLAND_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua}
+  local search_path=""
+
+  # An error is the only way eval returns a value.
+  search_path=$(hyprctl eval 'error(package.path, 0)' 2>&1 || true)
+  if [[ $search_path == "error: "*"?.lua"* ]]; then
+    search_path=${search_path#error: }
+  else
+    # As Omarchy's bootstrap and Hyprland set it up.
+    search_path="$HOME/.local/state/?.lua;$HOME/.config/?.lua;${entry%/*}/?.lua;${entry%/*}/?/init.lua"
+  fi
+  timeout 10 lua - "$entry" "$search_path" "${OMARCHY_PATH:-/usr/share/omarchy}" <<'LUA'
+-- Run the user's Hyprland config with hl.monitor recording instead of
+-- applying, and print the rules it makes: "named<TAB>selector" for each
+-- output or desc: rule, "field<TAB>key<TAB>literal" for the catch-all's
+-- settings, and "panel<TAB>false" when the panel's saved settings are off.
+--
+-- It fails closed: anything that reads Hyprland's state, waits for an event,
+-- runs a command, writes a file, or uses something this recorder does not
+-- know ends the run as unsure, even when the config catches the error, and
+-- the caller then leaves every output alone. Registration calls that only
+-- add binds, rules or settings are ignored.
+local entry, search_path, omarchy_path = arg[1], arg[2], arg[3]
+
+local unsure
+local function fail(reason)
+  unsure = unsure or reason
+  error(reason, 0)
+end
+
+local real_open = io.open
+local function readable(path)
+  local file = real_open(path, "r")
+  if file then
+    file:close()
+    return true
+  end
+  return false
+end
+
+-- A value any use of which means the config depends on something unknown.
+local function poison(what)
+  local function used()
+    fail(what .. " is used")
+  end
+  return setmetatable({}, {
+    __index = used, __newindex = used, __call = used, __len = used, __concat = used,
+    __eq = used, __lt = used, __le = used, __unm = used, __add = used, __sub = used,
+    __mul = used, __div = used, __mod = used, __pow = used, __idiv = used,
+    __band = used, __bor = used, __bxor = used, __shl = used, __shr = used, __bnot = used,
+    __tostring = used, __pairs = used, __close = used,
+  })
+end
+
+-- A dispatcher or launcher value handed to a bind: inert, since nothing at
+-- config load runs it.
+local inert
+inert = setmetatable({}, {
+  __index = function(_, key)
+    if type(key) == "string" then
+      return inert
+    end
+    return nil
+  end,
+  __call = function()
+    return inert
+  end,
+  __newindex = function() end,
+})
+
+local function ignore() end
+
+-- A table whose listed keys are what it holds and whose other keys fail.
+local function only(name, entries)
+  return setmetatable(entries, {
+    __index = function(_, key)
+      fail(name .. "." .. tostring(key) .. " is not known to display sync")
+    end,
+    __newindex = function(_, key)
+      fail(name .. "." .. tostring(key) .. " is set")
+    end,
+  })
+end
+
+local named, fields, order = {}, {}, {}
+local kept_back = { output = true, mode = true, scale = true, position = true }
+
+local function record(rule)
+  if type(rule) ~= "table" or getmetatable(rule) ~= nil or type(rule.output) ~= "string" then
+    fail("hl.monitor without a string output")
+  end
+  if rule.output ~= "" then
+    named[rule.output] = true
+    return
+  end
+  -- Everything but what display sync sets itself: Hyprland merges a later
+  -- catch-all into the earlier one the same way.
+  for key, value in pairs(rule) do
+    if type(key) ~= "string" then
+      fail("hl.monitor with a non-string field")
+    end
+    if not kept_back[key] then
+      if fields[key] == nil then
+        order[#order + 1] = key
+      end
+      fields[key] = value
+    end
+  end
+end
+
+-- Registration only: binds, rules, settings and devices for later. Calls
+-- that read state, wait for events or timers, or dispatch are left out, so
+-- they fail.
+local hl = only("hl", {
+  monitor = record,
+  animation = ignore, bind = ignore, unbind = ignore, config = ignore, curve = ignore,
+  device = ignore, env = ignore, gesture = ignore, layer_rule = ignore, window_rule = ignore,
+  workspace_rule = ignore, permission = ignore, exec_cmd = ignore,
+  define_submap = function(_, body)
+    if type(body) == "function" then
+      body()
+    end
+  end,
+  dsp = inert,
+  plugin = only("hl.plugin", { load = ignore }),
+})
+
+local function shell_quote(value)
+  return "'" .. tostring(value):gsub("'", "'\\''") .. "'"
+end
+
+-- Omarchy's helpers: the ones that register binds, window rules and start
+-- commands, and the launchers that build a bind's command. The ones that
+-- check commands or settings fail.
+local o = only("o", {
+  bind = ignore, rebind = ignore, bind_toggle = ignore, bind_hold = ignore,
+  exec_on_start = ignore, launch_on_start = ignore, window = ignore, transparent_window = ignore,
+  notify = ignore, shell_quote = shell_quote,
+  launch = inert, launch_terminal = inert, launch_webapp = inert, launch_webapp_sole = inert,
+  launch_sole = inert,
+})
+
+local env = {}
+local loaded = {}
+
+local function run(path)
+  local chunk, err = loadfile(path, "t", env)
+  if not chunk then
+    fail(err)
+  end
+  return chunk()
+end
+
+local function omarchy_file(path)
+  return path:sub(1, #omarchy_path + 1) == omarchy_path .. "/"
+end
+
+local function sandbox_require(name)
+  if type(name) ~= "string" then
+    fail("require without a module name")
+  end
+  if loaded[name] ~= nil then
+    return loaded[name]
+  end
+  -- Omarchy's own defaults and the current theme are not the user's rules;
+  -- the panel's saved settings are read from their state file instead.
+  if name:match("^default%.") or name:match("^omarchy%.") then
+    loaded[name] = poison("module " .. name)
+    return loaded[name]
+  end
+  local relative = name:gsub("%.", "/")
+  for template in search_path:gmatch("[^;]+") do
+    local path = template:gsub("%?", (relative:gsub("%%", "%%%%")))
+    if not omarchy_file(path) and readable(path) then
+      loaded[name] = true
+      local result = run(path)
+      if result ~= nil then
+        loaded[name] = result
+      end
+      return loaded[name]
+    end
+  end
+  fail("module " .. name .. " is not in the user's config")
+end
+
+-- The contract tests stand in for the guest's kernel command line.
+local cmdline = os.getenv("OMARCHY_DISPLAY_SYNC_CMDLINE")
+
+local function read_only_open(path, mode)
+  if mode == nil or mode == "r" or mode == "rb" then
+    if path == "/proc/cmdline" and cmdline then
+      path = cmdline
+    end
+    return real_open(path, mode)
+  end
+  fail("the config writes " .. tostring(path))
+end
+
+local function refused(what)
+  return function()
+    fail("the config runs " .. what)
+  end
+end
+
+for _, name in ipairs({
+  "assert", "error", "ipairs", "next", "pairs", "pcall", "rawequal", "rawget", "rawlen",
+  "rawset", "select", "setmetatable", "getmetatable", "tonumber", "tostring", "type", "xpcall",
+}) do
+  env[name] = _G[name]
+end
+env.string, env.table, env.math, env.utf8 = string, table, math, utf8
+env.print = ignore
+env.os = { getenv = os.getenv, time = os.time, clock = os.clock, date = os.date,
+  execute = refused("os.execute"), remove = refused("os.remove"), rename = refused("os.rename"),
+  exit = refused("os.exit"), tmpname = refused("os.tmpname") }
+env.io = { open = read_only_open, lines = function(path) return io.lines(path) end,
+  popen = refused("io.popen"), write = ignore, read = refused("io.read"),
+  output = refused("io.output"), input = refused("io.input") }
+env.package = { path = search_path, loaded = loaded }
+env.require = sandbox_require
+env.dofile = function(path)
+  if type(path) ~= "string" then
+    fail("dofile without a path")
+  end
+  if omarchy_file(path) then
+    return nil
+  end
+  return run(path)
+end
+env.loadfile = function(path, mode, chunk_env)
+  return loadfile(path, mode, chunk_env or env)
+end
+env.load = function(chunk, name, mode, chunk_env)
+  return load(chunk, name, mode, chunk_env or env)
+end
+env.o = o
+env.hl = hl
+env._G = env
+
+local function literal(value)
+  local kind = type(value)
+  if kind == "string" then
+    if value:find("[\r\n]") then
+      fail("a multi-line string in the catch-all")
+    end
+    return string.format("%q", value)
+  elseif kind == "number" or kind == "boolean" then
+    return tostring(value)
+  elseif kind == "table" and getmetatable(value) == nil then
+    local parts = {}
+    for index, item in ipairs(value) do
+      parts[index] = literal(item)
+    end
+    for key, item in pairs(value) do
+      if type(key) == "string" then
+        parts[#parts + 1] = key .. " = " .. literal(item)
+      elseif math.type(key) ~= "integer" or key < 1 or key > #value then
+        fail("a table key in the catch-all that cannot be copied")
+      end
+    end
+    return "{ " .. table.concat(parts, ", ") .. " }"
+  end
+  -- Copying a value that is not plain data would either fail in Hyprland
+  -- or set something other than what the user wrote.
+  fail("a catch-all " .. kind .. " value that cannot be copied")
+end
+
+-- A config that never finishes costs this run, not the display. The config
+-- could catch an error, so the run ends here.
+debug.sethook(function()
+  io.stderr:write("omarchy-native-display-sync: the config runs too long\n")
+  os.exit(3)
+end, "", 20000000)
+
+local ok, err = pcall(function()
+  if not readable(entry) then
+    fail("no Hyprland config at " .. entry)
+  end
+  run(entry)
+end)
+debug.sethook()
+if not ok then
+  unsure = unsure or tostring(err)
+end
+
+local lines = {}
+if not unsure then
+  local selectors = {}
+  for selector in pairs(named) do
+    selectors[#selectors + 1] = selector
+  end
+  table.sort(selectors)
+  for _, selector in ipairs(selectors) do
+    lines[#lines + 1] = "named\t" .. (selector:gsub("[\t\r\n]", " "))
+  end
+  table.sort(order)
+  for _, key in ipairs(order) do
+    local copied, text = pcall(literal, fields[key])
+    if not copied then
+      break
+    end
+    lines[#lines + 1] = "field\t" .. key .. "\t" .. text
+  end
+  if rawget(env, "omarchy_monitor_panel_settings") == false then
+    lines[#lines + 1] = "panel\tfalse"
+  end
+end
+if unsure then
+  io.stderr:write("omarchy-native-display-sync: ", unsure, "\n")
+  os.exit(3)
+end
+print(table.concat(lines, "\n"))
+LUA
+}
+
+# Prints "output<TAB>fields<TAB>rule" for each output that should get a rule of
+# its own, where fields are the synced ones the rule sets, and "output" alone
+# for one display sync must leave alone,
+# from the recorded rules and "output mode scale" triples. An output
+# the user's config names, by connector or desc:, keeps its rule. One the
+# display panel saved settings for gets the mode or the scale only when the
+# panel did not choose it, merged into the panel's rule. Any other output gets
+# the catch-all's settings with its own mode and scale, since a new rule for
+# one output starts from Hyprland's defaults, not from the catch-all.
+plan_output_rules() {
+  python3 - "$@" <<'PY'
+import json
+import os
+import pathlib
+import subprocess
+import sys
+
+recorded, *args = sys.argv[1:]
+outputs = [args[index : index + 3] for index in range(0, len(args), 3)]
+
+named = set()
+fields = []
+panel_on = True
+for line in recorded.splitlines():
+    kind, _, value = line.partition("\t")
+    if kind == "named":
+        named.add(value)
+    elif kind == "field":
+        key, _, literal = value.partition("\t")
+        fields.append((key, literal))
+    elif kind == "panel" and value == "false":
+        panel_on = False
+
+monitors = {
+    monitor["name"]: monitor
+    for monitor in json.loads(
+        subprocess.run(
+            ["hyprctl", "-j", "monitors", "all"],
+            capture_output=True,
+            text=True,
+            timeout=10,
+            check=True,
+        ).stdout
+    )
+}
+
+
+def description_matches(selector: str, monitor: dict) -> bool:
+    # Hyprland matches desc: as a prefix of the description, or of make,
+    # model and serial.
+    wanted = selector[5:].strip()
+    short = " ".join(
+        str(monitor.get(key) or "") for key in ("make", "model", "serial")
+    ).strip()
+    return str(monitor.get("description") or "").startswith(wanted) or short.startswith(wanted)
+
+
+state_home = pathlib.Path(
+    os.environ.get("XDG_STATE_HOME") or pathlib.Path.home() / ".local/state"
+)
+panel_dir = state_home / "omarchy/monitors"
+
+
+def identity(output: str) -> str:
+    # As omarchy-hyprland-monitor-identity: the name monitor-workspaces gave
+    # the monitor on this connector, else its description, else the connector.
+    found = ""
+    try:
+        for line in (panel_dir / "workspaces").read_text(encoding="utf-8").splitlines():
+            columns = line.split("\t", 2)
+            if len(columns) == 3 and columns[1] == output:
+                found = columns[2]
+                break
+    except FileNotFoundError:
+        pass
+    found = found or str(monitors.get(output, {}).get("description") or "") or output
+    return found.replace("\t", " ").replace("\n", " ")
+
+
+# The display panel of newer Omarchy keeps each monitor's choices here and
+# applies them as rules for its connector: mode, position, scale, transform
+# (missing on older lines), then the identity.
+saved = {}
+if panel_on:
+    try:
+        lines = (panel_dir / "settings").read_text(encoding="utf-8").splitlines()
+    except FileNotFoundError:
+        lines = []
+    for line in lines:
+        columns = line.split("\t")
+        if len(columns) in (4, 5) and columns[-1]:
+            saved[columns[-1]] = {"mode": columns[0], "scale": columns[2]}
+
+
+def number(text: str) -> bool:
+    try:
+        float(text)
+    except ValueError:
+        return False
+    return True
+
+
+for output, mode, scale in outputs:
+    monitor = monitors.get(output)
+    if monitor is None:
+        print(f"omarchy-native-display-sync: Hyprland does not list {output}; leaving it alone", file=sys.stderr)
+        continue
+    if output in named or any(
+        selector.startswith("desc:") and description_matches(selector, monitor)
+        for selector in named
+    ):
+        print(output)
+        continue
+    synced = {"mode": mode, "scale": scale}
+    choice = saved.get(identity(output))
+    if choice is not None:
+        if choice["mode"]:
+            del synced["mode"]
+        if number(choice["scale"]):
+            del synced["scale"]
+        if not synced:
+            print(output)
+            continue
+    entry = [f"{key} = {json.dumps(value)}" for key, value in synced.items()]
+    if choice is None:
+        # A catch-all mirror of this very output would mirror it onto itself.
+        entry += [
+            f"{key} = {literal}"
+            for key, literal in fields
+            if not (key == "mirror" and literal == json.dumps(output))
+        ]
+    print(f"{output}\t{','.join(synced)}\thl.monitor({{ output = {json.dumps(output)}, {', '.join(entry)} }})")
+PY
+}
+
+apply_rule() {
+  local output=$1
+  local rule=$2
+  local response
+
+  if ! response=$(hyprctl eval "$rule" 2>&1); then
+    printf 'omarchy-native-display-sync: failed to apply %s to %s: %s\n' \
+      "$rule" "$output" "$response" >&2
+    return 1
+  elif [[ $response != ok ]]; then
+    printf 'omarchy-native-display-sync: Hyprland rejected %s for %s: %s\n' \
+      "$rule" "$output" "$response" >&2
+    return 1
+  fi
+}
+
 apply_preferred_modes() {
   local connector
   local connector_name
   local mode
