+# Which outputs the user's own Hyprland config already gives a rule, and the
+# settings of its catch-all rule. Hyprland cannot list its monitor rules, so
+# run the config the way Hyprland loads it, from hyprland.lua through every
+# user module it requires, with hl.monitor recording instead of applying.
+# Omarchy's defaults are not run. Fails when the config does something it
+# cannot follow, and then no output gets a rule of its own.
+configured_rules() {
+  local config_home=$HOME/.config
+  local entry=${OMARCHY_DISPLAY_SYNC_HYPR_CONFIG:-$config_home/hypr/hyprland.lua}
+
+  timeout 10 lua - "$entry" "$config_home" "$HOME/.local/state" \
+    "${OMARCHY_PATH:-/usr/share/omarchy}" <<'LUA'
+-- Run the user's Hyprland config with hl.monitor recording instead of
+-- applying, and print the rules it makes: "named<TAB>selector" for each
+-- output or desc: rule, "field<TAB>key<TAB>literal" for the catch-all's
+-- settings, and "panel<TAB>false" when the panel's saved settings are off.
+-- Anything it cannot follow is an error, and the caller leaves outputs alone.
+local entry, config_home, state_home, omarchy_path = arg[1], arg[2], arg[3], arg[4]
+
+local real_open = io.open
+local function readable(path)
+  local file = real_open(path, "r")
+  if file then
+    file:close()
+    return true
+  end
+  return false
+end
+
+-- Stands in for Omarchy's helpers and anything hl offers besides monitor:
+-- every field and call gives the stand-in back, and it lists nothing.
+local stand_in
+stand_in = setmetatable({}, {
+  __index = function(_, key)
+    if type(key) == "string" then
+      return stand_in
+    end
+    return nil
+  end,
+  __call = function()
+    return stand_in
+  end,
+  __newindex = function() end,
+})
+
+local named, fields, order = {}, {}, {}
+local copied = {
+  reserved = true, reserved_area = true, transform = true, bitdepth = true, cm = true,
+  sdr_eotf = true, sdrbrightness = true, sdrsaturation = true, vrr = true, icc = true,
+}
+
+local function record(rule)
+  if type(rule) ~= "table" or type(rule.output) ~= "string" then
+    error("hl.monitor without a string output")
+  end
+  if rule.output ~= "" then
+    named[rule.output] = true
+    return
+  end
+  for key, value in pairs(rule) do
+    if copied[key] then
+      if fields[key] == nil then
+        order[#order + 1] = key
+      end
+      fields[key] = value
+    end
+  end
+end
+
+local env = {}
+local loaded = {}
+
+local function run(path)
+  local chunk, err = loadfile(path, "t", env)
+  if not chunk then
+    error(err)
+  end
+  return chunk()
+end
+
+local function omarchy_file(path)
+  return path:sub(1, #omarchy_path + 1) == omarchy_path .. "/"
+end
+
+local function sandbox_require(name)
+  if loaded[name] ~= nil then
+    return loaded[name]
+  end
+  -- Omarchy's own defaults and the current theme are not the user's rules;
+  -- the panel's saved settings are read from their state file instead.
+  if name:match("^default%.") or name:match("^omarchy%.") then
+    loaded[name] = stand_in
+    return stand_in
+  end
+  local relative = name:gsub("%.", "/")
+  for _, root in ipairs({ state_home, config_home }) do
+    local path = root .. "/" .. relative .. ".lua"
+    if readable(path) then
+      loaded[name] = true
+      local result = run(path)
+      if result ~= nil then
+        loaded[name] = result
+      end
+      return loaded[name]
+    end
+  end
+  error("module " .. name .. " is not in the user's config")
+end
+
+local function read_only_open(path, mode)
+  if mode == nil or mode == "r" or mode == "rb" then
+    return real_open(path, mode)
+  end
+  return nil, "read only"
+end
+
+for _, name in ipairs({
+  "assert", "error", "ipairs", "next", "pairs", "pcall", "rawequal", "rawget", "rawlen",
+  "rawset", "select", "setmetatable", "getmetatable", "tonumber", "tostring", "type", "xpcall",
+}) do
+  env[name] = _G[name]
+end
+env.string, env.table, env.math, env.utf8 = string, table, math, utf8
+env.print = function() end
+env.os = { getenv = os.getenv, time = os.time, clock = os.clock, date = os.date,
+  execute = function() return nil end, remove = function() return nil end, rename = function() return nil end }
+env.io = { open = read_only_open, lines = function(path) return io.lines(path) end,
+  popen = function() return nil end, write = function() end }
+env.package = { path = state_home .. "/?.lua;" .. config_home .. "/?.lua;", loaded = loaded }
+env.require = sandbox_require
+env.dofile = function(path)
+  if type(path) ~= "string" then
+    error("dofile without a literal path")
+  end
+  if omarchy_file(path) then
+    return stand_in
+  end
+  return run(path)
+end
+env.loadfile = function(path, mode, chunk_env)
+  return loadfile(path, mode, chunk_env or env)
+end
+env.load = function(chunk, name, mode, chunk_env)
+  return load(chunk, name, mode, chunk_env or env)
+end
+env.o = stand_in
+env.hl = setmetatable({ monitor = record }, getmetatable(stand_in))
+env._G = env
+
+local function literal(value)
+  local kind = type(value)
+  if kind == "string" then
+    if value:find("[\r\n]") then
+      error("unsupported multi-line string")
+    end
+    return string.format("%q", value)
+  elseif kind == "number" or kind == "boolean" then
+    return tostring(value)
+  elseif kind == "table" then
+    local parts = {}
+    for index, item in ipairs(value) do
+      parts[index] = literal(item)
+    end
+    for key, item in pairs(value) do
+      if type(key) == "string" then
+        parts[#parts + 1] = key .. " = " .. literal(item)
+      elseif type(key) ~= "number" or key < 1 or key > #value or key % 1 ~= 0 then
+        error("unsupported table key")
+      end
+    end
+    return "{ " .. table.concat(parts, ", ") .. " }"
+  end
+  error("unsupported " .. kind .. " value")
+end
+
+if readable(entry) then
+  run(entry)
+end
+
+local selectors = {}
+for selector in pairs(named) do
+  selectors[#selectors + 1] = selector
+end
+table.sort(selectors)
+for _, selector in ipairs(selectors) do
+  print("named\t" .. (selector:gsub("[\t\r\n]", " ")))
+end
+table.sort(order)
+for _, key in ipairs(order) do
+  print("field\t" .. key .. "\t" .. literal(fields[key]))
+end
+if rawget(env, "omarchy_monitor_panel_settings") == false then
+  print("panel\tfalse")
+end
+LUA
+}
+
+# Prints "output<TAB>rule" for each output that should get a rule of its own,
+# from the recorded rules and "output mode scale" triples. An output
+# the user's config names, by connector or desc:, keeps its rule. One the
+# display panel saved settings for gets the mode or the scale only when the
+# panel did not choose it, merged into the panel's rule. Any other output gets
+# the catch-all's settings with its own mode and scale, since a new rule for
+# one output starts from Hyprland's defaults, not from the catch-all.
+plan_output_rules() {
+  python3 - "$@" <<'PY'
+import json
+import os
+import pathlib
+import subprocess
+import sys
+
+recorded, *args = sys.argv[1:]
+outputs = [args[index : index + 3] for index in range(0, len(args), 3)]
+
+named = set()
+fields = []
+panel_on = True
+for line in recorded.splitlines():
+    kind, _, value = line.partition("\t")
+    if kind == "named":
+        named.add(value)
+    elif kind == "field":
+        key, _, literal = value.partition("\t")
+        fields.append((key, literal))
+    elif kind == "panel" and value == "false":
+        panel_on = False
+
+monitors = {
+    monitor["name"]: monitor
+    for monitor in json.loads(
+        subprocess.run(
+            ["hyprctl", "-j", "monitors", "all"],
+            capture_output=True,
+            text=True,
+            timeout=10,
+            check=True,
+        ).stdout
+    )
+}
+
+
+def description_matches(selector: str, monitor: dict) -> bool:
+    # Hyprland matches desc: as a prefix of the description, or of make,
+    # model and serial.
+    wanted = selector[5:].strip()
+    short = " ".join(
+        str(monitor.get(key) or "") for key in ("make", "model", "serial")
+    ).strip()
+    return str(monitor.get("description") or "").startswith(wanted) or short.startswith(wanted)
+
+
+state_home = pathlib.Path(
+    os.environ.get("XDG_STATE_HOME") or pathlib.Path.home() / ".local/state"
+)
+panel_dir = state_home / "omarchy/monitors"
+
+
+def identity(output: str) -> str:
+    # As omarchy-hyprland-monitor-identity: the name monitor-workspaces gave
+    # the monitor on this connector, else its description, else the connector.
+    found = ""
+    try:
+        for line in (panel_dir / "workspaces").read_text(encoding="utf-8").splitlines():
+            columns = line.split("\t", 2)
+            if len(columns) == 3 and columns[1] == output:
+                found = columns[2]
+                break
+    except FileNotFoundError:
+        pass
+    found = found or str(monitors.get(output, {}).get("description") or "") or output
+    return found.replace("\t", " ").replace("\n", " ")
+
+
+# The display panel of newer Omarchy keeps each monitor's choices here and
+# applies them as rules for its connector: mode, position, scale, transform
+# (missing on older lines), then the identity.
+saved = {}
+if panel_on:
+    try:
+        lines = (panel_dir / "settings").read_text(encoding="utf-8").splitlines()
+    except FileNotFoundError:
+        lines = []
+    for line in lines:
+        columns = line.split("\t")
+        if len(columns) in (4, 5) and columns[-1]:
+            saved[columns[-1]] = {"mode": columns[0], "scale": columns[2]}
+
+
+def number(text: str) -> bool:
+    try:
+        float(text)
+    except ValueError:
+        return False
+    return True
+
+
+for output, mode, scale in outputs:
+    monitor = monitors.get(output)
+    if monitor is None:
+        print(f"omarchy-native-display-sync: Hyprland does not list {output}; leaving it alone", file=sys.stderr)
+        continue
+    if output in named or any(
+        selector.startswith("desc:") and description_matches(selector, monitor)
+        for selector in named
+    ):
+        continue
+    entry = [f"mode = {json.dumps(mode)}", f"scale = {json.dumps(scale)}"]
+    choice = saved.get(identity(output))
+    if choice is not None:
+        entry = []
+        if not choice["mode"]:
+            entry.append(f"mode = {json.dumps(mode)}")
+        if not number(choice["scale"]):
+            entry.append(f"scale = {json.dumps(scale)}")
+        if not entry:
+            continue
+    else:
+        entry += [f"{key} = {literal}" for key, literal in fields]
+    print(f"{output}\thl.monitor({{ output = {json.dumps(output)}, {', '.join(entry)} }})")
+PY
+}
+
+apply_rule() {
+  local output=$1
+  local rule=$2
+  local response
+
+  if ! response=$(hyprctl eval "$rule" 2>&1); then
+    printf 'omarchy-native-display-sync: failed to apply %s to %s: %s\n' \
+      "$rule" "$output" "$response" >&2
+    return 1
+  elif [[ $response != ok ]]; then
+    printf 'omarchy-native-display-sync: Hyprland rejected %s for %s: %s\n' \
+      "$rule" "$output" "$response" >&2
+    return 1
+  fi
+}
+
 apply_preferred_modes() {
   local connector
   local connector_name
   local mode
   local output
+  local plan
   local preferred
-  local response
   local rule
+  local rules
   local scale
   local user_scale
-  local applied=0
-  local last_mode=""
-  local last_scale=""
+  local -a modes=()
+  local -a outputs=()
+  local -a scales=()
+  local -a triples=()
 
-  # Several displays share the single catch-all rule, so read the file once.
+  # Several displays share the user's scale, so read the file once.
   user_scale=$(configured_scale)
   shopt -s nullglob
   for connector in "$drm_root"/card*-Virtual-*; do
@@ -284,36 +626,69 @@ apply_preferred_modes() {
     fi
     IFS=$'\t' read -r mode scale <<<"$preferred"
     [[ -n $mode && -n $scale ]] || continue
-
-    # Aquamarine 0.14 does not refresh its mode cache when an existing DRM
-    # connector's EDID or physical size changes. A complete modeline bypasses
-    # the stale mode cache; an explicit scale calculated from the fresh EDID
-    # avoids using the stale fullscreen dimensions for Hyprland's auto scale,
-    # unless the user set a number, which comes first. Hyprland's Lua config
