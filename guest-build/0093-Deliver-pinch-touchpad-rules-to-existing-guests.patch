index 54aef80..c717257 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
@@ -8,6 +8,8 @@
 #   - remove the Hyprland toggles an older image switched on by mistake, when
 #     they are still the seeded copies (same mtime as the flags placeholder)
 #   - switch on Omarchy's suspend-off toggle, since a VM cannot suspend
+#   - load the virtual pinch touchpad's device-only rules from input.lua,
+#     once per user, keeping the original file beside it
 # Runs once per integration revision, before the display manager.
 set -euo pipefail
 
@@ -17,6 +19,7 @@ fragment=${TRY_OMARCHY_QEMU_FRAGMENT:-/usr/share/try-omarchy/skel-fragments/hypr
 omarchy_default=${TRY_OMARCHY_OMARCHY_MONITORS:-/usr/share/omarchy/config/hypr/monitors.lua}
 toggle_templates=${TRY_OMARCHY_TOGGLE_TEMPLATES:-/usr/share/omarchy/default/hypr/toggles}
 omarchy_version=${TRY_OMARCHY_OMARCHY_VERSION:-/usr/share/omarchy/version}
+pinch_fragment=${TRY_OMARCHY_PINCH_FRAGMENT:-/usr/share/try-omarchy/skel-fragments/hypr-input-pinch.append.lua}
 homes=${TRY_OMARCHY_HOMES:-/home}
 
 revision=$(cut -d: -f1 "$revision_file" 2>/dev/null || echo 0)
@@ -94,12 +97,79 @@ restore_nvim_theme_link() {
   echo "restored the Neovim theme link for $1"
 }
 
+load_pinch_rules() {
+  # Disks created before the pinch device never got a loader for its rules,
+  # and images since then loaded them unguarded, which breaks input.lua after
+  # try-omarchy-export copies it to a real Omarchy install. Append the current
+  # guarded loader once per user. A later removal is the user's choice and is
+  # not undone. Files that cannot safely be extended are left alone;
+  # try-omarchy-pinch-ready then keeps the device ignored.
+  local home=$1 file=$1/.config/hypr/input.lua record=$state_dir/pinch-input/${1##*/}
+  local backup=$1/.config/hypr/input.lua.before-try-omarchy-pinch last tmp
+  [[ -f $pinch_fragment && ! -e $record ]] || return 0
+  # Never write through a linked config, such as a dotfiles checkout.
+  if [[ -L $1/.config/hypr || -L $file || ! -f $file ]]; then
+    echo "left pinch gestures off for $home: $file is linked or not a regular file"
+    return 0
+  fi
+  if grep -qxF -- '-- BEGIN TRY OMARCHY PINCH DEVICE' "$file"; then
+    mkdir -p "${record%/*}" && : >"$record"
+    return 0
+  fi
+  if ! grep -qxF "$legacy_pinch_load" "$file" && grep -qE '^[^-]*qemu-virtio-pinch-touchpad' "$file"; then
+    echo "kept the pinch device rules $home already has in $file"
+    mkdir -p "${record%/*}" && : >"$record"
+    return 0
+  fi
+  # Code after a top-level return would not parse.
+  last=$(grep -vE '^[[:space:]]*(--.*)?$' "$file" | tail -n 1 || true)
+  if [[ $last =~ ^[[:space:]]*return([^[:alnum:]_]|$) ]]; then
+    echo "left pinch gestures off for $home: $file ends with a return statement"
+    return 0
+  fi
+  # set -e does not apply here (the caller uses || true), so check each step.
+  if [[ ! -e $backup && ! -L $backup ]] && ! cp -p "$file" "$backup"; then
+    echo "left pinch gestures off for $home: could not keep a copy of $file"
+    return 0
+  fi
+  tmp=$(mktemp "$(dirname "$file")/.input.lua.XXXXXX") || return 0
+  # Drop the unguarded loader earlier images appended, with its comment and
+  # the blank line before it, then append the guarded one.
+  if awk -v comment="$legacy_pinch_comment" -v loader="$legacy_pinch_load" '
+      { line[NR] = $0 }
+      END {
+        for (i = 1; i <= NR; i++) {
+          if (line[i] == loader) {
+            if (kept && out[kept] == comment) kept--
+            if (kept && out[kept] == "") kept--
+            continue
+          }
+          out[++kept] = line[i]
+        }
+        for (i = 1; i <= kept; i++) print out[i]
+      }' "$file" >"$tmp" &&
+    cat "$pinch_fragment" >>"$tmp" &&
+    chown --reference="$file" "$tmp" &&
+    chmod --reference="$file" "$tmp" &&
+    mv -f "$tmp" "$file"; then
+    mkdir -p "${record%/*}" && : >"$record"
+    echo "loaded the pinch device rules in $file (original kept as $backup)"
+  else
+    rm -f "$tmp"
+    echo "left pinch gestures off for $home: could not update $file"
+  fi
+}
+
+legacy_pinch_comment="-- Try Omarchy's host pinch device carries gestures only."
+legacy_pinch_load='dofile("/usr/share/try-omarchy/pinch-input.lua")'
+
 for home in "$homes"/*; do
   restore_nvim_theme_link "$home" || true
   [[ -d $home/.config/hypr ]] || continue
   refresh_monitors "$home" || true
   remove_seeded_toggles "$home" || true
   enable_suspend_off "$home" || true
+  load_pinch_rules "$home" || true
 done
 printf '%s\n' "$revision" >"$marker"
 exit 0
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/pinch-ready b/guest/factory-overlay/usr/local/lib/try-omarchy/pinch-ready
new file mode 100755
index 0000000..ada6604
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/pinch-ready
@@ -0,0 +1,51 @@
+#!/bin/bash
+# libinput ignores Try Omarchy's virtual pinch touchpad until every desktop
+# user's Hyprland config loads its device-only rules. Without them a Windows
+# pinch can register as a two-finger tap click, and typing can suppress it.
+# Runs every boot, after provisioning and catch-up and before the desktop, so
+# a later edit that drops the rules turns the device off again. The reason is
+# left in /run/try-omarchy/pinch-gestures.
+set -uo pipefail
+
+rules=${TRY_OMARCHY_PINCH_RULES:-/usr/share/try-omarchy/pinch-input.lua}
+homes=${TRY_OMARCHY_HOMES:-/home}
+run_dir=${TRY_OMARCHY_RUN_DIR:-/run/try-omarchy}
+sysfs=${TRY_OMARCHY_SYSFS:-/sys}
+device="QEMU Virtio Pinch Touchpad"
+
+reason=""
+users=0
+[[ -f $rules ]] || reason="$rules is missing"
+for home in "$homes"/*; do
+  config=$home/.config/hypr
+  [[ -d $config ]] || continue
+  users=$((users + 1))
+  [[ -z $reason ]] || continue
+  if ! grep -qE "^[[:space:]]*require[[:space:](]+[\"']hypr\.input[\"']" "$config/hyprland.lua" 2>/dev/null; then
+    reason="$config/hyprland.lua does not load hypr.input"
+  elif ! grep -qE -e '^-- BEGIN TRY OMARCHY PINCH DEVICE$' \
+      -e "^[[:space:]]*dofile\(\"$rules\"\)" \
+      -e '^[^-]*qemu-virtio-pinch-touchpad' "$config/input.lua" 2>/dev/null; then
+    reason="$config/input.lua does not load $rules"
+  fi
+done
+((users)) || reason=${reason:-no desktop user has a Hyprland config}
+
+mkdir -p "$run_dir"
+if [[ -z $reason ]]; then
+  : >"$run_dir/pinch-ready"
+  echo ready >"$run_dir/pinch-gestures"
+  echo "pinch gestures are ready"
+else
+  rm -f "$run_dir/pinch-ready"
+  printf 'inactive: %s\n' "$reason" >"$run_dir/pinch-gestures"
+  echo "pinch gestures stay off: $reason"
+fi
+
+# udev classified the device during coldplug, before this ran.
+for name in "$sysfs"/class/input/input*/name; do
+  [[ -f $name && $(<"$name") == "$device" ]] || continue
+  udevadm trigger --action=change --parent-match="$(dirname "$(readlink -f "$name")")" || true
+done
+udevadm settle --timeout=10 || true
+exit 0
diff --git a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-input-pinch.append.lua b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-input-pinch.append.lua
new file mode 100644
index 0000000..18df2ce
--- /dev/null
+++ b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-input-pinch.append.lua
@@ -0,0 +1,14 @@
+
+-- BEGIN TRY OMARCHY PINCH DEVICE
+-- Try Omarchy's virtual pinch touchpad only carries Windows pinch gestures.
+-- Its device-only rules keep those contacts from turning into tap clicks.
+-- Other Omarchy installs do not have the file, so nothing loads there.
+do
+  local rules = "/usr/share/try-omarchy/pinch-input.lua"
+  local file = io.open(rules, "r")
+  if file then
+    file:close()
+    dofile(rules)
+  end
+end
+-- END TRY OMARCHY PINCH DEVICE
