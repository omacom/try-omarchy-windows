+[Unit]
+Description=Enable Try Omarchy pinch gestures once Hyprland applies their device rules
+After=systemd-udev-trigger.service try-omarchy-catch-up.service omarchy-provision-owner.service
+Before=display-manager.service
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/lib/try-omarchy/pinch-ready
+
+[Install]
+WantedBy=multi-user.target
diff --git a/guest/factory-overlay/etc/udev/rules.d/70-try-omarchy-pinch.rules b/guest/factory-overlay/etc/udev/rules.d/70-try-omarchy-pinch.rules
new file mode 100644
index 0000000..ceeec00
--- /dev/null
+++ b/guest/factory-overlay/etc/udev/rules.d/70-try-omarchy-pinch.rules
@@ -0,0 +1,4 @@
+# Try Omarchy's virtual pinch touchpad only carries Windows pinch gestures.
+# libinput ignores it until try-omarchy-pinch-ready confirms that Hyprland
+# turns off tapping and disable-while-typing for it.
+ACTION!="remove", SUBSYSTEM=="input", KERNEL=="event*", ATTRS{name}=="QEMU Virtio Pinch Touchpad", TEST!="/run/try-omarchy/pinch-ready", ENV{LIBINPUT_IGNORE_DEVICE}="1"
