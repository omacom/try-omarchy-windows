+class PinchReadyTests(OverlayCase):
+    def setUp(self) -> None:
+        super().setUp()
+        self.homes = self.root / "homes"
+        self.config = self.homes / "alice/.config/hypr"
+        self.config.mkdir(parents=True)
+        (self.config / "hyprland.lua").write_text('require("default.hypr.omarchy")\nrequire("hypr.input")\n')
+        self.rules = self.root / "pinch-input.lua"
+        self.rules.write_text("hl.device({})\n")
+        self.run_dir = self.root / "run"
+        self.sysfs = self.root / "sys"
+        device = self.sysfs / "devices/virtual/input/input7"
+        device.mkdir(parents=True)
+        (device / "name").write_text("QEMU Virtio Pinch Touchpad\n")
+        tablet = self.sysfs / "devices/virtual/input/input3"
+        tablet.mkdir(parents=True)
+        (tablet / "name").write_text("QEMU Virtio Tablet\n")
+        (self.sysfs / "class/input").mkdir(parents=True)
+        (self.sysfs / "class/input/input7").symlink_to(device)
+        (self.sysfs / "class/input/input3").symlink_to(tablet)
+        self.device = device
+        self.fake("udevadm", f'echo "udevadm $*" >>"{self.log}"')
+
+    def run_ready(self) -> subprocess.CompletedProcess:
+        return self.run_script(PINCH_READY, TRY_OMARCHY_PINCH_RULES=str(self.rules), TRY_OMARCHY_HOMES=str(self.homes),
+                               TRY_OMARCHY_RUN_DIR=str(self.run_dir), TRY_OMARCHY_SYSFS=str(self.sysfs))
+
+    def status(self) -> str:
+        return (self.run_dir / "pinch-gestures").read_text().strip()
+
+    def test_the_guarded_loader_enables_the_device(self) -> None:
+        (self.config / "input.lua").write_text("-- mine\n" + PINCH_FRAGMENT.read_text())
+        result = self.run_ready()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertTrue((self.run_dir / "pinch-ready").exists())
+        self.assertEqual(self.status(), "ready")
+        calls = self.log.read_text().splitlines()
+        self.assertEqual(calls, [f"udevadm trigger --action=change --parent-match={self.device}", "udevadm settle --timeout=10"])
+
+    def test_the_legacy_loader_and_a_users_own_rule_count_as_ready(self) -> None:
+        for content in (f'dofile("{self.rules}")\n', 'hl.device({ name = "qemu-virtio-pinch-touchpad", tap_to_click = false })\n'):
+            with self.subTest(content=content):
+                (self.config / "input.lua").write_text(content)
+                self.run_ready()
+                self.assertEqual(self.status(), "ready")
+
+    def test_input_without_the_rules_keeps_the_device_ignored(self) -> None:
+        self.run_dir.mkdir()
+        (self.run_dir / "pinch-ready").touch()
+        # A commented-out device rule does not count.
+        (self.config / "input.lua").write_text('-- nothing here\n-- name = "qemu-virtio-pinch-touchpad"\n')
+        result = self.run_ready()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse((self.run_dir / "pinch-ready").exists())
+        self.assertIn("input.lua does not load", self.status())
+        self.assertIn("pinch gestures stay off", result.stdout)
+        # The device is reclassified either way, so a stale udev state cannot linger.
+        self.assertIn(f"--parent-match={self.device}", self.log.read_text())
+
+    def test_a_config_that_never_loads_input_lua_keeps_the_device_ignored(self) -> None:
+        (self.config / "input.lua").write_text(PINCH_FRAGMENT.read_text())
+        (self.config / "hyprland.lua").write_text('-- require("hypr.input")\n')
+        self.run_ready()
+        self.assertIn("does not load hypr.input", self.status())
+
+    def test_one_unready_user_or_no_rules_file_keeps_the_device_ignored(self) -> None:
+        (self.config / "input.lua").write_text(PINCH_FRAGMENT.read_text())
+        other = self.homes / "bob/.config/hypr"
+        other.mkdir(parents=True)
+        (other / "hyprland.lua").write_text('require "hypr.input"\n')
+        (other / "input.lua").write_text("-- no loader\n")
+        self.run_ready()
+        self.assertIn("bob/.config/hypr/input.lua does not load", self.status())
+        (other / "input.lua").write_text(PINCH_FRAGMENT.read_text())
+        self.run_ready()
+        self.assertEqual(self.status(), "ready")
+        self.rules.unlink()
+        self.run_ready()
+        self.assertIn("pinch-input.lua is missing", self.status())
+
+    def test_no_desktop_user_keeps_the_device_ignored(self) -> None:
+        shutil.rmtree(self.homes)
+        self.homes.mkdir()
+        result = self.run_ready()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse((self.run_dir / "pinch-ready").exists())
+        self.assertIn("no desktop user", self.status())
+
 
