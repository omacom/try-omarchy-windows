@@ -760,6 +763,180 @@ class CatchUpTests(OverlayCase):
         self.assertEqual(result.returncode, 0, result.stderr)
         self.assertEqual(os.readlink(plugins / "theme.lua"), "../../../../.config/omarchy/current/theme/neovim.lua")
 
+    def next_revision(self, revision: int) -> None:
+        self.version.write_text(f"{revision}:7.2.3-arch1\n")
+
+    def test_existing_input_gets_the_pinch_loader_once_and_keeps_its_content(self) -> None:
+        input_lua = self.user / ".config/hypr/input.lua"
+        original = 'hl.config({ input = { kb_layout = "us,dk" } })\n'
+        input_lua.write_text(original)
+        input_lua.chmod(0o640)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(input_lua.read_text(), original + PINCH_FRAGMENT.read_text())
+        self.assertEqual(input_lua.stat().st_mode & 0o777, 0o640)
+        backup = self.user / ".config/hypr/input.lua.before-try-omarchy-pinch"
+        self.assertEqual(backup.read_text(), original)
+        self.assertIn("loaded the pinch device rules", result.stdout)
+        # Later revisions neither duplicate the loader nor replace the copy.
+        self.next_revision(13)
+        self.run_catch_up()
+        self.assertEqual(input_lua.read_text().count("BEGIN TRY OMARCHY PINCH DEVICE"), 1)
+        self.assertEqual(backup.read_text(), original)
+        # Removing the loader is the user's choice and survives upgrades.
+        input_lua.write_text(original)
+        self.next_revision(14)
+        self.run_catch_up()
+        self.assertEqual(input_lua.read_text(), original)
+
+    def test_the_unguarded_factory_loader_is_replaced(self) -> None:
+        input_lua = self.user / ".config/hypr/input.lua"
+        skeleton = "-- Keep only your personal input overrides here.\n"
+        legacy = "\n-- Try Omarchy's host pinch device carries gestures only.\ndofile(\"/usr/share/try-omarchy/pinch-input.lua\")\n"
+        input_lua.write_text(skeleton + legacy)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(input_lua.read_text(), skeleton + PINCH_FRAGMENT.read_text())
+        self.assertEqual((self.user / ".config/hypr/input.lua.before-try-omarchy-pinch").read_text(), skeleton + legacy)
+
+    def test_a_users_own_pinch_device_rule_is_kept(self) -> None:
+        input_lua = self.user / ".config/hypr/input.lua"
+        own = 'hl.device({\n  name = "qemu-virtio-pinch-touchpad",\n  tap_to_click = false,\n})\n'
+        input_lua.write_text(own)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(input_lua.read_text(), own)
+        self.assertFalse((self.user / ".config/hypr/input.lua.before-try-omarchy-pinch").exists())
+
+    def test_input_that_cannot_be_extended_safely_is_left_alone(self) -> None:
+        input_lua = self.user / ".config/hypr/input.lua"
+        returning = "local M = {}\nreturn M -- module\n\n-- trailing note\n"
+        input_lua.write_text(returning)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(input_lua.read_text(), returning)
+        self.assertIn("ends with a return statement", result.stdout)
+        # A dotfiles symlink is never written through.
+        target = self.root / "dotfiles-input.lua"
+        target.write_text("-- managed elsewhere\n")
+        input_lua.unlink()
+        input_lua.symlink_to(target)
+        self.next_revision(13)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(target.read_text(), "-- managed elsewhere\n")
+        self.assertTrue(input_lua.is_symlink())
+        self.assertIn("is linked or not a regular file", result.stdout)
+        self.assertFalse((self.user / ".config/hypr/input.lua.before-try-omarchy-pinch").exists())
+        # Nor is a linked Hyprland directory.
+        dotfiles = self.root / "dotfiles-hypr"
+        shutil.move(self.user / ".config/hypr", dotfiles)
+        (dotfiles / "input.lua").unlink()
+        (dotfiles / "input.lua").write_text("-- managed elsewhere\n")
+        (self.user / ".config/hypr").symlink_to(dotfiles)
+        self.next_revision(14)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual((dotfiles / "input.lua").read_text(), "-- managed elsewhere\n")
+        self.assertFalse((dotfiles / "input.lua.before-try-omarchy-pinch").exists())
+
+    def test_an_untouched_default_input_gets_the_loader(self) -> None:
+        input_lua = self.user / ".config/hypr/input.lua"
+        default = "-- Keep only your personal input overrides here.\n-- hl.config({\n--   input = {},\n-- })\n"
+        input_lua.write_text(default)
+        result = self.run_catch_up()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(input_lua.read_text(), default + PINCH_FRAGMENT.read_text())
+
