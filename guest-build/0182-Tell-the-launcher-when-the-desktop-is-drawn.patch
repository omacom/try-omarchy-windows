+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/desktop-drawn
@@ -0,0 +1,281 @@
+#!/usr/bin/env python3
+"""Tell the Windows launcher when the desktop is drawn, once per Hyprland session.
+
+The launcher keeps its window hidden while Omarchy starts and shows it on this
+report. The desktop counts as drawn when, on the first monitor, the shell's
+wallpaper layer and bar are mapped, its black startup cover is gone, and a
+small capture of the screen shows a wallpaper. The shell normally lifts the
+cover once the wallpaper has rendered, but after 10 seconds it lifts it
+anyway, and on a slow PC the wallpaper is then still being decoded. A dark
+wallpaper cannot be told from an empty screen, so the report goes out
+PAINT_WAIT after the layers are up even if the capture never shows one, and
+also when the capture does not work. A short settle then gives the compositor
+time to present the frame. Captures are scaled down, read in memory and
+dropped.
+
+The agent runs this for each launcher connection with the channel on a file
+descriptor and the agent's write lock, and stops it when the connection ends.
+Hyprland's IPC sockets are read directly, so watching the layers costs no
+processes; grim runs only while the wallpaper is awaited, at most twice a second.
+"""
+import argparse
+import fcntl
+import glob
+import json
+import os
+import pathlib
+import pwd
+import re
+import select
+import socket
+import subprocess
+import sys
+import time
+
+BACKGROUND = "omarchy-background"
+BAR = "omarchy-bar"
+# zwlr_layer_shell levels as hyprctl reports them.
+LEVEL_BACKGROUND, LEVEL_OVERLAY = "0", "3"
+SETTLE = 0.5
+IPC_TIMEOUT = 2
+# Events can be missed between connections, so look again at least this often.
+POLL = 1.0
+# How long to look for the wallpaper once the layers are up, and how often.
+PAINT_WAIT = 8.0
+PAINT_POLL = 0.5
+CAPTURE_SCALE = "0.1"
+# Where the wallpaper is sampled, as fractions of the output (left, top,
+# right, bottom): below the bar, above the dock, left of the notifications.
+SAMPLE_AREA = (0.03, 0.12, 0.60, 0.80)
+SAMPLE_COLUMNS, SAMPLE_ROWS = 16, 10
+
+
+def instances(runtime_root="/run/user"):
+    """Hyprland instance directories owned by the session user they belong to."""
+    found = []
+    for path in sorted(glob.glob(f"{runtime_root}/*/hypr/*/.socket.sock")):
+        sock = pathlib.Path(path)
+        try:
+            uid = int(sock.parents[2].name)
+            if sock.stat().st_uid != uid:
+                continue
+        except (OSError, ValueError):
+            continue
+        found.append(sock.parent)
+    return found
+
+
+def request(instance, command, timeout=IPC_TIMEOUT):
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
+        conn.settimeout(timeout)
+        conn.connect(str(instance / ".socket.sock"))
+        conn.sendall(command.encode())
+        chunks = []
+        while True:
+            chunk = conn.recv(65536)
+            if not chunk:
+                break
+            chunks.append(chunk)
+    return json.loads(b"".join(chunks))
+
+
+def first_monitor(monitors):
+    if not isinstance(monitors, list) or not monitors:
+        return None
+    return min(monitors, key=lambda m: m.get("id", 0)).get("name")
+
+
+def drawn(layers, monitors):
+    """Whether the first monitor shows the wallpaper and bar, uncovered."""
+    first = first_monitor(monitors)
+    if first is None or not isinstance(layers, dict):
+        return False
+    levels = (layers.get(first) or {}).get("levels") or {}
+
+    def names(level):
+        return {layer.get("namespace") for layer in levels.get(level) or []}
+
+    mapped = set().union(*(names(level) for level in levels)) if levels else set()
+    return (BACKGROUND in names(LEVEL_BACKGROUND)
+            and BAR in mapped
+            and BACKGROUND not in names(LEVEL_OVERLAY))
+
+
+def instance_drawn(instance):
+    try:
+        return drawn(request(instance, "j/layers"), request(instance, "j/monitors"))
+    except (OSError, ValueError):
+        return False
+
+
+def parse_ppm(data):
+    """Width, height and RGB bytes of a binary PPM, as grim writes it."""
+    header = re.match(rb"P6\s+(\d+)\s+(\d+)\s+255\s", data)
+    if not header:
+        raise ValueError("not an 8-bit binary PPM")
+    width, height = int(header[1]), int(header[2])
+    rgb = data[header.end():header.end() + width * height * 3]
+    if len(rgb) < width * height * 3:
+        raise ValueError("short PPM")
+    return width, height, rgb
+
+
+def wallpaper_shown(width, height, rgb):
+    """Whether the part of the frame the bar, dock and notifications leave
+    free shows a wallpaper rather than flat black or Hyprland's #111111.
+    Like the launcher's frame test (app/boot_curtain.go), a frame counts when
+    enough samples differ from the median, or when it is one flat colour
+    that is neither."""
+    if width < SAMPLE_COLUMNS or height < SAMPLE_ROWS or len(rgb) < width * height * 3:
+        return False
+    samples = []
+    for row in range(SAMPLE_ROWS):
+        y = int(height * (SAMPLE_AREA[1] + (SAMPLE_AREA[3] - SAMPLE_AREA[1]) * (row + 0.5) / SAMPLE_ROWS))
+        for column in range(SAMPLE_COLUMNS):
+            x = int(width * (SAMPLE_AREA[0] + (SAMPLE_AREA[2] - SAMPLE_AREA[0]) * (column + 0.5) / SAMPLE_COLUMNS))
+            offset = (y * width + x) * 3
+            samples.append(tuple(rgb[offset:offset + 3]))
+
+    def median(values):
+        return sorted(values)[len(values) // 2]
+
+    lums = [(r * 299 + g * 587 + b * 114) // 1000 for r, g, b in samples]
+    middle = median(lums)
+    if sum(1 for lum in lums if abs(lum - middle) > 6) * 100 >= len(lums) * 15:
+        return True
+    flat = [median([sample[i] for sample in samples]) for i in range(3)]
+    return all(max(abs(c - level) for c in flat) > 6 for level in (0, 0x11))
+
+
+def capture(instance, output):
+    """A scaled-down capture of one output, taken as the session's user."""
+    lock = (instance / "hyprland.lock").read_text().split()
+    if len(lock) < 2 or "/" in lock[1]:
+        raise ValueError("no Wayland display for this instance")
+    runtime = instance.parents[1]
+    env = {"PATH": "/usr/bin:/bin", "XDG_RUNTIME_DIR": str(runtime), "WAYLAND_DISPLAY": lock[1]}
+    user = {}
+    if os.geteuid() == 0:
+        uid = int(runtime.name)
+        user = {"user": uid, "group": pwd.getpwuid(uid).pw_gid, "extra_groups": []}
+    result = subprocess.run(["grim", "-s", CAPTURE_SCALE, "-t", "ppm", "-o", output, "-"],
+                            env=env, capture_output=True, timeout=IPC_TIMEOUT * 2, check=True, **user)
+    return parse_ppm(result.stdout)
+
+
+def instance_painted(instance):
+    """Whether the first monitor shows a wallpaper. True when the screen
+    cannot be captured, so the layer check alone decides."""
+    try:
+        output = first_monitor(request(instance, "j/monitors"))
+        if output is None:
+            return True
+        return wallpaper_shown(*capture(instance, output))
+    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
+        return True
+
+
+def open_events(instance):
+    """Hyprland's event socket, or None. Open it before looking, so a layer
+    that changes while this looks still wakes the wait."""
+    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        conn.settimeout(IPC_TIMEOUT)
+        conn.connect(str(instance / ".socket2.sock"))
+        return conn
+    except OSError:
+        conn.close()
+        return None
+
+
+def wait_for_layers(conn, timeout):
+    """Return when a layer opens or closes, or after timeout."""
+    if conn is None:
+        time.sleep(timeout)
+        return
+    end = time.monotonic() + timeout
+    pending = b""
+    try:
+        while (left := end - time.monotonic()) > 0:
+            if not select.select([conn], [], [], left)[0]:
+                return
+            chunk = conn.recv(65536)
+            if not chunk:
+                time.sleep(max(0, end - time.monotonic()))
+                return
+            pending += chunk
+            *lines, pending = pending.split(b"\n")
+            if any(line.startswith((b"openlayer>>", b"closelayer>>")) for line in lines):
+                return
+    except OSError:
+        time.sleep(max(0, end - time.monotonic()))
+
+
+def watch(emit, runtime_root="/run/user", settle=SETTLE, poll=POLL,
+          is_drawn=instance_drawn, events=open_events, wait=wait_for_layers, rounds=None,
+          is_painted=instance_painted, paint_wait=PAINT_WAIT, paint_poll=PAINT_POLL,
+          clock=time.monotonic):
+    """Emit once for each Hyprland instance whose desktop is drawn."""
+    reported = set()
+    # When each instance's layers were first seen drawn.
+    laid_out = {}
+    while rounds is None or rounds > 0:
+        if rounds is not None:
+            rounds -= 1
+        current = instances(runtime_root)
+        # A logout removes the instance; a new login is a new one.
+        reported &= set(current)
+        laid_out = {i: t for i, t in laid_out.items() if i in current}
+        waiting = [i for i in current if i not in reported]
+        if not waiting:
+            time.sleep(poll)
+            continue
+        conn = events(waiting[0])
+        try:
+            for instance in waiting:
+                if not is_drawn(instance):
+                    laid_out.pop(instance, None)
+                    continue
+                since = laid_out.setdefault(instance, clock())
+                if not is_painted(instance) and clock() - since < paint_wait:
+                    continue
+                time.sleep(settle)
+                if is_drawn(instance):
+                    emit()
+                    reported.add(instance)
+            first = waiting[0]
+            if first not in reported:
+                # While the wallpaper is awaited, nothing on the event
+                # socket announces it, so look again sooner.
+                wait(conn, paint_poll if first in laid_out else poll)
+        finally:
+            if conn is not None:
+                conn.close()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--fd", type=int, help="write the report to this descriptor")
+    parser.add_argument("--lock", help="hold this lock while writing")
+    parser.add_argument("--runtime-root", default="/run/user", help=argparse.SUPPRESS)
+    args = parser.parse_args()
+
+    def emit():
+        line = b"desktop drawn\n"
+        if args.fd is None:
+            sys.stdout.buffer.write(line)
+            sys.stdout.flush()
+            return
+        with open(args.lock or os.devnull, "a") as lock:
+            if args.lock:
+                fcntl.flock(lock, fcntl.LOCK_EX)
+            os.write(args.fd, line)
+
+    try:
+        watch(emit, args.runtime_root)
+    except (BrokenPipeError, KeyboardInterrupt):
+        pass
+
+
+if __name__ == "__main__":
+    main()
