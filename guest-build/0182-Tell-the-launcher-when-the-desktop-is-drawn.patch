+++ b/guest/tests/test_desktop_drawn.py
@@ -0,0 +1,306 @@
+import importlib.machinery
+import json
+import os
+from pathlib import Path
+import socket
+import subprocess
+import tempfile
+import threading
+import time
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+HELPER = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/desktop-drawn'
+AGENT = HELPER.parent / 'agent'
+drawn_helper = importlib.machinery.SourceFileLoader('desktop_drawn', str(HELPER)).load_module()
+
+MONITORS = [{'id': 0, 'name': 'Virtual-1'}, {'id': 1, 'name': 'Virtual-2'}]
+
+
+def layers(*per_level, monitor='Virtual-1'):
+    """Layers on one monitor as hyprctl -j layers reports them, by level 0-3."""
+    levels = {str(level): [{'namespace': name, 'w': 1280, 'h': 729} for name in names]
+              for level, names in enumerate(per_level)}
+    for level in range(4):
+        levels.setdefault(str(level), [])
+    return {monitor: {'levels': levels}}
+
+
+# What Omarchy 4.5's shell maps while a session starts, sampled from a guest
+# with hyprctl -j layers.
+STARTING = layers([], [], [], [])
+COVERED = layers([], [], [], ['omarchy-background'])
+COVERED_BAR = layers([], [], ['omarchy-bar'], ['omarchy-background'])
+COVERED_ALL = layers(['omarchy-background'], [], ['omarchy-bar', 'omarchy-dock'], ['omarchy-background'])
+REVEALED = layers(['omarchy-background'], [], ['omarchy-bar', 'omarchy-dock'], ['omarchy-notifications'])
+
+
+class DrawnTests(unittest.TestCase):
+    def test_the_startup_sequence(self):
+        for state in [STARTING, COVERED, COVERED_BAR, COVERED_ALL]:
+            self.assertFalse(drawn_helper.drawn(state, MONITORS), state)
+        self.assertTrue(drawn_helper.drawn(REVEALED, MONITORS))
+
+    def test_needs_wallpaper_and_bar(self):
+        self.assertFalse(drawn_helper.drawn(layers([], [], ['omarchy-bar'], []), MONITORS))
+        self.assertFalse(drawn_helper.drawn(layers(['omarchy-background'], [], [], []), MONITORS))
+        # A theme cover on the bottom level is not the wallpaper.
+        self.assertFalse(drawn_helper.drawn(layers([], ['omarchy-background'], ['omarchy-bar'], []), MONITORS))
+
+    def test_first_monitor_only(self):
+        second = layers(['omarchy-background'], [], ['omarchy-bar'], [], monitor='Virtual-2')
+        self.assertFalse(drawn_helper.drawn(second, MONITORS))
+        both = dict(second, **REVEALED)
+        self.assertTrue(drawn_helper.drawn(both, list(reversed(MONITORS))))
+
+    def test_bad_replies(self):
+        for reply, monitors in [({}, MONITORS), (REVEALED, []), (None, MONITORS), (REVEALED, {}), ([], MONITORS)]:
+            self.assertFalse(drawn_helper.drawn(reply, monitors))
+
+
+def frame(width=128, height=72, fill=(0, 0, 0), boxes=()):
+    """An RGB frame with filled boxes, given as fractions of the frame."""
+    pixels = bytearray(bytes(fill) * width * height)
+    for (left, top, right, bottom), colour in boxes:
+        for y in range(int(top * height), int(bottom * height)):
+            for x in range(int(left * width), int(right * width)):
+                pixels[(y * width + x) * 3:(y * width + x) * 3 + 3] = bytes(colour)
+    return width, height, bytes(pixels)
+
+
+BAR = ((0, 0, 1, 0.04), (40, 40, 60))
+NOTIFICATIONS = ((0.7, 0.05, 1, 0.95), (30, 30, 46))
+DOCK = ((0.35, 0.9, 0.65, 1), (50, 50, 70))
+
+
+class WallpaperTests(unittest.TestCase):
+    def test_an_uncovered_desktop_without_its_wallpaper(self):
+        # What the window showed for 1 to 2 seconds when the shell lifted its
+        # cover on its timer, before the wallpaper was decoded.
+        for fill in [(0, 0, 0), (0x11, 0x11, 0x11)]:
+            self.assertFalse(drawn_helper.wallpaper_shown(*frame(fill=fill, boxes=[BAR, NOTIFICATIONS, DOCK])))
+
+    def test_wallpapers(self):
+        width, height = 128, 72
+        gradient = bytes(v for y in range(height) for x in range(width) for v in (x * 2, y * 3, 90))
+        self.assertTrue(drawn_helper.wallpaper_shown(width, height, gradient))
+        self.assertTrue(drawn_helper.wallpaper_shown(*frame(fill=(40, 60, 120), boxes=[BAR, NOTIFICATIONS])))
+        self.assertFalse(drawn_helper.wallpaper_shown(4, 4, bytes(48)))
+
+    def test_ppm(self):
+        self.assertEqual(drawn_helper.parse_ppm(b'P6\n2 1\n255\n' + bytes(range(6))), (2, 1, bytes(range(6))))
+        for bad in [b'P5\n2 1\n255\n' + bytes(2), b'P6\n2 1\n255\n' + bytes(5), b'']:
+            with self.assertRaises(ValueError):
+                drawn_helper.parse_ppm(bad)
+
+    def test_a_capture_that_fails_leaves_the_layers_to_decide(self):
+        root = tempfile.mkdtemp(dir='/tmp')
+        self.addCleanup(subprocess.run, ['rm', '-rf', root])
+        hypr = FakeHyprland(root, os.getuid(), 'sig')
+        self.addCleanup(hypr.close)
+        [instance] = drawn_helper.instances(root)
+        # No hyprland.lock, so no Wayland display to capture.
+        self.assertTrue(drawn_helper.instance_painted(instance))
+
+
+class FakeHyprland:
+    """A Hyprland instance: request socket answering j/layers and j/monitors,
+    and an event socket that can announce layer changes."""
+
+    def __init__(self, root, uid, signature):
+        self.dir = Path(root) / str(uid) / 'hypr' / signature
+        self.dir.mkdir(parents=True)
+        self.layers = STARTING
+        self.requests = 0
+        self.events = []
+        self.stop = threading.Event()
+        self.servers = []
+        for name, handler in [('.socket.sock', self.answer), ('.socket2.sock', self.stream)]:
+            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+            server.bind(str(self.dir / name))
+            server.listen(8)
+            server.settimeout(0.05)
+            self.servers.append(server)
+            threading.Thread(target=self.serve, args=(server, handler), daemon=True).start()
+
+    def serve(self, server, handler):
+        while not self.stop.is_set():
+            try:
+                conn, _ = server.accept()
+            except (TimeoutError, OSError):
+                continue
+            threading.Thread(target=handler, args=(conn,), daemon=True).start()
+
+    def answer(self, conn):
+        with conn:
+            command = conn.recv(64).decode()
+            self.requests += 1
+            reply = {'j/layers': self.layers, 'j/monitors': MONITORS}.get(command, 'unknown request')
+            conn.sendall(json.dumps(reply).encode())
+
+    def stream(self, conn):
+        # Like Hyprland, a listener only hears events after it connects.
+        with conn:
+            sent = len(self.events)
+            try:
+                while not self.stop.is_set():
+                    while sent < len(self.events):
+                        conn.sendall(self.events[sent] + b'\n')
+                        sent += 1
+                    time.sleep(0.01)
+            except OSError:
+                pass
+
+    def close(self):
+        self.stop.set()
+        for server in self.servers:
+            server.close()
+
+
+class WatchTests(unittest.TestCase):
+    def setUp(self):
+        self.root = tempfile.mkdtemp(dir='/tmp')
+        self.addCleanup(subprocess.run, ['rm', '-rf', self.root])
+
+    def test_ipc_against_a_fake_compositor(self):
+        hypr = FakeHyprland(self.root, os.getuid(), 'sig')
+        self.addCleanup(hypr.close)
+        [instance] = drawn_helper.instances(self.root)
+        self.assertFalse(drawn_helper.instance_drawn(instance))
+        hypr.layers = REVEALED
+        self.assertTrue(drawn_helper.instance_drawn(instance))
+        # Another user's socket is not trusted.
+        other = Path(self.root) / str(os.getuid() + 1) / 'hypr' / 'x'
+        other.mkdir(parents=True)
+        (other / '.socket.sock').touch()
+        self.assertEqual(drawn_helper.instances(self.root), [instance])
+
+    def test_a_layer_event_wakes_the_wait(self):
+        hypr = FakeHyprland(self.root, os.getuid(), 'sig')
+        self.addCleanup(hypr.close)
+        [instance] = drawn_helper.instances(self.root)
+        conn = drawn_helper.open_events(instance)
+        self.addCleanup(conn.close)
+        started = time.monotonic()
+        threading.Timer(0.2, lambda: hypr.events.append(b'activelayout>>kbd,us')).start()
+        threading.Timer(0.4, lambda: hypr.events.append(b'closelayer>>omarchy-background')).start()
+        drawn_helper.wait_for_layers(conn, 5)
+        self.assertLess(time.monotonic() - started, 3)
+        # Without an event socket the wait is a plain timeout.
+        started = time.monotonic()
+        drawn_helper.wait_for_layers(None, 0.1)
+        self.assertGreaterEqual(time.monotonic() - started, 0.1)
+
+    def test_reports_once_per_session_after_the_cover_lifts(self):
+        hypr = FakeHyprland(self.root, os.getuid(), 'first')
+        self.addCleanup(hypr.close)
+        reports = []
+        done = threading.Event()
+
+        def run():
+            drawn_helper.watch(lambda: reports.append(time.monotonic()), self.root, settle=0.05, poll=0.1, rounds=40,
+                               is_painted=lambda i: True)
+            done.set()
+
+        threading.Thread(target=run, daemon=True).start()
+        for state in [COVERED, COVERED_BAR, COVERED_ALL]:
+            hypr.layers = state
+            hypr.events.append(b'openlayer>>omarchy-background')
+            time.sleep(0.3)
+            self.assertEqual(reports, [])
+        lifted = time.monotonic()
+        hypr.layers = REVEALED
+        hypr.events.append(b'closelayer>>omarchy-background')
+        time.sleep(0.5)
+        self.assertEqual(len(reports), 1)
+        # The settle is part of the report's delay, and the event avoids the poll.
+        self.assertGreaterEqual(reports[0] - lifted, 0.05)
+        self.assertLess(reports[0] - lifted, 0.4)
+        # Still drawn: no second report for the same session.
+        time.sleep(0.5)
+        self.assertEqual(len(reports), 1)
+        # Log out and back in: a new instance reports again.
+        hypr.close()
+        subprocess.run(['rm', '-rf', str(hypr.dir)], check=True)
+        again = FakeHyprland(self.root, os.getuid(), 'second')
+        self.addCleanup(again.close)
+        again.layers = REVEALED
+        done.wait(10)
+        self.assertEqual(len(reports), 2)
+
+    def test_a_flash_of_the_desktop_needs_to_last_the_settle(self):
+        instance = Path(self.root) / str(os.getuid()) / 'hypr' / 'x'
+        instance.mkdir(parents=True)
+        (instance / '.socket.sock').touch()
+        states = iter([True, False, False])
+        reports = []
+        drawn_helper.watch(lambda: reports.append(1), self.root, settle=0, poll=0,
+                           is_drawn=lambda i: next(states, False), events=lambda i: None,
+                           wait=lambda c, t: None, rounds=3)
+        self.assertEqual(reports, [])
+
+    def watch_one(self, painted, paint_wait, rounds):
+        instance = Path(self.root) / str(os.getuid()) / 'hypr' / 'x'
+        instance.mkdir(parents=True, exist_ok=True)
+        (instance / '.socket.sock').touch()
+        now = [0.0]
+        reports, waits = [], []
+
+        def wait(conn, timeout):
+            waits.append(timeout)
+            now[0] += timeout
+
+        drawn_helper.watch(lambda: reports.append(now[0]), self.root, settle=0, poll=0.01,
+                           is_drawn=lambda i: True, events=lambda i: None, wait=wait,
+                           is_painted=lambda i: painted(now[0]), paint_wait=paint_wait, paint_poll=0.5,
+                           clock=lambda: now[0], rounds=rounds)
+        return reports, waits
+
+    def test_waits_for_the_wallpaper_after_the_layers(self):
+        reports, waits = self.watch_one(lambda now: now >= 2, paint_wait=8, rounds=20)
+        self.assertEqual(reports, [2.0])
+        self.assertEqual(set(waits[:4]), {0.5})
+
+    def test_a_wallpaper_that_looks_empty_still_reports(self):
+        reports, _ = self.watch_one(lambda now: False, paint_wait=8, rounds=40)
+        self.assertEqual(reports, [8.0])
+
+    def test_command_line_writes_one_line_under_the_lock(self):
+        hypr = FakeHyprland(self.root, os.getuid(), 'sig')
+        self.addCleanup(hypr.close)
+        hypr.layers = REVEALED
+        read_end, write_end = os.pipe()
+        lock = Path(self.root) / 'lock'
+        proc = subprocess.Popen([str(HELPER), '--fd', str(write_end), '--lock', str(lock),
+                                 '--runtime-root', self.root], pass_fds=(write_end,))
+        os.close(write_end)
+        try:
+            with os.fdopen(read_end, 'rb') as out:
+                self.assertEqual(out.read(len(b'desktop drawn\n')), b'desktop drawn\n')
+            self.assertTrue(lock.exists())
+            # The session stays reported; the helper keeps waiting for the next.
+            time.sleep(0.3)
+            self.assertIsNone(proc.poll())
+        finally:
+            proc.kill()
+            proc.wait(timeout=5)
+
+
+class AgentTests(unittest.TestCase):
+    def test_agent_runs_the_probe_per_connection(self):
+        agent = AGENT.read_text()
+        self.assertIn('desktop_probe=${TRY_OMARCHY_DESKTOP_PROBE:-/usr/local/lib/try-omarchy/desktop-drawn}', agent)
+        self.assertIn('"$desktop_probe" --fd 3 --lock "$write_lock" &', agent)
+        self.assertIn('kill "$health_pid" "$desktop_pid"', agent)
+        self.assertTrue(HELPER.stat().st_mode & 0o111)
+
+    def test_existing_disks_receive_the_probe(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        self.assertIn('compat_revision=72', finalizer)
+        paths = finalizer.split('compat_paths=(', 1)[1].split(')', 1)[0].split()
+        for name in ['agent', 'desktop-drawn']:
+            self.assertIn('usr/local/lib/try-omarchy/' + name, paths)
+
+
+if __name__ == '__main__':
+    unittest.main()
