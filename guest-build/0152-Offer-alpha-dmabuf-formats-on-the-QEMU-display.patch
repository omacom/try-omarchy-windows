         self.assertEqual((self.state / "catch-up-revision").read_text(), "62\n")
         self.assertEqual(monitors.read_text(), "-- user cursor config\n")
 
+    def test_revision_64_offers_alpha_dmabuf_formats_and_preserves_user_config(self) -> None:
+        monitors = self.user / ".config/hypr/monitors.lua"
+        monitors.write_text(self.default.read_text() + self.old_fragment)
+        self.state.mkdir()
+        (self.state / "catch-up-revision").write_text("63\n")
+        self.version.write_text("64:7.2.3-arch1\n")
+        self.assertEqual(self.run_catch_up().returncode, 0)
+        self.assertIn("skip_non_kms_dmabuf_formats = false", monitors.read_text())
+        self.assertEqual((self.state / "catch-up-revision").read_text(), "64\n")
+        custom = "hl.monitor({ output = \"DP-1\", scale = 2 })\n" + self.old_fragment
+        monitors.write_text(custom)
+        (self.state / "catch-up-revision").write_text("63\n")
+        self.assertEqual(self.run_catch_up().returncode, 0)
+        self.assertEqual(monitors.read_text(), custom)
+
     def test_quick_start_disk_gets_key_only_ssh_once(self) -> None:
         dropin = self.root / "sshd_config.d/90-try-omarchy-quick-start.conf"
         self.state.mkdir(parents=True)
