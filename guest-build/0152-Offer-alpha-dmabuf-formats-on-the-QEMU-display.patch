diff --git a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
index 329129e..2ad8475 100644
--- a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
+++ b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
@@ -92,6 +92,11 @@ end
 if omarchy_kernel_option_enabled("omarchy.qemu=1") then
   -- Virgl cursor GPU buffers arrive inverted; use a small CPU cursor buffer.
   hl.config({ cursor = { invisible = false, use_cpu_buffer = 1 } })
+  -- Virtio GPU scans out only XRGB8888. Hyprland 0.57 offers clients only
+  -- scanout formats by default, so Mesa drops alpha and transparent layers
+  -- such as notifications cover the desktop in black. Offer every format the
+  -- renderer can import, as Hyprland 0.56 did.
+  hl.config({ quirks = { skip_non_kms_dmabuf_formats = false } })
   local synced_mode, synced_scale = omarchy_synced_display_mode()
   if synced_mode then
     -- A number the user set in this file is explicit intent and outranks
