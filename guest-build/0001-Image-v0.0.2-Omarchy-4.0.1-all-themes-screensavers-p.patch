@@ -0,0 +1,15 @@
+# Auto-mount the host folder the launcher attaches with -Share (virtio-9p,
+# mount tag "hostshare"). The condition keeps boots without -Share clean: no
+# 9p device, no mount attempt, no failed unit.
+[Unit]
+Description=Host shared folder (Try Omarchy -Share)
+ConditionPathExistsGlob=/sys/bus/virtio/devices/*/mount_tag
+
+[Mount]
+What=hostshare
+Where=/mnt/host
+Type=9p
+Options=trans=virtio
+
+[Install]
+WantedBy=multi-user.target
