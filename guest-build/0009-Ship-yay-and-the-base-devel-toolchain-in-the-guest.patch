       "reportedVersion": "2026.8.11 linux-x64 (2026-08-23)",
       "license": "MIT"
+    },
+    "yay": {
+      "version": "13.0.1",
+      "repository": "https://github.com/Jguer/yay",
+      "commit": "02fb6ba948720d2d7eae6e5989168a297710a3e4",
+      "license": "GPL-3.0-or-later"
     }
   },
   "themes": [
