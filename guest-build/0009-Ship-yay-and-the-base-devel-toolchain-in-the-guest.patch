diff --git a/guest/scripts/register-pinned-yay.sh b/guest/scripts/register-pinned-yay.sh
new file mode 100755
index 0000000..8f64414
--- /dev/null
+++ b/guest/scripts/register-pinned-yay.sh
@@ -0,0 +1,206 @@
+#!/bin/bash
+
+set -euo pipefail
+
+usage() {
+  cat <<'USAGE'
+Usage: register-pinned-yay.sh --root ROOT --work WORK --spec SPEC --pacman-config CONFIG
+
+Fetches the spec-pinned yay source at an exact commit, builds it with the
+container's Go toolchain under the module cache's go.sum verification, verifies
+the reported version, and installs it as a local Arch package staged in the
+guest's immutable local repository.
+USAGE
+}
+
+fail() {
+  echo "register-pinned-yay: $*" >&2
+  exit 1
+}
+
+root=""
+work=""
+spec=""
+pacman_config=""
+
+while (($#)); do
+  case "$1" in
+    --root)
+      root=${2:-}
+      shift 2
+      ;;
+    --work)
+      work=${2:-}
+      shift 2
+      ;;
+    --spec)
+      spec=${2:-}
+      shift 2
+      ;;
+    --pacman-config)
+      pacman_config=${2:-}
+      shift 2
+      ;;
+    -h|--help)
+      usage
+      exit 0
+      ;;
+    *)
+      fail "unknown option: $1"
+      ;;
+  esac
+done
+
+[[ $root == /* && -d $root ]] || fail "--root must be an absolute staged root"
+case "$root" in
+  /|/bin|/boot|/etc|/home|/opt|/root|/usr|/var)
+    fail "refusing unsafe root: $root"
+    ;;
+esac
+[[ $work == /* && -d $work ]] || fail "--work must be an absolute directory"
+[[ -f $spec ]] || fail "spec not found: $spec"
+[[ -f $pacman_config ]] || fail "pacman config not found: $pacman_config"
+for command in git go install msgfmt pacman python3 tar zstd; do
+  command -v "$command" >/dev/null || fail "$command is required"
+done
+
+mapfile -t metadata < <(python3 - "$spec" <<'PY'
+import json
+import pathlib
+import sys
+
+spec = json.loads(pathlib.Path(sys.argv[1]).read_text())
+component = spec.get("supplyChain", {}).get("yay")
+if component is None:
+    print("disabled")
+    raise SystemExit
+print("enabled")
+for key in ("version", "repository", "commit", "license"):
+    print(component[key])
+print(spec["image"]["architecture"])
+print(spec["image"]["sourceDateEpoch"])
+PY
+) || fail "could not read pinned yay metadata"
+[[ ${metadata[0]:-} == disabled ]] && exit 0
+[[ ${metadata[0]:-} == enabled ]] || fail "invalid pinned yay state"
+(( ${#metadata[@]} == 7 )) || fail "pinned yay metadata is incomplete"
+version=${metadata[1]}
+repository=${metadata[2]}
+commit=${metadata[3]}
+license=${metadata[4]}
+architecture=${metadata[5]}
+source_date_epoch=${metadata[6]}
+
+[[ $architecture == x86_64 ]] || fail "pinned yay component supports only x86_64"
+[[ $version =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "invalid yay version: $version"
+[[ $repository == https://github.com/Jguer/yay ]] || fail "unexpected yay repository: $repository"
+[[ $commit =~ ^[0-9a-f]{40}$ ]] || fail "invalid yay commit: $commit"
+[[ $license == GPL-3.0-or-later ]] || fail "unexpected yay license: $license"
+[[ $source_date_epoch =~ ^[0-9]+$ ]] || fail "invalid source date epoch"
+
+source_dir="$work/yay-source"
+if [[ -d $source_dir/.git ]]; then
+  actual_commit=$(git -C "$source_dir" rev-parse HEAD || true)
+  [[ $actual_commit == "$commit" ]] || rm -rf "$source_dir"
+fi
+if [[ ! -d $source_dir/.git ]]; then
+  git init --quiet "$source_dir"
+  git -C "$source_dir" remote add origin "$repository"
+  git -C "$source_dir" fetch --quiet --depth=1 origin "$commit"
+fi
+git -C "$source_dir" checkout --quiet --detach FETCH_HEAD
+actual_commit=$(git -C "$source_dir" rev-parse HEAD)
+[[ $actual_commit == "$commit" ]] || fail "yay checkout does not match the pinned commit"
+
+build_dir="$work/yay-build"
+install -d -m 0755 "$build_dir"
+export CGO_ENABLED=0
+export GOPATH="$build_dir/gopath"
+export GOCACHE="$build_dir/gocache"
+(
+  cd "$source_dir"
+  go build \
+    -trimpath \
+    -mod=readonly \
+    -modcacherw \
+    -buildvcs=false \
+    -buildmode=pie \
+    -ldflags "-X main.yayVersion=$version -X main.localePath=/usr/share/locale/" \
+    -o "$build_dir/yay" \
+    .
+)
+
+"$build_dir/yay" --version | grep -q "^yay v$version " ||
+  fail "yay reported an unexpected identity: $("$build_dir/yay" --version | tail -n 1)"
+
+stage=$(mktemp -d "$work/yay-package.XXXXXX")
+cleanup() {
+  rm -rf "$stage"
+}
+trap cleanup EXIT
+
+install -d -m 0755 "$stage/usr/bin"
+install -d -m 0755 "$stage/usr/share/licenses/yay"
+install -m 0755 "$build_dir/yay" "$stage/usr/bin/yay"
+install -m 0644 "$source_dir/LICENSE" "$stage/usr/share/licenses/yay/LICENSE"
+install -D -m 0644 "$source_dir/doc/yay.8" "$stage/usr/share/man/man8/yay.8"
+install -D -m 0644 "$source_dir/completions/bash" "$stage/usr/share/bash-completion/completions/yay"
+install -D -m 0644 "$source_dir/completions/zsh" "$stage/usr/share/zsh/site-functions/_yay"
+install -D -m 0644 "$source_dir/completions/fish" "$stage/usr/share/fish/vendor_completions.d/yay.fish"
+shopt -s nullglob
+for po in "$source_dir"/po/*.po; do
+  lang=$(basename "$po" .po)
+  install -d -m 0755 "$stage/usr/share/locale/$lang/LC_MESSAGES"
+  msgfmt "$po" --output-file "$stage/usr/share/locale/$lang/LC_MESSAGES/yay.mo"
+done
+shopt -u nullglob
+
+installed_size=$(du -sb "$stage/usr" | awk '{print $1}')
+cat >"$stage/.PKGINFO" <<EOF
+pkgname = yay
+pkgbase = yay
+pkgver = $version-1
+pkgdesc = AUR helper built from the pinned Jguer/yay commit for the Omarchy x86_64 guest
+url = $repository
+builddate = $source_date_epoch
+packager = Try Omarchy reproducible guest builder
+size = $installed_size
+arch = x86_64
+license = $license
+depend = pacman
+depend = git
+EOF
+
+package_archive="$stage/yay-$version-1-x86_64.pkg.tar.zst"
+tar \
+  --sort=name \
+  --mtime="@$source_date_epoch" \
+  --owner=0 \
+  --group=0 \
+  --numeric-owner \
+  --format=gnu \
+  -C "$stage" \
+  -cf - .PKGINFO usr |
+  zstd --force --quiet -12 --threads=1 -o "$package_archive"
+
+pacman \
+  --noconfirm \
+  --config "$pacman_config" \
+  --root "$root" \
+  --dbpath "$root/var/lib/pacman" \
+  --logfile "$root/var/log/pacman.log" \
+  -U "$package_archive"
+
+query=$(pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -Q yay)
+[[ $query == "yay $version-1" ]] || fail "installed yay query returned: $query"
+pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -Qkk yay >/dev/null ||
+  fail "installed yay package failed its ownership check"
+pacman --config "$pacman_config" --root "$root" --dbpath "$root/var/lib/pacman" -T git >/dev/null ||
+  fail "installed yay package does not satisfy the git dependency"
+reported=$(arch-chroot "$root" /usr/bin/yay --version | grep "^yay v$version " || true)
+[[ -n $reported ]] || fail "installed yay reported an unexpected identity"
+
+repo_dir="$root/usr/share/try-omarchy/repo"
+install -d -m 0755 "$repo_dir"
+install -m 0644 "$package_archive" "$repo_dir/$(basename "$package_archive")"
+echo "Registered $query from pinned source $commit"
