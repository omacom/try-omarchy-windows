 guest/build.sh                             |   5 +
 guest/packages.txt                         |   1 +
 guest/scripts/register-local-repository.sh |   3 +-
 guest/scripts/register-pinned-yay.sh       | 206 +++++++++++++++++++++
 guest/spec.json                            |   6 +
 6 files changed, 221 insertions(+), 2 deletions(-)
 create mode 100755 guest/scripts/register-pinned-yay.sh

