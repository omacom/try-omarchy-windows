diff --git a/guest/tests/test_windows_hello_broker.py b/guest/tests/test_windows_hello_broker.py
new file mode 100644
index 0000000..d52967f
--- /dev/null
+++ b/guest/tests/test_windows_hello_broker.py
@@ -0,0 +1,169 @@
+"""Security checks for the guest side of Windows Hello sudo."""
+
+from __future__ import annotations
+
+import base64
+import hashlib
+import importlib.machinery
+import json
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+
+BROKER_PATH = Path(__file__).resolve().parents[1] / "factory-overlay/usr/local/lib/try-omarchy/windows-hello-broker"
+broker = importlib.machinery.SourceFileLoader("windows_hello_broker", str(BROKER_PATH)).load_module()
+GUEST = "a" * 64
+CREDENTIAL = bytes(range(32))
+
+
+def cbor(value: object) -> bytes:
+    def head(major: int, argument: int) -> bytes:
+        if argument < 24:
+            return bytes([major << 5 | argument])
+        return bytes([major << 5 | 24, argument]) if argument < 256 else bytes([major << 5 | 25]) + argument.to_bytes(2, "big")
+
+    if isinstance(value, int):
+        return head(0, value) if value >= 0 else head(1, -1 - value)
+    if isinstance(value, bytes):
+        return head(2, len(value)) + value
+    if isinstance(value, dict):
+        return head(5, len(value)) + b"".join(cbor(k) + cbor(v) for k, v in value.items())
+    raise TypeError(value)
+
+
+def auth_data(flags: int, count: int = 0, attested: bytes = b"", rp_id: str = broker.RP_ID) -> bytes:
+    return hashlib.sha256(rp_id.encode()).digest() + bytes([flags]) + count.to_bytes(4, "big") + attested
+
+
+def b64(data: bytes) -> str:
+    return base64.b64encode(data).decode("ascii")
+
+
+class HelloBrokerTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls) -> None:
+        cls.directory = tempfile.TemporaryDirectory()
+        cls.private = Path(cls.directory.name) / "key.pem"
+        subprocess.run(["openssl", "ecparam", "-name", "prime256v1", "-genkey", "-noout", "-out", str(cls.private)], check=True)
+        der = subprocess.run(["openssl", "pkey", "-in", str(cls.private), "-pubout", "-outform", "DER"], capture_output=True, check=True).stdout
+        cls.public = der
+        cls.x, cls.y = der[-64:-32], der[-32:]
+
+    @classmethod
+    def tearDownClass(cls) -> None:
+        cls.directory.cleanup()
+
+    def sign(self, data: bytes) -> bytes:
+        return subprocess.run(["openssl", "dgst", "-sha256", "-sign", str(self.private)], input=data, capture_output=True, check=True).stdout
+
+    def enrollment(self) -> tuple[dict[str, object], dict[str, object]]:
+        request = broker.make_request("enroll", GUEST)
+        key = cbor({1: 2, 3: -7, -1: 1, -2: self.x, -3: self.y})
+        attested = bytes(16) + len(CREDENTIAL).to_bytes(2, "big") + CREDENTIAL + key
+        response = {**request, "type": "authorization-result", "approved": True,
+                    "authenticatorData": b64(auth_data(0x45, 0, attested)), "signature": ""}
+        return request, response
+
+    def sudo(self, flags: int = 0x05) -> tuple[dict[str, object], dict[str, object]]:
+        request = broker.make_request("sudo", GUEST, credential_id=b64(CREDENTIAL), user="root", requesting_user="omarchy", tty="/dev/pts/3")
+        data = auth_data(flags, 7)
+        signature = self.sign(data + hashlib.sha256(broker.client_data(request)).digest())
+        response = {**request, "type": "authorization-result", "approved": True,
+                    "authenticatorData": b64(data), "signature": b64(signature)}
+        return request, response
+
+    def round_trip(self, request: dict[str, object], response: dict[str, object]) -> dict[str, object]:
+        return broker.parse_response(json.dumps(response).encode("ascii"), request)
+
+    def test_client_data_matches_the_launcher(self) -> None:
+        request = broker.make_request("sudo", GUEST, credential_id=b64(CREDENTIAL), user="root", requesting_user="omarchy", tty="/dev/pts/3")
+        expected = (
+            '{"type":"try-omarchy.windows-hello.sudo","version":2,"operation":"sudo","guestId":"' + GUEST
+            + '","requestId":"' + request["requestId"] + '","challenge":"' + request["challenge"]
+            + '","user":"root","requestingUser":"omarchy","service":"sudo","tty":"/dev/pts/3","credentialId":"'
+            + b64(CREDENTIAL) + '"}'
+        )
+        self.assertEqual(broker.client_data(request), expected.encode("ascii"))
+
+    def test_enrollment_pins_the_credential_key(self) -> None:
+        request, response = self.enrollment()
+        credential, key = broker.enrolled_credential(self.round_trip(request, response))
+        self.assertEqual(credential, CREDENTIAL)
+        self.assertEqual(key, self.public)
+        for flags in (0x41, 0x05):
+            changed = dict(response, authenticatorData=b64(auth_data(flags, 0, base64.b64decode(response["authenticatorData"])[37:])))
+            with self.subTest(flags=flags), self.assertRaises(broker.ApprovalError):
+                broker.enrolled_credential(self.round_trip(request, changed))
+        with self.assertRaises(broker.ApprovalError):
+            self.round_trip(request, dict(response, signature=b64(b"x" * 70)))
+
+    def test_signed_sudo_request_and_context_binding(self) -> None:
+        request, response = self.sudo()
+        broker.verify_approval(request, self.round_trip(request, response), self.public)
+
+        for field, value in (
+            ("requestId", "c1d0243d-705e-4b64-a5c3-458d4e2b1f9d"),
+            ("challenge", "b" * 64),
+            ("user", "omarchy"),
+            ("requestingUser", "root"),
+            ("tty", "/dev/pts/4"),
+            ("credentialId", b64(bytes(32))),
+        ):
+            changed = dict(response, **{field: value})
+            with self.subTest(field=field), self.assertRaises(broker.ApprovalError):
+                self.round_trip(request, changed)
+
+        other_request = dict(request, challenge="c" * 64)
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(other_request, self.round_trip(other_request, dict(response, challenge="c" * 64)), self.public)
+        other_key = subprocess.run(
+            "openssl ecparam -name prime256v1 -genkey -noout | openssl pkey -pubout -outform DER",
+            shell=True, capture_output=True, check=True,
+        ).stdout
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(request, self.round_trip(request, response), other_key)
+
+    def test_unverified_or_foreign_assertions_fail(self) -> None:
+        request, response = self.sudo(flags=0x01)
+        with self.assertRaisesRegex(broker.ApprovalError, "verify the user"):
+            broker.verify_approval(request, self.round_trip(request, response), self.public)
+        request, response = self.sudo()
+        data = auth_data(0x05, 7, rp_id="example.com")
+        signature = self.sign(data + hashlib.sha256(broker.client_data(request)).digest())
+        foreign = dict(response, authenticatorData=b64(data), signature=b64(signature))
+        with self.assertRaisesRegex(broker.ApprovalError, "relying party"):
+            broker.verify_approval(request, self.round_trip(request, foreign), self.public)
+
+    def test_denial_and_duplicate_fields_cannot_authorize(self) -> None:
+        request, response = self.sudo()
+        denial = dict(response, approved=False, authenticatorData="", signature="")
+        parsed = self.round_trip(request, denial)
+        with self.assertRaises(broker.ApprovalError):
+            broker.verify_approval(request, parsed, self.public)
+        denial["signature"] = response["signature"]
+        with self.assertRaises(broker.ApprovalError):
+            self.round_trip(request, denial)
+        duplicate = json.dumps(response).replace('"approved": true', '"approved": true, "approved": true')
+        with self.assertRaises(broker.ApprovalError):
+            broker.parse_response(duplicate.encode("ascii"), request)
+        with self.assertRaises(broker.ApprovalError):
+            self.round_trip(request, dict(response, version=1))
+
+    def test_invalid_pam_scope_never_makes_request(self) -> None:
+        for context in (
+            {"user": "root", "requesting_user": "omarchy", "tty": "/dev/ttyUSB0"},
+            {"user": "root", "requesting_user": "omarchy;id", "tty": "/dev/pts/3"},
+            {"user": "root", "requesting_user": "omarchy", "tty": ""},
+        ):
+            with self.subTest(context=context), self.assertRaises(broker.ApprovalError):
+                broker.make_request("sudo", GUEST, credential_id=b64(CREDENTIAL), **context)
+        with self.assertRaises(broker.ApprovalError):
+            broker.make_request("sudo", GUEST, credential_id="", user="root", requesting_user="omarchy", tty="/dev/pts/3")
+        with self.assertRaises(broker.ApprovalError):
+            broker.make_request("enroll", GUEST, credential_id=b64(CREDENTIAL))
+
+
+if __name__ == "__main__":
+    unittest.main()
