+#!/usr/bin/python3 -I
+"""Root-only Windows Hello approval broker for interactive guest sudo."""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import secrets
+import select
+import stat
+import subprocess
+import sys
+import tempfile
+import time
+import uuid
+
+
+PORT = Path("/dev/virtio-ports/dev.tryomarchy.authentication")
+STATE = Path("/var/lib/try-omarchy/windows-hello/enrollment.json")
+MAX_LINE = 4096
+VERSION = 2
+# Windows Hello answers as a WebAuthn platform authenticator. These must match
+# helloRelyingPartyID and helloClientDataType in the Windows launcher.
+RP_ID = "try-omarchy.invalid"
+CLIENT_TYPE = "try-omarchy.windows-hello.sudo"
+FLAG_USER_PRESENT = 0x01
+FLAG_USER_VERIFIED = 0x04
+FLAG_ATTESTED = 0x40
+P256_SPKI_PREFIX = bytes.fromhex("3059301306072a8648ce3d020106082a8648ce3d030107034200")
+HEX32 = re.compile(r"[0-9a-f]{64}\Z")
+ACCOUNT = re.compile(r"[a-z_][a-z0-9_-]{0,31}\Z")
+TTY = re.compile(r"/dev/(?:pts/[0-9]+|tty[0-9]+)\Z")
+VPORT_TARGET = re.compile(r"\.\./(vport[0-9]+p[0-9]+)\Z")
+REQUEST_ORDER = (
+    "type", "version", "operation", "guestId", "requestId", "challenge",
+    "user", "requestingUser", "service", "tty", "credentialId",
+)
+REQUEST_FIELDS = set(REQUEST_ORDER)
+RESPONSE_FIELDS = REQUEST_FIELDS | {"approved", "authenticatorData", "signature"}
+STATE_FIELDS = {"version", "guestId", "credentialId", "publicKey", "keyId"}
+
+
+class ApprovalError(Exception):
+    pass
+
+
+def unique_object(pairs: list[tuple[str, object]]) -> dict[str, object]:
+    result: dict[str, object] = {}
+    for key, value in pairs:
+        if key in result:
+            raise ApprovalError("duplicate authentication field")
+        result[key] = value
+    return result
+
+
+def decode_json(data: bytes) -> dict[str, object]:
+    if len(data) > MAX_LINE:
+        raise ApprovalError("authentication data exceeds 4 KiB")
+    try:
+        value = json.loads(data, object_pairs_hook=unique_object)
+    except (UnicodeDecodeError, json.JSONDecodeError) as error:
+        raise ApprovalError("invalid authentication JSON") from error
+    if not isinstance(value, dict):
+        raise ApprovalError("authentication data is not an object")
+    return value
+
+
+def decode_b64(value: object, label: str) -> bytes:
+    if not isinstance(value, str):
+        raise ApprovalError(f"invalid {label}")
+    try:
+        return base64.b64decode(value, validate=True)
+    except (ValueError, binascii.Error) as error:
+        raise ApprovalError(f"invalid {label}") from error
+
+
+def valid_credential_id(value: object) -> bytes:
+    credential = decode_b64(value, "credential ID")
+    if not 16 <= len(credential) <= 255 or base64.b64encode(credential).decode("ascii") != value:
+        raise ApprovalError("invalid credential ID")
+    return credential
+
+
+def make_request(operation: str, guest_id: str, *, credential_id: str = "", user: str = "", requesting_user: str = "", tty: str = "") -> dict[str, object]:
+    if not HEX32.fullmatch(guest_id) or operation not in {"enroll", "disable", "sudo"}:
+        raise ApprovalError("invalid guest or operation")
+    if operation == "sudo":
+        if not ACCOUNT.fullmatch(user) or not ACCOUNT.fullmatch(requesting_user) or not TTY.fullmatch(tty):
+            raise ApprovalError("invalid sudo context")
+    elif user or requesting_user or tty:
+        raise ApprovalError("control request contains sudo context")
+    if operation == "enroll":
+        if credential_id:
+            raise ApprovalError("enrollment names an existing credential")
+    else:
+        valid_credential_id(credential_id)
+    return {
+        "type": "authorize", "version": VERSION, "operation": operation,
+        "guestId": guest_id, "requestId": str(uuid.uuid4()),
+        "challenge": secrets.token_hex(32), "user": user,
+        "requestingUser": requesting_user, "service": "sudo", "tty": tty,
+        "credentialId": credential_id,
+    }
+
+
+def client_data(request: dict[str, object]) -> bytes:
+    """The exact bytes Windows signs; the launcher builds the same string."""
+    ordered = {key: request[key] for key in REQUEST_ORDER}
+    ordered["type"] = CLIENT_TYPE
+    return json.dumps(ordered, separators=(",", ":"), ensure_ascii=True).encode("ascii")
+
+
+def parse_response(line: bytes, request: dict[str, object]) -> dict[str, object]:
+    result = decode_json(line)
+    if set(result) != RESPONSE_FIELDS or result.get("type") != "authorization-result" or result.get("version") != VERSION or type(result.get("approved")) is not bool:
+        raise ApprovalError("invalid authentication response schema")
+    if result["requestId"] != request["requestId"]:
+        raise ApprovalError("authentication response belongs to another request")
+    for field in ("operation", "guestId", "requestId", "challenge", "user", "requestingUser", "service", "tty", "credentialId"):
+        if result[field] != request[field]:
+            raise ApprovalError("authentication response context changed")
+    material = (result["authenticatorData"], result["signature"])
+    if not all(isinstance(value, str) for value in material):
+        raise ApprovalError("invalid approval fields")
+    if not result["approved"] or request["operation"] == "disable":
+        if any(material):
+            raise ApprovalError("unsigned response contains approval material")
+        return result
+    auth_data = decode_b64(result["authenticatorData"], "authenticator data")
+    if not 37 <= len(auth_data) <= 1024:
+        raise ApprovalError("invalid authenticator data length")
+    if request["operation"] == "enroll":
+        if result["signature"]:
+            raise ApprovalError("enrollment response contains a signature")
+    elif not 8 <= len(decode_b64(result["signature"], "signature")) <= 80:
+        raise ApprovalError("invalid signature length")
+    return result
+
+
+def cbor_item(data: bytes, offset: int, depth: int = 0) -> tuple[object, int]:
+    """Decode one CBOR item: enough for a COSE EC2 public key."""
+    if depth > 4 or offset >= len(data):
+        raise ApprovalError("invalid credential key")
+    major, info = data[offset] >> 5, data[offset] & 0x1F
+    offset += 1
+    if info < 24:
+        argument = info
+    elif info in (24, 25, 26, 27):
+        size = 1 << (info - 24)
+        if offset + size > len(data):
+            raise ApprovalError("invalid credential key")
+        argument = int.from_bytes(data[offset:offset + size], "big")
+        offset += size
+    else:
+        raise ApprovalError("invalid credential key")
+    if major == 0:
+        return argument, offset
+    if major == 1:
+        return -1 - argument, offset
+    if major in (2, 3):
+        if argument > len(data) - offset:
+            raise ApprovalError("invalid credential key")
+        value = data[offset:offset + argument]
+        return (value if major == 2 else value.decode("utf-8", "strict")), offset + argument
+    if major == 5 and argument <= 16:
+        result: dict[object, object] = {}
+        for _ in range(argument):
+            key, offset = cbor_item(data, offset, depth + 1)
+            value, offset = cbor_item(data, offset, depth + 1)
+            if key in result:
+                raise ApprovalError("invalid credential key")
+            result[key] = value
+        return result, offset
+    raise ApprovalError("invalid credential key")
+
+
+def check_authenticator_data(auth_data: bytes) -> int:
+    if auth_data[:32] != hashlib.sha256(RP_ID.encode("ascii")).digest():
+        raise ApprovalError("Windows Hello answered for another relying party")
+    flags = auth_data[32]
+    if not flags & FLAG_USER_PRESENT or not flags & FLAG_USER_VERIFIED:
+        raise ApprovalError("Windows Hello did not verify the user")
+    return flags
+
+
+def enrolled_credential(response: dict[str, object]) -> tuple[bytes, bytes]:
+    """Return the new credential ID and its P-256 key as SubjectPublicKeyInfo DER."""
+    auth_data = decode_b64(response["authenticatorData"], "authenticator data")
+    if not check_authenticator_data(auth_data) & FLAG_ATTESTED:
+        raise ApprovalError("enrollment returned no credential")
+    offset = 37 + 16
+    if offset + 2 > len(auth_data):
+        raise ApprovalError("enrollment returned no credential")
+    length = int.from_bytes(auth_data[offset:offset + 2], "big")
+    offset += 2
+    credential = auth_data[offset:offset + length]
+    if len(credential) != length or not 16 <= length <= 255:
+        raise ApprovalError("invalid enrolled credential ID")
+    key, _ = cbor_item(auth_data, offset + length)
+    if not isinstance(key, dict) or key.get(1) != 2 or key.get(3) != -7 or key.get(-1) != 1:
+        raise ApprovalError("enrolled credential is not an ES256 P-256 key")
+    x, y = key.get(-2), key.get(-3)
+    if not isinstance(x, bytes) or not isinstance(y, bytes) or len(x) != 32 or len(y) != 32:
+        raise ApprovalError("enrolled credential key is malformed")
+    return credential, P256_SPKI_PREFIX + b"\x04" + x + y
+
+
+def verify_signature(public_key: bytes, signature: bytes, signed: bytes) -> bool:
+    runtime_dir = "/run" if os.access("/run", os.W_OK) else None
+    with tempfile.TemporaryDirectory(prefix="try-omarchy-hello-", dir=runtime_dir) as directory:
+        key = Path(directory) / "key.der"
+        sig = Path(directory) / "signature.bin"
+        key.write_bytes(public_key)
+        sig.write_bytes(signature)
+        key.chmod(0o600)
+        sig.chmod(0o600)
+        arguments = ["/usr/bin/openssl", "dgst", "-sha256", "-keyform", "DER", "-verify", str(key), "-signature", str(sig)]
+        result = subprocess.run(arguments, input=signed, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5, check=False, env={"PATH": "/usr/bin"})
+        return result.returncode == 0
+
+
+def verify_approval(request: dict[str, object], response: dict[str, object], public_key: bytes) -> None:
+    if not response["approved"] or request["operation"] != "sudo":
+        raise ApprovalError("Windows Hello was not approved")
+    auth_data = decode_b64(response["authenticatorData"], "authenticator data")
+    check_authenticator_data(auth_data)
+    signed = auth_data + hashlib.sha256(client_data(request)).digest()
+    if not verify_signature(public_key, decode_b64(response["signature"], "signature"), signed):
+        raise ApprovalError("Windows Hello signature is invalid")
+
+
+def read_line(descriptor: int, deadline: float) -> bytes:
+    line = bytearray()
+    while True:
+        remaining = deadline - time.monotonic()
+        if remaining <= 0 or not select.select([descriptor], [], [], remaining)[0]:
+            raise TimeoutError("Windows Hello request timed out")
+        try:
+            byte = os.read(descriptor, 1)
+        except BlockingIOError:
+            continue
+        if not byte:
+            raise ConnectionError("Windows Hello bridge disconnected")
+        if byte == b"\n":
+            return bytes(line)
+        line.extend(byte)
+        if len(line) > MAX_LINE:
+            raise ApprovalError("Windows Hello response exceeds 4 KiB")
+
+
+def exchange(request: dict[str, object], timeout: float = 65) -> dict[str, object]:
+    target = PORT
+    info = PORT.lstat()
+    if stat.S_ISLNK(info.st_mode):
+        if info.st_uid != 0:
+            raise ApprovalError("authentication port link is not root-owned")
+        match = VPORT_TARGET.fullmatch(os.readlink(PORT))
+        if match is None:
+            raise ApprovalError("authentication port link target is invalid")
+        target = PORT.parent.parent / match.group(1)
+    descriptor = os.open(target, os.O_RDWR | os.O_CLOEXEC | os.O_NOCTTY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        info = os.fstat(descriptor)
+        if not stat.S_ISCHR(info.st_mode) or info.st_uid != 0 or info.st_gid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
+            raise ApprovalError("authentication port is not root-only")
+        try:
+            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError as error:
+            raise ApprovalError("another Hello request is in progress") from error
+        data = json.dumps(request, sort_keys=True, separators=(",", ":")).encode("ascii") + b"\n"
+        if len(data) > MAX_LINE:
+            raise ApprovalError("authentication request exceeds 4 KiB")
+        deadline = time.monotonic() + timeout
+        view = memoryview(data)
+        while view:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0 or not select.select([], [descriptor], [], remaining)[1]:
+                raise TimeoutError("Windows Hello request timed out")
+            try:
+                count = os.write(descriptor, view)
+            except BlockingIOError:
+                continue
+            if count <= 0:
+                raise ConnectionError("Windows Hello bridge stopped accepting data")
+            view = view[count:]
+        return parse_response(read_line(descriptor, deadline), request)
+    finally:
+        os.close(descriptor)
+
+
+def save_state(guest_id: str, credential: bytes, key: bytes) -> None:
+    if not HEX32.fullmatch(guest_id) or not 16 <= len(credential) <= 255 or not key.startswith(P256_SPKI_PREFIX):
+        raise ApprovalError("invalid enrollment")
+    parent = STATE.parent
+    parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    info = parent.lstat()
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0:
+        raise ApprovalError("authentication state directory is unsafe")
+    parent.chmod(0o700)
+    state = {
+        "version": VERSION, "guestId": guest_id,
+        "credentialId": base64.b64encode(credential).decode("ascii"),
+        "publicKey": base64.b64encode(key).decode("ascii"),
+        "keyId": hashlib.sha256(key).hexdigest(),
+    }
+    data = (json.dumps(state, sort_keys=True) + "\n").encode("ascii")
+    directory = os.open(parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    temporary = f".{STATE.name}.{secrets.token_hex(8)}"
+    try:
+        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
+        try:
+            view = memoryview(data)
+            while view:
+                count = os.write(descriptor, view)
+                if count <= 0:
+                    raise OSError("state write stopped")
+                view = view[count:]
+            os.fsync(descriptor)
+        finally:
+            os.close(descriptor)
+        os.replace(temporary, STATE.name, src_dir_fd=directory, dst_dir_fd=directory)
+        os.fsync(directory)
+    finally:
+        try:
+            os.unlink(temporary, dir_fd=directory)
+        except FileNotFoundError:
+            pass
+        os.close(directory)
+
+
+def load_state() -> tuple[str, str, bytes]:
+    parent = STATE.parent
+    info = parent.stat(follow_symlinks=False)
+    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
+        raise ApprovalError("authentication state directory is unsafe")
+    descriptor = os.open(STATE, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(descriptor)
+        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o600:
+            raise ApprovalError("authentication enrollment state is unsafe")
+        data = os.read(descriptor, MAX_LINE + 1)
+    finally:
+        os.close(descriptor)
+    state = decode_json(data)
+    if (set(state) != STATE_FIELDS or state.get("version") != VERSION
+            or not isinstance(state.get("guestId"), str) or not HEX32.fullmatch(state["guestId"])
+            or not isinstance(state.get("keyId"), str) or not HEX32.fullmatch(state["keyId"])):
+        raise ApprovalError("authentication enrollment state is invalid")
+    valid_credential_id(state["credentialId"])
+    key = decode_b64(state["publicKey"], "enrolled key")
+    if not key.startswith(P256_SPKI_PREFIX) or len(key) != len(P256_SPKI_PREFIX) + 65 or hashlib.sha256(key).hexdigest() != state["keyId"]:
+        raise ApprovalError("enrolled key is invalid")
+    return state["guestId"], state["credentialId"], key
+
+
+def enroll() -> None:
+    try:
+        guest_id, _, _ = load_state()
+    except FileNotFoundError:
+        guest_id = secrets.token_hex(32)
+    print("Approve the Windows Hello prompt on Windows to pair this guest.")
+    request = make_request("enroll", guest_id)
+    response = exchange(request)
+    if not response["approved"]:
+        raise ApprovalError("Windows Hello pairing was not approved")
+    credential, key = enrolled_credential(response)
+    save_state(guest_id, credential, key)
+    print("Windows Hello paired for this guest. Your guest password remains available.")
+
+
+def disable() -> None:
+    try:
+        guest_id, credential_id, _ = load_state()
+    except FileNotFoundError:
+        print("Windows Hello is already disabled for sudo.")
+        return
+    try:
+        response = exchange(make_request("disable", guest_id, credential_id=credential_id), timeout=5)
+        if not response["approved"]:
+            raise ApprovalError("Windows kept the passkey; remove it in Settings > Accounts > Passkeys")
+    except (ApprovalError, OSError, TimeoutError, ConnectionError) as error:
+        print(f"Host passkey cleanup unavailable: {error}", file=sys.stderr)
+    STATE.unlink()
+    print("Windows Hello sudo disabled in this guest.")
+
+
+def authenticate_pam() -> bool:
+    if os.getuid() != 0 or os.geteuid() != 0 or os.environ.get("PAM_TYPE") != "auth" or os.environ.get("PAM_SERVICE") != "sudo":
+        return False
+    user = os.environ.get("PAM_USER", "")
+    requester = os.environ.get("PAM_RUSER", "") or user
+    tty = os.environ.get("PAM_TTY", "")
+    try:
+        guest_id, credential_id, key = load_state()
+        request = make_request("sudo", guest_id, credential_id=credential_id, user=user, requesting_user=requester, tty=tty)
+        print("Approve with Windows Hello, or cancel to use your password.", flush=True)
+        verify_approval(request, exchange(request), key)
+        return True
+    except (ApprovalError, OSError, TimeoutError, ConnectionError, subprocess.SubprocessError):
+        print("Windows Hello unavailable. Use your guest password.")
+        return False
+
+
+def main() -> int:
+    if len(sys.argv) != 2 or sys.argv[1] not in {"enroll", "disable", "pam"}:
+        print("usage: windows-hello-broker enroll|disable|pam", file=sys.stderr)
+        return 2
+    if sys.argv[1] == "pam":
+        return 0 if authenticate_pam() else 1
+    if os.getuid() != 0 or os.geteuid() != 0:
+        print("Windows Hello pairing requires root", file=sys.stderr)
+        return 1
+    try:
+        if sys.argv[1] == "enroll":
+            enroll()
+        else:
+            disable()
+        return 0
+    except (ApprovalError, OSError, TimeoutError, ConnectionError, subprocess.SubprocessError) as error:
+        print(f"Windows Hello {sys.argv[1]} failed: {error}", file=sys.stderr)
+        return 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
