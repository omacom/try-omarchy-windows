+#!/bin/bash
+
+set -euo pipefail
+
+broker=/usr/local/lib/try-omarchy/windows-hello-broker
+policy=/etc/pam.d/sudo
+rule=$'auth\t\tsufficient\tpam_exec.so quiet seteuid stdout /usr/local/lib/try-omarchy/windows-hello-broker pam'
+
+(( EUID == 0 )) || { echo 'Run with sudo to confirm your guest password.' >&2; exit 1; }
+[[ $# == 1 && $1 =~ ^(enable|disable)$ ]] || {
+  echo 'Usage: sudo try-omarchy-windows-hello enable|disable' >&2
+  exit 2
+}
+[[ -x $broker && ! -L $broker ]] || { echo 'Windows Hello broker is missing.' >&2; exit 1; }
+[[ -f $policy && ! -L $policy && $(sed -n '1p' "$policy") == '#%PAM-1.0' ]] || {
+  echo 'Unexpected sudo PAM policy.' >&2
+  exit 1
+}
+if grep -F '/usr/local/lib/try-omarchy/windows-hello-broker' "$policy" | grep -Fvx "$rule" >/dev/null; then
+  echo 'Unexpected Windows Hello PAM rule.' >&2
+  exit 1
+fi
+
+rewrite_policy() {
+  local action=$1 temporary
+  temporary=$(mktemp /etc/pam.d/.sudo.windows-hello.XXXXXX)
+  trap 'rm -f -- "$temporary"' EXIT
+  if [[ $action == enable ]]; then
+    if grep -Fxq "$rule" "$policy"; then
+      rm -f -- "$temporary"
+      trap - EXIT
+      return
+    fi
+    awk -v line="$rule" 'NR == 1 { print; print line; next } { print }' "$policy" >"$temporary"
+  else
+    if ! grep -Fxq "$rule" "$policy"; then
+      rm -f -- "$temporary"
+      trap - EXIT
+      return
+    fi
+    awk -v line="$rule" '$0 != line { print }' "$policy" >"$temporary"
+  fi
+  chown --reference="$policy" "$temporary"
+  chmod --reference="$policy" "$temporary"
+  mv -f -- "$temporary" "$policy"
+  trap - EXIT
+}
+
+if [[ $1 == enable ]]; then
+  if grep -Fxq "$rule" "$policy"; then
+    echo 'Windows Hello is already enabled. Disable it before re-pairing.' >&2
+    exit 1
+  fi
+  "$broker" enroll
+  rewrite_policy enable
+  echo 'Windows Hello enabled for sudo. Your guest password remains available.'
+else
+  rewrite_policy disable
+  "$broker" disable
+fi
