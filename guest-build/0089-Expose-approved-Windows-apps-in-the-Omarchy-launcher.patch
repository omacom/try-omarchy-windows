 .../usr/local/lib/try-omarchy/agent           | 10 ++-
 .../local/lib/try-omarchy/approved-apps-sync  | 75 +++++++++++++++++++
 guest/scripts/finalize-rootfs.sh              |  5 +-
 guest/tests/test_overlay_scripts.py           | 44 +++++++++++
 guest/tests/verify.py                         |  4 +-
 6 files changed, 159 insertions(+), 3 deletions(-)
 create mode 100755 guest/factory-overlay/usr/local/bin/try-omarchy-windows-app
