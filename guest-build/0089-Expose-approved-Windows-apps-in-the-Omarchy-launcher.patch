@@ -511,6 +513,48 @@ class HostLocaleTests(OverlayCase):
 
 
 class AgentTests(OverlayCase):
+    def test_approved_windows_apps_sync_and_revoke(self) -> None:
+        app_id = "a" * 32
+        directory = self.root / "applications"
+        env = dict(self.env, TRY_OMARCHY_APP_SYNC=str(APP_SYNC), TRY_OMARCHY_APP_DIR=str(directory))
+        encoded = base64.b64encode(json.dumps([{"id": app_id, "name": "Notepad"}]).encode()).decode()
+        result = subprocess.run([str(AGENT), "--handle"], input=f"apps {encoded}\n", env=env,
+                                capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        entry = directory / f"try-omarchy-windows-{app_id}.desktop"
+        self.assertIn(f"Exec=try-omarchy-windows-app {app_id}", entry.read_text())
+        result = subprocess.run([str(AGENT), "--handle"], input="apps W10=\n", env=env,
+                                capture_output=True, text=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse(entry.exists())
+        bad = base64.b64encode(b'[{"id":"../../etc","name":"Bad"}]').decode()
+        result = subprocess.run([str(APP_SYNC)], input=bad + "\n", env=env,
+                                capture_output=True, text=True, timeout=10)
+        self.assertNotEqual(result.returncode, 0)
+
+    def test_approved_windows_app_request(self) -> None:
+        app_id = "b" * 32
+        with socket.socket() as server:
+            server.bind(("127.0.0.1", 0))
+            server.listen(1)
+            env = dict(self.env, TRY_OMARCHY_AGENT_HOST="127.0.0.1",
+                       TRY_OMARCHY_AGENT_PORT=str(server.getsockname()[1]))
+            def answer(status: bytes) -> bytes:
+                with server.accept()[0] as connection:
+                    request = connection.recv(128)
+                    connection.sendall(status)
+                    return request
+            with ThreadPoolExecutor(max_workers=1) as executor:
+                received = executor.submit(answer, b"ok\n")
+                result = subprocess.run([str(WINDOWS_APP), app_id], env=env, capture_output=True, text=True, timeout=10)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                self.assertEqual(received.result(timeout=5), f"launch-app {app_id}\n".encode())
+            with ThreadPoolExecutor(max_workers=1) as executor:
+                received = executor.submit(answer, b"unavailable\n")
+                result = subprocess.run([str(WINDOWS_APP), app_id], env=env, capture_output=True, text=True, timeout=10)
+                self.assertEqual(received.result(timeout=5), f"launch-app {app_id}\n".encode())
+                self.assertEqual(result.returncode, 1)
+
     def test_host_settings_request_and_failure(self) -> None:
         with socket.socket() as server:
             server.bind(("127.0.0.1", 0))
