diff --git a/guest/factory-overlay/usr/local/bin/try-omarchy-windows-app b/guest/factory-overlay/usr/local/bin/try-omarchy-windows-app
new file mode 100755
index 0000000..bc13be3
--- /dev/null
+++ b/guest/factory-overlay/usr/local/bin/try-omarchy-windows-app
@@ -0,0 +1,24 @@
+#!/bin/bash
+# Launch only a Windows app ID previously approved in host Settings.
+set -u
+id=${1:-}
+if [[ ! $id =~ ^[0-9a-f]{32}$ || $# -ne 1 ]]; then
+  echo 'Invalid approved Windows app.' >&2
+  exit 2
+fi
+host=${TRY_OMARCHY_AGENT_HOST:-10.0.2.2}
+port=${TRY_OMARCHY_AGENT_PORT:-4451}
+if ! { exec 3<>"/dev/tcp/$host/$port"; } 2>/dev/null; then
+  message='Windows app launch is unavailable. Start Omarchy from Windows and try again.'
+elif ! printf 'launch-app %s\n' "$id" >&3 || ! IFS= read -r -t 5 response <&3 || [[ $response != ok ]]; then
+  message='That Windows app is no longer approved or could not start. Check Try Omarchy Settings on Windows.'
+else
+  exec 3>&-
+  exit 0
+fi
+exec 3>&-
+printf '%s\n' "$message" >&2
+if command -v notify-send >/dev/null 2>&1; then
+  notify-send 'Try Omarchy' "$message"
+fi
+exit 1
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/agent b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
index 97eec4a..00b6a0a 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/agent
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
@@ -11,7 +11,8 @@ host=${TRY_OMARCHY_AGENT_HOST:-10.0.2.2}
 port=${TRY_OMARCHY_AGENT_PORT:-4451}
 set_time=${TRY_OMARCHY_SET_TIME:-date -s}
 fill_dir=${TRY_OMARCHY_FILL_DIR:-/var/tmp}
-version=3
+version=4
+app_sync=${TRY_OMARCHY_APP_SYNC:-/usr/local/lib/try-omarchy/approved-apps-sync}
 max_drift=2
 # Space left free while zero-filling, so running programs keep working.
 fill_reserve_mib=512
@@ -59,6 +60,13 @@ zero_fill() {
 handle() {
   local line=$1 target now drift
   case $line in
+    apps\ *)
+      if [[ -n ${TRY_OMARCHY_APP_SYNC:-} ]]; then
+        printf '%s\n' "${line#apps }" | "$app_sync" || echo 'could not sync approved Windows apps' >&2
+      else
+        printf '%s\n' "${line#apps }" | runuser -u omarchy -- "$app_sync" || echo 'could not sync approved Windows apps' >&2
+      fi
+      ;;
     battery\ *)
       printf '%s\n' "${line#battery }" | /usr/local/lib/try-omarchy/battery-apply ||
         echo 'could not apply host battery state' >&2
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/approved-apps-sync b/guest/factory-overlay/usr/local/lib/try-omarchy/approved-apps-sync
new file mode 100755
index 0000000..eaa0f68
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/approved-apps-sync
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Apply host-approved Windows app IDs to the Omarchy user's launcher menu."""
+import base64
+import json
+import os
+import pathlib
+import re
+import sys
+import tempfile
+
+PREFIX = "try-omarchy-windows-"
+ID = re.compile(r"[0-9a-f]{32}\Z")
+
+
+def entries(data: str) -> dict[str, str]:
+    raw = base64.b64decode(data, validate=True)
+    if len(raw) > 12288:
+        raise ValueError("approved app list is too large")
+    value = json.loads(raw)
+    if not isinstance(value, list) or len(value) > 16:
+        raise ValueError("invalid approved app list")
+    result = {}
+    for item in value:
+        if not isinstance(item, dict) or set(item) != {"id", "name"}:
+            raise ValueError("invalid approved app entry")
+        app_id, name = item["id"], item["name"]
+        if not isinstance(app_id, str) or not ID.fullmatch(app_id) or app_id in result:
+            raise ValueError("invalid approved app ID")
+        if not isinstance(name, str) or not name or len(name) > 80 or any(ord(ch) < 32 or ord(ch) == 127 for ch in name):
+            raise ValueError("invalid approved app name")
+        result[app_id] = name
+    return result
+
+
+def sync(apps: dict[str, str], directory: pathlib.Path) -> None:
+    directory.mkdir(mode=0o755, parents=True, exist_ok=True)
+    wanted = set()
+    for app_id, name in apps.items():
+        target = directory / f"{PREFIX}{app_id}.desktop"
+        wanted.add(target.name)
+        content = ("[Desktop Entry]\nType=Application\n"
+                   f"Name=Windows: {name.replace('\\', '\\\\')}\n"
+                   "Comment=Launch an approved Windows app outside Omarchy\n"
+                   f"Exec=try-omarchy-windows-app {app_id}\n"
+                   "Icon=computer\nCategories=Utility;\nTerminal=false\n")
+        if target.is_file() and target.read_text(encoding="utf-8") == content:
+            continue
+        fd, temp = tempfile.mkstemp(prefix=".try-omarchy-windows-", dir=directory)
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as output:
+                output.write(content)
+            os.chmod(temp, 0o644)
+            os.replace(temp, target)
+        finally:
+            if os.path.exists(temp):
+                os.unlink(temp)
+    for path in directory.glob(f"{PREFIX}*.desktop"):
+        if ID.fullmatch(path.stem.removeprefix(PREFIX)) and path.name not in wanted:
+            path.unlink()
+
+
+def main() -> None:
+    data = sys.stdin.readline(16385).strip()
+    if not data or sys.stdin.read(1):
+        raise ValueError("invalid approved app input")
+    directory = pathlib.Path(os.environ.get("TRY_OMARCHY_APP_DIR", "~/.local/share/applications")).expanduser()
+    sync(entries(data), directory)
+
+
+if __name__ == "__main__":
+    try:
+        main()
+    except (OSError, ValueError, json.JSONDecodeError) as error:
+        print(f"could not sync approved Windows apps: {error}", file=sys.stderr)
+        sys.exit(1)
