From d21fc727b31c5760b103241e769e970c506bd234 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Wed, 2 Sep 2026 13:36:16 -0400
Subject: [PATCH 11/13] Update Omarchy to 4.0.2 and require signed Omarchy
 packages

4.0.2 is a security release: sshd hardening, browser policy directories,
sudoers tightening, and no more unsigned packages from the Omarchy
repository. Drop the SigLevel override to match upstream's pacman-stable.conf
and teach the builder container to trust the Omarchy packaging key, checked
by fingerprint against the vendored copy (the same key omarchy-keyring
ships). Instant trial provisioning stops replaying the input group unless a
feature that needs raw input devices is installed, the rule upstream's owner
provisioning adopted in this release.
---
 guest/Containerfile                           |  9 +++++++
 .../lib/try-omarchy/provision-instant-trial   |  7 ++++++
 guest/keys/omarchy-pkgs.asc                   | 15 +++++++++++
 guest/pacman-x86_64.conf                      |  1 -
 guest/scripts/fetch-source.sh                 | 25 +++++++++++--------
 guest/spec.json                               |  8 +++---
 6 files changed, 50 insertions(+), 15 deletions(-)
 create mode 100644 guest/keys/omarchy-pkgs.asc

diff --git a/guest/Containerfile b/guest/Containerfile
index c1f3b8f..f75a47c 100644
--- a/guest/Containerfile
+++ b/guest/Containerfile
@@ -4,7 +4,16 @@ FROM docker.io/library/archlinux@sha256:b860afd5823683f7ea389ba5f00d812f4fe55f6f
 
 RUN test "$(uname -m)" = x86_64
 
+# Omarchy 4.0.2 requires signed packages from its repository. The builder
+# trusts the Omarchy packaging key (fingerprint checked against the vendored
+# copy, which matches the key shipped in omarchy-keyring) before resolving
+# the transaction; the guest gets the same trust from omarchy-keyring itself.
+COPY guest/keys/omarchy-pkgs.asc /tmp/omarchy-pkgs.asc
 RUN pacman-key --init && pacman-key --populate archlinux && \
+    test "$(gpg --batch --with-colons --show-keys /tmp/omarchy-pkgs.asc | awk -F: '/^fpr:/ { print $10; exit }')" = 40DFB630FF42BCFFB047046CF0134EE680CAC571 && \
+    pacman-key --add /tmp/omarchy-pkgs.asc && \
+    pacman-key --lsign-key 40DFB630FF42BCFFB047046CF0134EE680CAC571 && \
+    rm /tmp/omarchy-pkgs.asc && \
     pacman -Syu --noconfirm && \
     pacman -S --needed --noconfirm arch-install-scripts e2fsprogs git python zstd && \
     pacman -Scc --noconfirm
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial b/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial
index e464b39..f146c15 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/provision-instant-trial
@@ -17,6 +17,13 @@ user_groups() {
   if [[ -f $provisioning_dir/groups ]]; then
     while IFS= read -r group; do
       [[ -n $group && $group != docker ]] || continue
+      # Same rule as upstream's owner provisioning: raw input device access
+      # is only kept when a feature that deliberately needs it is installed.
+      if [[ $group == input ]] &&
+        ! pacman -Qq xpadneo-dkms &>/dev/null &&
+        ! pacman -Qq ydotool &>/dev/null; then
+        continue
+      fi
       getent group "$group" >/dev/null || continue
       [[ ,$groups, == *,$group,* ]] || groups+=",$group"
     done <"$provisioning_dir/groups"
