diff --git a/guest/pacman-x86_64.conf b/guest/pacman-x86_64.conf
index 3aede6c..d86ef38 100644
--- a/guest/pacman-x86_64.conf
+++ b/guest/pacman-x86_64.conf
@@ -27,5 +27,4 @@ Include = /etc/pacman.d/mirrorlist
 Include = /etc/pacman.d/mirrorlist
 
