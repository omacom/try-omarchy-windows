 def generated_key(directory: Path) -> str:
@@ -380,3 +381,28 @@ class HostLocaleTests(OverlayCase):
         self.assertEqual(result.returncode, 0, result.stderr)
         self.assertEqual(self.vconsole.read_text(), "KEYMAP=us\n")
         self.assertFalse((self.state / "host-timezone").exists())
+
+
+class AgentTests(OverlayCase):
+    def handle(self, message: str, now: int) -> subprocess.CompletedProcess:
+        self.fake("date", f'if [ "$1" = +%s ]; then echo {now}; else echo "date $@" >> "$CALLS"; fi')
+        return subprocess.run([str(AGENT), "--handle"], input=message + "\n", env=dict(self.env, CALLS=str(self.log)),
+                              capture_output=True, text=True, timeout=30)
+
+    def calls(self) -> str:
+        return self.log.read_text() if self.log.exists() else ""
+
+    def test_steps_the_clock_only_past_two_seconds_of_drift(self) -> None:
+        result = self.handle("time 1788609600", now=1788609601)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.calls(), "")
+        result = self.handle("time 1788609600", now=1788609690)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.calls(), "date -s @1788609600\n")
+        self.assertIn("stepped by -90 s", result.stdout)
+
+    def test_ignores_malformed_messages(self) -> None:
+        for message in ["time now", "time 1788609600; reboot", "reboot", "time 12"]:
+            result = self.handle(message, now=1)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(self.calls(), "", message)
