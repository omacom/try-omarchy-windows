+[Unit]
+Description=Try Omarchy guest agent (clock sync with the Windows launcher)
+After=network-online.target NetworkManager.service
+Wants=network-online.target
+
+[Service]
+Type=simple
+ExecStart=/usr/local/lib/try-omarchy/agent
+Restart=always
+RestartSec=5
+
+[Install]
+WantedBy=multi-user.target
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/agent b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
new file mode 100755
index 0000000..80a7d93
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/agent
@@ -0,0 +1,49 @@
+#!/bin/bash
+# Guest agent: keeps a line-based channel open to the Windows launcher at
+# 10.0.2.2:4451 (QEMU user networking) and applies the small things only the
+# host knows. Today that is the clock: the launcher sends "time <unix>" on
+# connect, periodically, and after Windows resumes from sleep, and the guest
+# steps its clock when it has drifted by more than two seconds. Reconnects
+# forever, quietly, since the launcher may not be listening on every boot.
+set -u
+
+host=${TRY_OMARCHY_AGENT_HOST:-10.0.2.2}
+port=${TRY_OMARCHY_AGENT_PORT:-4451}
+set_time=${TRY_OMARCHY_SET_TIME:-date -s}
+version=1
+max_drift=2
+
+handle() {
+  local line=$1 target now drift
+  case $line in
+    time\ *)
+      target=${line#time }
+      [[ $target =~ ^[0-9]{9,11}$ ]] || return 0
+      now=$(date +%s)
+      drift=$((now - target))
+      if ((drift > max_drift || drift < -max_drift)); then
+        if $set_time "@$target" >/dev/null 2>&1; then
+          echo "clock stepped by $((-drift)) s to follow Windows"
+        else
+          echo "could not set the clock" >&2
+        fi
+      fi
+      ;;
+  esac
+}
+
+if [[ ${1:-} == --handle ]]; then
+  # Test entry point: apply one message from stdin without a network.
+  while IFS= read -r line; do handle "$line"; done
+  exit 0
+fi
+
+while :; do
+  exec 3<>"/dev/tcp/$host/$port" 2>/dev/null || { sleep 10; continue; }
+  printf 'hello %s\n' "$version" >&3
+  while IFS= read -r line <&3; do
+    handle "${line%$'\r'}"
+  done
+  exec 3>&-
+  sleep 5
+done
