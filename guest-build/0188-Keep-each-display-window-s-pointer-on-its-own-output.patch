@@ -0,0 +1,373 @@
+#!/usr/bin/env python3
+"""Keep the pointer of each Try Omarchy display window on its own output.
+
+With more than one display, the launcher gives every display window its own
+virtual tablet. Its serial is try-omarchy-head-N for the window that shows
+Virtual-(N+1), and QEMU reports the pointer as 0 to 100% of that window.
+Hyprland spreads an absolute pointer over the box around all outputs and has
+no setting that binds a pointer device to one output, so each tablet gets a
+libinput calibration matrix that maps its range onto its own output within
+that box. Moving across a window then moves across its output only.
+
+The matrix follows Hyprland's layout: positions, modes (which follow the
+window size), scale and rotation, as the Hyprland of the active seat0 session
+lays them out. This watches that Hyprland's monitor events, the
+GPU's hotplug events and, as a safety net, polls the layout every few seconds.
+When an output's box changes, the matrix is written where the udev rule
+imports it and the tablet is announced again, which is the only way libinput
+reads a new one. Hyprland drops and adds the device; the pointer stays put.
+
+udev starts this as root when the first such tablet appears. It exits when
+there are none, so a guest with one display never runs it.
+"""
+import glob
+import json
+import math
+import os
+import pathlib
+import select
+import socket
+import subprocess
+import sys
+import time
+
+TABLET_NAME = "QEMU Virtio Tablet"
+SERIAL_PREFIX = "try-omarchy-head-"
+MAXIMUM_HEADS = 16
+PROPERTY = "LIBINPUT_CALIBRATION_MATRIX"
+IPC_TIMEOUT = 2
+# Layout changes that Hyprland does not announce are found this often.
+POLL = 5.0
+# Display sync applies a window's new mode shortly after the GPU's hotplug
+# event, so look again a few times after one.
+FOLLOW_UP = (0.3, 1.0, 2.5, 5.0)
+LAYOUT_EVENTS = (b"monitoradded>>", b"monitorremoved>>", b"monitoraddedv2>>",
+                 b"monitorremovedv2>>", b"configreloaded>>")
+
+# For each wl_output transform, the output's logical position (p, q) from the
+# window position (u, v), both 0 to 1: rows of (u, v, 1) coefficients. The
+# window shows the output's buffer, which the compositor draws rotated or
+# flipped by the transform.
+TRANSFORMS = {
+    0: ((1, 0, 0), (0, 1, 0)),
+    1: ((0, -1, 1), (1, 0, 0)),
+    2: ((-1, 0, 1), (0, -1, 1)),
+    3: ((0, 1, 0), (-1, 0, 1)),
+    4: ((-1, 0, 1), (0, 1, 0)),
+    5: ((0, 1, 0), (1, 0, 0)),
+    6: ((1, 0, 0), (0, -1, 1)),
+    7: ((0, -1, 1), (-1, 0, 1)),
+}
+
+
+def head_of(serial):
+    if not serial.startswith(SERIAL_PREFIX):
+        return None
+    number = serial[len(SERIAL_PREFIX):]
+    if not (number.isascii() and number.isdigit()) or number != str(int(number)) or int(number) >= MAXIMUM_HEADS:
+        return None
+    return int(number)
+
+
+def head_tablets(sys_root="/sys"):
+    """The per-display tablets, as {head: event device directory}."""
+    found = {}
+    for event in sorted(glob.glob(f"{sys_root}/class/input/event*")):
+        device = pathlib.Path(event) / "device"
+        try:
+            if (device / "name").read_text().strip() != TABLET_NAME:
+                continue
+            head = head_of((device / "uniq").read_text().strip())
+        except OSError:
+            continue
+        if head is not None and head not in found:
+            found[head] = pathlib.Path(event)
+    return found
+
+
+def logical_box(monitor):
+    """The output's box in the layout, as Hyprland computes it."""
+    width, height = monitor["width"], monitor["height"]
+    if monitor.get("transform", 0) % 2:
+        width, height = height, width
+    scale = monitor.get("scale") or 1
+    return (monitor["x"], monitor["y"],
+            math.floor(width / scale + 0.5), math.floor(height / scale + 0.5))
+
+
+def calibrations(monitors, heads):
+    """The calibration matrix for each head whose output is shown, by head.
+
+    monitors is hyprctl's monitors all. The layout box is the one Hyprland
+    maps an unbound absolute pointer onto: the enabled outputs that are not
+    mirrors. A mirror's window shows its source (mirrorOf is the source's
+    id), so its tablet goes there.
+    """
+    if not isinstance(monitors, list):
+        return {}
+    by_name = {m.get("name"): m for m in monitors if isinstance(m, dict)}
+    by_id = {str(m.get("id")): m for m in by_name.values()}
+    try:
+        active = [m for m in by_name.values()
+                  if not m.get("disabled") and m.get("mirrorOf", "none") == "none"]
+        boxes = [logical_box(m) for m in active]
+    except (KeyError, TypeError, ValueError, ZeroDivisionError):
+        return {}
+    if not boxes:
+        return {}
+    left = min(b[0] for b in boxes)
+    top = min(b[1] for b in boxes)
+    width = max(b[0] + b[2] for b in boxes) - left
+    height = max(b[1] + b[3] for b in boxes) - top
+    if width <= 0 or height <= 0:
+        return {}
+    matrices = {}
+    for head in heads:
+        monitor = by_name.get(f"Virtual-{head + 1}")
+        if not monitor or monitor.get("disabled"):
+            continue
+        shown = monitor
+        if monitor.get("mirrorOf", "none") != "none":
+            shown = by_id.get(str(monitor["mirrorOf"]))
+            if not shown or shown.get("disabled"):
+                continue
+        try:
+            x, y, w, h = logical_box(shown)
+            rows = TRANSFORMS[monitor.get("transform", 0)]
+        except (KeyError, TypeError, ValueError, ZeroDivisionError):
+            continue
+        if w <= 0 or h <= 0:
+            continue
+        # The window's edges land on the centres of the output's edge pixels,
+        # so rounding never puts the pointer on the output next to it.
+        a, b, c = ((w - 1) / width * k for k in rows[0])
+        d, e, f = ((h - 1) / height * k for k in rows[1])
+        c += (x - left + 0.5) / width
+        f += (y - top + 0.5) / height
+        matrices[head] = " ".join(format_number(n) for n in (a, b, c, d, e, f))
+    return matrices
+
+
+def format_number(value):
+    text = f"{value:.9f}".rstrip("0").rstrip(".")
+    return "0" if text in ("", "-0") else text
+
+
+def device_property(event_dir, udev_data="/run/udev/data"):
+    """The calibration the device was last announced with, or None."""
+    try:
+        major, minor = (event_dir / "dev").read_text().strip().split(":")
+        lines = pathlib.Path(udev_data, f"c{major}:{minor}").read_text().splitlines()
+    except (OSError, ValueError):
+        return None
+    for line in lines:
+        if line.startswith(f"E:{PROPERTY}="):
+            return line.split("=", 1)[1]
+    return None
+
+
+def write_matrix(state_dir, head, matrix):
+    path = pathlib.Path(state_dir) / f"{SERIAL_PREFIX}{head}"
+    if matrix is None:
+        path.unlink(missing_ok=True)
+        return
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_name(path.name + ".new")
+    temporary.write_text(f"{PROPERTY}={matrix}\n")
+    os.replace(temporary, path)
+
+
+def announce_again(event_dir):
+    """Have udev import the new matrix and libinput open the device again."""
+    for action in ("remove", "add"):
+        (event_dir / "uevent").write_text(action)
+    subprocess.run(["udevadm", "settle", "--timeout=5"], check=False,
+                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
+
+
+def apply(matrices, tablets, state_dir="/run/try-omarchy/head-tablets",
+          udev_data="/run/udev/data", announce=announce_again):
+    """Write each head's matrix and re-announce only the tablets whose own
+    matrix differs from the one udev last gave them. Announcing a tablet again
+    lets go of a button held on it, so an unchanged tablet is left alone."""
+    changed = []
+    for head, event_dir in sorted(tablets.items()):
+        matrix = matrices.get(head)
+        write_matrix(state_dir, head, matrix)
+        if device_property(event_dir, udev_data) != matrix:
+            announce(event_dir)
+            changed.append(head)
+    return changed
+
+
+def instances(runtime_root="/run/user"):
+    """Hyprland instance directories owned by their session user, newest last."""
+    found = []
+    for path in glob.glob(f"{runtime_root}/*/hypr/*/.socket.sock"):
+        sock = pathlib.Path(path)
+        try:
+            uid = int(sock.parents[2].name)
+            info = sock.stat()
+            if info.st_uid != uid:
+                continue
+        except (OSError, ValueError):
+            continue
+        found.append((info.st_mtime, str(sock.parent)))
+    return [pathlib.Path(path) for _, path in sorted(found)]
+
+
+def seat_user(run=subprocess.run):
+    """The user of the active local session on seat0, from logind, or None."""
+    try:
+        result = run(["/usr/bin/loginctl", "show-seat", "seat0", "--property=ActiveSession", "--value"],
+                     capture_output=True, text=True, timeout=3)
+        session = result.stdout.strip()
+        if result.returncode or not session or not session.isalnum():
+            return None
+        result = run(["/usr/bin/loginctl", "show-session", session, "--property=Remote",
+                      "--property=User"], capture_output=True, text=True, timeout=3)
+    except (OSError, subprocess.SubprocessError):
+        return None
+    fields = dict(line.split("=", 1) for line in result.stdout.splitlines() if "=" in line)
+    if result.returncode or fields.get("Remote") != "no" or not fields.get("User", "").isdigit():
+        return None
+    return int(fields["User"])
+
+
+def drives_display(instance, proc="/proc"):
+    """Whether this Hyprland has the GPU's display device open. A nested
+    Hyprland, started inside the desktop, draws through its parent instead."""
+    try:
+        pid = (instance / "hyprland.lock").read_text().split()[0]
+        if not pid.isdigit():
+            return False
+        fds = pathlib.Path(proc, pid, "fd")
+        for fd in fds.iterdir():
+            try:
+                if os.readlink(fd).startswith("/dev/dri/card"):
+                    return True
+            except OSError:
+                continue
+    except (OSError, IndexError):
+        return False
+    return False
+
+
+def seat_instance(runtime_root="/run/user", proc="/proc", run=subprocess.run):
+    """The Hyprland that shows the active seat0 session, or None. Its layout is
+    what the display windows show; another account's or a nested Hyprland's
+    is not."""
+    uid = seat_user(run)
+    if uid is None:
+        return None
+    for instance in reversed(instances(runtime_root)):
+        if instance.parents[1].name == str(uid) and drives_display(instance, proc):
+            return instance
+    return None
+
+
+def request(instance, command, timeout=IPC_TIMEOUT):
+    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as conn:
+        conn.settimeout(timeout)
+        conn.connect(str(instance / ".socket.sock"))
+        conn.sendall(command.encode())
+        chunks = []
+        while chunk := conn.recv(65536):
+            chunks.append(chunk)
+    return json.loads(b"".join(chunks))
+
+
+def open_events(instance):
+    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    try:
+        conn.settimeout(IPC_TIMEOUT)
+        conn.connect(str(instance / ".socket2.sock"))
+        conn.setblocking(False)
+        return conn
+    except OSError:
+        conn.close()
+        return None
+
+
+def open_hotplug():
+    """Kernel uevents, for the GPU's hotplug when a window changes size."""
+    try:
+        conn = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, socket.NETLINK_KOBJECT_UEVENT)
+        conn.bind((0, 1))
+        conn.setblocking(False)
+        return conn
+    except (OSError, AttributeError):
+        return None
+
+
+def check(sys_root, runtime_root, state_dir, udev_data, announce=announce_again,
+          proc="/proc", run=subprocess.run):
+    """One pass. Returns the tablets and the Hyprland instance it used."""
+    tablets = head_tablets(sys_root)
+    if not tablets:
+        return tablets, None
+    instance = seat_instance(runtime_root, proc, run)
+    if instance is None:
+        return tablets, None
+    try:
+        monitors = request(instance, "j/monitors all")
+    except (OSError, ValueError):
+        return tablets, None
+    changed = apply(calibrations(monitors, tablets), tablets, state_dir, udev_data, announce)
+    if changed:
+        print(f"head-tablets: mapped {', '.join(f'Virtual-{h + 1}' for h in changed)}", flush=True)
+    return tablets, instance
+
+
+def watch(sys_root="/sys", runtime_root="/run/user", state_dir="/run/try-omarchy/head-tablets",
+          udev_data="/run/udev/data", clock=time.monotonic):
+    hotplug = open_hotplug()
+    events, events_for = None, None
+    checks = [clock()]
+    while True:
+        now = clock()
+        if min(checks) <= now:
+            checks = [t for t in checks if t > now]
+            tablets, instance = check(sys_root, runtime_root, state_dir, udev_data)
+            if not tablets:
+                return 0
+            if instance != events_for:
+                if events is not None:
+                    events.close()
+                events = open_events(instance) if instance else None
+                events_for = instance if events is not None else None
+            # Until Hyprland runs, look for it sooner.
+            if not checks:
+                checks = [now + (POLL if instance else 1.0)]
+        sockets = [s for s in (events, hotplug) if s is not None]
+        timeout = max(0.0, min(checks) - now)
+        if not sockets:
+            time.sleep(timeout)
+            continue
+        for conn in select.select(sockets, [], [], timeout)[0]:
+            try:
+                data = conn.recv(65536)
+            except BlockingIOError:
+                continue
+            except OSError:
+                data = b""
+            now = clock()
+            if conn is events and not data:
+                events.close()
+                events, events_for = None, None
+                checks.append(now + 1.0)
+            elif conn is events and any(line.startswith(LAYOUT_EVENTS) for line in data.split(b"\n")):
+                checks += [now] + [now + delay for delay in FOLLOW_UP]
+            elif conn is hotplug and b"SUBSYSTEM=drm" in data and b"HOTPLUG=1" in data:
+                checks += [now + delay for delay in FOLLOW_UP]
+
+
+def main():
+    try:
+        return watch(os.environ.get("TRY_OMARCHY_SYSFS", "/sys"))
+    except KeyboardInterrupt:
+        return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
