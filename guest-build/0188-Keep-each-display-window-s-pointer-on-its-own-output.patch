@@ -0,0 +1,346 @@
+import contextlib
+import fnmatch
+import io
+import importlib.machinery
+import math
+import json
+import os
+from pathlib import Path
+import socket
+import tempfile
+import threading
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+HELPER = GUEST / 'factory-overlay/usr/local/lib/try-omarchy/head-tablets'
+RULES = GUEST / 'factory-overlay/etc/udev/rules.d/70-try-omarchy-head-tablets.rules'
+UNIT = GUEST / 'factory-overlay/etc/systemd/system/try-omarchy-head-tablets.service'
+heads = importlib.machinery.SourceFileLoader('head_tablets', str(HELPER)).load_module()
+
+
+def monitor(name, x, y, width, height, scale=1, transform=0, mirror='none', disabled=False):
+    """One output as hyprctl -j monitors all reports it."""
+    return {'id': int(name.split('-')[1]) - 1, 'name': name, 'x': x, 'y': y, 'width': width,
+            'height': height, 'scale': scale, 'transform': transform, 'mirrorOf': mirror,
+            'disabled': disabled}
+
+
+def window(pixel, size):
+    """A window pixel as QEMU reports it and libinput normalizes it."""
+    return pixel * 32767 // size / 32768
+
+
+def layout_box(monitors):
+    boxes = [heads.logical_box(m) for m in monitors if not m['disabled'] and m['mirrorOf'] == 'none']
+    left, top = min(b[0] for b in boxes), min(b[1] for b in boxes)
+    return left, top, max(b[0] + b[2] for b in boxes) - left, max(b[1] + b[3] for b in boxes) - top
+
+
+def pointer(matrix, monitors, u, v):
+    """Where Hyprland puts the pointer for a window position (u, v), each 0 to 1."""
+    a, b, c, d, e, f = (float(n) for n in matrix.split())
+    left, top, width, height = layout_box(monitors)
+    return left + width * (a * u + b * v + c), top + height * (d * u + e * v + f)
+
+
+def inside(point, monitor):
+    x, y, w, h = heads.logical_box(monitor)
+    return x <= point[0] < x + w and y <= point[1] < y + h
+
+
+class MatrixTests(unittest.TestCase):
+    def assertCovers(self, matrix, monitors, target):
+        """The window's corners and centre land on the target output only."""
+        x, y, w, h = heads.logical_box(target)
+        for u, v in [(0, 0), (1, 0), (0, 1), (1, 1), (0.5, 0.5), (32767 / 32768, 32767 / 32768)]:
+            point = pointer(matrix, monitors, u, v)
+            self.assertTrue(inside(point, target), (u, v, point, target['name']))
+            for other in monitors:
+                if other is not target and not other['disabled'] and other['mirrorOf'] == 'none':
+                    self.assertFalse(inside(point, other), (u, v, point, other['name']))
+        corners = {tuple(math.floor(n) for n in pointer(matrix, monitors, u, v)) for u in (0, 1) for v in (0, 1)}
+        self.assertEqual({(px, py) for px in (x, x + w - 1) for py in (y, y + h - 1)}, corners)
+
+    def test_side_by_side_like_the_report(self):
+        # Issue 424: Virtual-1 at 0x0 and Virtual-2 at 1920x0, both 1920x1080.
+        monitors = [monitor('Virtual-1', 0, 0, 1920, 1080), monitor('Virtual-2', 1920, 0, 1920, 1080)]
+        matrices = heads.calibrations(monitors, [0, 1])
+        self.assertCovers(matrices[0], monitors, monitors[0])
+        self.assertCovers(matrices[1], monitors, monitors[1])
+        # The middle of window 1 is the middle of Virtual-1, to the pixel.
+        for got, want in zip(pointer(matrices[0], monitors, 0.5, 0.5), (960, 540)):
+            self.assertLessEqual(abs(got - want), 1)
+
+    def test_heads_follow_output_names_not_positions(self):
+        # Virtual-2 sits to the left of and below Virtual-1, listed first.
+        monitors = [monitor('Virtual-2', -300, 381, 488, 381), monitor('Virtual-1', 188, 0, 640, 480),
+                    monitor('Virtual-3', 828, 50, 800, 600)]
+        matrices = heads.calibrations(monitors, [0, 1, 2])
+        by_name = {m['name']: m for m in monitors}
+        for head in range(3):
+            self.assertCovers(matrices[head], monitors, by_name[f'Virtual-{head + 1}'])
+
+    def test_scale_uses_the_logical_size(self):
+        monitors = [monitor('Virtual-1', 0, 0, 640, 480, scale=2), monitor('Virtual-2', 320, 100, 488, 381)]
+        self.assertEqual(heads.logical_box(monitors[0]), (0, 0, 320, 240))
+        matrices = heads.calibrations(monitors, [0, 1])
+        self.assertCovers(matrices[0], monitors, monitors[0])
+        self.assertCovers(matrices[1], monitors, monitors[1])
+        # Measured in the Windows VM: a click on pixel 121,190 of the 488x381
+        # window 2 landed at 441,289.
+        x, y = pointer(matrices[1], monitors, window(121, 488), window(190, 381))
+        self.assertEqual((math.floor(x), math.floor(y)), (441, 289))
+
+    def test_rotation_matches_what_the_window_shows(self):
+        # Measured in the Windows VM with Virtual-2 488x381 at 640x0 beside a
+        # 640x480 Virtual-1: the host pointer at (0.1, 0.1) or (0.1, 0.2) of
+        # window 2, and the guest pointer Hyprland reported.
+        seen = {1: ((0.1, 0.1), (982, 48)), 3: ((0.1, 0.2), (716, 439)),
+                5: ((0.1, 0.2), (716, 48)), 2: ((0.1, 0.2), (1079, 304))}
+        for transform, ((u, v), want) in seen.items():
+            monitors = [monitor('Virtual-1', 0, 0, 640, 480), monitor('Virtual-2', 640, 0, 488, 381, transform=transform)]
+            matrix = heads.calibrations(monitors, [1])[1]
+            got = pointer(matrix, monitors, u, v)
+            self.assertLessEqual(abs(got[0] - want[0]), 1.5, (transform, got, want))
+            self.assertLessEqual(abs(got[1] - want[1]), 1.5, (transform, got, want))
+        for transform in range(8):
+            monitors = [monitor('Virtual-1', 0, 0, 640, 480), monitor('Virtual-2', 640, 0, 488, 381, transform=transform)]
+            self.assertCovers(heads.calibrations(monitors, [1])[1], monitors, monitors[1])
+
+    def test_window_corners_for_every_transform(self):
+        # Worked out by hand from wl_output's transforms: the window shows the
+        # buffer, which is the logical output rotated counter-clockwise, and
+        # the flipped ones mirror it left to right first. Where the window's
+        # top-left and top-right corners land on the output, as left/right
+        # and top/bottom.
+        corners = {
+            0: (('left', 'top'), ('right', 'top')),
+            1: (('right', 'top'), ('right', 'bottom')),
+            2: (('right', 'bottom'), ('left', 'bottom')),
+            3: (('left', 'bottom'), ('left', 'top')),
+            4: (('right', 'top'), ('left', 'top')),
+            5: (('left', 'top'), ('left', 'bottom')),
+            6: (('left', 'bottom'), ('right', 'bottom')),
+            7: (('right', 'bottom'), ('right', 'top')),
+        }
+        for transform, expected in corners.items():
+            monitors = [monitor('Virtual-1', 0, 0, 640, 480), monitor('Virtual-2', 640, 0, 488, 381, transform=transform)]
+            x, y, w, h = heads.logical_box(monitors[1])
+            edges = {'left': x, 'right': x + w - 1, 'top': y, 'bottom': y + h - 1}
+            matrix = heads.calibrations(monitors, [1])[1]
+            for (u, v), (across, down) in zip([(0, 0), (1, 0)], expected):
+                got = tuple(math.floor(n) for n in pointer(matrix, monitors, u, v))
+                self.assertEqual(got, (edges[across], edges[down]), (transform, (u, v)))
+
+    def test_outputs_that_are_not_shown(self):
+        monitors = [monitor('Virtual-1', 0, 0, 800, 600), monitor('Virtual-2', 800, 0, 800, 600, disabled=True)]
+        self.assertEqual(set(heads.calibrations(monitors, [0, 1, 2])), {0})
+        # A mirror's window shows its source.
+        monitors = [monitor('Virtual-1', 0, 0, 800, 600), monitor('Virtual-2', 0, 0, 800, 600, mirror='0')]
+        matrices = heads.calibrations(monitors, [0, 1])
+        self.assertEqual(matrices[0], matrices[1])
+        for reply in [None, {}, [], [{'name': 'Virtual-1'}], [monitor('Virtual-1', 0, 0, 0, 0)]]:
+            self.assertEqual(heads.calibrations(reply, [0]), {})
+
+
+def make_tablet(root, event, name, serial, dev):
+    device = root / 'class/input' / event / 'device'
+    device.mkdir(parents=True)
+    (device / 'name').write_text(name + '\n')
+    (device / 'uniq').write_text(serial + '\n')
+    (device.parent / 'dev').write_text(dev + '\n')
+    (device.parent / 'uevent').write_text('')
+    return device.parent
+
+
+def logind(uid, session='2', remote='no'):
+    """A fake run for loginctl: seat0's active session belongs to uid."""
+    def run(args, **kwargs):
+        class Result:
+            returncode = 0
+            stdout = ''
+        result = Result()
+        if args[1:3] == ['show-seat', 'seat0']:
+            result.stdout = f'{session}\n'
+        elif args[1:3] == ['show-session', session]:
+            result.stdout = f'Remote={remote}\nUser={uid}\n'
+        else:
+            result.returncode = 1
+        return result
+    return run
+
+
+def hyprland(runtime, proc, uid, signature, pid, card):
+    """An instance directory, and a /proc entry with the GPU open or not."""
+    instance = runtime / str(uid) / 'hypr' / signature
+    instance.mkdir(parents=True)
+    (instance / 'hyprland.lock').write_text(f'{pid}\nwayland-1\n')
+    fds = proc / str(pid) / 'fd'
+    fds.mkdir(parents=True)
+    os.symlink('/dev/dri/renderD128', fds / '10')
+    if card:
+        os.symlink('/dev/dri/card1', fds / '11')
+    return instance
+
+
+class DeviceTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory()
+        self.root = Path(self.temporary.name)
+        self.sys = self.root / 'sys'
+
+    def tearDown(self):
+        self.temporary.cleanup()
+
+    def test_serials(self):
+        self.assertEqual([heads.head_of(f'try-omarchy-head-{n}') for n in (0, 1, 15)], [0, 1, 15])
+        for serial in ['', 'try-omarchy-head-', 'try-omarchy-head-16', 'try-omarchy-head-01',
+                       'try-omarchy-head--1', 'try-omarchy-head-1/../2', 'try-omarchy-head-\u00b2', 'other-0']:
+            self.assertIsNone(heads.head_of(serial), serial)
+
+    def test_finds_only_the_per_display_tablets(self):
+        make_tablet(self.sys, 'event3', 'QEMU Virtio Tablet', 'try-omarchy-head-0', '13:67')
+        make_tablet(self.sys, 'event4', 'QEMU Virtio Tablet', 'try-omarchy-head-1', '13:68')
+        make_tablet(self.sys, 'event5', 'QEMU Virtio Tablet', '', '13:69')
+        make_tablet(self.sys, 'event6', 'QEMU Virtio Keyboard', 'try-omarchy-head-2', '13:70')
+        found = heads.head_tablets(str(self.sys))
+        self.assertEqual({h: p.name for h, p in found.items()}, {0: 'event3', 1: 'event4'})
+        # One display: a single tablet with no serial, so the helper has nothing to do.
+        self.assertEqual(heads.head_tablets(str(self.root / 'empty')), {})
+        self.assertEqual(heads.watch(str(self.root / 'empty'), str(self.root / 'run')), 0)
+
+    def test_announces_only_tablets_whose_matrix_changed(self):
+        first = make_tablet(self.sys, 'event3', 'QEMU Virtio Tablet', 'try-omarchy-head-0', '13:67')
+        second = make_tablet(self.sys, 'event4', 'QEMU Virtio Tablet', 'try-omarchy-head-1', '13:68')
+        third = make_tablet(self.sys, 'event5', 'QEMU Virtio Tablet', 'try-omarchy-head-2', '13:69')
+        udev = self.root / 'udev'
+        udev.mkdir()
+        (udev / 'c13:67').write_text('E:ID_INPUT_MOUSE=1\nE:LIBINPUT_CALIBRATION_MATRIX=1 0 0 0 1 0\n')
+        (udev / 'c13:68').write_text('E:LIBINPUT_CALIBRATION_MATRIX=0.5 0 0.5 0 1 0\n')
+        (udev / 'c13:69').write_text('E:LIBINPUT_CALIBRATION_MATRIX=0.5 0 0 0 1 0\n')
+        state = self.root / 'state'
+        (state).mkdir()
+        (state / 'try-omarchy-head-2').write_text('LIBINPUT_CALIBRATION_MATRIX=0.5 0 0 0 1 0\n')
+        announced = []
+        changed = heads.apply({0: '0.5 0 0 0 1 0', 1: '0.5 0 0.5 0 1 0'},
+                              {0: first, 1: second, 2: third}, state, udev, announced.append)
+        self.assertEqual(changed, [0, 2])
+        self.assertEqual(announced, [first, third])
+        self.assertEqual((state / 'try-omarchy-head-0').read_text(), 'LIBINPUT_CALIBRATION_MATRIX=0.5 0 0 0 1 0\n')
+        self.assertEqual((state / 'try-omarchy-head-1').read_text(), 'LIBINPUT_CALIBRATION_MATRIX=0.5 0 0.5 0 1 0\n')
+        # A head whose output is gone goes back to the plain tablet.
+        self.assertFalse((state / 'try-omarchy-head-2').exists())
+
+    def test_announcing_again_removes_and_adds_the_device(self):
+        event = make_tablet(self.sys, 'event3', 'QEMU Virtio Tablet', 'try-omarchy-head-0', '13:67')
+        written = []
+        real_write = Path.write_text
+
+        def record(path, text, *args, **kwargs):
+            if path.name == 'uevent':
+                written.append(text)
+            return real_write(path, text, *args, **kwargs)
+
+        Path.write_text = record
+        original = heads.subprocess.run
+        try:
+            heads.subprocess.run = lambda *args, **kwargs: None
+            heads.announce_again(event)
+        finally:
+            Path.write_text = real_write
+            heads.subprocess.run = original
+        self.assertEqual(written, ['remove', 'add'])
+
+    def test_one_pass_against_hyprland(self):
+        make_tablet(self.sys, 'event3', 'QEMU Virtio Tablet', 'try-omarchy-head-0', '13:67')
+        make_tablet(self.sys, 'event4', 'QEMU Virtio Tablet', 'try-omarchy-head-1', '13:68')
+        runtime = self.root / 'run/user'
+        proc = self.root / 'proc'
+        instance = hyprland(runtime, proc, os.getuid(), 'abc', 700, card=True)
+        monitors = [monitor('Virtual-1', 0, 0, 1920, 1080), monitor('Virtual-2', 1920, 0, 1920, 1080)]
+        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        server.bind(str(instance / '.socket.sock'))
+        server.listen()
+        requests = []
+
+        def serve():
+            conn, _ = server.accept()
+            with conn:
+                requests.append(conn.recv(1024))
+                conn.sendall(json.dumps(monitors).encode())
+
+        thread = threading.Thread(target=serve)
+        thread.start()
+        announced = []
+        state = self.root / 'state'
+        output = io.StringIO()
+        try:
+            with contextlib.redirect_stdout(output):
+                tablets, used = heads.check(str(self.sys), str(runtime), state, self.root / 'udev', announced.append,
+                                            proc, logind(os.getuid()))
+        finally:
+            thread.join(5)
+            server.close()
+        self.assertEqual(requests, [b'j/monitors all'])
+        self.assertEqual(output.getvalue(), 'head-tablets: mapped Virtual-1, Virtual-2\n')
+        self.assertEqual(used, instance)
+        self.assertEqual([p.name for p in announced], ['event3', 'event4'])
+        expected = heads.calibrations(monitors, [0, 1])
+        for head in (0, 1):
+            self.assertEqual((state / f'try-omarchy-head-{head}').read_text(),
+                             f'LIBINPUT_CALIBRATION_MATRIX={expected[head]}\n')
+
+    def test_no_hyprland_yet(self):
+        make_tablet(self.sys, 'event3', 'QEMU Virtio Tablet', 'try-omarchy-head-0', '13:67')
+        announced = []
+        tablets, used = heads.check(str(self.sys), str(self.root / 'run/user'), self.root / 'state',
+                                    self.root / 'udev', announced.append, self.root / 'proc', logind(os.getuid()))
+        self.assertEqual(list(tablets), [0])
+        self.assertIsNone(used)
+        self.assertEqual(announced, [])
+
+
+    def test_uses_the_hyprland_of_the_active_seat_session(self):
+        runtime, proc = self.root / 'run/user', self.root / 'proc'
+        uid = os.getuid()
+        desktop = hyprland(runtime, proc, uid, 'desktop', 700, card=True)
+        # Started later, so newest: a nested Hyprland inside the desktop and
+        # another account's session on a second seat or in the background.
+        nested = hyprland(runtime, proc, uid, 'nested', 900, card=False)
+        other = hyprland(runtime, proc, uid + 1, 'other', 950, card=True)
+        self.assertNotEqual(other.parents[1].name, str(uid))
+        for path, age in ((desktop, 100), (nested, 200), (other, 300)):
+            (path / '.socket.sock').touch()
+            os.utime(path / '.socket.sock', (age, age))
+        self.assertEqual(heads.instances(str(runtime))[-1], nested)
+        self.assertEqual(heads.seat_instance(str(runtime), proc, logind(uid)), desktop)
+        self.assertIsNone(heads.seat_instance(str(runtime), proc, logind(uid, remote='yes')))
+        self.assertIsNone(heads.seat_instance(str(runtime), proc, logind(uid + 2)))
+        # Only the seat's own account counts, whatever runs elsewhere.
+        os.unlink(desktop / '.socket.sock')
+        self.assertIsNone(heads.seat_instance(str(runtime), proc, logind(uid)))
+
+
+class RuleTests(unittest.TestCase):
+    def test_rule_matches_the_serials_the_launcher_gives(self):
+        rules = [line for line in RULES.read_text().splitlines() if line and not line.startswith('#')]
+        self.assertEqual(len(rules), 2)
+        for rule in rules:
+            self.assertIn('ATTRS{name}=="QEMU Virtio Tablet"', rule)
+            pattern = rule.split('ATTRS{uniq}=="')[1].split('"')[0]
+            alternatives = pattern.split('|')
+            for head in range(16):
+                self.assertTrue(any(fnmatch.fnmatchcase(f'try-omarchy-head-{head}', p) for p in alternatives), head)
+            for serial in ['try-omarchy-head-16', 'try-omarchy-head-', '', 'try-omarchy-head-1x']:
+                self.assertFalse(any(fnmatch.fnmatchcase(serial, p) for p in alternatives), serial)
+        # The matrix is imported only when the helper wrote one; the service
+        # is started for any per-display tablet.
+        self.assertIn('TEST=="/run/try-omarchy/head-tablets/$attr{uniq}"', rules[1])
+        self.assertIn('IMPORT{file}="/run/try-omarchy/head-tablets/$attr{uniq}"', rules[1])
+        self.assertIn('ENV{SYSTEMD_WANTS}+="try-omarchy-head-tablets.service"', rules[0])
+        self.assertIn('ExecStart=/usr/local/lib/try-omarchy/head-tablets\n', UNIT.read_text())
+        self.assertTrue(os.access(HELPER, os.X_OK))
+
+
+if __name__ == '__main__':
+    unittest.main()
