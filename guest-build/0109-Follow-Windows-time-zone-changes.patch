diff --git a/guest/tests/test_timezone.py b/guest/tests/test_timezone.py
new file mode 100644
index 0000000..510d399
--- /dev/null
+++ b/guest/tests/test_timezone.py
@@ -0,0 +1,128 @@
+"""Real file fixtures for host following, manual opt-out, and setup defaults."""
+import importlib.machinery
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+from unittest.mock import patch
+
+GUEST = Path(__file__).resolve().parents[1]
+SCRIPT = GUEST / 'factory-overlay/usr/local/bin/try-omarchy-timezone'
+loader = importlib.machinery.SourceFileLoader('timezone_helper', str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+helper = importlib.util.module_from_spec(spec)
+loader.exec_module(helper)
+
+class TimeZoneTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.zones = self.root / 'zoneinfo'
+        for zone in ['Etc/UTC', 'America/Chicago', 'Europe/Berlin']:
+            p = self.zones / zone
+            p.parent.mkdir(parents=True, exist_ok=True)
+            p.write_text(zone)
+        self.local = self.root / 'localtime'
+        self.local.symlink_to(self.zones / 'Etc/UTC')
+        self.state = self.root / 'state/timezone.json'
+        self.applied = []
+
+    def replace(self, target):
+        name = self.root / 'localtime-new'
+        name.symlink_to(target)
+        name.replace(self.local)
+
+    def sync(self, zone, **kw):
+        def apply(target):
+            self.applied.append(target)
+            self.replace(target)
+        return helper.synchronize(zone, self.state, self.local, self.zones, apply, **kw)
+
+    def test_changes_and_repeated_snapshot(self):
+        self.assertTrue(self.sync('America/Chicago'))
+        self.assertFalse(self.sync('America/Chicago'))
+        self.assertTrue(self.sync('Europe/Berlin'))
+        self.assertEqual(len(self.applied), 2)
+        self.assertEqual(json.loads(self.state.read_text())['mode'], 'auto')
+
+    def test_manual_choice_survives_host_change_and_restart(self):
+        self.sync('America/Chicago')
+        self.replace(self.zones / 'Etc/UTC')
+        self.assertFalse(self.sync('Europe/Berlin'))
+        self.assertFalse(self.sync('America/Chicago'))
+        self.assertEqual(self.local.resolve(), self.zones / 'Etc/UTC')
+        self.assertEqual(json.loads(self.state.read_text()), {'mode': 'manual'})
+        self.assertTrue(self.sync('Europe/Berlin', force=True))
+
+    def test_same_zone_manual_replacement_opts_out(self):
+        self.sync('America/Chicago')
+        self.replace(self.zones / 'America/Chicago')
+        self.assertFalse(self.sync('Europe/Berlin'))
+        self.assertEqual(self.local.resolve(), self.zones / 'America/Chicago')
+
+    def test_legacy_manual_override_is_preserved(self):
+        legacy = self.root / 'legacy'
+        legacy.write_text('America/Chicago\n')
+        self.assertFalse(self.sync('Europe/Berlin', legacy_path=legacy))
+        self.assertEqual(self.local.resolve(), self.zones / 'Etc/UTC')
+
+    def test_legacy_following_adopts_new_host_zone(self):
+        legacy = self.root / 'legacy'
+        legacy.write_text('Etc/UTC\n')
+        self.assertTrue(self.sync('Europe/Berlin', legacy_path=legacy))
+
+    def test_invalid_zone_cannot_change_localtime_or_state(self):
+        escaped = self.zones / 'Escaped'
+        escaped.symlink_to(self.root / 'outside')
+        (self.root / 'outside').write_text('x')
+        before = helper.fingerprint(self.local)
+        for zone in ['../outside', 'Etc//UTC', 'Missing/Zone', 'Escaped', 'Etc/UTC\n', {}, '']:
+            with self.subTest(zone=zone), self.assertRaises(ValueError):
+                self.sync(zone)
+        self.assertEqual(helper.fingerprint(self.local), before)
+        self.assertFalse(self.state.exists())
+
+    def test_corrupt_state_preserves_guest_until_explicit_follow(self):
+        self.state.parent.mkdir()
+        for value in ['{', '[]', '{"mode":"wrong"}', '{"mode":"auto"}']:
+            self.state.write_text(value)
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                self.sync('America/Chicago')
+            self.assertEqual(self.local.resolve(), self.zones / 'Etc/UTC')
+        self.assertTrue(self.sync('America/Chicago', force=True))
+
+    def test_apply_failure_does_not_record_success(self):
+        with patch.object(helper.subprocess, 'run', side_effect=subprocess.TimeoutExpired('timedatectl', 5)):
+            with self.assertRaises(subprocess.TimeoutExpired):
+                helper.synchronize('Europe/Berlin', self.state, self.local, self.zones)
+        self.assertFalse(self.state.exists())
+        self.assertEqual(self.local.resolve(), self.zones / 'Etc/UTC')
+
+    def test_early_initializer_and_legacy_marker_via_real_scripts(self):
+        cmdline = self.root / 'cmdline'
+        cmdline.write_text('tryomarchy.tz=America/Chicago\n')
