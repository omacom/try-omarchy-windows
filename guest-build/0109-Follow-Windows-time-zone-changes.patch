++  fi
++  if [[ -z $guess ]]; then guess=$(tzupdate -p 2>/dev/null) || guess=""; fi
+ 
+   if [[ -n $guess ]]; then
+     timezone=$(timedatectl list-timezones | gum choose --height 10 --selected "$guess" --header "Timezone") && status=0 || status=$?
