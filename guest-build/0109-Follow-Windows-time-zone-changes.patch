+ # often; guard it or a `set -e` caller dies before the filter fallback.
+ omarchy_prompt_timezone() {
+   local guess status
+-  guess=$(tzupdate -p 2>/dev/null) || guess=""
++  # The VM launcher supplies a validated host hint. Keep geolocation as a
++  # fallback for environments without a host time-zone integration.
++  guess=""
++  local host_hint=${TRY_OMARCHY_HOST_ZONE:-/run/try-omarchy/host-timezone}
