diff --git a/guest/tests/fixtures/omarchy-4.0.4/patches/omarchy/notification-screen-privacy.patch b/guest/tests/fixtures/omarchy-4.0.4/patches/omarchy/notification-screen-privacy.patch
new file mode 100644
index 0000000..32c468f
--- /dev/null
+++ b/guest/tests/fixtures/omarchy-4.0.4/patches/omarchy/notification-screen-privacy.patch
@@ -0,0 +1,235 @@
+diff --git a/shell/plugins/notifications/Service.qml b/shell/plugins/notifications/Service.qml
+--- a/shell/plugins/notifications/Service.qml
++++ b/shell/plugins/notifications/Service.qml
+@@ -50,6 +50,18 @@
+   readonly property int defaultBarSize: barVertical ? Style.bar.sizeVertical : Style.bar.sizeHorizontal
+   readonly property int liveBarSize: shell && shell.bar && !shell.bar.barHidden ? Math.max(0, shell.bar.barSize) : defaultBarSize
+   readonly property int barClearance: liveBarSize + Style.gapsOut
++  // Notification surfaces live on the overlay layer, above the ordinary
++  // fullscreen terminal used by the screensaver. Hide them while either the
++  // screensaver or secure lock covers the session, and resume their remaining
++  // lifetime only once the user can see them again. Startup remains private
