diff --git a/guest/tests/test_omarchy_migrations.py b/guest/tests/test_omarchy_migrations.py
new file mode 100644
index 0000000..212e81c
--- /dev/null
+++ b/guest/tests/test_omarchy_migrations.py
@@ -0,0 +1,117 @@
+"""Omarchy migrations the guest makes inert, and the kernel reboot check."""
+import hashlib
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+MATERIALIZE = (GUEST / 'scripts/materialize-omarchy.sh').read_text()
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def function(name):
+    match = re.search(r'^' + name + r'\(\) \{\n.*?^\}\n', MATERIALIZE, re.M | re.S)
+    assert match, name
+    return match.group(0)
+
+
+def skipped():
+    return re.findall(r'^skip_migration (\d+) ([0-9a-f]{64}) \\\n  "([^"]+)"$', MATERIALIZE, re.M)
+
+
+class SkippedMigrationTests(unittest.TestCase):
+    def run_skip(self, root, *args):
+        script = 'set -euo pipefail\nfail() { echo "$*" >&2; exit 1; }\nomarchy_root=$1\nshift\n'
+        script += function('skip_migration') + 'skip_migration "$@"\n'
+        return subprocess.run(['bash', '-c', script, 'skip', str(root), *args],
+                              text=True, capture_output=True, timeout=10)
+
+    def test_reviewed_migrations_are_replaced_by_their_message(self):
+        entries = skipped()
+        self.assertEqual(
+            [name for name, _, _ in entries],
+            ['1789325478', '1791403252', '1789294350', '1791147791', '1789764927',
+             '1790539857', '1790542069', '1791403310', '1791542175', '1791708587'])
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            (root / 'migrations').mkdir()
+            for name, _, message in entries:
+                original = f'echo "upstream {name}"\nomarchy-pkg-add something\n'.encode()
+                migration = root / 'migrations' / f'{name}.sh'
+                migration.write_bytes(original)
+                result = self.run_skip(root, name, digest(original), message)
+                self.assertEqual(result.returncode, 0, result.stderr)
+                ran = subprocess.run(['bash', '-euo', 'pipefail', str(migration)],
+                                     text=True, capture_output=True, timeout=10)
+                self.assertEqual(ran.returncode, 0, ran.stderr)
+                self.assertEqual(ran.stdout, message + '\n')
+
+    def test_a_changed_or_missing_migration_stops_the_build(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            (root / 'migrations').mkdir()
+            migration = root / 'migrations/1791403252.sh'
+            migration.write_text('echo "changed upstream"\n')
+            result = self.run_skip(root, '1791403252', digest(b'reviewed\n'), 'Keep it')
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn('changed; review it', result.stderr)
+            self.assertEqual(migration.read_text(), 'echo "changed upstream"\n')
+            result = self.run_skip(root, '1700000000', digest(b''), 'Keep it')
+            self.assertNotEqual(result.returncode, 0)
+            self.assertIn('moved; review it', result.stderr)
+
+    def test_messages_cannot_carry_shell_syntax(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            (root / 'migrations').mkdir()
+            original = b'echo upstream\n'
+            (root / 'migrations/1.sh').write_bytes(original)
+            for message in ['say "hi"', 'run $(id)', 'tick `id`', 'back\\slash']:
+                result = self.run_skip(root, '1', digest(original), message)
+                self.assertNotEqual(result.returncode, 0, message)
+                self.assertEqual((root / 'migrations/1.sh').read_bytes(), original)
+
+    def test_input_method_migration_keeps_only_the_shortcut_defaults(self):
+        block = MATERIALIZE.split('input_migration="$omarchy_root/migrations/1791367434.sh"', 1)[1]
+        block = block.split("<<'MIGRATION'\n", 1)[1].split('\nMIGRATION\n', 1)[0]
+        self.assertIn('omarchy-input-method configure --defaults', block)
+        self.assertNotIn('omarchy-pkg-add', block)
+        self.assertIn('b5dc5a2ef3ea113896c0a0bb9569228ebb1bd93f856fe13a8e24346c7b9bfed6', MATERIALIZE)
+
+    def test_kernel_reboot_check_is_disabled_on_the_indented_line(self):
+        # The shape of Omarchy 4.5's omarchy-update-restart around the check.
+        restart = '''if [[ $mode != "--services-only" ]]; then
+  running_kernel=$(uname -r)
+  kernel_updated=true
+
+  for kernel in "$kernel_modules_path"/*/modules.builtin; do
+        kernel_updated=false
+  done
+'''
+        block = MATERIALIZE.split('restart_check="$root/usr/bin/omarchy-update-restart"\n', 1)[1]
+        block = block.split('\n\n', 1)[0]
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            (root / 'usr/bin').mkdir(parents=True)
+            target = root / 'usr/bin/omarchy-update-restart'
+            for text, ok in [(restart, True), (restart.replace('  kernel_updated=true', 'kernel_updated=true'), False),
+                             (restart + '  kernel_updated=true\n', False)]:
+                target.write_text(text)
+                script = 'set -euo pipefail\nfail() { echo "$*" >&2; exit 1; }\nroot=$1\n'
+                script += 'restart_check="$root/usr/bin/omarchy-update-restart"\n' + block + '\n'
+                result = subprocess.run(['bash', '-c', script, 'restart', str(root)],
+                                        text=True, capture_output=True, timeout=10)
+                self.assertEqual(result.returncode == 0, ok, (text, result.stderr))
+                if ok:
+                    self.assertIn('  kernel_updated=false # Try Omarchy: the launcher supplies the kernel\n',
+                                  target.read_text())
+                    self.assertNotIn('kernel_updated=true', target.read_text())
+
+
+if __name__ == '__main__':
+    unittest.main()
