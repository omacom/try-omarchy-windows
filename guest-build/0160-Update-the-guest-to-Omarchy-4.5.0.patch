diff --git a/guest/tests/fixtures/omarchy-4.0.4/patches/omarchy/mute-terminal-bell.patch b/guest/tests/fixtures/omarchy-4.0.4/patches/omarchy/mute-terminal-bell.patch
new file mode 100644
index 0000000..592cb85
--- /dev/null
+++ b/guest/tests/fixtures/omarchy-4.0.4/patches/omarchy/mute-terminal-bell.patch
@@ -0,0 +1,14 @@
+--- a/default/hypr/looknfeel.lua
++++ b/default/hypr/looknfeel.lua
+@@ -124,3 +124,11 @@
+     hide_special_on_workspace_change = true,
+   },
+ })
++
++-- Hyprland 0.57 plays a sound for every terminal bell (tab-completion misses,
++-- TUI alerts). Mute it, as Omarchy does upstream; older Hyprland releases
++-- reject the unknown option, so only set it where it exists.
++local hyprland_major, hyprland_minor = hl.version():match("^(%d+)%.(%d+)")
++if hyprland_major and (tonumber(hyprland_major) > 0 or tonumber(hyprland_minor) >= 57) then
++  hl.config({ misc = { bell_sound = "none" } })
++end
