From 2a991921b2f70a24f27ed2cb88b0be679eb8fb79 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Tue, 29 Sep 2026 03:11:17 -0400
Subject: [PATCH] Turn off service watchdogs that fire after Windows sleeps

The guest clock keeps running while Windows sleeps, so on resume every system service watchdog is already overdue. systemd then kills logind, journald, udevd and userdbd as hung. logind restarting under the running Hyprland session leaves the desktop black until a VT switch. A top-level service drop-in sets WatchdogSec=0 for every system service. Compatibility revision 41 delivers it to existing guests.
---
 .../systemd/system/service.d/10-try-omarchy-watchdog.conf | 7 +++++++
 guest/scripts/finalize-rootfs.sh                          | 5 ++++-
 guest/tests/verify.py                                     | 8 +++++++-
 3 files changed, 18 insertions(+), 2 deletions(-)
 create mode 100644 guest/factory-overlay/etc/systemd/system/service.d/10-try-omarchy-watchdog.conf

diff --git a/guest/factory-overlay/etc/systemd/system/service.d/10-try-omarchy-watchdog.conf b/guest/factory-overlay/etc/systemd/system/service.d/10-try-omarchy-watchdog.conf
new file mode 100644
index 0000000..c0eaa1e
--- /dev/null
+++ b/guest/factory-overlay/etc/systemd/system/service.d/10-try-omarchy-watchdog.conf
@@ -0,0 +1,7 @@
+# The guest clock keeps running while Windows sleeps, so on resume every
+# service watchdog is already overdue. systemd then kills logind, journald
+# and udevd as hung, and the running desktop loses its seat. In this VM,
+# losing the automatic restart of a service that really hangs is the smaller
+# cost.
+[Service]
+WatchdogSec=0
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 0967966..2861e2a 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -136,6 +136,7 @@ compat_paths=(
   etc/systemd/system/multi-user.target.wants/try-omarchy-agent.service
   etc/modules-load.d/95-try-omarchy-battery.conf
   etc/UPower/UPower.conf.d/90-try-omarchy.conf
+  etc/systemd/system/service.d/10-try-omarchy-watchdog.conf
   usr/src/try-omarchy-battery-1.0.0
   etc/systemd/system/try-omarchy-catch-up.service
   etc/systemd/system/multi-user.target.wants/try-omarchy-catch-up.service
@@ -199,7 +200,9 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # drop overlay is mapped before dragging, and records reload modes per display.
 # Revision 40 keeps the scale the writer set in monitors.lua across display
 # sync and Hyprland config reloads.
-compat_revision=40
+# Revision 41 turns off system service watchdogs, which fire after Windows
+# sleeps and restart logind under the running desktop.
+compat_revision=41
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index 00578a4..119311e 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -277,8 +277,14 @@ def main() -> None:
 
     finalize_rootfs = read(GUEST / "scripts/finalize-rootfs.sh")
     compat_paths = finalize_rootfs.split("compat_paths=(", 1)[1].split(")", 1)[0]
+    watchdog_dropin = read(GUEST / "factory-overlay/etc/systemd/system/service.d/10-try-omarchy-watchdog.conf")
     check(
-        "compat_revision=40" in finalize_rootfs
+        "[Service]\nWatchdogSec=0\n" in watchdog_dropin,
+        "system services run without watchdogs, which fire after Windows sleeps",
+    )
+    check(
+        "compat_revision=41" in finalize_rootfs
+        and "etc/systemd/system/service.d/10-try-omarchy-watchdog.conf" in compat_paths
         and "usr/local/lib/try-omarchy/catch-up" in compat_paths
         and "usr/local/bin/omarchy-native-display-sync" in compat_paths
         and "usr/local/bin/omarchy-windows-audio-bridge" in compat_paths
