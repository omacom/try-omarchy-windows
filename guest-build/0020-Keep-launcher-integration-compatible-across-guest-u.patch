diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/guest-ready b/guest/factory-overlay/usr/local/lib/try-omarchy/guest-ready
new file mode 100755
index 0000000..3ac6ad1
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/guest-ready
@@ -0,0 +1,16 @@
+#!/bin/bash
+# Payload updates are kept rollback-capable until the guest reaches userspace
+# with networking. The launcher listens on the existing lifecycle channel.
+# A persistent disk upgraded across kernel releases is not ready until the
+# initramfs compatibility hook installed the matching module tree and marker.
+kernel=$(uname -r)
+marker=$(cat /usr/share/try-omarchy/compat-version 2>/dev/null || true)
+[[ $marker == *:"$kernel" ]] || exit 0
+[[ -f /usr/lib/modules/$kernel/modules.dep.bin ]] || exit 0
+for _ in {1..10}; do
+  if printf 'ready\n' | socat -u - TCP:10.0.2.2:4450,connect-timeout=2 2>/dev/null; then
+    exit 0
+  fi
+  sleep 1
+done
+exit 0
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/show-factory-update-notice b/guest/factory-overlay/usr/local/lib/try-omarchy/show-factory-update-notice
new file mode 100755
index 0000000..51dfc38
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/show-factory-update-notice
@@ -0,0 +1,9 @@
+#!/bin/bash
+set -euo pipefail
+
+state="$HOME/.local/state/try-omarchy/factory-update-notice-shown"
+mkdir -p "$(dirname "$state")"
+notify-send -a "Try Omarchy" -u normal -t 20000 \
+  "Your existing Omarchy system was preserved" \
+  "The launcher integration was updated without replacing your files or installed OS. To use the newest factory image and packages, run try-omarchy-export first, then start Try Omarchy with -fresh."
+touch "$state"
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 95e47f7..47e4926 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -48,6 +48,34 @@ ln -sfn /usr/lib/systemd/system/systemd-growfs-root.service \
 fc-cache -f
 update-desktop-database /usr/share/applications || true
 
+# The launcher updates the external kernel and initramfs without replacing a
+# user's persistent disk. Carry the small host/guest integration surface in
+# the initramfs so disks created by older releases gain matching SSH, share,
+# export, lifecycle, and readiness behavior without touching user data or
+# attempting a full package upgrade.
+compat_paths=(
+  etc/systemd/system/try-omarchy-ready.service
+  etc/systemd/system/multi-user.target.wants/try-omarchy-ready.service
+  etc/systemd/system/try-omarchy-sshd.service
+  etc/systemd/system/multi-user.target.wants/try-omarchy-sshd.service
+  etc/systemd/user/try-omarchy-share-link.service
+  etc/systemd/user/default.target.wants/try-omarchy-share-link.service
+  etc/systemd/user/try-omarchy-factory-update-notice.service
+  etc/systemd/user/graphical-session.target.wants/try-omarchy-factory-update-notice.service
+  usr/local/bin/try-omarchy-export
+  usr/local/lib/try-omarchy/guest-ready
+  usr/local/lib/try-omarchy/request-sshd
+  usr/local/lib/try-omarchy/share-link
+  usr/local/lib/try-omarchy/show-factory-update-notice
+)
+tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
+kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '%f\n')
+[[ -n $kernel_release && $kernel_release != *$'\n'* ]] || {
+  echo "Expected exactly one installed kernel module tree" >&2
+  exit 1
+}
+printf '1:%s\n' "$kernel_release" >/usr/share/try-omarchy/compat-version
+
 # Never let the container host's hardware autodetection remove the virtual
 # devices required by QEMU on the Windows host.
 mkinitcpio -P
