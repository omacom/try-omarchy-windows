+    def refuse_refresh(self):
+        """What an unpatched omarchy refresh pacman leaves when it is refused."""
+        shutil.copy(self.config, f'{self.config}.bak')
+        shutil.copy(self.mirrorlist, f'{self.mirrorlist}.bak')
