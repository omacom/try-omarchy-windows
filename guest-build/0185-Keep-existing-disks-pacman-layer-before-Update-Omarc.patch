+        listing = sorted(self.root.iterdir())
+        outputs = {self.layer('repair').stdout for _ in range(run)}
+        self.assertEqual({p: (p.read_bytes(), os.lstat(p).st_ino, os.lstat(p).st_mtime_ns) for p in paths}, before)
+        self.assertEqual(sorted(self.root.iterdir()), listing)
+        self.assertEqual(len(outputs), 1)
+        return outputs.pop()
