 compat_paths=(
   usr/local/lib/try-omarchy/install-qt612-palette
   usr/share/try-omarchy/qt612-palette
@@ -185,6 +192,7 @@ compat_paths=(
   usr/local/lib/try-omarchy/hold-kernel-headers
   usr/local/lib/try-omarchy/pacman-layer
   usr/share/try-omarchy/arch-mirrorlist
+  usr/share/try-omarchy/refresh-pacman
   usr/local/lib/try-omarchy/battery-apply
   usr/local/lib/try-omarchy/apply-host-locale
   usr/local/lib/try-omarchy/catch-up
@@ -273,7 +281,11 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Omarchy's mirrors without them.
 # Revision 72 has the agent tell the launcher when the desktop is drawn, so the
 # launcher shows its window on the wallpaper and bar instead of on a timer.
-compat_revision=72
+# Revision 73 patches Omarchy's refresh command before login on disks still on
+# an older 4.5.0 runtime, and repairs a disk an unpatched refresh rewrote at
+# every boot, not only once. It also carries the QEMU profile's updated
+# comment on the dmabuf quirk.
+compat_revision=73
