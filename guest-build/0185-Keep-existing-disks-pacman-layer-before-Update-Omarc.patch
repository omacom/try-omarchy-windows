diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
index 94e1a61..e0fc27b 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/catch-up
@@ -16,8 +16,10 @@
 #     /usr/local/bin, when it is still our unchanged copy
 #   - hold linux-headers with the linux package, once per disk
 #   - put back the local repository, kernel hold and Arch mirrors on a disk
-#     that a refused omarchy refresh pacman left on Omarchy's mirrors
-# Runs once per integration revision, before the display manager.
+#     that a refused omarchy refresh pacman left on Omarchy's mirrors, and
+#     patch that command, at every boot
+# Runs before the display manager. Apart from the pacman layer, each step runs
+# once per integration revision.
 set -euo pipefail
 
 revision_file=${TRY_OMARCHY_COMPAT_VERSION:-/usr/share/try-omarchy/compat-version}
@@ -35,6 +37,22 @@ terminal_shim=${TRY_OMARCHY_TERMINAL_SHIM:-/usr/local/bin/xdg-terminal-exec}
 revision=$(cut -d: -f1 "$revision_file" 2>/dev/null || echo 0)
 marker="$state_dir/catch-up-revision"
 previous_revision=$(cat "$marker" 2>/dev/null || true)
+
+# Every boot: omarchy refresh pacman (and so channel switches and package
+# reinstalls) replaced pacman.conf and the mirrorlist with Omarchy's templates,
+# then its transaction was refused, leaving the disk on Omarchy's stable mirror
+# snapshot without the local repository or the kernel hold. Until the next
+# Update > Omarchy installs the patched command, it can happen again after a
+# repair, so patch the command when it is Omarchy's reviewed original and put
+# back what a refused refresh replaced. A pacman.conf or mirrorlist set up some
+# other way is left alone, a healthy disk is not written, and no package
+# transaction runs here.
+pacman_layer=${TRY_OMARCHY_PACMAN_LAYER:-/usr/local/lib/try-omarchy/pacman-layer}
+if [[ -x $pacman_layer ]]; then
+  "$pacman_layer" commands || true
+  "$pacman_layer" repair || true
+fi
+
 [[ "$previous_revision" != "$revision" ]] || exit 0
 mkdir -p "$state_dir"
 
@@ -50,17 +68,6 @@ if [[ -x $battery_installer ]] && { [[ ! $previous_revision =~ ^[0-9]+$ ]] || ((
   "$battery_installer"
 fi
 
-# Before revision 71, omarchy refresh pacman (and so channel switches and
-# package reinstalls) replaced pacman.conf and the mirrorlist with Omarchy's
-# templates, then its transaction was refused. Such a disk was left on
-# Omarchy's stable mirror snapshot without the local repository or the kernel
-# hold. Put them back; a pacman.conf or mirrorlist set up some other way is
-# left alone. No package transaction runs here.
-pacman_layer=${TRY_OMARCHY_PACMAN_LAYER:-/usr/local/lib/try-omarchy/pacman-layer}
-if [[ -x $pacman_layer ]] && { [[ ! $previous_revision =~ ^[0-9]+$ ]] || (( previous_revision < 71 )); }; then
-  "$pacman_layer" repair || true
-fi
-
 # Hold linux-headers with the kernel. Disks from before revision 70 hold only
 # linux, so Update > Omarchy moved the headers past the kernel the launcher
 # boots and the DKMS hooks removed the camera and battery modules from it.
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer b/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer
index ca2facc..d667242 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/pacman-layer
@@ -29,7 +29,15 @@
 #            the guest's Arch mirrorlist back. Its pacman.conf.bak is restored
 #            only while pacman.conf is still exactly one of Omarchy's
 #            templates, so later edits are kept. Anything else is left alone.
-#            No package transaction runs.
+#            No package transaction runs. Catch-up runs it at every boot: until
+#            Update > Omarchy installs the patched commands, an unpatched
+#            refresh can break the disk again. On a healthy disk it reads two
+#            files and writes nothing.
+#   commands Before login: replace Omarchy's unpatched refresh and reinstall
+#            commands with the patched copies the image carries, so a refresh
+#            before the next Update > Omarchy already keeps the layer. Only
+#            the exact reviewed originals are replaced; an edited command or
+#            another Omarchy release's is left to the package.
 set -euo pipefail
 
 config=${TRY_OMARCHY_PACMAN_CONF:-/etc/pacman.conf}
@@ -38,6 +46,15 @@ arch_mirrors=${TRY_OMARCHY_ARCH_MIRRORLIST:-/usr/share/try-omarchy/arch-mirrorli
 repo=${TRY_OMARCHY_LOCAL_REPO:-/usr/share/try-omarchy/repo}
 pacman=${TRY_OMARCHY_PACMAN:-pacman}
 templates=${TRY_OMARCHY_OMARCHY_TEMPLATES:-/usr/share/omarchy/default/pacman}
+command_dir=${TRY_OMARCHY_COMMANDS:-/usr/bin}
+patched_commands=${TRY_OMARCHY_PATCHED_COMMANDS:-/usr/share/try-omarchy/refresh-pacman}
+
+# Each command's digest in the pinned Omarchy release, then with the reviewed
+# refresh-pacman-guest-layer patch. They match its targets in guest/spec.json.
+reviewed_commands=(
+  "omarchy-refresh-pacman e2832cb1963ee951fb2ab32b2989083cbb599c77c30c97f720cc19c43dca369e b65ab1c896f0a4d2ed54a355d53738f99f6d187de0443a503456c0f3cd14d226"
+  "omarchy-reinstall-pkgs c3767c3b27e7ccad073d8a79738da4a69710cdad12e4767668054ce1954f4070 353f12a240e7747e3b9425bfbe7382de31362a85c6e734fbd77b305f87a6625b"
+)
 
 regular() {
   [[ -f $1 && ! -L $1 ]]
@@ -208,6 +225,23 @@ ignore() {
   echo "${names[*]}"
 }
 
+digest() {
+  local sum
+  sum=$(sha256sum -- "$1") && echo "${sum%% *}"
+}
+
+commands() {
+  local entry name before after target patched
+  for entry in "${reviewed_commands[@]}"; do
+    read -r name before after <<<"$entry"
+    target=$command_dir/$name patched=$patched_commands/$name
+    regular "$target" && regular "$patched" || continue
+    [[ $(digest "$target") == "$before" && $(digest "$patched") == "$after" ]] || continue
+    replace "$target" <"$patched"
+    echo "patched $target to keep the guest's pacman layer"
+  done
+}
+
 repair() {
   local source
   if ! regular "$config"; then
@@ -239,8 +273,9 @@ case ${1:-} in
   sync) sync ;;
   ignore) ignore ;;
   repair) repair ;;
+  commands) commands ;;
   *)
-    echo "Usage: pacman-layer refresh|sync|ignore|repair" >&2
+    echo "Usage: pacman-layer refresh|sync|ignore|repair|commands" >&2
     exit 2
     ;;
 esac
