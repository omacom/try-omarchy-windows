diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-locale b/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-locale
index 8717164..e21fde4 100755
--- a/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-locale
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/apply-host-locale
@@ -6,6 +6,7 @@
 # changes. Omarchy's Hyprland input config reads XKBLAYOUT and XKBVARIANT
 # from /etc/vconsole.conf, so writing that file is enough for the desktop.
 # The current time-zone helper preserves manual guest changes across host changes.
+# On Korean Windows, untouched fcitx5 profiles offer Hangul instead of Chewing.
 set -euo pipefail
 
 cmdline_file=${TRY_OMARCHY_CMDLINE:-/proc/cmdline}
@@ -17,6 +18,10 @@ locale_gen=${TRY_OMARCHY_LOCALE_GEN:-/etc/locale.gen}
 locale_conf=${TRY_OMARCHY_LOCALE_CONF:-/etc/locale.conf}
 locale_sources=${TRY_OMARCHY_LOCALE_SOURCES:-/usr/share/i18n/locales}
 locale_gen_cmd=${TRY_OMARCHY_LOCALE_GEN_CMD:-locale-gen}
+homes=${TRY_OMARCHY_HOMES:-/home}
+skel=${TRY_OMARCHY_SKEL:-/etc/skel}
+fcitx5_inputmethods=${TRY_OMARCHY_FCITX5_INPUTMETHODS:-/usr/share/fcitx5/inputmethod}
+fcitx5_default=${TRY_OMARCHY_FCITX5_DEFAULT:-/usr/share/try-omarchy/guest-qol/fcitx5-profile}
 
 zone=""
 keyboard=""
@@ -103,7 +108,100 @@ apply_locale() {
   echo "language set to $full from Windows"
 }
 
+# The image seeds fcitx5 with the US keyboard and Chewing. On Korean Windows a
+# profile that is still that default switches its second input method to
+# Hangul. Two forms count as the default: the file the image ships, and the
+# same file after fcitx5 5.1 saved it on logout, which adds comments and
+# resolves DefaultIM. Edited, missing and linked profiles are left alone, and
+# other languages never change a home directory. This runs every boot before
+# the display manager, so no fcitx5 is holding a profile it would write back on
+# exit, and a disk that receives fcitx5-hangul later switches on its next boot.
+chewing_profiles=(
+  06a789f19c36b51585104fae04b3759d3abf06c6d0d63bb33a8955fb04a3615c
+  48cb57e228952a320c11d343abc766431c3b42a965b1d5e90726082f2070ebc4
+)
+hangul_profile='[Groups/0]
+Name=Default
+Default Layout=us
+DefaultIM=hangul
+
+[Groups/0/Items/0]
+Name=keyboard-us
+Layout=
+
+[Groups/0/Items/1]
+Name=hangul
+Layout=
+
+[GroupOrder]
+0=Default
+'
+
+profile_digest() {
+  sha256sum | cut -d' ' -f1
+}
+
+# replace_profile writes stdin over FILE, keeping its owner and mode. It writes
+# as the owner of FILE and its directory, so a link planted there gains nothing.
+replace_profile() {
+  local file=$1 owner
+  owner=$(stat -c %u:%g "$file") || return 1
+  [[ $(stat -c %u "${file%/*}") == "${owner%:*}" ]] || return 1
+  setpriv --reuid="${owner%:*}" --regid="${owner#*:}" --clear-groups -- bash -c '
+    tmp=$(mktemp "${1%/*}/.profile.XXXXXX") || exit 1
+    cat >"$tmp" && chmod --reference="$1" "$tmp" && mv -f "$tmp" "$1" && exit 0
+    rm -f "$tmp"
+    exit 1' replace-profile "$file"
+}
+
+# plain_profile succeeds when BASE has a regular profile and no link on the way.
+plain_profile() {
+  local base=$1 file=$1/.config/fcitx5/profile
+  # Dotfiles checkouts and redirected config directories are user choices.
+  [[ ! -L $base && ! -L $base/.config && ! -L $base/.config/fcitx5 && ! -L $file && -f $file ]]
+}
+
+# untouched_profile succeeds when BASE has a plain copy of the image default.
+untouched_profile() {
+  local digest
+  plain_profile "$1" || return 1
+  digest=$(profile_digest <"$1/.config/fcitx5/profile")
+  [[ $digest == "${chewing_profiles[0]}" || $digest == "${chewing_profiles[1]}" ]]
+}
+
+apply_input_method() {
+  local name=$1 home skel_profile=$skel/.config/fcitx5/profile
+  [[ $name =~ ^[a-z]{2,3}_[A-Z]{2}$ ]] || return 0
+  if [[ $name != ko_KR ]]; then
+    # Accounts created after Windows leaves Korean start from the image default again.
+    if plain_profile "$skel" && [[ -f $fcitx5_default ]] &&
+      [[ $(profile_digest <"$skel_profile") == "$(printf '%s' "$hangul_profile" | profile_digest)" ]] &&
+      [[ $(profile_digest <"$fcitx5_default") == "${chewing_profiles[0]}" ]]; then
+      replace_profile "$skel_profile" <"$fcitx5_default" || echo "could not restore the default input methods for new accounts" >&2
+    fi
+    return 0
+  fi
+  if [[ ! -f $fcitx5_inputmethods/hangul.conf ]]; then
+    echo "fcitx5-hangul is not installed; keeping the input methods" >&2
+    return 0
+  fi
+  # New accounts copy the skeleton, so the first Korean session already has Hangul.
+  if untouched_profile "$skel"; then
+    printf '%s' "$hangul_profile" | replace_profile "$skel_profile" || echo "could not offer Hangul to new accounts" >&2
+  fi
+  for home in "$homes"/*; do
+    [[ -d $home ]] || continue
+    untouched_profile "$home" || continue
+    if printf '%s' "$hangul_profile" | replace_profile "$home/.config/fcitx5/profile"; then
+      echo "input methods set to US keyboard and Hangul for $home"
+    else
+      echo "could not offer Hangul in $home" >&2
+    fi
+  done
+}
+
 [[ -z $zone ]] || apply_zone "$zone"
 [[ -z $keyboard ]] || apply_keyboard "$keyboard"
 [[ -z $locale ]] || apply_locale "$locale"
+[[ -z $locale ]] || apply_input_method "$locale"
 exit 0
