+        profile = self.seed_profile(self.homes / "user", FCITX5_SAVED_PROFILE.read_bytes())
+        (self.inputmethods / "hangul.conf").unlink()
+        result = self.apply("tryomarchy.locale=ko_KR")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("fcitx5-hangul is not installed", result.stderr)
+        self.assertEqual(profile.read_bytes(), FCITX5_SAVED_PROFILE.read_bytes())
+        (self.inputmethods / "hangul.conf").write_text("[InputMethod]\nName=Hangul\n")
+        self.apply("tryomarchy.locale=ko_KR")
+        self.assertIn("Name=hangul", profile.read_text())
+
+    def test_other_languages_leave_input_methods_unchanged(self) -> None:
+        shipped = self.seed_profile(self.homes / "fresh", FCITX5_PROFILE.read_bytes(), 0o644)
+        saved = self.seed_profile(self.homes / "used", FCITX5_SAVED_PROFILE.read_bytes())
+        for cmdline in ["tryomarchy.locale=zh_TW", "tryomarchy.locale=ja_JP tryomarchy.kb=jp",
+                        "tryomarchy.locale=de_DE", "tryomarchy.kb=kr", "tryomarchy.locale=ko_kr"]:
+            result = self.apply(cmdline)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            self.assertEqual(shipped.read_bytes(), FCITX5_PROFILE.read_bytes(), cmdline)
+            self.assertEqual(saved.read_bytes(), FCITX5_SAVED_PROFILE.read_bytes(), cmdline)
+            self.assertEqual((self.skel / ".config/fcitx5/profile").read_bytes(), FCITX5_PROFILE.read_bytes(), cmdline)
+
+    def test_new_accounts_return_to_the_default_when_windows_leaves_korean(self) -> None:
+        user = self.seed_profile(self.homes / "user", FCITX5_PROFILE.read_bytes())
+        self.apply("tryomarchy.locale=ko_KR")
+        skel_profile = self.skel / ".config/fcitx5/profile"
+        self.assertIn("Name=hangul", skel_profile.read_text())
+        self.apply("tryomarchy.locale=en_US")
+        self.assertEqual(skel_profile.read_bytes(), FCITX5_PROFILE.read_bytes())
+        self.assertEqual(skel_profile.stat().st_mode & 0o777, 0o644)
+        # A home directory keeps the user's Hangul profile after Windows changes language.
+        self.assertIn("Name=hangul", user.read_text())
+
+    def test_new_account_default_is_not_restored_through_a_linked_directory(self) -> None:
+        self.apply("tryomarchy.locale=ko_KR")
+        user = self.seed_profile(self.homes / "user", (self.skel / ".config/fcitx5/profile").read_bytes())
+        shutil.rmtree(self.skel / ".config/fcitx5")
+        (self.skel / ".config/fcitx5").symlink_to(user.parent, target_is_directory=True)
+        result = self.apply("tryomarchy.locale=en_US")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("Name=hangul", user.read_text())
+
 
