+    def test_korean_windows_offers_hangul_in_untouched_profiles(self) -> None:
+        shipped = self.seed_profile(self.homes / "fresh", FCITX5_PROFILE.read_bytes(), 0o644)
+        saved = self.seed_profile(self.homes / "used", FCITX5_SAVED_PROFILE.read_bytes())
+        result = self.apply("tryomarchy.locale=ko_KR tryomarchy.kb=kr")
+        self.assertEqual(result.returncode, 0, result.stderr)
+        for profile, mode in [(shipped, 0o644), (saved, 0o600), (self.skel / ".config/fcitx5/profile", 0o644)]:
+            text = profile.read_text()
+            self.assertIn("[Groups/0/Items/0]\nName=keyboard-us\n", text, profile)
+            self.assertIn("[Groups/0/Items/1]\nName=hangul\n", text, profile)
+            self.assertNotIn("chewing", text, profile)
+            self.assertEqual(profile.stat().st_mode & 0o777, mode, profile)
+        self.assertEqual(list(shipped.parent.iterdir()), [shipped])
+        self.assertIn(f"setpriv --reuid={os.getuid()}\n", (self.root / "setpriv.log").read_text())
+        # Seeded profiles no longer match the default, so later boots leave them alone.
+        inode = saved.stat().st_ino
+        self.apply("tryomarchy.locale=ko_KR tryomarchy.kb=kr")
+        self.assertEqual(saved.stat().st_ino, inode)
