+        (self.homes / "linked/.config").mkdir(parents=True)
+        (self.homes / "linked/.config/fcitx5").symlink_to(outside.parent, target_is_directory=True)
+        before = edited.read_bytes()
+        result = self.apply("tryomarchy.locale=ko_KR")
+        self.assertEqual(result.returncode, 0, result.stderr)
