+class NoPulseEvents:
+    """A pactl subscription that never starts."""
+
+    def fileno(self):
+        return None
+
+    def next_retry(self):
+        return float("inf")
+
+    def ensure(self):
+        return False
+
+    def read(self):
+        return set()
+
+    def close(self):
+        pass
+
+
+# main() tests drive select() with fixed descriptors. Keep a real pactl
+# subscription out of them; SubscriptionTests use the real class.
+RealPulseEvents = bridge.PulseEvents
+bridge.PulseEvents = NoPulseEvents
+
+
