+class SubscriptionTests(unittest.TestCase):
+    def fake_pactl(self, body: str) -> dict[str, str]:
+        import os
+        import tempfile
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        script = Path(directory.name) / "pactl"
+        script.write_text("#!/bin/sh\n" + body + "\n")
+        script.chmod(0o755)
+        return {"PATH": directory.name + os.pathsep + os.environ["PATH"]}
+
+    def wait_for(self, events, expected):
+        import select
+        import time
+        seen: set[str] = set()
+        deadline = time.monotonic() + 5
+        while expected - seen and time.monotonic() < deadline and events.fileno() is not None:
+            select.select([events.fileno()], [], [], 0.5)
+            seen |= events.read()
+        return seen
+
+    def test_only_device_and_server_events_wake_the_bridge(self):
+        env = self.fake_pactl(
+            '[ "$1" = subscribe ] || exit 2\n'
+            '[ "$LC_ALL" = C ] || exit 3\n'
+            "echo \"Event 'new' on client #5\"\n"
+            "echo \"Event 'remove' on client #5\"\n"
+            "echo \"Event 'change' on sink-input #3\"\n"
+            "echo \"Event 'change' on server\"\n"
+            "echo \"Event 'change' on sink #45\"\n"
+            "echo \"Event 'remove' on module #12\"\n"
+            "exec sleep 30")
+        events = RealPulseEvents()
+        self.addCleanup(events.close)
+        with mock.patch.dict(bridge.os.environ, env):
+            self.assertTrue(events.ensure())
+        self.assertFalse(events.ensure())
+        self.assertEqual(self.wait_for(events, {"server", "sink", "module"}), {"server", "sink", "module"})
+        self.assertIsNotNone(events.fileno())
+        self.assertEqual(events.next_retry(), float("inf"))
+
+    def test_ended_subscription_is_reported_and_restarted_later(self):
+        env = self.fake_pactl("echo \"Event 'new' on client #1\"; exit 1")
+        events = RealPulseEvents()
+        self.addCleanup(events.close)
+        with mock.patch.dict(bridge.os.environ, env):
+            self.assertTrue(events.ensure())
+            self.assertEqual(self.wait_for(events, {"lost"}), {"lost"})
+            self.assertIsNone(events.fileno())
+            # Not before the retry interval, so a server that is still down is
+            # not hammered.
+            self.assertFalse(events.ensure())
+            retry = events.next_retry()
+            with mock.patch.object(bridge.time, "monotonic", return_value=retry):
+                self.assertTrue(events.ensure())
+
+    def test_missing_pactl_is_retried(self):
+        events = RealPulseEvents()
+        with mock.patch.object(bridge.subprocess, "Popen", side_effect=FileNotFoundError("pactl")), \
+                mock.patch.object(bridge, "log") as log:
+            self.assertFalse(events.ensure())
+        log.assert_called_once()
+        self.assertIsNone(events.fileno())
+        self.assertLess(events.next_retry(), float("inf"))
+
+
+class IdleTests(unittest.TestCase):
+    """The bridge waits on events at idle instead of polling pactl."""
+
+    def run_main(self, events, iterations):
+        timeouts = []
+
+        def select(watched, _write, _error, timeout):
+            timeouts.append(timeout)
+            if len(timeouts) > iterations:
+                raise SystemExit(0)
+            descriptor = events.fileno()
+            return ([descriptor] if descriptor in watched else []), [], []
+
+        with mock.patch.object(bridge, "PulseEvents", return_value=events), \
+                mock.patch.object(bridge, "run_pactl", side_effect=PactlStub()), \
+                mock.patch.object(bridge.PipeWireMirror, "poll_selection") as poll, \
+                mock.patch.object(bridge, "open_port", return_value=17), \
+                mock.patch.object(bridge.os, "write", side_effect=lambda fd, data: len(data)), \
+                mock.patch.object(bridge.os, "close"), \
+                mock.patch.object(bridge.select, "select", side_effect=select), \
+                mock.patch.object(bridge.signal, "signal"):
+            with self.assertRaises(SystemExit):
+                bridge.main()
+        return poll.call_count, timeouts
+
+    def test_idle_bridge_checks_once_then_waits_for_the_safety_interval(self):
+        polls, timeouts = self.run_main(NoPulseEvents(), 3)
+        self.assertEqual(polls, 1)
+        self.assertEqual(timeouts[0], 0)
+        for timeout in timeouts[1:]:
+            self.assertGreater(timeout, bridge.SAFETY_INTERVAL - 0.5)
+
+    def test_server_event_checks_the_defaults_at_once(self):
+        class Events(NoPulseEvents):
+            def __init__(self):
+                self.batches = [set(), {"server"}, set()]
+
+            def fileno(self):
+                return 99
+
+            def read(self):
+                return self.batches.pop(0) if self.batches else set()
+
+        polls, timeouts = self.run_main(Events(), 3)
+        # The initial check, then one for the server event only.
+        self.assertEqual(polls, 2)
+        self.assertGreater(timeouts[-1], bridge.SAFETY_INTERVAL - 0.5)
+
+    def test_volume_gesture_is_sent_after_it_settles(self):
+        volume = bridge.VolumeMirror(bridge.PipeWireMirror(lambda _: None), lambda _: None)
+        self.assertEqual(bridge.volume_deadline(volume), float("inf"))
+        volume.mirror.sync_enabled = True
+        volume.last_host_state = 100.0
+        self.assertEqual(bridge.volume_deadline(volume), 100.0 + bridge.VOLUME_HOST_TIMEOUT)
+        volume.pending, volume.changed_at = (0.5, False), 101.0
+        self.assertEqual(bridge.volume_deadline(volume), 101.0 + bridge.VOLUME_SETTLE)
+        volume.inflight = True
+        self.assertEqual(bridge.volume_deadline(volume), 100.0 + bridge.VOLUME_HOST_TIMEOUT)
+
+
