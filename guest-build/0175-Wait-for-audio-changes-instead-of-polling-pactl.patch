+# Default devices, volume and mute are watched through one long-lived pactl
+# subscription instead of polling. Each pactl call is a new PipeWire client, and
+# polling them four times a second kept the guest's audio stack awake.
+SAFETY_INTERVAL = 5.0
+SUBSCRIBE_RETRY = 1.0
+VOLUME_SETTLE = 0.04
+# The server event covers default sink and source changes, sink and source
+# events volume and mute, module events the mirror's own routes. Client and
+# stream events are ignored: every pactl call the bridge makes is a new client.
+WATCHED_FACILITIES = frozenset({"server", "sink", "source", "module"})
+EVENT_LINE = re.compile(r"^Event '([a-z]+)' on ([a-z-]+)(?: #\d+)?$")
+
+
+class PulseEvents:
+    """Read `pactl subscribe` without blocking, restarting it when it ends."""
+
+    def __init__(self) -> None:
+        self.process: subprocess.Popen[bytes] | None = None
+        self.buffer = bytearray()
+        self.retry_at = 0.0
+
+    def fileno(self) -> int | None:
+        if self.process is None or self.process.stdout is None:
+            return None
+        return self.process.stdout.fileno()
+
+    def next_retry(self) -> float:
+        return math.inf if self.process is not None else self.retry_at
+
+    def ensure(self) -> bool:
+        """Start the subscription if it is not running. True when it started."""
+        if self.process is not None or time.monotonic() < self.retry_at:
+            return False
+        self.retry_at = time.monotonic() + SUBSCRIBE_RETRY
+        try:
+            # The event line is translated; the facility names are not.
+            process = subprocess.Popen(
+                ["pactl", "subscribe"],
+                stdin=subprocess.DEVNULL,
+                stdout=subprocess.PIPE,
+                stderr=subprocess.DEVNULL,
+                env={**os.environ, "LC_ALL": "C"},
+            )
+        except OSError as error:
+            log(f"pactl subscribe: {error}")
+            return False
+        assert process.stdout is not None
+        os.set_blocking(process.stdout.fileno(), False)
+        self.process = process
+        self.buffer.clear()
+        return True
+
+    def read(self) -> set[str]:
+        """Drain waiting events and return the watched facilities they name.
+
+        An ended subscription reports "lost": events may have been missed.
+        """
+        descriptor = self.fileno()
+        if descriptor is None:
+            return set()
+        facilities: set[str] = set()
+        while True:
+            try:
+                chunk = os.read(descriptor, 65536)
+            except BlockingIOError:
+                break
+            except OSError:
+                chunk = b""
+            if not chunk:
+                self.close()
+                facilities.add("lost")
+                break
+            self.buffer.extend(chunk)
+        *lines, rest = self.buffer.split(b"\n")
+        self.buffer = bytearray(rest[-4096:])
+        for line in lines:
+            match = EVENT_LINE.match(line.decode(errors="replace").strip())
+            if match is None:
+                facilities.add("unknown")
+            elif match.group(2) in WATCHED_FACILITIES:
+                facilities.add(match.group(2))
+        return facilities
+
+    def close(self) -> None:
+        process, self.process = self.process, None
+        if process is None:
+            return
+        process.kill()
+        try:
+            process.wait(timeout=1)
+        except subprocess.TimeoutExpired:
+            pass
+        if process.stdout is not None:
+            process.stdout.close()
+
+
+def volume_deadline(volume: VolumeMirror) -> float:
+    """When the volume mirror next needs a check without any event."""
+    deadline = math.inf
+    if volume.mirror.sync_enabled:
+        deadline = volume.last_host_state + VOLUME_HOST_TIMEOUT
+        if volume.pending is not None and not volume.inflight:
+            deadline = min(deadline, volume.changed_at + VOLUME_SETTLE)
+    return deadline
+
+
