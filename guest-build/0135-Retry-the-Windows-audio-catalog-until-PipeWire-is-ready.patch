diff --git a/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge b/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
index 6bbbb86..203104d 100755
--- a/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
+++ b/guest/factory-overlay/usr/local/bin/omarchy-windows-audio-bridge
@@ -613,7 +613,14 @@ def main() -> int:
                                 if message["type"] == "volume":
                                     volume.apply(message)
                                 else:
-                                    mirror.apply(message)
+                                    applied = False
+                                    while not applied:
+                                        try:
+                                            mirror.apply(message)
+                                            applied = True
+                                        except RuntimeError as error:
+                                            log(str(error))
+                                            time.sleep(1)
                                     volume.capable = message.get("volumeSync") is True
                                     if not volume.capable:
                                         volume.disconnect()
