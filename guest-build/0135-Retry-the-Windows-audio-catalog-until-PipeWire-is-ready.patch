@@ -240,7 +240,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 53 delivers bounded compositor health probes through the agent.
 # Revision 54 pauses config autoreload during live package updates.
