@@ -481,5 +481,57 @@ class PipeWireMirrorTests(unittest.TestCase):
         self.assertEqual(seen, set(expected))
 
 
+class CatalogRetryTests(unittest.TestCase):
+    def test_main_retries_startup_catalog_until_transport_is_ready(self):
+        for capable in (False, True):
+            with self.subTest(capable=capable):
+                message = catalog_message()
+                if capable:
+                    message["volumeSync"] = True
+                pactl = PactlStub()
+                transport_ready = False
+                writes = []
+                mirror = bridge.PipeWireMirror(lambda _: None)
+
+                def run_pactl(*args, **kwargs):
+                    if not transport_ready and args in (("list", "short", "sinks"), ("list", "short", "sources")):
+                        return ""
+                    return pactl(*args, **kwargs)
+
+                def sleep(seconds):
+                    nonlocal transport_ready
+                    self.assertEqual(seconds, 1)
+                    transport_ready = True
+
+                def read(_descriptor, _size):
+                    if read_catalog.call_count == 1:
+                        return json.dumps(message).encode() + b"\n"
+                    # No second catalog or device change is sent. The retained
+                    # startup catalog must have built the real mirror's routes.
+                    self.assertEqual(set(mirror.output_uids.values()), {None, "laptop-output", "studio-output"})
+                    self.assertEqual(set(mirror.input_uids.values()), {None, "laptop-input", "studio-input"})
+                    self.assertEqual(len(mirror.module_ids), 6)
+                    return b""
+
+                with mock.patch.object(bridge, "run_pactl", side_effect=run_pactl), \
+                        mock.patch.object(bridge, "PipeWireMirror", return_value=mirror), \
+                        mock.patch.object(mirror, "apply", wraps=mirror.apply) as apply, \
+                        mock.patch.object(bridge, "open_port", side_effect=[17, SystemExit(0)]), \
+                        mock.patch.object(bridge.os, "read", side_effect=read) as read_catalog, \
+                        mock.patch.object(bridge.os, "write", side_effect=lambda fd, data: writes.append(json.loads(data)) or len(data)), \
+                        mock.patch.object(bridge.os, "close"), \
+                        mock.patch.object(bridge.select, "select", return_value=([17], [], [])), \
+                        mock.patch.object(bridge.signal, "signal"), \
+                        mock.patch.object(bridge.time, "sleep", side_effect=sleep) as retry_sleep, \
+                        mock.patch.object(bridge, "log") as log:
+                    with self.assertRaises(SystemExit):
+                        bridge.main()
+                    self.assertEqual(apply.call_args_list, [mock.call(message), mock.call(message)])
+                    log.assert_called_once_with("the QEMU audio transport is not ready")
+                    self.assertEqual(retry_sleep.call_args_list, [mock.call(1), mock.call(1)])
+                self.assertEqual(writes, [{"type": "get-catalog"}] + ([{"type": "get-volume"}] if capable else []))
+                self.assertEqual(pactl.loaded_modules, set())  # EOF/exit cleanup.
+
+
 if __name__ == "__main__":
     unittest.main()
