diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/hold-kernel-headers b/guest/factory-overlay/usr/local/lib/try-omarchy/hold-kernel-headers
new file mode 100755
index 0000000..67b477f
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/hold-kernel-headers
@@ -0,0 +1,47 @@
+#!/bin/bash
+# Holds linux-headers with the linux package on disks created before the
+# image held both. Without the hold, Update > Omarchy moved the headers to
+# Arch's newer kernel, and the DKMS hooks removed the camera and battery
+# modules from the kernel the launcher boots. The package goes on the
+# IgnorePkg line that already holds linux. A configuration without that hold
+# is the administrator's and is left alone.
+set -euo pipefail
+
+config=${TRY_OMARCHY_PACMAN_CONF:-/etc/pacman.conf}
+
+if [[ ! -f $config || -L $config ]]; then
+  echo "left $config alone: not a regular file"
+  exit 0
+fi
+
+# Prints the line number of the [options] IgnorePkg line that holds linux, or
+# "held" when [options] already holds linux-headers.
+target=$(awk '
+  /^[[:space:]]*\[.*\][[:space:]]*$/ { options = ($0 ~ /^[[:space:]]*\[options\][[:space:]]*$/); next }
+  options && /^[[:space:]]*IgnorePkg[[:space:]]*=/ {
+    value = $0; sub(/^[^=]*=/, "", value)
+    count = split(value, names, /[[:space:]]+/)
+    for (i = 1; i <= count; i++) {
+      if (names[i] == "linux-headers") held = 1
+      if (names[i] == "linux" && !line) line = NR
+    }
+  }
+  END { if (held) print "held"; else if (line) print line }
+' "$config")
+
+if [[ $target == held ]]; then
+  exit 0
+fi
+if [[ -z $target ]]; then
+  echo "left $config alone: it does not hold the linux package"
+  exit 0
+fi
+
+tmp=$(mktemp "$(dirname "$config")/.pacman.conf.XXXXXX")
+trap 'rm -f "$tmp"' EXIT
+awk -v line="$target" 'NR == line { sub(/[[:space:]]*$/, " linux-headers") } { print }' "$config" >"$tmp"
+chown --reference="$config" "$tmp"
+chmod --reference="$config" "$tmp"
+mv -f "$tmp" "$config"
+trap - EXIT
+echo "held linux-headers with the kernel in $config"
