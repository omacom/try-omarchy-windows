+class ModuleRepairTests(unittest.TestCase):
+    """The initramfs hook on a disk whose Update removed the DKMS modules."""
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.guest = self.root / 'guest'
+
+    def files(self, base, files):
+        for name, value in files.items():
+            path = base / name
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(value)
+
+    def boot(self, kernel, version, modules):
+        """Run the latehook as the launcher's initramfs for kernel would."""
+        (self.root / 'version').write_text(version + '\n')
+        with tarfile.open(self.root / 'overlay.tar', 'w'):
+            pass
+        with tarfile.open(self.root / 'modules.tar', 'w') as out:
+            for name, value in modules.items():
+                data = value.encode()
+                info = tarfile.TarInfo(f'{kernel}/{name}')
+                info.size = len(data)
+                out.addfile(info, io.BytesIO(data))
+        script = HOOK.read_text().replace('root=/new_root', 'root=' + str(self.guest))
+        for before, after in [('tryomarchy-compat-version', 'version'), ('tryomarchy-compat-overlay.tar', 'overlay.tar'),
+                              ('tryomarchy-kernel-modules.tar', 'modules.tar')]:
+            script = script.replace('/' + before, str(self.root / after))
+        script = script.replace('kernel=$(uname -r)', 'kernel=' + kernel)
+        result = subprocess.run(['sh', '-c', script + '\nrun_latehook'], text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+
+    def delivered(self, tag):
+        return {'modules.dep.bin': f'dep {tag}', 'kernel/drivers/net/tun.ko': f'tun {tag}',
+                'updates/dkms/v4l2loopback.ko.zst': f'camera {tag}',
+                'updates/dkms/try_omarchy_battery.ko.zst': f'battery {tag}'}
+
+    def test_next_revision_puts_back_modules_an_update_removed(self):
+        old = 'old-kernel'
+        tree = self.guest / 'usr/lib/modules' / old
+        self.files(tree, self.delivered('image'))
+        self.files(tree, {'.tryomarchy-complete': f'69:{old}\n'})
+        self.files(self.guest, {'usr/share/try-omarchy/compat-version': f'69:{old}\n'})
+        # What the DKMS remove hook left behind after the headers upgrade.
+        for name in ('v4l2loopback.ko.zst', 'try_omarchy_battery.ko.zst'):
+            (tree / 'updates/dkms' / name).unlink()
+        (tree / 'modules.dep.bin').write_text('dep without dkms')
+        self.boot(old, f'69:{old}', self.delivered('image'))
+        self.assertFalse((tree / 'updates/dkms/v4l2loopback.ko.zst').exists())
+        self.boot(old, f'70:{old}', self.delivered('image'))
+        for name, value in self.delivered('image').items():
+            self.assertEqual((tree / name).read_text(), value)
+
+    def test_kernel_change_with_the_hold_in_place(self):
+        # The disk keeps linux and linux-headers for the image's kernel. A
+        # release that moves the launcher to a new kernel delivers that
+        # kernel's complete tree, DKMS modules included, without headers.
+        old, new = 'old-kernel', 'new-kernel'
+        old_tree = self.guest / 'usr/lib/modules' / old
+        self.files(old_tree, {**self.delivered('old'), 'build/include/linux/version.h': 'headers'})
+        self.boot(new, f'70:{new}', self.delivered('new'))
+        new_tree = self.guest / 'usr/lib/modules' / new
+        for name, value in self.delivered('new').items():
+            self.assertEqual((new_tree / name).read_text(), value)
+        self.assertFalse((new_tree / 'build').exists())
+        self.assertEqual((old_tree / 'build/include/linux/version.h').read_text(), 'headers')
+        self.assertEqual((old_tree / 'updates/dkms/v4l2loopback.ko.zst').read_text(), 'camera old')
+
+
+@unittest.skipUnless(ALPM, 'requires an Arch builder as root')
+class TransactionTests(unittest.TestCase):
+    """Real pacman -Syu runs with the image's and a caught-up disk's options."""
+
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.base = Path(self.tmp.name)
+        self.root = self.base / 'root'
+        for name in ('var/lib/pacman/local', 'var/lib/pacman/sync', 'var/cache/pacman/pkg', 'var/log', 'tmp'):
+            (self.root / name).mkdir(parents=True, exist_ok=True)
+        self.repo = self.base / 'arch'
+        self.repo.mkdir()
+
+    def package(self, name, version):
+        stage = self.base / f'{name}-{version}'
+        stage.mkdir()
+        (stage / '.PKGINFO').write_text(f'pkgname = {name}\npkgver = {version}\npkgdesc = fixture\narch = x86_64\nsize = 1\n')
+        archive = self.repo / f'{name}-{version}-x86_64.pkg.tar.gz'
+        with tarfile.open(archive, 'w:gz') as tar:
+            tar.add(stage / '.PKGINFO', arcname='.PKGINFO')
+        return archive
+
+    def pacman(self, config, *args):
+        result = subprocess.run(['pacman', '--noconfirm', '--config', str(config), '--root', str(self.root),
+                                 '--dbpath', str(self.root / 'var/lib/pacman'),
+                                 '--logfile', str(self.root / 'var/log/pacman.log'), *args],
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
+        return result.stdout
+
+    def upgrade_with(self, options):
+        config = self.base / 'pacman.conf'
+        config.write_text(f'''{options}CacheDir = {self.root}/var/cache/pacman/pkg
+SigLevel = Never
+LocalFileSigLevel = Never
+DisableSandbox
+[arch]
+Server = file://{self.repo}
+''')
+        names = ('linux', 'linux-headers', 'v4l2loopback-dkms')
+        self.pacman(config, '-U', '--noscriptlet', *(str(self.package(n, '1-1')) for n in names))
+        new = [self.package(n, '2-1') for n in names]
+        subprocess.run(['repo-add', '-q', str(self.repo / 'arch.db.tar.gz'), *map(str, new)], check=True, capture_output=True)
+        self.pacman(config, '-Syu')
+        return dict(line.split() for line in self.pacman(config, '-Q').splitlines())
+
+    def test_image_options_keep_kernel_and_headers_and_upgrade_the_rest(self):
+        conf = (GUEST / 'pacman-x86_64.conf').read_text()
+        options = ''.join(f'IgnorePkg = {name}\n' for name in ignored(conf))
+        installed = self.upgrade_with('[options]\nArchitecture = x86_64\n' + options)
+        self.assertEqual(installed, {'linux': '1-1', 'linux-headers': '1-1', 'v4l2loopback-dkms': '2-1'})
+
+    def test_caught_up_disk_keeps_kernel_and_headers(self):
+        config = self.base / 'old.conf'
+        config.write_text(OLD_OPTIONS.replace('Architecture = auto', 'Architecture = x86_64'))
+        subprocess.run([str(HOLD)], env={**os.environ, 'TRY_OMARCHY_PACMAN_CONF': str(config)}, check=True, capture_output=True)
+        installed = self.upgrade_with(config.read_text())
+        self.assertEqual(installed, {'linux': '1-1', 'linux-headers': '1-1', 'v4l2loopback-dkms': '2-1'})
+
+
+if __name__ == '__main__':
+    unittest.main()
