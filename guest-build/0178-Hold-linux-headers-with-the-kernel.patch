diff --git a/guest/tests/test_kernel_headers_hold.py b/guest/tests/test_kernel_headers_hold.py
new file mode 100644
index 0000000..bfa0c99
--- /dev/null
+++ b/guest/tests/test_kernel_headers_hold.py
@@ -0,0 +1,273 @@
+"""linux-headers stays with the kernel the launcher boots.
+
+Update > Omarchy used to move linux-headers past the held linux package, and
+the DKMS hooks then removed the camera and battery modules from the running
+kernel. These tests cover the image's hold, the catch-up step that adds it to
+existing disks, the module repair on the next revision, and a later kernel
+change with the hold in place. The pacman tests run real libalpm transactions
+on Arch builders and are skipped elsewhere.
+"""
+import io
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tarfile
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / 'factory-overlay'
+HOLD = OVERLAY / 'usr/local/lib/try-omarchy/hold-kernel-headers'
+CATCH_UP = OVERLAY / 'usr/local/lib/try-omarchy/catch-up'
+HOOK = OVERLAY / 'etc/initcpio/hooks/tryomarchy_compat'
+
+# /etc/pacman.conf's [options] as v0.14.0 and earlier images shipped it.
+OLD_OPTIONS = '''[options]
+Color
+HoldPkg = pacman glibc
+# QEMU direct-boots the immutable kernel and initramfs beside the guest disk.
+IgnorePkg = linux
+Architecture = auto
+'''
+REPOSITORIES = '''
+[omarchy]
+Server = https://pkgs.omarchy.org/stable/$arch
+
+[core]
+Include = /etc/pacman.d/mirrorlist
+'''
+
+ALPM = os.geteuid() == 0 and all(shutil.which(x) for x in ('pacman', 'repo-add'))
+if os.environ.get('REQUIRE_ALPM_TESTS') == '1' and not ALPM:
+    raise RuntimeError('required Arch transaction tools unavailable')
+
+
+def ignored(config):
+    """Package names pacman ignores, read the way pacman reads [options]."""
+    names, options = [], False
+    for line in config.splitlines():
+        line = line.strip()
+        if line.startswith('['):
+            options = line == '[options]'
+        elif options and line.split('=')[0].strip() == 'IgnorePkg':
+            names += line.split('=', 1)[1].split()
+    return names
+
+
+class HoldTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.config = self.root / 'pacman.conf'
+
+    def hold(self, text, mode=0o644):
+        self.config.write_text(text)
+        self.config.chmod(mode)
+        result = subprocess.run([str(HOLD)], env={**os.environ, 'TRY_OMARCHY_PACMAN_CONF': str(self.config)},
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        return result.stdout
+
+    def test_image_holds_headers_with_the_kernel(self):
+        config = (GUEST / 'pacman-x86_64.conf').read_text()
+        self.assertEqual(ignored(config), ['linux', 'linux-headers'])
+
+    def test_existing_disk_gets_the_hold_once(self):
+        output = self.hold(OLD_OPTIONS + REPOSITORIES, 0o640)
+        text = self.config.read_text()
+        self.assertIn('held linux-headers', output)
+        self.assertEqual(ignored(text), ['linux', 'linux-headers'])
+        self.assertEqual(text, (OLD_OPTIONS + REPOSITORIES).replace('IgnorePkg = linux\n', 'IgnorePkg = linux linux-headers\n'))
+        self.assertEqual(self.config.stat().st_mode & 0o777, 0o640)
+        self.assertEqual(self.hold(text, 0o640), '')
+        self.assertEqual(self.config.read_text(), text)
+
+    def test_keeps_other_held_packages(self):
+        self.hold(OLD_OPTIONS.replace('IgnorePkg = linux\n', 'IgnorePkg = firefox\nIgnorePkg = linux  mesa \n') + REPOSITORIES)
+        self.assertEqual(ignored(self.config.read_text()), ['firefox', 'linux', 'mesa', 'linux-headers'])
+
+    def test_leaves_a_configuration_that_already_holds_headers(self):
+        text = OLD_OPTIONS.replace('IgnorePkg = linux\n', 'IgnorePkg = linux\nIgnorePkg=linux-headers\n') + REPOSITORIES
+        self.assertEqual(self.hold(text), '')
+        self.assertEqual(self.config.read_text(), text)
+
+    def test_leaves_a_configuration_without_the_kernel_hold(self):
+        for text in [OLD_OPTIONS.replace('IgnorePkg = linux\n', '') + REPOSITORIES,
+                     OLD_OPTIONS.replace('IgnorePkg = linux\n', 'IgnorePkg = linux-lts\n#IgnorePkg = linux\n') + REPOSITORIES,
+                     OLD_OPTIONS.replace('IgnorePkg = linux\n', '') + REPOSITORIES + 'IgnorePkg = linux\n']:
+            self.assertIn('does not hold the linux package', self.hold(text))
+            self.assertEqual(self.config.read_text(), text)
+
+    def test_catch_up_runs_the_hold_below_revision_70(self):
+        state = self.root / 'state'
+        version = self.root / 'compat-version'
+        version.write_text('70:7.2.14-arch1-1\n')
+        homes = self.root / 'home'
+        homes.mkdir()
+        log = self.root / 'held'
+        hold = self.root / 'hold'
+        hold.write_text(f'#!/bin/sh\necho run >> {log}\n')
+        hold.chmod(0o755)
+        env = {**os.environ, 'TRY_OMARCHY_COMPAT_VERSION': str(version), 'TRY_OMARCHY_STATE_DIR': str(state),
+               'TRY_OMARCHY_HOMES': str(homes), 'TRY_OMARCHY_HEADERS_HOLD': str(hold)}
+        for name in ('QOL', 'BATTERY', 'NIGHTLIGHT', 'NOTIFICATIONS', 'PALETTE'):
+            env[f'TRY_OMARCHY_{name}_INSTALLER'] = '/nonexistent'
+        env['TRY_OMARCHY_SSHD_CONFIG_DIR'] = str(self.root / 'sshd')
+        env['TRY_OMARCHY_TERMINAL_SHIM'] = str(self.root / 'shim')
+        runs = []
+        for previous in ['', '67', '69', '70']:
+            state.mkdir(exist_ok=True)
+            marker = state / 'catch-up-revision'
+            marker.unlink(missing_ok=True)
+            if previous:
+                marker.write_text(previous + '\n')
+            log.unlink(missing_ok=True)
+            result = subprocess.run(['bash', str(CATCH_UP)], env=env, text=True, capture_output=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            runs.append(log.exists())
+        self.assertEqual(runs, [True, True, True, False])
+
+    def test_revision_70_delivers_the_hold(self):
+        finalize = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        paths = finalize.split('compat_paths=(', 1)[1].split(')', 1)[0].split()
+        self.assertIn('usr/local/lib/try-omarchy/hold-kernel-headers', paths)
+        self.assertIn('compat_revision=70', finalize)
+        self.assertTrue(os.access(HOLD, os.X_OK))
