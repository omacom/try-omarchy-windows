From 75dd60995057d5fd4f382f108a320d4d1c4dea63 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Wed, 2 Sep 2026 21:00:26 -0400
Subject: [PATCH] Use a stable PipeWire quantum for QEMU HDA

---
 .../90-try-omarchy-quantum.conf               | 22 +++++++++++++++++++
 guest/tests/verify.py                         | 12 ++++++++++
 2 files changed, 34 insertions(+)
 create mode 100644 guest/native-overlay/usr/share/pipewire/pipewire.conf.d/90-try-omarchy-quantum.conf

diff --git a/guest/native-overlay/usr/share/pipewire/pipewire.conf.d/90-try-omarchy-quantum.conf b/guest/native-overlay/usr/share/pipewire/pipewire.conf.d/90-try-omarchy-quantum.conf
new file mode 100644
index 0000000..11ac2fd
--- /dev/null
+++ b/guest/native-overlay/usr/share/pipewire/pipewire.conf.d/90-try-omarchy-quantum.conf
@@ -0,0 +1,22 @@
+# Try Omarchy: raise the graph quantum for QEMU's emulated HDA device.
+#
+# QEMU advances the emulated Intel HDA DMA position from its audio timer in
+# coarse steps. A 4096-frame quantum prevents PipeWire from treating those
+# jumps as underruns while the guest ring still contains plenty of audio.
+context.properties = {
+    default.clock.quantum     = 4096
+    default.clock.min-quantum = 4096
+    default.clock.max-quantum = 4096
+}
+
+# PipeWire's stock VM rule is evaluated after context.properties and lowers
+# min-quantum again. A later VM rule keeps the requested value in effect.
+context.properties.rules = [
+    {   matches = [ { cpu.vm.name = !null } ]
+        actions = {
+            update-props = {
+                default.clock.min-quantum = 4096
+            }
+        }
+    }
+]
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index 538c339..a232472 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -84,6 +84,18 @@ def main() -> None:
     )
     check("cmp -s" not in configure, "rootfs configuration uses only declared build tools")
 
+    audio_quantum = read(
+        GUEST
+        / "native-overlay/usr/share/pipewire/pipewire.conf.d/90-try-omarchy-quantum.conf"
+    )
+    check(
+        "default.clock.quantum     = 4096" in audio_quantum
+        and "default.clock.min-quantum = 4096" in audio_quantum
+        and "default.clock.max-quantum = 4096" in audio_quantum
+        and "cpu.vm.name = !null" in audio_quantum,
+        "guest audio quantum tolerates QEMU HDA position updates",
+    )
+
     provision_dispatch = read(
         GUEST / "factory-overlay/usr/local/lib/try-omarchy/provision-owner"
     )
-- 
2.55.0

