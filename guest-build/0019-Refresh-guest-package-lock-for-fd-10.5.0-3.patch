diff --git a/guest/packages.lock.json b/guest/packages.lock.json
index 9e3c425..b4b9ae1 100644
--- a/guest/packages.lock.json
+++ b/guest/packages.lock.json
@@ -69,7 +69,7 @@
     "fakeroot": "1:1.37.2-3",
     "fastfetch": "2.68.1-1",
     "fcft": "3.3.3-1",
-    "fd": "10.5.0-2",
+    "fd": "10.5.0-3",
     "ffmpeg": "2:9.0.1-4",
     "fftw": "3.3.11-1",
     "file": "5.48-1",
