+Description=Remove an orphaned pacman database lock from an interrupted update
+DefaultDependencies=no
+After=local-fs.target
+Before=sysinit.target systemd-tmpfiles-setup.service try-omarchy-update-repository.service
+ConditionPathExists=/var/lib/pacman/db.lck
+
+[Service]
+Type=oneshot
+ExecStart=/usr/local/lib/try-omarchy/clear-stale-pacman-lock
+RemainAfterExit=yes
+
+[Install]
+WantedBy=sysinit.target
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/clear-stale-pacman-lock b/guest/factory-overlay/usr/local/lib/try-omarchy/clear-stale-pacman-lock
new file mode 100755
index 0000000..5785b9c
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/clear-stale-pacman-lock
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Remove an orphaned pacman database lock left by an interrupted update.
+
+pacman records an in-progress transaction with /var/lib/pacman/db.lck and
+removes it on exit. A crash, reboot or killed terminal during an update can
+leave the file behind, and every later update then fails with "unable to lock
+database" until it is removed by hand (see try-omarchy-windows issue #90).
+
+This runs once at early boot. It removes the lock only when all of the
+following hold, which together prove the lock cannot belong to a live
+transaction:
+
+  * it is a regular file, not a symlink or directory
+  * no pacman (or alpm) process is running
+  * no process has the lock file open
+  * the file predates this boot, so no process in this boot created it
+
+Anything ambiguous is left untouched and the reason is written to the journal.
+This never runs pacman itself and never repairs the database.
+"""
+import os
+import stat
+
+LOCK = "/var/lib/pacman/db.lck"
+PROC = "/proc"
+PROC_STAT = "/proc/stat"
+PACMAN_NAMES = ("pacman", "alpm")
+
+
+def boot_time(proc_stat=PROC_STAT):
+    """Wall-clock time this boot started, from /proc/stat btime."""
+    try:
+        with open(proc_stat, encoding="utf-8") as handle:
+            for line in handle:
+                if line.startswith("btime "):
+                    return int(line.split()[1])
+    except (OSError, ValueError, IndexError):
+        return None
+    return None
+
+
+def _processes(proc):
+    for name in os.listdir(proc):
+        if name.isdigit():
+            yield name, os.path.join(proc, name)
+
+
+def running_pacman(proc=PROC):
+    """Name of a running pacman/alpm process, or None."""
+    for _, path in _processes(proc):
+        try:
+            with open(os.path.join(path, "comm"), encoding="utf-8") as handle:
+                name = handle.read().strip()
+        except OSError:
+            continue
+        if name in PACMAN_NAMES:
+            return name
+    return None
+
+
+def lock_holder(lock, proc=PROC):
+    """PID with the lock file open, or None."""
+    for pid, path in _processes(proc):
+        fd_dir = os.path.join(path, "fd")
+        try:
+            fds = os.listdir(fd_dir)
+        except OSError:
+            continue
+        for fd in fds:
+            try:
+                if os.readlink(os.path.join(fd_dir, fd)) == lock:
+                    return pid
+            except OSError:
+                continue
+    return None
+
+
+def evaluate(lock, proc=PROC, now_boot_time=None):
+    """Return (remove, reason) for the given lock path."""
+    if os.path.islink(lock):
+        return False, "lock is a symbolic link"
+    try:
+        info = os.stat(lock, follow_symlinks=False)
+    except FileNotFoundError:
+        return False, "no lock present"
+    except OSError as error:
+        return False, f"cannot inspect lock: {error}"
+    if not stat.S_ISREG(info.st_mode):
+        return False, "lock is not a regular file"
+    name = running_pacman(proc)
+    if name:
+        return False, f"{name} is running"
+    holder = lock_holder(lock, proc)
+    if holder:
+        return False, f"pid {holder} holds the lock open"
+    if now_boot_time is None:
+        return False, "boot time is unknown"
+    if info.st_mtime >= now_boot_time:
+        return False, "lock was created after this boot"
+    return True, "lock predates this boot and no pacman process owns it"
+
+
+def clear(lock=LOCK, proc=PROC, now_boot_time=None):
+    """Remove the lock when evaluate proves it stale; report in the journal."""
+    remove, reason = evaluate(lock, proc, now_boot_time)
+    if not remove:
+        print(f"try-omarchy: leaving pacman lock {lock}: {reason}", flush=True)
+        return False
+    # Re-check the live conditions immediately before unlinking. A pacman that
+    # started meanwhile cannot have created this file (it refuses to start while
+    # the lock exists), so the file being removed is still the stale one.
+    if running_pacman(proc) or lock_holder(lock, proc):
+        print(f"try-omarchy: pacman became active; keeping {lock}", flush=True)
+        return False
+    os.unlink(lock)
+    print(f"try-omarchy: removed stale pacman lock {lock} ({reason})", flush=True)
+    return True
+
+
+if __name__ == "__main__":
+    clear(LOCK, PROC, boot_time())
