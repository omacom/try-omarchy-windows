diff --git a/guest/tests/test_pacman_lock_recovery.py b/guest/tests/test_pacman_lock_recovery.py
new file mode 100644
index 0000000..e234e5c
--- /dev/null
+++ b/guest/tests/test_pacman_lock_recovery.py
@@ -0,0 +1,116 @@
+"""Behavioral tests for the early-boot stale pacman lock recovery.
+
+Run unprivileged against a fake /proc and a temp lock file. They pin the exact
+conditions under which the guest is allowed to remove an orphaned
+/var/lib/pacman/db.lck and, more importantly, every case where it must not.
+"""
+
+import importlib.machinery
+import importlib.util
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+SCRIPT = (
+    Path(__file__).resolve().parents[1]
+    / "factory-overlay/usr/local/lib/try-omarchy/clear-stale-pacman-lock"
+)
+loader = importlib.machinery.SourceFileLoader("pacman_lock", str(SCRIPT))
+spec = importlib.util.spec_from_loader(loader.name, loader)
+module = importlib.util.module_from_spec(spec)
+loader.exec_module(module)
+
+BOOT = 1_700_000_000.0
+BEFORE_BOOT = BOOT - 3600
+AFTER_BOOT = BOOT + 60
+
+
+class PacmanLockTests(unittest.TestCase):
+    def setUp(self):
+        self.root = Path(tempfile.mkdtemp())
+        self.addCleanup(lambda: __import__("shutil").rmtree(self.root, ignore_errors=True))
+        self.proc = self.root / "proc"
+        self.proc.mkdir()
+        self.lock = self.root / "db.lck"
+
+    def make_lock(self, mtime=BEFORE_BOOT):
+        self.lock.write_text("")
+        os.utime(self.lock, (mtime, mtime))
+
+    def process(self, pid, comm="bash", opens=()):
+        directory = self.proc / str(pid)
+        directory.mkdir()
+        (directory / "comm").write_text(f"{comm}\n")
+        if opens:
+            fd_dir = directory / "fd"
+            fd_dir.mkdir()
+            for index, target in enumerate(opens):
+                os.symlink(target, fd_dir / str(index))
+
+    def test_removes_lock_that_predates_boot(self):
+        self.make_lock()
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), BOOT)
+        self.assertTrue(remove, reason)
+        self.assertTrue(module.clear(str(self.lock), str(self.proc), BOOT))
+        self.assertFalse(self.lock.exists())
+
+    def test_keeps_lock_created_after_boot(self):
+        self.make_lock(mtime=AFTER_BOOT)
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), BOOT)
+        self.assertFalse(remove)
+        self.assertIn("after this boot", reason)
+        self.assertFalse(module.clear(str(self.lock), str(self.proc), BOOT))
+        self.assertTrue(self.lock.exists())
+
+    def test_keeps_lock_while_pacman_runs(self):
+        self.make_lock()
+        self.process(4242, comm="pacman")
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), BOOT)
+        self.assertFalse(remove)
+        self.assertIn("pacman", reason)
+        module.clear(str(self.lock), str(self.proc), BOOT)
+        self.assertTrue(self.lock.exists())
+
+    def test_keeps_lock_held_open_by_a_process(self):
+        self.make_lock()
+        self.process(7, comm="sh", opens=(str(self.lock),))
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), BOOT)
+        self.assertFalse(remove)
+        self.assertIn("holds the lock open", reason)
+        self.assertFalse(module.clear(str(self.lock), str(self.proc), BOOT))
+        self.assertTrue(self.lock.exists())
+
+    def test_keeps_symlink_in_place_of_lock(self):
+        target = self.root / "elsewhere"
+        target.write_text("")
+        self.lock.symlink_to(target)
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), BOOT)
+        self.assertFalse(remove)
+        self.assertIn("symbolic link", reason)
+        self.assertFalse(module.clear(str(self.lock), str(self.proc), BOOT))
+        self.assertTrue(self.lock.is_symlink())
+
+    def test_missing_lock_is_not_an_error(self):
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), BOOT)
+        self.assertFalse(remove)
+        self.assertIn("no lock", reason)
+        self.assertFalse(module.clear(str(self.lock), str(self.proc), BOOT))
+
+    def test_unknown_boot_time_keeps_lock(self):
+        self.make_lock()
+        remove, reason = module.evaluate(str(self.lock), str(self.proc), None)
+        self.assertFalse(remove)
+        self.assertIn("boot time", reason)
+        self.assertFalse(module.clear(str(self.lock), str(self.proc), None))
+        self.assertTrue(self.lock.exists())
+
+    def test_boot_time_reads_btime(self):
+        stat_file = self.root / "stat"
+        stat_file.write_text("cpu  0 0 0\nbtime 1700000000\nprocesses 9\n")
+        self.assertEqual(module.boot_time(str(stat_file)), 1_700_000_000)
+        self.assertIsNone(module.boot_time(str(self.root / "absent")))
+
+
+if __name__ == "__main__":
+    unittest.main()
