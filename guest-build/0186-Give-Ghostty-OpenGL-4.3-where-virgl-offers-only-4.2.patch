diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty b/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty
new file mode 100755
index 0000000..5a1e948
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty
@@ -0,0 +1,22 @@
+#!/bin/bash
+# /usr/local/bin/ghostty links here while Ghostty is installed, so every way
+# of starting it (Super+Return through xdg-terminal-exec, the screensaver,
+# typing ghostty, the D-Bus service's ExecStart) picks up the OpenGL 4.3
+# override on hosts whose renderer offers only 4.2. See ghostty-gl.
+# A MESA_GL_VERSION_OVERRIDE that is already set wins.
+helper=${TRY_OMARCHY_GHOSTTY_GL:-/usr/local/lib/try-omarchy/ghostty-gl}
+ghostty_bin=${TRY_OMARCHY_GHOSTTY_BIN:-/usr/bin/ghostty}
+
+if [[ -z ${MESA_GL_VERSION_OVERRIDE+set} ]] && env_file=$("$helper" env 2>/dev/null); then
+  while IFS= read -r line; do
+    if [[ $line =~ ^(MESA_GL_VERSION_OVERRIDE|MESA_GLSL_VERSION_OVERRIDE)=([0-9.]+)$ ]]; then
+      export "${BASH_REMATCH[1]}=${BASH_REMATCH[2]}"
+    fi
+  done <"$env_file"
+fi
+
+if [[ ! -x $ghostty_bin ]]; then
+  echo "ghostty: $ghostty_bin is not installed" >&2
+  exit 127
+fi
+exec "$ghostty_bin" "$@"
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty-gl b/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty-gl
new file mode 100755
index 0000000..754e021
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty-gl
@@ -0,0 +1,102 @@
+#!/bin/bash
+# Ghostty needs an OpenGL 4.3 core context. On some hosts (Intel graphics,
+# #383) virgl offers only 4.2 although Ghostty draws fine there once Mesa is
+# told to report 4.3. Only Ghostty gets that override, and only when the
+# renderer really stops at 4.2: other apps keep the real version, and hosts
+# that offer 4.3 or more, or CPU rendering, are left alone.
+#
+#   ghostty-gl env    decide once per login from what the renderer offers,
+#                     write $XDG_RUNTIME_DIR/try-omarchy/ghostty-gl.env and
+#                     print its path. The file holds the two Mesa variables
+#                     when they are needed and only comments otherwise. The
+#                     runtime directory is cleared at logout and boot, so a
+#                     new host GPU or render mode is probed again. A probe
+#                     that fails or times out saves nothing and exits 1, so
+#                     the next Ghostty start probes again; starts that race
+#                     share one probe, and for a few seconds after a failure
+#                     they do not probe again.
+#   ghostty-gl link   (root) link /usr/local/bin/ghostty to the wrapper that
+#                     applies the file while Ghostty is installed, and remove
+#                     that link when it is not. Anything else at that path is
+#                     left alone. The pacman hook and catch-up run this.
+set -u
+
+cmdline=${TRY_OMARCHY_CMDLINE:-/proc/cmdline}
+probe=${TRY_OMARCHY_GHOSTTY_GL_PROBE:-/usr/local/lib/try-omarchy/ghostty-gl-probe}
+ghostty_bin=${TRY_OMARCHY_GHOSTTY_BIN:-/usr/bin/ghostty}
+ghostty_link=${TRY_OMARCHY_GHOSTTY_LINK:-/usr/local/bin/ghostty}
+wrapper=${TRY_OMARCHY_GHOSTTY_WRAPPER:-/usr/local/lib/try-omarchy/ghostty}
+retry_after=${TRY_OMARCHY_GHOSTTY_GL_RETRY:-10}
+
+decide() {
+  if [[ " $(cat "$cmdline" 2>/dev/null) " == *" tryomarchy.render=cpu "* ]]; then
+    echo "# CPU rendering offers OpenGL 4.3 or later; no override"
+    return 0
+  fi
+  local version
+  if ! version=$(timeout 5 "$probe" 2>/dev/null) || [[ ! $version =~ ^[0-9]+\.[0-9]+$ ]]; then
+    return 1
+  fi
+  if [[ $version == 4.2 ]]; then
+    echo "# The renderer offers OpenGL $version core; Ghostty needs 4.3"
+    echo "MESA_GL_VERSION_OVERRIDE=4.3"
+    echo "MESA_GLSL_VERSION_OVERRIDE=430"
+  else
+    echo "# The renderer offers OpenGL $version core; no override"
+  fi
+}
+
+env_file() {
+  local runtime=${XDG_RUNTIME_DIR:-}
+  [[ -n $runtime && -d $runtime && -O $runtime ]] || return 1
+  local dir=$runtime/try-omarchy file failed tmp lock
+  file=$dir/ghostty-gl.env
+  failed=$dir/ghostty-gl.failed
+  if [[ ! -f $file ]]; then
+    mkdir -p -m 0700 "$dir" || return 1
+    # One probe at a time; a start that waited finds the answer saved.
+    exec {lock}>"$dir/ghostty-gl.lock" || return 1
+    flock -w 15 "$lock" || return 1
+    if [[ ! -f $file ]]; then
+      if [[ -f $failed ]] && (( $(date +%s) - $(stat -c %Y "$failed") < retry_after )); then
+        return 1
+      fi
+      tmp=$(mktemp "$file.XXXXXX") || return 1
+      if ! decide >"$tmp"; then
+        rm -f -- "$tmp"
+        touch -- "$failed"
+        echo "ghostty-gl: the OpenGL probe failed; trying again at the next start" >&2
+        return 1
+      fi
+      mv -f -- "$tmp" "$file" || { rm -f -- "$tmp"; return 1; }
+      rm -f -- "$failed"
+    fi
+  fi
+  printf '%s\n' "$file"
+}
+
+ours() {
+  [[ -L $ghostty_link && $(readlink -- "$ghostty_link") == "$wrapper" ]]
+}
+
+link() {
+  if [[ -x $ghostty_bin ]]; then
+    ours && return 0
+    [[ -e $ghostty_link || -L $ghostty_link ]] && return 0
+    mkdir -p -- "$(dirname -- "$ghostty_link")"
+    ln -s -- "$wrapper" "$ghostty_link"
+    echo "linked $ghostty_link so Ghostty gets the OpenGL 4.3 override where the renderer offers only 4.2"
+  elif ours; then
+    rm -f -- "$ghostty_link"
+    echo "removed the $ghostty_link link since Ghostty is not installed"
+  fi
+}
+
+case ${1:-} in
+  env) env_file ;;
+  link) link ;;
+  *)
+    echo "Usage: ghostty-gl env|link" >&2
+    exit 2
+    ;;
+esac
diff --git a/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty-gl-probe b/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty-gl-probe
new file mode 100755
index 0000000..d230dc9
--- /dev/null
+++ b/guest/factory-overlay/usr/local/lib/try-omarchy/ghostty-gl-probe
@@ -0,0 +1,76 @@
+#!/usr/bin/python3 -I
+"""Print the highest OpenGL core profile version the guest renderer offers.
+
+Ghostty asks EGL for an OpenGL 4.3 core context. This makes the same kind of
+request on a surfaceless display, from 4.6 down, and prints the first version
+that succeeds, such as "4.2". It exits 1 when EGL or every request fails.
+"""
+import ctypes
+import sys
+
+EGL_NONE = 0x3038
+EGL_EXTENSIONS = 0x3055
+EGL_OPENGL_API = 0x30A2
+EGL_PLATFORM_SURFACELESS_MESA = 0x31DD
+EGL_CONTEXT_MAJOR_VERSION = 0x3098
+EGL_CONTEXT_MINOR_VERSION = 0x30FB
+EGL_CONTEXT_OPENGL_PROFILE_MASK = 0x30FD
+EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT = 0x1
+
+VERSIONS = [(4, 6), (4, 5), (4, 4), (4, 3), (4, 2), (4, 1), (4, 0), (3, 3)]
+
+
+def highest_core_version():
+    egl = ctypes.CDLL("libEGL.so.1")
+    egl.eglQueryString.restype = ctypes.c_char_p
+    egl.eglQueryString.argtypes = [ctypes.c_void_p, ctypes.c_int]
+    egl.eglGetPlatformDisplay.restype = ctypes.c_void_p
+    egl.eglGetPlatformDisplay.argtypes = [ctypes.c_uint, ctypes.c_void_p, ctypes.c_void_p]
+    egl.eglInitialize.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p]
+    egl.eglBindAPI.argtypes = [ctypes.c_uint]
+    egl.eglCreateContext.restype = ctypes.c_void_p
+    egl.eglCreateContext.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_void_p, ctypes.POINTER(ctypes.c_int)]
+    egl.eglDestroyContext.argtypes = [ctypes.c_void_p, ctypes.c_void_p]
+    egl.eglTerminate.argtypes = [ctypes.c_void_p]
+
+    client = (egl.eglQueryString(None, EGL_EXTENSIONS) or b"").split()
+    if b"EGL_MESA_platform_surfaceless" not in client:
+        return None
+    display = egl.eglGetPlatformDisplay(EGL_PLATFORM_SURFACELESS_MESA, None, None)
+    if not display or not egl.eglInitialize(display, None, None):
+        return None
+    try:
+        extensions = (egl.eglQueryString(display, EGL_EXTENSIONS) or b"").split()
+        if b"EGL_KHR_no_config_context" not in extensions and b"EGL_MESA_configless_context" not in extensions:
+            return None
+        if not egl.eglBindAPI(EGL_OPENGL_API):
+            return None
+        for major, minor in VERSIONS:
+            attributes = (ctypes.c_int * 7)(
+                EGL_CONTEXT_MAJOR_VERSION, major,
+                EGL_CONTEXT_MINOR_VERSION, minor,
+                EGL_CONTEXT_OPENGL_PROFILE_MASK, EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT,
+                EGL_NONE,
+            )
+            context = egl.eglCreateContext(display, None, None, attributes)
+            if context:
+                egl.eglDestroyContext(display, context)
+                return f"{major}.{minor}"
+        return None
+    finally:
+        egl.eglTerminate(display)
+
+
+def main():
+    try:
+        version = highest_core_version()
+    except (OSError, AttributeError):
+        version = None
+    if version is None:
+        return 1
+    print(version)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
