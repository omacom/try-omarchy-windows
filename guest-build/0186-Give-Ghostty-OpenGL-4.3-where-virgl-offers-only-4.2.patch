diff --git a/guest/tests/test_ghostty_gl.py b/guest/tests/test_ghostty_gl.py
new file mode 100644
index 0000000..659d725
--- /dev/null
+++ b/guest/tests/test_ghostty_gl.py
@@ -0,0 +1,333 @@
+import configparser
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+OVERLAY = GUEST / 'factory-overlay'
+LIB = OVERLAY / 'usr/local/lib/try-omarchy'
+HELPER = LIB / 'ghostty-gl'
+WRAPPER = LIB / 'ghostty'
+PROBE = LIB / 'ghostty-gl-probe'
+DROP_IN = OVERLAY / 'etc/systemd/user/app-com.mitchellh.ghostty.service.d/10-try-omarchy-gl.conf'
+PROBE_UNIT = OVERLAY / 'usr/lib/systemd/user/try-omarchy-ghostty-gl.service'
+HOOK = OVERLAY / 'etc/pacman.d/hooks/try-omarchy-ghostty-gl.hook'
+CATCH_UP = LIB / 'catch-up'
+# The unit, D-Bus service and desktop entry from Arch's ghostty 1.4.0-1
+# (sha256 84774165c8fd9214d2eae42bdb730d6f9f850e87e5e70869f73795552c2da31c),
+# which installs them as usr/lib/systemd/user/app-com.mitchellh.ghostty.service,
+# usr/share/dbus-1/services/com.mitchellh.ghostty.service and
+# usr/share/applications/com.mitchellh.ghostty.desktop next to usr/bin/ghostty.
+ARCH = GUEST / 'tests/fixtures/ghostty-1.4.0-1'
+
+GPU = 'root=/dev/vda omarchy.qemu=1 tryomarchy.render=gpu quiet\n'
+CPU = 'root=/dev/vda omarchy.qemu=1 tryomarchy.render=cpu quiet\n'
+OVERRIDE = {'MESA_GL_VERSION_OVERRIDE': '4.3', 'MESA_GLSL_VERSION_OVERRIDE': '430'}
+
+
+def unit(text):
+    parser = configparser.ConfigParser(strict=False, interpolation=None)
+    parser.optionxform = str
+    parser.read_string(text)
+    return parser
+
+
+class GhosttyGlTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.runtime = self.root / 'run-user'
+        self.runtime.mkdir(mode=0o700)
+        self.cmdline = self.root / 'cmdline'
+        self.cmdline.write_text(GPU)
+        self.probe_log = self.root / 'probed'
+        self.probe = self.root / 'probe'
+        self.ghostty = self.root / 'usr/bin/ghostty'
+        self.link = self.root / 'usr/local/bin/ghostty'
+
+    def fake_probe(self, body):
+        self.probe.write_text(f'#!/bin/sh\necho run >> {self.probe_log}\n{body}\n')
+        self.probe.chmod(0o755)
+
+    def fake_ghostty(self):
+        # Prints the two variables as Ghostty's process would see them.
+        self.ghostty.parent.mkdir(parents=True, exist_ok=True)
+        self.ghostty.write_text('#!/bin/sh\necho "GL=${MESA_GL_VERSION_OVERRIDE-unset} '
+                                'GLSL=${MESA_GLSL_VERSION_OVERRIDE-unset} ARGS=$*"\n')
+        self.ghostty.chmod(0o755)
+
+    def env(self, **extra):
+        env = {key: value for key, value in os.environ.items() if not key.startswith('MESA_')}
+        env.update({'XDG_RUNTIME_DIR': str(self.runtime), 'TRY_OMARCHY_CMDLINE': str(self.cmdline),
+                    'TRY_OMARCHY_GHOSTTY_GL_PROBE': str(self.probe), 'TRY_OMARCHY_GHOSTTY_GL': str(HELPER),
+                    'TRY_OMARCHY_GHOSTTY_BIN': str(self.ghostty), 'TRY_OMARCHY_GHOSTTY_LINK': str(self.link),
+                    'TRY_OMARCHY_GHOSTTY_WRAPPER': str(WRAPPER)})
+        env.update(extra)
+        return env
+
+    def helper(self, *args, **extra):
+        return subprocess.run(['bash', str(HELPER), *args], env=self.env(**extra), text=True, capture_output=True)
+
+    def decision(self):
+        """The variables the env file sets, as systemd's EnvironmentFile reads it."""
+        result = self.helper('env')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        path = Path(result.stdout.strip())
+        self.assertEqual(path, self.runtime / 'try-omarchy/ghostty-gl.env')
+        values = {}
+        for line in path.read_text().splitlines():
+            if line and not line.startswith('#'):
+                key, value = line.split('=', 1)
+                values[key] = value
+        return values
+
+    def test_only_a_renderer_that_stops_at_4_2_gets_the_override(self):
+        cases = [
+            ('echo 4.2', OVERRIDE, 'virgl on the Intel host in #383'),
+            ('echo 4.3', {}, 'virgl on an AMD host'),
+            ('echo 4.6', {}, 'a host that offers more'),
+            ('echo 4.1', {}, 'too far below 4.3 to claim it'),
+        ]
+        for body, expected, why in cases:
+            with self.subTest(why):
+                (self.runtime / 'try-omarchy/ghostty-gl.env').unlink(missing_ok=True)
+                self.fake_probe(body)
+                self.assertEqual(self.decision(), expected)
+
+    def test_a_failed_probe_is_not_saved(self):
+        env_file = self.runtime / 'try-omarchy/ghostty-gl.env'
+        for body in ('exit 1', 'echo nonsense', 'sleep 30'):
+            with self.subTest(body):
+                self.fake_probe(body)
+                result = self.helper('env', TRY_OMARCHY_GHOSTTY_GL_RETRY='0')
+                self.assertNotEqual(result.returncode, 0)
+                self.assertEqual(result.stdout, '')
+                self.assertFalse(env_file.exists())
+
+    def test_failure_then_success_gives_the_override_on_the_next_start(self):
+        self.fake_ghostty()
+        self.fake_probe('exit 1')
+        self.assertEqual(self.wrapper(TRY_OMARCHY_GHOSTTY_GL_RETRY='0').stdout, 'GL=unset GLSL=unset ARGS=\n')
+        self.fake_probe('echo 4.2')
+        self.assertEqual(self.wrapper(TRY_OMARCHY_GHOSTTY_GL_RETRY='0').stdout, 'GL=4.3 GLSL=430 ARGS=\n')
+        self.assertEqual(self.probe_log.read_text(), 'run\nrun\n')
+        self.assertFalse((self.runtime / 'try-omarchy/ghostty-gl.failed').exists())
+
+    def test_starts_right_after_a_failure_do_not_probe_again(self):
+        self.fake_probe('exit 1')
+        self.assertNotEqual(self.helper('env').returncode, 0)
+        self.fake_probe('echo 4.2')
+        self.assertNotEqual(self.helper('env').returncode, 0)
+        self.assertEqual(self.probe_log.read_text(), 'run\n')
+        # Once the retry delay has passed, the next start probes again.
+        failed = self.runtime / 'try-omarchy/ghostty-gl.failed'
+        os.utime(failed, (failed.stat().st_mtime - 60,) * 2)
+        self.assertEqual(self.decision(), OVERRIDE)
+
+    def concurrent(self, count):
+        env = self.env()
+        processes = [subprocess.Popen(['bash', str(HELPER), 'env'], env=env, text=True,
+                                      stdout=subprocess.PIPE, stderr=subprocess.PIPE) for _ in range(count)]
+        return [(process.wait(timeout=30), process.stdout.read().strip()) for process in processes]
+
+    def test_concurrent_starts_share_one_probe(self):
+        self.fake_probe('sleep 1; echo 4.2')
+        results = self.concurrent(6)
+        env_file = str(self.runtime / 'try-omarchy/ghostty-gl.env')
+        self.assertEqual(results, [(0, env_file)] * 6)
+        self.assertEqual(self.probe_log.read_text(), 'run\n')
+        self.assertEqual(self.decision(), OVERRIDE)
+
+    def test_concurrent_starts_after_a_failure_share_one_probe(self):
+        self.fake_probe('sleep 1; exit 1')
+        results = self.concurrent(6)
+        self.assertEqual([code for code, _ in results], [1] * 6)
+        self.assertEqual(self.probe_log.read_text(), 'run\n')
+
+    def test_cpu_rendering_is_left_alone_without_probing(self):
+        self.cmdline.write_text(CPU)
+        self.fake_probe('echo 4.2')
+        self.assertEqual(self.decision(), {})
+        self.assertFalse(self.probe_log.exists())
+
+    def test_the_decision_is_made_once_per_login(self):
+        self.fake_probe('echo 4.2')
+        self.assertEqual(self.decision(), OVERRIDE)
+        self.fake_probe('echo 4.6')
+        self.assertEqual(self.decision(), OVERRIDE)
+        self.assertEqual(self.probe_log.read_text(), 'run\n')
+        # A new login (or boot) starts with an empty runtime directory.
+        (self.runtime / 'try-omarchy/ghostty-gl.env').unlink()
+        self.assertEqual(self.decision(), {})
+
+    def test_no_runtime_directory_means_no_file(self):
+        self.fake_probe('echo 4.2')
+        result = self.helper('env', XDG_RUNTIME_DIR=str(self.root / 'missing'))
+        self.assertNotEqual(result.returncode, 0)
+        self.assertEqual(result.stdout, '')
+
+    def wrapper(self, *args, **extra):
+        return subprocess.run(['bash', str(WRAPPER), *args], env=self.env(**extra), text=True, capture_output=True)
+
+    def test_the_wrapper_passes_the_decision_to_ghostty(self):
+        self.fake_ghostty()
+        self.fake_probe('echo 4.2')
+        result = self.wrapper('--gtk-single-instance=true', '-e', 'echo hi')
+        self.assertEqual(result.stdout, 'GL=4.3 GLSL=430 ARGS=--gtk-single-instance=true -e echo hi\n')
+        (self.runtime / 'try-omarchy/ghostty-gl.env').unlink()
+        self.fake_probe('echo 4.3')
+        self.assertEqual(self.wrapper('+new-window').stdout, 'GL=unset GLSL=unset ARGS=+new-window\n')
+
+    def test_the_wrapper_keeps_an_override_already_set(self):
+        # The service's EnvironmentFile, or the user's own choice, already set it.
+        self.fake_ghostty()
+        self.fake_probe('echo 4.2')
+        result = self.wrapper(MESA_GL_VERSION_OVERRIDE='4.6')
+        self.assertEqual(result.stdout, 'GL=4.6 GLSL=unset ARGS=\n')
+        self.assertFalse(self.probe_log.exists())
+
+    def test_the_wrapper_reads_only_the_two_variables(self):
+        self.fake_ghostty()
+        env_file = self.runtime / 'try-omarchy/ghostty-gl.env'
+        env_file.parent.mkdir()
+        env_file.write_text('LD_PRELOAD=/tmp/x.so\nMESA_GL_VERSION_OVERRIDE=$(id)\nMESA_GLSL_VERSION_OVERRIDE=430\n')
+        self.fake_probe('exit 1')
+        self.assertEqual(self.wrapper().stdout, 'GL=unset GLSL=430 ARGS=\n')
+
+    def test_the_wrapper_still_starts_ghostty_when_the_helper_fails(self):
+        self.fake_ghostty()
+        result = self.wrapper(TRY_OMARCHY_GHOSTTY_GL=str(self.root / 'missing'), XDG_RUNTIME_DIR='')
+        self.assertEqual((result.returncode, result.stdout), (0, 'GL=unset GLSL=unset ARGS=\n'))
+
+    def test_the_wrapper_reports_a_missing_ghostty(self):
+        self.fake_probe('echo 4.2')
+        result = self.wrapper()
+        self.assertEqual(result.returncode, 127)
+        self.assertIn('not installed', result.stderr)
+
+    def test_the_link_follows_the_package(self):
+        # Not installed: nothing on PATH, so Omarchy still offers to install it.
+        self.assertEqual(self.helper('link').returncode, 0)
+        self.assertFalse(self.link.exists() or self.link.is_symlink())
+        self.fake_ghostty()
+        result = self.helper('link')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(os.readlink(self.link), str(WRAPPER))
+        self.assertEqual(self.helper('link').stdout, '')
+        self.ghostty.unlink()
+        self.helper('link')
+        self.assertFalse(self.link.exists() or self.link.is_symlink())
+
+    def test_the_link_leaves_other_files_alone(self):
+        self.link.parent.mkdir(parents=True)
+        for make in (lambda: self.link.write_text('#!/bin/sh\nmine\n'), lambda: self.link.symlink_to('/opt/ghostty/bin/ghostty')):
+            with self.subTest(make=make):
+                if self.link.is_symlink() or self.link.exists():
+                    self.link.unlink()
+                make()
+                before = (self.link.is_symlink(), os.readlink(self.link) if self.link.is_symlink() else self.link.read_text())
+                for installed in (False, True):
+                    if installed:
+                        self.fake_ghostty()
+                    else:
+                        self.ghostty.unlink(missing_ok=True)
+                    self.helper('link')
+                    after = (self.link.is_symlink(), os.readlink(self.link) if self.link.is_symlink() else self.link.read_text())
+                    self.assertEqual(after, before)
+
+    def test_catch_up_links_at_every_boot(self):
+        version = self.root / 'compat-version'
+        version.write_text('74:7.2.15-arch1-1\n')
+        state = self.root / 'state'
+        homes = self.root / 'home'
+        homes.mkdir()
+        log = self.root / 'linked'
+        helper = self.root / 'helper'
+        helper.write_text(f'#!/bin/sh\necho "$@" >> {log}\nexit 1\n')
+        helper.chmod(0o755)
+        env = {**os.environ, 'TRY_OMARCHY_COMPAT_VERSION': str(version), 'TRY_OMARCHY_STATE_DIR': str(state),
+               'TRY_OMARCHY_HOMES': str(homes), 'TRY_OMARCHY_PACMAN_LAYER': '/nonexistent',
+               'TRY_OMARCHY_GHOSTTY_GL': str(helper), 'TRY_OMARCHY_HEADERS_HOLD': '/nonexistent',
+               'TRY_OMARCHY_SSHD_CONFIG_DIR': str(self.root / 'sshd'), 'TRY_OMARCHY_TERMINAL_SHIM': str(self.root / 'shim')}
+        for name in ('QOL', 'BATTERY', 'NIGHTLIGHT', 'NOTIFICATIONS', 'PALETTE'):
+            env[f'TRY_OMARCHY_{name}_INSTALLER'] = '/nonexistent'
+        for _ in range(2):
+            result = subprocess.run(['bash', str(CATCH_UP)], env=env, text=True, capture_output=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(log.read_text(), 'link\nlink\n')
+        self.assertEqual((state / 'catch-up-revision').read_text(), '74\n')
+
+
+class GhosttyWiringTests(unittest.TestCase):
+    """The pieces match the names and commands Arch's Ghostty package ships."""
+
+    def test_the_drop_in_is_for_the_service_d_bus_activation_starts(self):
+        dbus = unit((ARCH / 'dbus-com.mitchellh.ghostty.service').read_text())
+        service = dbus['D-BUS Service']['SystemdService']
+        self.assertEqual(service, 'app-com.mitchellh.ghostty.service')
+        self.assertTrue((ARCH / service).is_file())
+        self.assertEqual(DROP_IN.parent.name, service + '.d')
+        desktop = unit((ARCH / 'com.mitchellh.ghostty.desktop').read_text())
+        self.assertEqual(desktop['Desktop Entry']['DBusActivatable'], 'true')
+        self.assertEqual(dbus['D-BUS Service']['Name'], 'com.mitchellh.ghostty')
+
+    def test_the_drop_in_reads_the_file_the_helper_writes(self):
+        drop_in = unit(DROP_IN.read_text())
+        self.assertEqual(drop_in['Service']['EnvironmentFile'], '-%t/try-omarchy/ghostty-gl.env')
+        self.assertIn('$runtime/try-omarchy', HELPER.read_text())
+        self.assertIn('file=$dir/ghostty-gl.env', HELPER.read_text())
+        self.assertEqual(drop_in['Unit']['Wants'], PROBE_UNIT.name)
+        self.assertEqual(drop_in['Unit']['After'], PROBE_UNIT.name)
+        probe_unit = unit(PROBE_UNIT.read_text())
+        # It runs before every start of the service, so a failed probe is
+        # retried, and its failure never keeps Ghostty from starting.
+        self.assertEqual(probe_unit['Service']['Type'], 'oneshot')
+        self.assertNotIn('RemainAfterExit', probe_unit['Service'])
+        self.assertEqual(probe_unit['Service']['ExecStart'], '-/usr/local/lib/try-omarchy/ghostty-gl env')
+        self.assertNotIn('Requires', drop_in['Unit'])
+
+    def test_every_packaged_command_finds_the_wrapper_first(self):
+        # systemd and every PATH in the session search /usr/local/bin before
+        # /usr/bin, so the bare ghostty in these lines resolves to the link.
+        service = unit((ARCH / 'app-com.mitchellh.ghostty.service').read_text())
+        dbus = unit((ARCH / 'dbus-com.mitchellh.ghostty.service').read_text())
+        desktop = unit((ARCH / 'com.mitchellh.ghostty.desktop').read_text())
+        for line in (service['Service']['ExecStart'], dbus['D-BUS Service']['Exec'],
+                     desktop['Desktop Entry']['Exec'], desktop['Desktop Action new-window']['Exec'],
+                     desktop['Desktop Entry']['TryExec']):
+            self.assertEqual(line.split()[0], 'ghostty', line)
+        helper = HELPER.read_text()
+        self.assertIn('ghostty_link=${TRY_OMARCHY_GHOSTTY_LINK:-/usr/local/bin/ghostty}', helper)
+        self.assertIn('ghostty_bin=${TRY_OMARCHY_GHOSTTY_BIN:-/usr/bin/ghostty}', helper)
+        self.assertIn('ghostty_bin=${TRY_OMARCHY_GHOSTTY_BIN:-/usr/bin/ghostty}', WRAPPER.read_text())
+
+    def test_the_hook_follows_the_packaged_binary(self):
+        hook = HOOK.read_text()
+        self.assertIn('Type = Path\nTarget = usr/bin/ghostty\n', hook)
+        for operation in ('Install', 'Upgrade', 'Remove'):
+            self.assertIn(f'Operation = {operation}\n', hook)
+        self.assertIn('When = PostTransaction\nExec = /usr/local/lib/try-omarchy/ghostty-gl link\n', hook)
+
+    def test_existing_disks_get_every_piece(self):
+        finalizer = (GUEST / 'scripts/finalize-rootfs.sh').read_text()
+        paths = finalizer.split('compat_paths=(', 1)[1].split(')', 1)[0].split()
+        for path in (HELPER, WRAPPER, PROBE, PROBE_UNIT, DROP_IN, HOOK):
+            self.assertIn(str(path.relative_to(OVERLAY)), paths)
+        self.assertIn('compat_revision=74', finalizer)
+        for path in (HELPER, WRAPPER, PROBE):
+            self.assertTrue(os.access(path, os.X_OK), path)
+
+    def test_the_probe_reports_a_version_or_fails(self):
+        result = subprocess.run([str(PROBE)], text=True, capture_output=True, timeout=30)
+        self.assertIn(result.returncode, (0, 1))
+        if result.returncode == 0:
+            self.assertRegex(result.stdout, r'^[34]\.[0-9]\n$')
+        else:
+            self.assertEqual(result.stdout, '')
+
+
+if __name__ == '__main__':
+    unittest.main()
