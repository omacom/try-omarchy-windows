From 4647379c87c997d723ee5989f6b87c448f35f4e0 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sat, 5 Sep 2026 04:25:30 -0400
Subject: [PATCH] Bridge PNG images through the clipboard

The clipboard bridge carried text only. A second wl-paste watcher pushes PNG images as png: lines, and a png: line from the host is copied into the Wayland clipboard with the image/png type. Text keeps the bare base64 form, so an older launcher or guest ignores what it does not understand. Images are limited to 16 MiB. The bridge ships in the compat overlay, so the integration revision moves to 7.
---
 .../usr/local/bin/clipboard-bridge            | 64 ++++++++++++++-----
 guest/scripts/finalize-rootfs.sh              |  2 +-
 guest/tests/test_clipboard.py                 | 32 ++++++++++
 guest/tests/verify.py                         |  2 +-
 4 files changed, 81 insertions(+), 19 deletions(-)

diff --git a/guest/factory-overlay/usr/local/bin/clipboard-bridge b/guest/factory-overlay/usr/local/bin/clipboard-bridge
index 749aa7d..2fb1cb2 100755
--- a/guest/factory-overlay/usr/local/bin/clipboard-bridge
+++ b/guest/factory-overlay/usr/local/bin/clipboard-bridge
@@ -1,10 +1,13 @@
 #!/bin/sh
-# Clipboard bridge (guest side) for two-way text sync with the Windows host.
-# It waits for the active Wayland session and restarts both directions if the
-# compositor is replaced. 10.0.2.2 is the host under QEMU user networking.
+# Clipboard bridge (guest side) for two-way text and image sync with the
+# Windows host. It waits for the active Wayland session and restarts both
+# directions if the compositor is replaced. 10.0.2.2 is the host under QEMU
+# user networking. One line per item: base64 text, or "png:" + base64 PNG.
 HOST=10.0.2.2
 PUSH_PORT=4448
 PULL_PORT=4449
+TEXT_LIMIT=8388608
+IMAGE_LIMIT=16777216
 
 XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
 STATE=$XDG_RUNTIME_DIR/try-omarchy-clipboard
@@ -14,34 +17,49 @@ mkdir -p "$STATE"
 
 # wl-paste supplies the selected text on stdin. Keeping it in a file preserves
 # trailing newlines and avoids a second clipboard read after the selection moves.
-if [ "${1:-}" = --push ] || [ "${1:-}" = --receive ]; then
+case "${1:-}" in
+--push|--receive|--push-image|--receive-image)
+  kind=text
+  limit=$TEXT_LIMIT
+  case $1 in
+  --push-image|--receive-image) kind=png; limit=$IMAGE_LIMIT ;;
+  esac
   outgoing=$(mktemp "$STATE/outgoing.XXXXXX") || exit 1
   trap 'rm -f "$outgoing"' EXIT
-  head -c 8388609 > "$outgoing" || exit 1
+  head -c $((limit + 1)) > "$outgoing" || exit 1
   size=$(wc -c < "$outgoing")
-  [ "$size" -gt 0 ] && [ "$size" -le 8388608 ] || exit 0
+  [ "$size" -gt 0 ] && [ "$size" -le "$limit" ] || exit 0
   # Serialize both directions, including delivery. A completed push must not
   # overwrite the state of a newer host value received while it was sending.
   exec 9> "$STATE/lock"
   flock -x 9 || exit 1
   sha=$(sha256sum < "$outgoing" | cut -d' ' -f1)
-  if [ "$1" = --receive ]; then
+  case $1 in
+  --receive|--receive-image)
     printf '%s\n' "$sha" > "$STATE/last_content"
     # wl-copy forks a clipboard owner. It must not inherit the lock descriptor.
-    if ! wl-copy < "$outgoing" 9>&-; then
+    if [ "$kind" = png ]; then
+      wl-copy --type image/png < "$outgoing" 9>&-
+    else
+      wl-copy < "$outgoing" 9>&-
+    fi || {
       rm -f "$STATE/last_content"
       exit 1
-    fi
+    }
     exit 0
-  fi
+    ;;
+  esac
   [ "$sha" = "$(cat "$STATE/last_content" 2>/dev/null)" ] && exit 0
-  if { base64 -w0 < "$outgoing"; echo; } | timeout 10s socat -u - TCP:$HOST:$PUSH_PORT,connect-timeout=3 2>/dev/null 9>&-; then
+  prefix=""
+  [ "$kind" = png ] && prefix="png:"
+  if { printf '%s' "$prefix"; base64 -w0 < "$outgoing"; echo; } | timeout 20s socat -u - TCP:$HOST:$PUSH_PORT,connect-timeout=3 2>/dev/null 9>&-; then
     printf '%s\n' "$sha" > "$STATE/last_content"
   else
     exit 1
   fi
   exit 0
-fi
+  ;;
+esac
 
 find_wayland() {
   if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]; then
@@ -59,13 +77,16 @@ find_wayland() {
 }
 
 PULL_PID=
+IMAGE_PID=
 cleanup() {
 	pull_pid=$PULL_PID
+	image_pid=$IMAGE_PID
 	PULL_PID=
-	if [ -n "$pull_pid" ]; then
-		kill "$pull_pid" 2>/dev/null || true
-		wait "$pull_pid" 2>/dev/null || true
-	fi
+	IMAGE_PID=
+	for pid in $pull_pid $image_pid; do
+		kill "$pid" 2>/dev/null || true
+		wait "$pid" 2>/dev/null || true
+	done
 }
 stop() {
 	cleanup
@@ -87,14 +108,23 @@ while :; do
       # small clipboard payloads and makes ordinary text appear stuck.
       socat -u TCP:$HOST:$PULL_PORT,connect-timeout=3 - 2>/dev/null | while IFS= read -r line; do
         line=${line%"$(printf '\r')"}
+        receive=--receive
+        case $line in
+        png:*) receive=--receive-image; line=${line#png:} ;;
+        esac
         printf '%s' "$line" | base64 -d > "$STATE/incoming" 2>/dev/null || continue
-        "$0" --receive < "$STATE/incoming" || break
+        "$0" $receive < "$STATE/incoming" || break
       done
       sleep 2
     done
   ) &
   PULL_PID=$!
 
+  # guest -> host, images. wl-paste only runs the handler when the selection
+  # offers the requested type, so a text copy leaves this watcher idle.
+  wl-paste --type image/png --watch "$0" --push-image 2>/dev/null &
+  IMAGE_PID=$!
+
   # guest -> host. wl-paste exits when its Wayland connection disappears, so
   # the outer loop can discover the replacement socket and restart both sides.
   wl-paste --type text --watch "$0" --push || true
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index a1de599..dc06c45 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -82,7 +82,7 @@ kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '
 }
 # Bump this revision whenever compat-overlay.tar changes in a way that must be
 # applied to persistent disks created by an earlier launcher release.
-compat_revision=6
+compat_revision=7
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Never let the container host's hardware autodetection remove the virtual
diff --git a/guest/tests/test_clipboard.py b/guest/tests/test_clipboard.py
index 777e13d..591b33e 100644
--- a/guest/tests/test_clipboard.py
+++ b/guest/tests/test_clipboard.py
@@ -135,3 +135,35 @@ class ClipboardTests(unittest.TestCase):
         timeout.unlink()
         self.assertEqual(self.push(b'retry after timeout').returncode, 0)
         self.assertEqual(self.capture.read_bytes(), base64.b64encode(b'retry after timeout') + b'\n')
+
+    def push_image(self, data):
+        return subprocess.run(['sh', str(BRIDGE), '--push-image'], input=data,
+                              env=self.env, capture_output=True, timeout=10)
+
+    def test_image_push_uses_the_png_frame(self):
+        png = b'\x89PNG\r\n\x1a\n' + bytes(range(256)) * 16
+        self.assertEqual(self.push_image(png).returncode, 0)
+        self.assertEqual(self.capture.read_bytes(), b'png:' + base64.b64encode(png) + b'\n')
+        # The same image again is a duplicate; a text with identical bytes is not.
+        self.assertEqual(self.push_image(png).returncode, 0)
+        self.assertEqual(self.capture.read_bytes(), b'png:' + base64.b64encode(png) + b'\n')
+
+    def test_image_receive_sets_the_png_type(self):
+        wl_copy = self.bin / 'wl-copy'
+        wl_copy.write_text('#!/bin/sh\nprintf "%s|" "$@" >> "$CAPTURE.args"; cat > "$CAPTURE.copied"\n')
+        wl_copy.chmod(0o755)
+        png = b'\x89PNG\r\n\x1a\nimage'
+        result = subprocess.run(['sh', str(BRIDGE), '--receive-image'], input=png, env=self.env,
+                                capture_output=True, timeout=10)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(Path(str(self.capture) + '.args').read_text(), '--type|image/png|')
+        self.assertEqual(Path(str(self.capture) + '.copied').read_bytes(), png)
+        self.assertEqual((self.root / 'try-omarchy-clipboard/last_content').read_text().strip(),
+                         hashlib.sha256(png).hexdigest())
+        # A push of what was just received is suppressed, so nothing echoes back.
+        self.assertEqual(self.push_image(png).returncode, 0)
+        self.assertFalse(self.capture.exists())
+
+    def test_oversized_image_is_ignored(self):
+        self.assertEqual(self.push_image(b'x' * (16777216 + 1)).returncode, 0)
+        self.assertFalse(self.capture.exists())
diff --git a/guest/tests/verify.py b/guest/tests/verify.py
index 979a092..65f1e73 100755
--- a/guest/tests/verify.py
+++ b/guest/tests/verify.py
@@ -257,7 +257,7 @@ def main() -> None:
 
     finalize_rootfs = read(GUEST / "scripts/finalize-rootfs.sh")
     check(
-        "compat_revision=6" in finalize_rootfs
+        "compat_revision=7" in finalize_rootfs
         and "compat_revision" in finalize_rootfs.split("compat-version")[0]
         and "usr/local/lib/try-omarchy/apply-host-locale" in finalize_rootfs
         and "etc/systemd/system/sysinit.target.wants/try-omarchy-host-locale.service" in finalize_rootfs
