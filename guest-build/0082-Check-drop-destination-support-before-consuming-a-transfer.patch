diff --git a/guest/factory-overlay/usr/local/bin/file-transfer b/guest/factory-overlay/usr/local/bin/file-transfer
index 150dc73..a2f06a2 100755
--- a/guest/factory-overlay/usr/local/bin/file-transfer
+++ b/guest/factory-overlay/usr/local/bin/file-transfer
@@ -191,6 +191,30 @@ def receive(input, offer, destination):
                 return {'paths': [str(destination / name) for name in roots]}
 
 
+def can_receive_into(folder):
+    """Check required filesystem operations before consuming a one-use ticket.
+
+    Windows shares may allow writes but reject timestamp preservation or atomic
+    no-replace renames. Probe only disposable files, never an existing item.
+    """
+    try:
+        plain_path(folder)
+        with tempfile.TemporaryDirectory(prefix='.windows-drop-check-', dir=folder) as tmp:
+            stage = Path(tmp)
+            contents = stage / 'contents'
+            contents.mkdir(mode=0o700)
+            probe = contents / 'probe'
+            with probe.open('xb') as output:
+                output.write(b'probe')
+                output.flush()
+                os.fsync(output.fileno())
+            os.utime(probe, (946684800, 946684800), follow_symlinks=False)
+            publish(contents, stage / 'received')
+        return True
+    except (OSError, ValueError):
+        return False
+
+
 def download_into(ticket, folder, host='10.0.2.2', port=4452):
     """Verify in hidden staging, then atomically reveal each top-level item.
 
diff --git a/guest/factory-overlay/usr/local/bin/try-omarchy-drop b/guest/factory-overlay/usr/local/bin/try-omarchy-drop
index 4878d32..6c1af6c 100755
--- a/guest/factory-overlay/usr/local/bin/try-omarchy-drop
+++ b/guest/factory-overlay/usr/local/bin/try-omarchy-drop
@@ -151,6 +151,8 @@ def receive_ticket(ticket_path, point):
         # not redirect a copy that is already in progress.
         try:
             folder = target_folder(point)
+            if folder is not None and not transfer.can_receive_into(folder):
+                folder = None
         except Exception:
             folder = None
         fallback = folder is None
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
index 3fd9342..285fd5d 100755
--- a/guest/scripts/finalize-rootfs.sh
+++ b/guest/scripts/finalize-rootfs.sh
@@ -153,7 +153,7 @@ kernel_release=$(find /usr/lib/modules -mindepth 1 -maxdepth 1 -type d -printf '
 # Revision 27 delivers the complete matching kernel modules and preserves
 # the transfer fallback when a direct paste cannot be confirmed.
 # Revision 28 receives file drops in the background directly into folders.
-compat_revision=28
+compat_revision=29
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
