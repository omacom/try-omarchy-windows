 class DropTargetTests(unittest.TestCase):
+    def test_unsupported_folder_falls_back_before_downloading(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            state = root / 'try-omarchy-clipboard'
+            state.mkdir()
+            request = state / 'incoming-drop-test'
+            request.write_text('{}')
+            shared, downloads = root / 'shared', root / 'Downloads'
+            shared.mkdir()
+            ticket = {'test': 'one-use-ticket'}
+            fake = SimpleNamespace(read_metadata=Mock(return_value=ticket),
+                valid_ticket=Mock(return_value=True), can_receive_into=Mock(return_value=False),
+                download_into=Mock(return_value=[downloads / 'file']))
+            with patch.dict(os.environ, {'XDG_RUNTIME_DIR': str(root)}), \
+                 patch.object(module, 'target_folder', return_value=shared), \
+                 patch.object(module, 'downloads_folder', return_value=downloads), \
+                 patch.object(module, 'notify') as notify, \
+                 patch.object(importlib.machinery.SourceFileLoader, 'exec_module',
+                              side_effect=lambda loaded: loaded.__dict__.update(vars(fake))):
+                module.receive_ticket(request, (1, 1, 10, 10))
+            fake.can_receive_into.assert_called_once_with(shared)
+            fake.download_into.assert_called_once_with(ticket, downloads)
+            notify.assert_called_once_with('Files saved to Downloads', '1 item(s) received from Windows.')
+            self.assertFalse(request.exists())
+            self.assertEqual(list(shared.iterdir()), [])
+
     def test_picks_the_window_under_the_point(self):
         clients = [
             client("0xa", [0, 0], [800, 600], focus=0),
diff --git a/guest/tests/test_file_transfer.py b/guest/tests/test_file_transfer.py
index 478f56a..d55d601 100644
--- a/guest/tests/test_file_transfer.py
+++ b/guest/tests/test_file_transfer.py
@@ -15,6 +15,38 @@ loader.exec_module(transfer)
 
 
 class StreamingFileTests(unittest.TestCase):
+    def test_drop_probe_preserves_existing_files_and_cleans_up(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            original = folder / 'original'
+            original.write_text('keep me')
+            self.assertTrue(transfer.can_receive_into(folder))
+            self.assertEqual(list(folder.iterdir()), [original])
+            self.assertEqual(original.read_text(), 'keep me')
+
+    def test_drop_probe_rejects_unsupported_operations_without_leftovers(self):
+        for operation in ('utime', 'fsync'):
+            with self.subTest(operation=operation), tempfile.TemporaryDirectory() as tmp:
+                folder = Path(tmp)
+                with patch.object(transfer.os, operation, side_effect=PermissionError('shared filesystem')):
+                    self.assertFalse(transfer.can_receive_into(folder))
+                self.assertEqual(list(folder.iterdir()), [])
+        with tempfile.TemporaryDirectory() as tmp:
+            folder = Path(tmp)
+            with patch.object(transfer, 'publish', side_effect=OSError('no atomic rename')):
+                self.assertFalse(transfer.can_receive_into(folder))
+            self.assertEqual(list(folder.iterdir()), [])
+
+    def test_drop_probe_rejects_symlinked_destination(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            folder = root / 'folder'
+            folder.mkdir()
+            link = root / 'link'
+            link.symlink_to(folder)
+            self.assertFalse(transfer.can_receive_into(link))
+            self.assertEqual(list(folder.iterdir()), [])
+
     def test_outgoing_archive_uses_disk_cache_when_runtime_storage_is_small(self):
         from types import SimpleNamespace
         from unittest import mock
