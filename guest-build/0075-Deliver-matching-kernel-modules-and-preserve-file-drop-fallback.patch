@@ -0,0 +1,91 @@
+"""Run the actual initramfs hooks against disposable persistent-guest trees."""
+import io
+import os
+from pathlib import Path
+import subprocess
+import tarfile
+import tempfile
+import unittest
+
+GUEST = Path(__file__).resolve().parents[1]
+HOOKS = GUEST / 'factory-overlay/etc/initcpio'
+
+class ModuleDeliveryTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.root = Path(self.tmp.name)
+        self.guest = self.root / 'guest'
+        self.guest.mkdir()
+        self.kernel = 'test-kernel'
+        self.modules = self.guest / 'usr/lib/modules' / self.kernel
+        self.modules.mkdir(parents=True)
+        (self.modules / 'modules.dep.bin').write_text('old partial metadata')
+        (self.modules / 'keep-user-file').write_text('retained')
+        self.version = '27:test-kernel'
+        (self.root / 'version').write_text(self.version + '\n')
+        self.archive('overlay.tar', {'usr/share/try-omarchy/new-helper': 'helper'})
+        self.archive('modules.tar', {
+            self.kernel + '/modules.dep.bin': 'complete metadata',
+            self.kernel + '/modules.order': 'order',
+            self.kernel + '/modules.builtin': 'builtin',
+            self.kernel + '/modules.builtin.modinfo': 'metadata',
+            self.kernel + '/kernel/drivers/net/tun.ko': 'tun',
+            self.kernel + '/updates/dkms/v4l2loopback.ko': 'camera',
+        })
+        script = (HOOKS / 'hooks/tryomarchy_compat').read_text()
+        script = script.replace('root=/new_root', 'root=' + str(self.guest))
+        for before, after in [('tryomarchy-compat-version', 'version'), ('tryomarchy-compat-overlay.tar', 'overlay.tar'), ('tryomarchy-kernel-modules.tar', 'modules.tar')]:
+            script = script.replace('/' + before, str(self.root / after))
+        script = script.replace('kernel=$(uname -r)', 'kernel=' + self.kernel)
+        self.script = script
+
+    def archive(self, name, files):
+        with tarfile.open(self.root / name, 'w') as out:
+            for name, value in files.items():
+                data = value.encode()
+                info = tarfile.TarInfo(name)
+                info.size = len(data)
+                out.addfile(info, io.BytesIO(data))
+
+    def run_hook(self, prefix=''):
+        return subprocess.run(['sh', '-c', prefix + '\n' + self.script + '\nrun_latehook'], text=True, capture_output=True)
+
+    def test_repairs_partial_tree_and_does_not_repeat(self):
+        result = self.run_hook()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual((self.modules / 'kernel/drivers/net/tun.ko').read_text(), 'tun')
+        self.assertEqual((self.modules / 'updates/dkms/v4l2loopback.ko').read_text(), 'camera')
+        self.assertEqual((self.modules / 'keep-user-file').read_text(), 'retained')
+        self.assertEqual((self.modules / '.tryomarchy-complete').read_text().strip(), self.version)
+        (self.root / 'modules.tar').unlink()
+        self.assertEqual(self.run_hook().returncode, 0)
+
+    def test_failed_extraction_preserves_files_and_retries(self):
+        prefix = '''tar() {
+case "$*" in *modules.tar*) return 1;; esac
+command tar "$@"
+}'''
+        self.assertNotEqual(self.run_hook(prefix).returncode, 0)
+        self.assertFalse((self.modules / '.tryomarchy-complete').exists())
+        self.assertFalse((self.guest / 'usr/share/try-omarchy/compat-version').exists())
+        self.assertEqual((self.modules / 'keep-user-file').read_text(), 'retained')
+        self.assertEqual(self.run_hook().returncode, 0)
+
+    def test_install_archive_includes_modules_and_excludes_headers(self):
+        source = self.root / 'source'
+        for name in ['modules.order', 'kernel/drivers/net/tun.ko', 'updates/dkms/v4l2loopback.ko', 'build/header.h', 'source/source.c', 'vmlinuz']:
+            file = source / self.kernel / name
+            file.parent.mkdir(parents=True, exist_ok=True)
+            file.write_text(name)
+        install = (HOOKS / 'install/tryomarchy_compat').read_text().replace('/usr/lib/modules', str(source))
+        output = self.root / 'captured.tar'
+        prefix = 'KERNELVERSION=test-kernel\nadd_runscript() { :; }\n'
+        prefix += 'add_file() { if [[ $2 == /tryomarchy-kernel-modules.tar ]]; then cp "$1" ' + str(output) + '; fi; }\n'
+        result = subprocess.run(['bash', '-c', prefix + install + '\nbuild'], text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        with tarfile.open(output) as archive:
+            names = archive.getnames()
+        self.assertIn(self.kernel + '/kernel/drivers/net/tun.ko', names)
+        self.assertIn(self.kernel + '/updates/dkms/v4l2loopback.ko', names)
+        self.assertFalse(any('/build' in name or '/source' in name or name.endswith('/vmlinuz') for name in names))
