diff --git a/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat b/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat
index 9ba0de3..6ce51a3 100755
--- a/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat
+++ b/guest/factory-overlay/etc/initcpio/hooks/tryomarchy_compat
@@ -5,9 +5,10 @@ run_latehook() {
     marker="$root/usr/share/try-omarchy/compat-version"
     version=$(cat /tryomarchy-compat-version 2>/dev/null) || return 0
     kernel=$(uname -r)
+    modules_marker="$root/usr/lib/modules/$kernel/.tryomarchy-complete"
     [ -d "$root" ] || return 0
     if [ "$(cat "$marker" 2>/dev/null)" = "$version" ] &&
-       [ -f "$root/usr/lib/modules/$kernel/modules.dep.bin" ]; then
+       [ "$(cat "$modules_marker" 2>/dev/null)" = "$version" ]; then
         return 0
     fi
 
@@ -20,16 +21,21 @@ run_latehook() {
     # cannot express deletion, so remove the obsolete early-start link after
     # its replacement has been extracted successfully.
     rm -f "$root/etc/systemd/user/default.target.wants/try-omarchy-share-link.service"
-    # The launcher boots the release's external kernel. Persistent disks can
-    # still contain an older linux package, so carry this initramfs's matching
-    # module tree across before switch_root. A failed copy is retried next boot.
-    if [ ! -f "$root/usr/lib/modules/$kernel/modules.dep.bin" ]; then
+    # Replace the camera's old broken link and grant the active desktop access
+    # before systemd's seat-late udev rule applies ACLs.
+    rm -f "$root/etc/systemd/user/default.target.wants/omarchy-windows-camera-bridge.service"
+    rm -f "$root/etc/udev/rules.d/94-try-omarchy-camera.rules"
+    # Merge the complete matching tree, including into an older partial tree.
+    # Preserve existing files on failure and leave the completion marker stale,
+    # so an interrupted or disk-full extraction is retried on the next boot.
+    if [ "$(cat "$modules_marker" 2>/dev/null)" != "$version" ]; then
         if ! mkdir -p "$root/usr/lib/modules" ||
-           ! cp -a "/usr/lib/modules/$kernel" "$root/usr/lib/modules/"; then
+           ! tar -xf /tryomarchy-kernel-modules.tar -C "$root/usr/lib/modules"; then
             echo "ERROR: Try Omarchy could not install modules for $kernel" >&2
-            rm -rf "$root/usr/lib/modules/$kernel"
             return 1
         fi
+        [ -f "$root/usr/lib/modules/$kernel/modules.dep.bin" ] || return 1
+        printf '%s\n' "$version" >"$modules_marker" || return 1
     fi
     mkdir -p "$(dirname "$marker")"
     printf '%s\n' "$version" >"$marker"
diff --git a/guest/factory-overlay/etc/initcpio/install/tryomarchy_compat b/guest/factory-overlay/etc/initcpio/install/tryomarchy_compat
index 45414b3..71cd997 100755
--- a/guest/factory-overlay/etc/initcpio/install/tryomarchy_compat
+++ b/guest/factory-overlay/etc/initcpio/install/tryomarchy_compat
@@ -3,6 +3,23 @@
 build() {
     add_file /usr/share/try-omarchy/compat-overlay.tar /tryomarchy-compat-overlay.tar
     add_file /usr/share/try-omarchy/compat-version /tryomarchy-compat-version
+    # The external kernel needs its complete module tree after switch_root,
+    # including TUN and the DKMS camera module, not just early-boot drivers.
+    # Keep build headers out of the initramfs and avoid a duplicate archive in
+    # the factory rootfs. add_file copies the archive into the build tree.
+    local modules_archive
+    modules_archive=$(mktemp) || return 1
+    if ! tar --exclude="$KERNELVERSION/build" --exclude="$KERNELVERSION/source" \
+        --exclude="$KERNELVERSION/vmlinuz" -C /usr/lib/modules \
+        -cf "$modules_archive" "$KERNELVERSION"; then
+        rm -f "$modules_archive"
+        return 1
+    fi
+    add_file "$modules_archive" /tryomarchy-kernel-modules.tar || {
+        rm -f "$modules_archive"
+        return 1
+    }
+    rm -f "$modules_archive"
     add_runscript
 }
 
