diff --git a/guest/tests/test_file_drop_target.py b/guest/tests/test_file_drop_target.py
index f50d8f6..c35045d 100644
--- a/guest/tests/test_file_drop_target.py
+++ b/guest/tests/test_file_drop_target.py
@@ -4,6 +4,8 @@ import importlib.machinery
 import importlib.util
 from pathlib import Path
 import unittest
+from unittest.mock import patch
+from subprocess import CompletedProcess
 
 
 SCRIPT = (
@@ -63,6 +65,28 @@ class DropTargetTests(unittest.TestCase):
     def test_deliver_rejects_relative_paths(self):
         self.assertEqual(module.deliver(0, 0, ["relative.txt"]), 2)
 
+    def test_failed_paste_steps_preserve_fallback(self):
+        target = client("0xa", [0, 0], [800, 600])
+        for failed_at in range(3):
+            calls = []
+            def run(args, **kwargs):
+                calls.append(args)
+                return CompletedProcess(args, int(len(calls) == failed_at + 1))
+            with patch.object(module.shutil, 'which', return_value='/usr/bin/wl-copy'):
+                self.assertEqual(module.deliver(1, 1, ['/tmp/file'], run=run, target=target), 1)
+            self.assertEqual(len(calls), failed_at + 1)
+
+    def test_successful_shortcut_is_not_application_acceptance(self):
+        with patch.object(module.shutil, 'which', return_value='/usr/bin/wl-copy'):
+            result = module.deliver(1, 1, ['/tmp/file'], run=lambda args, **kwargs: CompletedProcess(args, 0), target=client('0xa', [0, 0], [800, 600]))
+        self.assertEqual(result, 3)
+
+    def test_drop_uses_current_guest_scale_and_resolution(self):
+        monitors = [{'width': 2560, 'height': 1440, 'scale': 2, 'x': 0, 'y': 0}]
+        self.assertEqual(module.display_point(400, 300, 800, 600, monitors), (640, 360))
+        self.assertIsNone(module.display_point(400, 300, 800, 600, monitors * 2))
+        self.assertIsNone(module.display_point(-1, 0, 800, 600, monitors))
+
 
 if __name__ == "__main__":
     unittest.main()
