-non-zero so the launcher can fall back to the transfer window.
+non-zero so received files remain available in the transfer window.
+A successful shortcut is only a paste request, not application acceptance.
 
 The decision logic is split into pure functions so the unprivileged test suite
 can exercise it without a compositor.
@@ -60,12 +61,26 @@ def uri_list(paths: list[str]) -> str:
     return "\r\n".join("file://" + quote(str(Path(path).resolve())) for path in paths) + "\r\n"
 
 
-def deliver(x: int, y: int, paths: list[str], run=subprocess.run) -> int:
+def display_point(x, y, width, height, monitors):
+    # Direct placement currently supports one guest display. Multiple displays
+    # keep the ordinary transfer window until the host event carries an identity.
+    if len(monitors) != 1 or width <= 0 or height <= 0 or not (0 <= x < width and 0 <= y < height):
+        return None
+    monitor = monitors[0]
+    scale = monitor.get("scale", 1)
+    if scale <= 0:
+        return None
+    return (int(monitor.get("x", 0) + x * monitor["width"] / scale / width),
+            int(monitor.get("y", 0) + y * monitor["height"] / scale / height))
+
+
+def deliver(x: int, y: int, paths: list[str], run=subprocess.run, target=None) -> int:
     for path in paths:
         if not Path(path).is_absolute():
             print("try-omarchy-drop: paths must be absolute", file=sys.stderr)
             return 2
-    target = candidate(clients(), x, y)
+    if target is None:
+        target = candidate(clients(), x, y)
     if target is None:
         print("try-omarchy-drop: no application window under the drop point", file=sys.stderr)
         return 1
@@ -79,10 +94,20 @@ def deliver(x: int, y: int, paths: list[str], run=subprocess.run) -> int:
 
     # Put the file list on the clipboard as text/uri-list, then paste it into
     # the target. Apps that accept a URI paste import the files in place.
-    run(["wl-copy", "--type", "text/uri-list", "--"], input=uri_list(paths), text=True, timeout=10)
-    run(["hyprctl", "dispatch", "focuswindow", f"address:{address}"], timeout=10)
-    run(["hyprctl", "dispatch", "sendshortcut", "CTRL,V," + f"address:{address}"], timeout=10)
-    return 0
+    try:
+        for args, options in (
+            (["wl-copy", "--type", "text/uri-list", "--"], {"input": uri_list(paths), "text": True}),
+            (["hyprctl", "dispatch", "focuswindow", f"address:{address}"], {}),
+            (["hyprctl", "dispatch", "sendshortcut", "CTRL,V," + f"address:{address}"], {}),
+        ):
+            result = run(args, timeout=10, **options)
+            if result.returncode != 0:
+                return 1
+    except (OSError, subprocess.SubprocessError):
+        return 1
+    # Wayland shortcut injection supplies no acknowledgement that the app
+    # accepted these files. Keep the transfer window available in either case.
+    return 3
 
 
 def main(argv: list[str]) -> int:
@@ -102,7 +127,22 @@ def main(argv: list[str]) -> int:
         ):
             print("try-omarchy-drop: invalid request", file=sys.stderr)
             return 2
-        return deliver(request["x"], request["y"], request["paths"])
+        try:
+            result = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=10, check=True)
+            monitors = json.loads(result.stdout)
+            point = display_point(request["x"], request["y"], request.get("width", 0), request.get("height", 0), monitors)
+            if point is None:
+                return 1
+            active_workspace = monitors[0].get("activeWorkspace", {}).get("id")
+            visible = clients()
+            target = candidate([client for client in visible if client.get("workspace", {}).get("id") == active_workspace], *point)
+            if target is None:
+                return 1
+            # Take one snapshot so focus changes during copying cannot select
+            # an unrelated workspace or a different application.
+            return deliver(*point, request["paths"], target=target)
+        except (OSError, subprocess.SubprocessError, ValueError, TypeError, KeyError):
+            return 1
     if len(argv) < 4:
         print("usage: try-omarchy-drop X Y FILE... | --json '{\"x\":..,\"y\":..,\"paths\":[..]}'", file=sys.stderr)
         return 2
