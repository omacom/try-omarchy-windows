+        )
         check(
             reload_log.read_text(encoding="utf-8").splitlines()
             == [
@@ -513,6 +528,18 @@ HOTPLUG=1
             ],
             "native display sync handles QEMU DisplayID and legacy EDID hotplug modes",
         )
+        applied_before_reloads = len(reload_log.read_text(encoding="utf-8").splitlines())
+        subprocess.run(
+            [str(display_sync), "--config-reloads-from-stdin"],
+            input="activewindow>>foot,foot\nconfigreloaded>>\nworkspace>>2\n",
+            text=True,
+            env=environment,
+            check=True,
+        )
+        check(
+            len(reload_log.read_text(encoding="utf-8").splitlines()) == applied_before_reloads + 2,
+            "native display sync applies the EDID modes again after a config reload",
+        )
 
     shell_files = [
         GUEST / "test",
