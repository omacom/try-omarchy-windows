diff --git a/guest/native-overlay/usr/local/bin/omarchy-native-display-sync b/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
index 5c050cd..6877c5b 100755
--- a/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
+++ b/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
@@ -3,6 +3,9 @@
 set -euo pipefail
 
 drm_root=${OMARCHY_DISPLAY_SYNC_DRM_ROOT:-/sys/class/drm}
+# The QEMU profile in monitors.lua reads the last applied mode from here, so a
+# config reload keeps that mode instead of falling back to "preferred".
+state_file=${OMARCHY_DISPLAY_SYNC_STATE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/try-omarchy/display-mode}
 
 preferred_mode_from_edid() {
   python3 - "$1" <<'PY'
@@ -272,11 +275,48 @@ apply_preferred_modes() {
     elif [[ $response != ok ]]; then
       printf 'omarchy-native-display-sync: Hyprland rejected %s for %s: %s\n' \
         "$mode" "$output" "$response" >&2
+    else
+      record_mode "$mode" "$scale"
     fi
   done
   shopt -u nullglob
 }
 
+record_mode() {
+  local tmp
+  mkdir -p "${state_file%/*}" || return 0
+  tmp=$(mktemp "$state_file.XXXXXX") || return 0
+  if printf '%s\n%s\n' "$1" "$2" >"$tmp" && mv -f "$tmp" "$state_file"; then
+    return 0
+  fi
+  rm -f "$tmp"
+}
+
+# Every theme switch runs hyprctl reload, which re-applies monitors.lua. The
+# current QEMU profile keeps the recorded mode; an older copy of it in a
+# customized monitors.lua cannot, so apply the EDID mode again afterwards.
+# When the mode already matches, Hyprland leaves the output alone.
+apply_after_config_reload() {
+  local line
+
+  while IFS= read -r line; do
+    if [[ $line == configreloaded* ]]; then
+      apply_preferred_modes
+    fi
+  done
+}
+
+watch_config_reloads() {
+  local socket=${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/.socket2.sock
+
+  [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || return 0
+  # The socket goes away with this Hyprland instance; so does the watcher.
+  while [[ -S $socket ]]; do
+    socat -U - "UNIX-CONNECT:$socket" 2>/dev/null | apply_after_config_reload || true
+    sleep 1
+  done
+}
+
 reload_on_display_change() {
   local action=""
   local hotplug=""
@@ -310,9 +350,15 @@ if [[ ${1:-} == --from-stdin ]]; then
   exit 0
 fi
 
+if [[ ${1:-} == --config-reloads-from-stdin ]]; then
+  apply_after_config_reload
+  exit 0
+fi
+
 # QEMU changes the virtio-gpu EDID whenever its SDL window changes size.
 # Linux exposes that as a DRM hotplug change.
 apply_preferred_modes
+watch_config_reloads &
 while true; do
   udevadm monitor --udev --subsystem-match=drm --property |
     reload_on_display_change || true
