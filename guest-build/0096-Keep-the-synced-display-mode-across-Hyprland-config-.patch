   usr/src/try-omarchy-battery-1.0.0
   etc/systemd/system/try-omarchy-catch-up.service
   etc/systemd/system/multi-user.target.wants/try-omarchy-catch-up.service
+  usr/local/bin/omarchy-native-display-sync
   usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
   usr/share/try-omarchy/skel-fragments/hypr-input-pinch.append.lua
   usr/share/try-omarchy/pinch-input.lua
@@ -183,7 +184,8 @@ tar -C / -cf /usr/share/try-omarchy/compat-overlay.tar "${compat_paths[@]}"
 # Revision 33 exposes Windows audio endpoints in the guest PipeWire picker.
 # Revision 34 loads the pinch touchpad's device rules for existing users and
 # keeps the device ignored until every user's Hyprland config applies them.
-compat_revision=34
+# Revision 35 keeps the synced display mode across Hyprland config reloads.
+compat_revision=35
 printf '%s:%s\n' "$compat_revision" "$kernel_release" >/usr/share/try-omarchy/compat-version
 
 # Fail the build if DKMS or networking modules were not packaged for this kernel.
