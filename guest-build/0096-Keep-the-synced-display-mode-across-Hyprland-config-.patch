From e2a13dda133862d3c80090718733f4f266c07f72 Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sat, 26 Sep 2026 17:50:56 -0400
Subject: [PATCH] Keep the synced display mode across Hyprland config reloads

Every theme switch runs hyprctl reload, which re-applied monitors.lua's "preferred" mode over the modeline display sync had applied from the window's EDID. The mode change forced a modeset, so QEMU showed "Display output is not active" for a few frames, and a restored window could snap back to an older size.

Display sync now records the mode it applied under the runtime directory, and the QEMU profile in monitors.lua applies that mode on every config load, so a reload leaves the output alone. A customized monitors.lua keeps the older profile, so display sync also applies the EDID mode again on configreloaded. Revision 35 delivers the script and fragment to existing guests; catch-up refreshes an untouched monitors.lua.
---
 .../hypr-monitors-qemu.append.lua             | 33 +++++++++++++
 guest/fragments/hypr-monitors-qemu.append.lua | 33 +++++++++++++
 .../usr/local/bin/omarchy-native-display-sync | 46 +++++++++++++++++++
 guest/scripts/finalize-rootfs.sh              |  4 +-
 guest/tests/verify.py                         | 29 +++++++++++-
 5 files changed, 143 insertions(+), 2 deletions(-)

diff --git a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
index a4c1b3c..e388dce 100644
--- a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
+++ b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
@@ -28,8 +28,41 @@ local function omarchy_kernel_option_enabled(expected_option)
   return false
 end
 
+-- Hyprland re-reads this file on every reload, and each theme switch runs
+-- one. Keep the mode display sync last applied from the window's EDID;
+-- falling back to "preferred" changes the mode, which blanks the window and
+-- can restore an older window size.
+local function omarchy_synced_display_mode()
+  if type(os) ~= "table" or type(os.getenv) ~= "function" or type(io) ~= "table" or type(io.open) ~= "function" then
+    return nil
+  end
+  local runtime_dir = os.getenv("XDG_RUNTIME_DIR")
+  if type(runtime_dir) ~= "string" or runtime_dir == "" then
+    return nil
+  end
+
+  local opened, mode_file = pcall(io.open, runtime_dir .. "/try-omarchy/display-mode", "r")
+  if not opened or not mode_file then
+    return nil
+  end
+  local mode_ok, mode = pcall(mode_file.read, mode_file, "*l")
+  local scale_ok, scale = pcall(mode_file.read, mode_file, "*l")
+  pcall(mode_file.close, mode_file)
+  if not mode_ok or not scale_ok or type(mode) ~= "string" or type(scale) ~= "string" then
+    return nil
+  end
+  if not mode:match("^modeline [%d ]+ [+-]hsync [+-]vsync$") or not scale:match("^%d+%.?%d*$") then
+    return nil
+  end
+  return mode, scale
+end
+
 if omarchy_kernel_option_enabled("omarchy.qemu=1") then
   hl.config({ cursor = { invisible = false } })
+  local synced_mode, synced_scale = omarchy_synced_display_mode()
+  if synced_mode then
+    hl.monitor({ output = "", mode = synced_mode, scale = synced_scale })
+  end
   o.exec_on_start("/usr/local/bin/omarchy-native-display-sync")
 end
 
