@@ -424,6 +425,13 @@ def main() -> None:
         read(GUEST / "factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua") == monitor_fragment,
         "the compat overlay carries the current QEMU profile fragment",
     )
