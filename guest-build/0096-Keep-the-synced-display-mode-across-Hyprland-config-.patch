+    )
     check(
         'omarchy_kernel_option_enabled("tryomarchy.render=cpu")' in monitor_fragment
         and "animations = { enabled = false }" in monitor_fragment,
@@ -496,6 +504,8 @@ HOTPLUG=1
         environment["PATH"] = f"{fake_bin}:{environment['PATH']}"
         environment["HYPRCTL_LOG"] = str(reload_log)
         environment["OMARCHY_DISPLAY_SYNC_DRM_ROOT"] = str(drm_root)
+        state_file = temporary_path / "runtime/try-omarchy/display-mode"
+        environment["OMARCHY_DISPLAY_SYNC_STATE"] = str(state_file)
         subprocess.run(
             [str(display_sync), "--from-stdin"],
             input=events,
@@ -503,6 +513,11 @@ HOTPLUG=1
             env=environment,
             check=True,
         )
+        check(
+            state_file.read_text(encoding="utf-8")
+            == "modeline 149 1920 2008 2052 2200 1080 1084 1089 1125 -hsync -vsync\n1\n",
