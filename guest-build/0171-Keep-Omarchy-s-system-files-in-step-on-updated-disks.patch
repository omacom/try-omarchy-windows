+        self.assertFalse(self.capture.exists())
+
     def test_missing_materialized_command_fails_before_registration(self):
         (self.root / 'usr/bin/omarchy').unlink()
         result = self.run_builder()
diff --git a/guest/tests/test_sync_omarchy_system_files.py b/guest/tests/test_sync_omarchy_system_files.py
new file mode 100644
index 0000000..416e22f
--- /dev/null
+++ b/guest/tests/test_sync_omarchy_system_files.py
@@ -0,0 +1,167 @@
+"""The runtime keeps Omarchy's unowned system files in step on existing disks."""
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+SYNC = Path(__file__).resolve().parents[1] / 'scripts/sync-omarchy-system-files'
+OMARCHY_4_0_4_FASTFETCH = '31c3f90562f3986894f1c3dd5d0be53a203cf6b474236010e45840d6c6dc65cf'
+
+
+class SyncOmarchySystemFilesTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        base = Path(self.temp.name)
+        self.root = base / 'root'
+        self.default = self.root / 'usr/share/omarchy/default'
+        self.write(self.default / 'fonts/omarchy/omarchy.ttf', 'font 4.5\n')
+        self.write(self.default / 'fontconfig/conf.avail/50-omarchy.conf', 'rules 4.5\n')
+        self.write(self.default / 'systemd/user/omarchy-fcitx5.service', 'unit 4.5\n')
+        self.write(self.default / 'systemd/user/wireplumber.service.d/10-omarchy-camera-access.conf', 'drop-in\n')
+        self.write(self.default / 'systemd/user@.service.d/faster-shutdown.conf', 'shutdown\n')
+        self.write(self.root / 'usr/lib/try-omarchy/omarchy-etc/fastfetch/config.jsonc', 'fastfetch 4.5\n')
+        # The previous release's unowned copies on an existing disk.
+        self.write(self.root / 'usr/share/fonts/omarchy/omarchy.ttf', 'font 4.0.4\n')
+        self.write(self.root / 'usr/share/fontconfig/conf.avail/50-omarchy.conf', 'rules 4.0.4\n')
+        self.write(self.root / 'usr/lib/systemd/user/omarchy-fcitx5.service', 'unit 4.0.4\n')
+        self.write(self.root / 'usr/lib/systemd/user/omarchy-windows-audio-bridge.service', 'guest unit\n')
+        self.write(self.root / 'usr/lib/systemd/system/user@.service.d/faster-shutdown.conf', 'shutdown\n')
+        self.bin = base / 'bin'
+        self.bin.mkdir()
+        self.owned = base / 'owned'
+        self.owned.write_text('')
+        self.queries = base / 'queries'
+        # Fake ownership: -Qqo succeeds only for system paths listed in OWNED.
+        self.fake('pacman', '[[ $1 == -Qqo && $2 == -- ]] || exit 2\n'
+                  'printf "%s\\n" "$3" >>"$QUERIES"\n'
+                  'grep -qxF -- "$3" "$OWNED"')
+
+    def write(self, path, text):
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(text)
+
+    def fake(self, name, body):
+        path = self.bin / name
+        path.write_text('#!/bin/bash\n' + body + '\n')
+        path.chmod(0o755)
+
+    def run_sync(self):
+        environment = dict(os.environ, PATH=str(self.bin) + os.pathsep + os.environ['PATH'],
+                           TRY_OMARCHY_SYNC_ROOT=str(self.root), OWNED=str(self.owned),
+                           QUERIES=str(self.queries))
+        return subprocess.run(['bash', str(SYNC)], env=environment, text=True,
+                              capture_output=True, timeout=30)
+
+    def text(self, path):
+        return (self.root / path.lstrip('/')).read_text()
+
+    def test_updates_unowned_copies_and_adds_new_units(self):
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.text('/usr/share/fonts/omarchy/omarchy.ttf'), 'font 4.5\n')
+        self.assertEqual(self.text('/usr/share/fontconfig/conf.avail/50-omarchy.conf'), 'rules 4.5\n')
+        self.assertEqual(self.text('/usr/lib/systemd/user/omarchy-fcitx5.service'), 'unit 4.5\n')
+        self.assertEqual(self.text('/usr/lib/systemd/user/wireplumber.service.d/10-omarchy-camera-access.conf'),
+                         'drop-in\n')
+        # Files Omarchy does not ship are left alone, and nothing is left behind.
+        self.assertEqual(self.text('/usr/lib/systemd/user/omarchy-windows-audio-bridge.service'), 'guest unit\n')
+        self.assertEqual([p for p in self.root.rglob('.*try-omarchy-new')], [])
+        mode = (self.root / 'usr/share/fonts/omarchy/omarchy.ttf').stat().st_mode & 0o777
+        self.assertEqual(mode, 0o644)
+        self.assertIn('Updated /usr/share/fonts/omarchy/omarchy.ttf', result.stdout)
+
+    def test_second_run_changes_nothing_and_queries_nothing(self):
+        self.assertEqual(self.run_sync().returncode, 0)
+        self.queries.write_text('')
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(result.stdout, '')
+        # Identical files are settled without asking pacman.
+        self.assertEqual(self.queries.read_text(), '')
+
+    def test_never_replaces_a_file_another_package_owns(self):
+        self.owned.write_text('/usr/share/fonts/omarchy/omarchy.ttf\n'
+                              '/usr/lib/systemd/user/omarchy-fcitx5.service\n')
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.text('/usr/share/fonts/omarchy/omarchy.ttf'), 'font 4.0.4\n')
+        self.assertEqual(self.text('/usr/lib/systemd/user/omarchy-fcitx5.service'), 'unit 4.0.4\n')
+        self.assertEqual(self.text('/usr/share/fontconfig/conf.avail/50-omarchy.conf'), 'rules 4.5\n')
+
+    def test_leaves_links_and_directories_in_place(self):
+        font = self.root / 'usr/share/fonts/omarchy/omarchy.ttf'
+        font.unlink()
+        font.symlink_to('/elsewhere/omarchy.ttf')
+        unit = self.root / 'usr/lib/systemd/user/omarchy-fcitx5.service'
+        unit.unlink()
+        unit.mkdir()
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertTrue(font.is_symlink())
+        self.assertTrue(unit.is_dir())
+
+    def test_fastfetch_replaced_only_while_it_is_a_shipped_copy(self):
+        fastfetch = self.root / 'etc/fastfetch/config.jsonc'
+        # Missing: installed.
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(fastfetch.read_text(), 'fastfetch 4.5\n')
+        # Edited by an administrator: kept.
+        fastfetch.write_text('my own layout\n')
+        self.assertEqual(self.run_sync().returncode, 0)
+        self.assertEqual(fastfetch.read_text(), 'my own layout\n')
+
+    def test_fastfetch_from_omarchy_4_0_4_is_updated(self):
+        self.assertIn(OMARCHY_4_0_4_FASTFETCH, SYNC.read_text())
+        # Write bytes whose hash is in the shipped list by stubbing sha256sum.
+        fastfetch = self.root / 'etc/fastfetch/config.jsonc'
+        self.write(fastfetch, 'omarchy 4.0.4 fastfetch\n')
+        self.fake('sha256sum', f'echo "{OMARCHY_4_0_4_FASTFETCH}  $2"')
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(fastfetch.read_text(), 'fastfetch 4.5\n')
+
+    def test_unit_names_with_spaces_are_placed(self):
+        self.write(self.default / 'systemd/user/omarchy two words.service', 'spaced\n')
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(self.text('/usr/lib/systemd/user/omarchy two words.service'), 'spaced\n')
+
+    @unittest.skipIf(os.geteuid() == 0, 'root reads unreadable directories')
+    def test_a_unit_folder_that_cannot_be_listed_is_reported(self):
+        units = self.default / 'systemd/user'
+        units.chmod(0)
+        self.addCleanup(units.chmod, 0o755)
+        result = self.run_sync()
+        self.assertEqual(result.returncode, 1)
+        self.assertIn('Could not list', result.stderr)
+        # Everything else still syncs.
+        self.assertEqual(self.text('/usr/share/fonts/omarchy/omarchy.ttf'), 'font 4.5\n')
+
+    def test_managers_reload_only_on_a_live_system_after_unit_changes(self):
+        script = SYNC.read_text()
+        block = script[script.index('hook=/usr/share/libalpm/scripts/systemd-hook'):]
+        self.assertIn('if ((units_changed)) && [[ -z $root && -x $hook ]]; then', block)
+        self.assertIn('"$hook" daemon-reload-system', block)
+        self.assertIn('"$hook" daemon-reload-user', block)
+
+    def test_build_refuses_a_fastfetch_layout_missing_from_the_list(self):
+        materialize = (SYNC.parent / 'materialize-omarchy.sh').read_text()
+        guard = materialize.index('fastfetch_digest=$(sha256sum "$source_dir/etc/fastfetch/config.jsonc"')
+        self.assertLess(guard, materialize.index('"$root/usr/lib/try-omarchy/omarchy-etc/fastfetch/config.jsonc"'))
+        self.assertIn('grep -qxF "  $fastfetch_digest" "$guest_dir/scripts/sync-omarchy-system-files"', materialize)
+        # The guard matches the list's two-space lines exactly.
+        lines = [line for line in SYNC.read_text().splitlines() if line.strip() == OMARCHY_4_0_4_FASTFETCH]
+        self.assertEqual(lines, ['  ' + OMARCHY_4_0_4_FASTFETCH])
+
+    def test_shipped_fastfetch_hashes_are_well_formed(self):
+        hashes = [line.strip() for line in SYNC.read_text().splitlines()
+                  if len(line.strip()) == 64 and all(c in '0123456789abcdef' for c in line.strip())]
+        self.assertEqual(len(hashes), 7)
+        self.assertEqual(len(set(hashes)), 7)
+
+
+if __name__ == '__main__':
+    unittest.main()
-- 
