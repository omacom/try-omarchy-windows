From e68bf4367202783f524d3b15d126a72206c9b8aa Mon Sep 17 00:00:00 2001
From: Tyler South <tsouth2@gmail.com>
Date: Sun, 8 Nov 2026 11:22:55 -0500
Subject: [PATCH] Keep Omarchy's system files in step on updated disks

The image installs Omarchy's icon font, fontconfig rules and user units where
Omarchy's package would, but no package owns them, so Update > Omarchy left
an existing disk with 4.0.4's copies: missing 4.5 icons, older CJK font
fallback and the previous fcitx5 unit. The runtime package now runs a sync
after every install and upgrade that copies its own versions into place
wherever no package owns the target, and refreshes /etc/fastfetch only while
it is a copy Omarchy shipped.
It reloads systemd when units change, and the image build stops if Omarchy
ships a fastfetch layout the sync does not know.
---
 guest/scripts/materialize-omarchy.sh          |  11 ++
 guest/scripts/register-omarchy-runtime.sh     |   6 +
 guest/scripts/runtime-ownership.install       |  21 ++-
 guest/scripts/sync-omarchy-system-files       | 110 ++++++++++++
 guest/tests/test_runtime_package.py           |  18 ++
 guest/tests/test_sync_omarchy_system_files.py | 167 ++++++++++++++++++
 6 files changed, 332 insertions(+), 1 deletion(-)
 create mode 100755 guest/scripts/sync-omarchy-system-files
 create mode 100644 guest/tests/test_sync_omarchy_system_files.py

diff --git a/guest/scripts/materialize-omarchy.sh b/guest/scripts/materialize-omarchy.sh
index b691ce9..9f9acf8 100755
--- a/guest/scripts/materialize-omarchy.sh
+++ b/guest/scripts/materialize-omarchy.sh
@@ -295,6 +295,17 @@ install_file 0644 "$source_dir/default/wayland-sessions/omarchy.desktop" "$root/
 install_file 0644 "$source_dir/default/fonts/omarchy/omarchy.ttf" "$root/usr/share/fonts/omarchy/omarchy.ttf"
 install_file 0644 "$source_dir/etc/profile.d/omarchy.sh" "$root/etc/profile.d/omarchy.sh"
 install_file 0644 "$source_dir/etc/fastfetch/config.jsonc" "$root/etc/fastfetch/config.jsonc"
+# The runtime package carries the sync that keeps the unowned copies above in
+# step with it on existing disks, plus the /etc source it needs (etc/ is not
+# under /usr/share/omarchy). Fresh images register those paths as installed.
+# The sync replaces /etc/fastfetch/config.jsonc only while it is a layout it
+# knows Omarchy shipped, so a layout missing from its list would be kept on
+# updated disks as if an administrator had edited it.
+fastfetch_digest=$(sha256sum "$source_dir/etc/fastfetch/config.jsonc" | cut -d' ' -f1)
+grep -qxF "  $fastfetch_digest" "$guest_dir/scripts/sync-omarchy-system-files" ||
+  fail "add Omarchy's fastfetch layout $fastfetch_digest to sync-omarchy-system-files"
+install_file 0755 "$guest_dir/scripts/sync-omarchy-system-files" "$root/usr/lib/try-omarchy/sync-omarchy-system-files"
+install_file 0644 "$source_dir/etc/fastfetch/config.jsonc" "$root/usr/lib/try-omarchy/omarchy-etc/fastfetch/config.jsonc"
 
 # These upstream system defaults are needed by menu actions and security
 # fixes even though this guest does not run the bare-metal installer.
diff --git a/guest/scripts/register-omarchy-runtime.sh b/guest/scripts/register-omarchy-runtime.sh
index a6df4b3..895349c 100755
--- a/guest/scripts/register-omarchy-runtime.sh
+++ b/guest/scripts/register-omarchy-runtime.sh
@@ -115,6 +115,12 @@ for command in "${runtime_commands[@]}"; do
   cp -a "$root/usr/bin/$name" "$stage/usr/bin/$name"
 done
 
+# The sync the package's install script runs, and its /etc source copy.
+[[ -x $root/usr/lib/try-omarchy/sync-omarchy-system-files ]] || fail "missing Omarchy system file sync"
+[[ -f $root/usr/lib/try-omarchy/omarchy-etc/fastfetch/config.jsonc ]] || fail "missing Omarchy fastfetch source"
+install -Dm755 "$root/usr/lib/try-omarchy/sync-omarchy-system-files" "$stage/usr/lib/try-omarchy/sync-omarchy-system-files"
+install -Dm644 "$root/usr/lib/try-omarchy/omarchy-etc/fastfetch/config.jsonc" "$stage/usr/lib/try-omarchy/omarchy-etc/fastfetch/config.jsonc"
+
 # Keep the shader backend with the runtime command across package upgrades.
 install -Dm755 "$root/usr/local/bin/omarchy-native-nightlight" "$stage/usr/local/bin/omarchy-native-nightlight"
 install -Dm644 "$root/usr/local/share/try-omarchy/nightlight.frag" "$stage/usr/local/share/try-omarchy/nightlight.frag"
diff --git a/guest/scripts/runtime-ownership.install b/guest/scripts/runtime-ownership.install
index d590175..adf47a6 100644
--- a/guest/scripts/runtime-ownership.install
+++ b/guest/scripts/runtime-ownership.install
@@ -26,7 +26,7 @@ pre_upgrade() {
   done
 }
 
-post_upgrade() {
+restore_helpers() {
   local state=/var/lib/try-omarchy/runtime-ownership-recovery name path
   [[ -e $state || -L $state ]] || return 0
   [[ ! -L $state && -d $state && $(stat -c %u:%a "$state") == 0:700 ]] || return 1
@@ -43,3 +43,22 @@ post_upgrade() {
   done
   rmdir "$state" 2>/dev/null || true
 }
+
+# Omarchy's files outside /usr/share/omarchy (icon font, fontconfig rules, user
+# units) belong to no package, so follow this runtime's copies explicitly.
+sync_system_files() {
+  local sync=/usr/lib/try-omarchy/sync-omarchy-system-files
+  [[ -x $sync ]] || return 0
+  "$sync"
+}
+
+post_install() {
+  sync_system_files
+}
+
+post_upgrade() {
+  local status=0
+  restore_helpers || status=$?
+  sync_system_files || status=1
+  return "$status"
+}
diff --git a/guest/scripts/sync-omarchy-system-files b/guest/scripts/sync-omarchy-system-files
new file mode 100755
index 0000000..196d0c9
--- /dev/null
+++ b/guest/scripts/sync-omarchy-system-files
@@ -0,0 +1,110 @@
+#!/bin/bash
+# Bring Omarchy's files outside /usr/share/omarchy up to the runtime package
+# that was just installed. The image places them where Omarchy's own package
+# would, but no package owns them, so a runtime update alone leaves an existing
+# disk with the previous release's icon font, fontconfig rules and user units
+# while a fresh image has the new ones. The runtime package runs this after
+# every install and upgrade, so both end up with the same files.
+#
+# A target is replaced only when no package owns it, so a file another package
+# installed is never touched. /etc/fastfetch/config.jsonc is replaced only while
+# it is a copy Omarchy shipped, which keeps an administrator's edits.
+set -uo pipefail
+
+root=${TRY_OMARCHY_SYNC_ROOT:-}
+omarchy=$root/usr/share/omarchy/default
+etc_copies=$root/usr/lib/try-omarchy/omarchy-etc
+
+# Every /etc/fastfetch/config.jsonc Omarchy has shipped. The image build fails
+# when the layout it ships is missing here, so add each new one.
+fastfetch_shipped=(
+  00a6fbf9af83cfa5bdb9cd37bc0746bb42e99672fb7cc4d76a92778de720c2b4
+  1a0a085e7a80036f415148da21f772e99898de7e70768ec7b7613f8cc620700c
+  26e144d380fc91357d6d602f5eff3dae21eaad08c960ff360d76c227706ce484
+  31c3f90562f3986894f1c3dd5d0be53a203cf6b474236010e45840d6c6dc65cf
+  596f9c3ac3543d15023abc112f338fb9a8b8fa1198457bacda2b540c429c3dba
+  69170ab32697f6c6fba0ac3f8d34a03cd8929984894acef92475aef19a2094e3
+  9c69d06d17929742344be0d42d3dde67556f0f189625de39c0ab7ba16c30b45c
+)
+
+failed=0
+fonts_changed=0
+units_changed=0
+
+# Scriptlets run with pacman's root as /, so the system path is the query.
+owned() {
+  pacman -Qqo -- "$1" &>/dev/null
+}
+
+# Copy one file into place. Returns 0 when the target changed.
+place() {
+  local from=$1 path=$2 target=$root$2 next
+  [[ -f $from && ! -L $from ]] || return 1
+  # Leave links, directories and anything else that is not a plain file alone.
+  if [[ -L $target || (-e $target && ! -f $target) ]]; then
+    return 1
+  fi
+  if [[ -f $target ]] && cmp -s -- "$from" "$target"; then
+    return 1
+  fi
+  owned "$path" && return 1
+  next=$(dirname "$target")/.$(basename "$target").try-omarchy-new
+  if ! install -D -m 0644 -- "$from" "$next" || ! mv -fT -- "$next" "$target"; then
+    rm -f -- "$next"
+    echo "Could not update $path" >&2
+    failed=1
+    return 1
+  fi
+  echo "Updated $path"
+}
+
+# Omarchy's unit names have no newlines. Listing first lets a failed listing
+# be reported, and needs no /dev/fd, which a chrooted build may not have.
+place_tree() {
+  local from=$1 to=$2 relative list
+  [[ -d $from ]] || return 0
+  if ! list=$(cd -- "$from" && find . -type f -printf '%P\n' | sort); then
+    echo "Could not list $from" >&2
+    failed=1
+    return 0
+  fi
+  while IFS= read -r relative; do
+    [[ -n $relative ]] || continue
+    if place "$from/$relative" "$to/$relative"; then
+      units_changed=1
+    fi
+  done <<<"$list"
+}
+
+if place "$omarchy/fonts/omarchy/omarchy.ttf" /usr/share/fonts/omarchy/omarchy.ttf; then
+  fonts_changed=1
+fi
+if place "$omarchy/fontconfig/conf.avail/50-omarchy.conf" /usr/share/fontconfig/conf.avail/50-omarchy.conf; then
+  fonts_changed=1
+fi
+place_tree "$omarchy/systemd/user" /usr/lib/systemd/user
+place_tree "$omarchy/systemd/user@.service.d" /usr/lib/systemd/system/user@.service.d
+
+fastfetch=$root/etc/fastfetch/config.jsonc
+if [[ -f $etc_copies/fastfetch/config.jsonc ]]; then
+  current=""
+  [[ ! -f $fastfetch || -L $fastfetch ]] || current=$(sha256sum -- "$fastfetch" | cut -d' ' -f1)
+  if [[ ! -e $fastfetch && ! -L $fastfetch ]] || printf '%s\n' "${fastfetch_shipped[@]}" | grep -qxF -- "$current"; then
+    place "$etc_copies/fastfetch/config.jsonc" /etc/fastfetch/config.jsonc || true
+  fi
+fi
+
+if ((fonts_changed)) && [[ -z $root ]] && command -v fc-cache >/dev/null; then
+  fc-cache -s >/dev/null 2>&1 || true
+fi
+
+# systemd's own pacman hooks only fire for files a package lists, so reload
+# the system and user managers here. Arch's hook script skips a chroot or a
+# root that is not booted, as at image build time.
+hook=/usr/share/libalpm/scripts/systemd-hook
+if ((units_changed)) && [[ -z $root && -x $hook ]]; then
+  "$hook" daemon-reload-system || echo "Could not reload systemd" >&2
+  "$hook" daemon-reload-user || echo "Could not reload user services" >&2
+fi
+
+exit "$failed"
