+/*
+ * Before a window that started full screen first leaves it, give it a
+ * windowed size: three quarters of the usable area of its display (without
+ * the taskbar), centered there. SDL would otherwise restore the size the
+ * window was created with, taken from the guest's display at the time.
+ */
+static void sdl2_window_size_after_full_screen(struct sdl2_console *scon)
+{
+    SDL_Rect usable;
+    int display, w, h;
+
+    if (!scon->fullscreen_start) {
+        return;
+    }
+    scon->fullscreen_start = false;
+    display = SDL_GetWindowDisplayIndex(scon->real_window);
+    if (display < 0 || SDL_GetDisplayUsableBounds(display, &usable) ||
+        usable.w <= 0 || usable.h <= 0) {
+        return;
+    }
+    w = usable.w * 3 / 4;
+    h = usable.h * 3 / 4;
+    SDL_SetWindowSize(scon->real_window, w, h);
+    SDL_SetWindowPosition(scon->real_window, usable.x + (usable.w - w) / 2,
+                          usable.y + (usable.h - h) / 2);
+}
