+/* Playback counterpart of sdl_backoff_in(). Stream starts respect it too,
+ * so a slow failed open cannot repeat on every guest sound.
+ */
+static void sdl_backoff_out(SDLVoiceOut *sdl)
+{
+    int seconds = SDL_GetNumAudioDevices(0) > 0 ? 10 : 1;
+
+    sdl->next_open_attempt = g_get_monotonic_time() + seconds * G_USEC_PER_SEC;
+}
+
+static bool sdl_open_due_out(SDLVoiceOut *sdl)
+{
+    return g_get_monotonic_time() >= sdl->next_open_attempt;
+}
+
+static bool sdl_try_acquire_out(SDLVoiceOut *sdl)
+{
+    if (!sdl_open_due_out(sdl)) {
+        return false;
+    }
+    if (sdl_acquire_out(sdl)) {
+        sdl->next_open_attempt = 0;
+        return true;
+    }
+    sdl_backoff_out(sdl);
+    return false;
+}
