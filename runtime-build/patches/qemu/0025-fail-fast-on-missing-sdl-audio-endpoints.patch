+/*
+ * SDL's WASAPI backend retries a missing endpoint for eight seconds before
+ * failing, and QEMU opens devices on its main loop, so every attempt froze
+ * the VM. Ask Windows once whether the default endpoint exists. Any other
+ * answer, including a COM failure, leaves the decision to SDL as before.
+ */
+static bool sdl_default_endpoint_missing(int rec)
+{
+    /* CLSID_MMDeviceEnumerator and IID_IMMDeviceEnumerator, kept local so
+     * the runtime needs no extra import library. */
+    static const GUID clsid = { 0xbcde0395, 0xe52f, 0x467c,
+        { 0x8e, 0x3d, 0xc4, 0x57, 0x92, 0x91, 0x69, 0x2e } };
+    static const GUID iid = { 0xa95664d2, 0x9614, 0x4f35,
+        { 0xa7, 0x46, 0xde, 0x8d, 0xb6, 0x36, 0x17, 0xe6 } };
+    typedef HRESULT (WINAPI *CreateInstance)(REFCLSID, LPUNKNOWN, DWORD,
+                                             REFIID, LPVOID *);
+    HMODULE ole32 = GetModuleHandleW(L"ole32.dll");
+    CreateInstance create = ole32 ?
+        (CreateInstance)(void *)GetProcAddress(ole32, "CoCreateInstance") :
+        NULL;
+    IMMDeviceEnumerator *enumerator = NULL;
+    IMMDevice *device = NULL;
+    HRESULT hr;
+
+    if (!create || FAILED(create(&clsid, NULL, CLSCTX_INPROC_SERVER, &iid,
+                                 (void **)&enumerator)) || !enumerator) {
+        return false;
+    }
+    hr = enumerator->lpVtbl->GetDefaultAudioEndpoint(
+            enumerator, rec ? eCapture : eRender, eConsole, &device);
+    if (device) {
+        device->lpVtbl->Release(device);
+    }
+    enumerator->lpVtbl->Release(enumerator);
+    return hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND);
+}
+#endif
