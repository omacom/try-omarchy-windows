+void whpx_report_free_pages(hwaddr gpa, void *host, size_t size)
+{
+    MemoryRegionSection section;
+    MemoryRegion *mr;
+    RAMBlock *rb;
+    size_t page_size = qemu_real_host_page_size();
+    HRESULT hr;
+    void *committed;
+
+    assert(bql_locked());
+    if (!size || !QEMU_IS_ALIGNED(gpa | (uintptr_t)host | size, page_size)) {
+        return;
+    }
+
+    /* Only QEMU-owned, private, writable anonymous RAM can be safely
+     * decommitted. The complete GPA range must resolve to these host pages.
+     * Leave file-backed, external, ROM and dirty-logged memory alone.
+     */
+    section = memory_region_find(get_system_memory(), gpa, size);
+    mr = section.mr;
+    if (!mr) {
+        return;
+    }
+    rb = mr->ram_block;
+    if (!memory_region_is_ram(mr) || mr->readonly || mr->rom_device ||
+        memory_region_is_ram_device(mr) || !rb || rb->fd >= 0 ||
+        (rb->flags & (RAM_SHARED | RAM_PREALLOC)) ||
+        memory_region_get_dirty_log_mask(mr) ||
+        int128_get64(section.size) != size ||
+        section.offset_within_address_space != gpa ||
+        memory_region_get_ram_ptr(mr) + section.offset_within_region != host) {
+        memory_region_unref(mr);
+        return;
+    }
+
+    /* The guest has surrendered these free pages until the queue reply.
+     * Unmap their GPA, decommit their private VirtualAlloc backing, then
+     * recommit at the same VA. MEM_COMMIT guarantees zeroes on the next
+     * access while physical pages remain unallocated until they are used.
+     * Do not acknowledge the report if any step leaves an invalid mapping.
+     */
+    hr = whp_dispatch.WHvUnmapGpaRange(whpx_global.partition, gpa, size);
+    if (FAILED(hr)) {
+        error_report("WHPX free-page unmap failed: %08lx", hr);
+        abort();
+    }
+    if (!VirtualFree(host, size, MEM_DECOMMIT)) {
+        error_report("WHPX free-page decommit failed: %lu", GetLastError());
+        abort();
+    }
+    committed = VirtualAlloc(host, size, MEM_COMMIT, PAGE_READWRITE);
+    if (committed != host) {
+        error_report("WHPX free-page recommit failed: %lu", GetLastError());
+        abort();
+    }
+    hr = whp_dispatch.WHvMapGpaRange(whpx_global.partition, host, gpa, size,
+            WHvMapGpaRangeFlagRead | WHvMapGpaRangeFlagWrite |
+            WHvMapGpaRangeFlagExecute);
+    if (FAILED(hr)) {
+        error_report("WHPX free-page remap failed: %08lx", hr);
+        abort();
+    }
+    memory_region_unref(mr);
+}
