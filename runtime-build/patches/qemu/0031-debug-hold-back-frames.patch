+
+/* Test builds only: hold back frames for a while after a cloaked window
+ * came on screen. */
+bool sdl2_debug_frame_held(struct sdl2_console *scon)
+{
+    static int64_t delay = -1;
+    int64_t now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+
+    if (delay < 0) {
+        const char *value = getenv("OMARCHY_SDL_DEBUG_FRAME_DELAY_MS");
+        delay = value ? atoll(value) : 0;
+    }
+    if (!delay) {
+        return false;
+    }
+    if (!scon->debug_from && scon->cloaked && scon->cloak_shown) {
+        scon->debug_from = now;
+    }
+    if (scon->debug_from && now - scon->debug_from < delay) {
+        scon->debug_redraw = true;
+        return true;
+    }
+    return false;
+}
