+/*
+ * The guest takes the size the window gives it a second or more later, and
+ * a busy guest can show sizes a round of full screen or more out of date,
+ * in the order it was given them: after the window left full screen it can
+ * show the windowed size of the round before, then this round's full screen
+ * size, then the windowed size again. The sizes the window had while full
+ * screen are remembered (record). Once it has left full screen the window
+ * does not follow the guest to one of them unless it is the size the window
+ * asks the guest for now, until the user asks for the guest's size with
+ * Ctrl+Alt+0 or the window goes full screen again. Which sizes the guest has
+ * shown says nothing about what is still on its way, so they do not end it.
+ */
+static bool sdl2_full_screen_size(struct sdl2_console *scon, int w, int h,
+                                  bool record)
+{
+    int n = ARRAY_SIZE(scon->full_screen_size);
+    int i;
+
+    for (i = 0; i < scon->full_screen_sizes; i++) {
+        if (scon->full_screen_size[i][0] == w &&
+            scon->full_screen_size[i][1] == h) {
+            return true;
+        }
+    }
+    if (record) {
+        if (scon->full_screen_sizes == n) {
+            memmove(scon->full_screen_size[0], scon->full_screen_size[1],
+                    sizeof(scon->full_screen_size[0]) * (n - 1));
+            scon->full_screen_sizes--;
+        }
+        scon->full_screen_size[scon->full_screen_sizes][0] = w;
+        scon->full_screen_size[scon->full_screen_sizes][1] = h;
+        scon->full_screen_sizes++;
+    }
+    return false;
+}
