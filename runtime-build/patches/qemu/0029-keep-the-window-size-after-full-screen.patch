                       surface_width(scon->surface),
@@ -529,19 +580,41 @@
                           usable.y + (usable.h - h) / 2);
 }
 
+/* Remember the size a full screen window has now (sdl2_full_screen_size). */
+static void sdl2_record_full_screen_size(struct sdl2_console *scon)
+{
+    int w, h;
+
+    SDL_GetWindowSize(scon->real_window, &w, &h);
+    sdl2_full_screen_size(scon, w, h, true);
+}
