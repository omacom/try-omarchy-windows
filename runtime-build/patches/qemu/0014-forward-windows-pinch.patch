     .parent        = TYPE_VIRTIO_PCI,
@@ -156,6 +165,13 @@
     .instance_init = virtio_multitouch_initfn,
 };
 
+static const VirtioPCIDeviceTypeInfo virtio_pinch_pci_info = {
