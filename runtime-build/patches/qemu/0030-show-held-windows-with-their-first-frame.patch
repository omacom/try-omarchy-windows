+
+/*
+ * The launcher hides a held window with an empty window region, and nothing
+ * QEMU presents reaches a window with an empty region. When the region came
+ * back the window showed what its surface held from before, black or white,
+ * until QEMU's next frame. So a held window is also cloaked: DWM goes on
+ * composing it, and frames reach it, but nothing of it shows. It stays
+ * cloaked until it is shown with a region that is not empty and QEMU has
+ * presented a frame at the size it has then. It is uncloaked anyway
+ * WIN_CLOAK_FRAME_WAIT_MS after it came on screen without such a frame,
+ * WIN_CLOAK_MAX_MS after it was cloaked, on Ctrl+Alt+F and when it is
+ * destroyed, so it can never stay invisible. If DWM refuses the cloak the
+ * window behaves as before.
+ */
+#define WIN_CLOAK_FRAME_WAIT_MS 1000
+#define WIN_CLOAK_MAX_MS 600000
+#define WIN_DWMWA_CLOAK 13
+
+typedef HRESULT (WINAPI *win_dwm_set_attribute_fn)(HWND, DWORD, LPCVOID, DWORD);
+typedef HRESULT (WINAPI *win_dwm_flush_fn)(void);
+static win_dwm_set_attribute_fn win_dwm_set_attribute;
+static win_dwm_flush_fn win_dwm_flush;
+
+static bool win_cloak_set(HWND hwnd, BOOL on)
+{
+    static bool loaded;
+
+    if (!loaded) {
+        HMODULE dwm = LoadLibraryW(L"dwmapi.dll");
+
+        loaded = true;
+        if (dwm) {
+            win_dwm_set_attribute = (win_dwm_set_attribute_fn)(void (*)(void))
+                GetProcAddress(dwm, "DwmSetWindowAttribute");
+            win_dwm_flush = (win_dwm_flush_fn)(void (*)(void))
+                GetProcAddress(dwm, "DwmFlush");
+        }
+    }
+    return win_dwm_set_attribute &&
+        SUCCEEDED(win_dwm_set_attribute(hwnd, WIN_DWMWA_CLOAK, &on, sizeof(on)));
+}
+
+static void win_cloak_start(struct sdl2_console *scon, HWND hwnd)
+{
+    scon->cloaked = win_cloak_set(hwnd, TRUE);
+    scon->cloak_shown = 0;
+    scon->cloak_framed = false;
+    scon->cloak_until = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + WIN_CLOAK_MAX_MS;
+}
+
+/* A refused uncloak is tried again on the next round. */
+static void win_cloak_end(struct sdl2_console *scon)
+{
+    HWND hwnd;
+
+    if (!scon->cloaked) {
+        return;
+    }
+    hwnd = win_hold_hwnd(scon->real_window);
+    if (!hwnd || win_cloak_set(hwnd, FALSE)) {
+        scon->cloaked = false;
+    }
+}
+
+/* Shown and with a region that is not empty: on screen if not cloaked. */
+static bool win_cloak_exposed(HWND hwnd)
+{
+    HRGN region;
+    int kind;
+
+    if (!IsWindowVisible(hwnd)) {
+        return false;
+    }
+    region = CreateRectRgn(0, 0, 0, 0);
+    if (!region) {
+        return true;
+    }
+    kind = GetWindowRgn(hwnd, region);
+    DeleteObject(region);
+    return kind != NULLREGION;
+}
+
+static bool win_cloak_size_is(HWND hwnd, int w, int h)
+{
+    RECT client;
+
+    return GetClientRect(hwnd, &client) &&
+        client.right - client.left == w && client.bottom - client.top == h;
+}
+
+/* Runs after each round of window messages; true asks for a frame. */
+static bool win_cloak_poll(struct sdl2_console *scon)
+{
+    HWND hwnd;
+    int64_t now;
+
+    if (!scon->cloaked) {
+        return false;
+    }
+    hwnd = win_hold_hwnd(scon->real_window);
+    now = qemu_clock_get_ms(QEMU_CLOCK_REALTIME);
+    if (!hwnd || now >= scon->cloak_until) {
+        win_cloak_end(scon);
+        return false;
+    }
+    if (!win_cloak_exposed(hwnd)) {
+        scon->cloak_shown = 0;
+        scon->cloak_framed = false;
+        return false;
+    }
+    if (!scon->cloak_shown) {
+        HDC dc = GetDC(hwnd);
+        RECT client;
+
+        /* SDL paints a window black only on the first erase in the process,
+         * which a held window misses while its region is empty, and nothing
+         * else draws in its surface: black, not white, if no frame comes. */
+        if (dc) {
+            if (GetClientRect(hwnd, &client)) {
+                FillRect(dc, &client, (HBRUSH)GetStockObject(BLACK_BRUSH));
+            }
+            ReleaseDC(hwnd, dc);
+        }
+        scon->cloak_shown = now;
+        scon->cloak_framed = false;
+        return true;
+    }
+    if (scon->cloak_framed && win_cloak_size_is(hwnd, scon->cloak_w, scon->cloak_h)) {
+        /* Let DWM compose the frame before the window shows. */
+        if (win_dwm_flush) {
+            win_dwm_flush();
+        }
+        win_cloak_end(scon);
+        return false;
+    }
+    if (now - scon->cloak_shown >= WIN_CLOAK_FRAME_WAIT_MS) {
+        win_cloak_end(scon);
+        return false;
+    }
+    /* The window was resized after the frame: wait for one at its size. */
+    if (scon->cloak_framed) {
+        scon->cloak_framed = false;
+        return true;
+    }
+    return false;
+}
+
+/* QEMU presented a frame drawn at w x h. */
+static void win_cloak_presented(struct sdl2_console *scon, int w, int h)
+{
+    HWND hwnd;
+
+    if (!scon->cloaked || !scon->cloak_shown) {
+        return;
+    }
+    hwnd = win_hold_hwnd(scon->real_window);
+    if (hwnd && win_cloak_exposed(hwnd) && win_cloak_size_is(hwnd, w, h)) {
+        scon->cloak_framed = true;
+        scon->cloak_w = w;
+        scon->cloak_h = h;
+    }
+}
 #else
 static inline int win_hold_flags(struct sdl2_console *scon) { return 0; }
 static inline void win_hold_window(struct sdl2_console *scon) {}
 static inline void win_hold_release(struct sdl2_console *scon, bool show) {}
 static inline void win_hold_poll(struct sdl2_console *scon) {}
+static inline void win_cloak_end(struct sdl2_console *scon) {}
+static inline bool win_cloak_poll(struct sdl2_console *scon) { return false; }
+static inline void win_cloak_presented(struct sdl2_console *scon, int w, int h) {}
 #endif
 #endif
