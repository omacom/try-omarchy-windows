diff --git a/src/winq_venus_trace.c b/src/winq_venus_trace.c
new file mode 100644
index 0000000..100e825
--- /dev/null
+++ b/src/winq_venus_trace.c
@@ -0,0 +1,351 @@
+/* SPDX-License-Identifier: MIT */
+/* Opt-in metadata tracing. No renderer lock, wait, timeout or memory policy
+ * is changed. Registry lock is never held across an instrumented operation.
+ */
+#include "c11/threads.h"
+#include "config.h"
+#include "virglrenderer.h"
+#include <errno.h>
+#include <inttypes.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#ifdef _WIN32
+#include <wchar.h>
+#include <windows.h>
+#else
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#endif
+
+#define TRACE_LIMIT (16u * 1024u * 1024u)
+#define TRACE_BACKUPS 3
+struct trace_call
+{
+   struct trace_call *next;
+   uint64_t id, tid, start, device;
+   uint32_t ctx;
+   bool reported;
+   char op[96], args[768];
+};
+static once_flag once = ONCE_FLAG_INIT;
+static atomic_int enabled = ATOMIC_VAR_INIT(-1);
+static atomic_bool stop;
+static mtx_t mutex;
+static thrd_t watchdog;
+static bool watchdog_started;
+static struct trace_call *calls;
+static uint64_t serial, pid;
+static FILE *logfile, *flightfile;
+static size_t logbytes, flightbytes;
+#ifdef _WIN32
+static wchar_t logpath[32768], flightpath[32768];
+static LARGE_INTEGER frequency;
+#else
+static char logpath[4096], flightpath[4120];
+#endif
+
+static uint64_t now_ms(void)
+{
+#ifdef _WIN32
+   LARGE_INTEGER t;
+   QueryPerformanceCounter(&t);
+   return (uint64_t)(t.QuadPart / frequency.QuadPart) * 1000 +
+          (uint64_t)(t.QuadPart % frequency.QuadPart) * 1000 / frequency.QuadPart;
+#else
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (uint64_t)t.tv_sec * 1000 + t.tv_nsec / 1000000;
+#endif
+}
+static uint64_t thread_id(void)
+{
+#ifdef _WIN32
+   return GetCurrentThreadId();
+#else
+   return (uint64_t)syscall(SYS_gettid);
+#endif
+}
+static void clean_line(char *s)
+{
+   for (; *s; s++)
+      if (*s == '\r' || *s == '\n')
+         *s = ' ';
+}
+/* Called under the trace mutex only. Each channel is bounded to 64 MiB.
+ * The separate in-flight channel preserves dumps during busy timeout logs.
+ */
+static void rotate(bool flight)
+{
+   FILE **file = flight ? &flightfile : &logfile;
+   size_t *bytes = flight ? &flightbytes : &logbytes;
+   if (*file)
+      fclose(*file);
+#ifdef _WIN32
+   const wchar_t *path = flight ? flightpath : logpath;
+   wchar_t from[32768], to[32768];
+   for (int n = TRACE_BACKUPS; n >= 1; n--)
+   {
+      swprintf(to, 32768, L"%ls.%d", path, n);
+      if (n == 1)
+         swprintf(from, 32768, L"%ls", path);
+      else
+         swprintf(from, 32768, L"%ls.%d", path, n - 1);
+      _wremove(to);
+      _wrename(from, to);
+   }
+   *file = _wfopen(path, L"w");
+#else
+   const char *path = flight ? flightpath : logpath;
+   char from[4160], to[4160];
+   for (int n = TRACE_BACKUPS; n >= 1; n--)
+   {
+      snprintf(to, sizeof(to), "%s.%d", path, n);
+      if (n == 1)
+         snprintf(from, sizeof(from), "%s", path);
+      else
+         snprintf(from, sizeof(from), "%s.%d", path, n - 1);
+      remove(to);
+      rename(from, to);
+   }
+   *file = fopen(path, "w");
+#endif
+   if (*file)
+      setvbuf(*file, NULL, _IOLBF, 0);
+   *bytes = 0;
+}
+static void emit(bool flight, const struct trace_call *c, const char *phase,
+                 const char *extra)
+{
+   FILE **file = flight ? &flightfile : &logfile;
+   size_t *bytes = flight ? &flightbytes : &logbytes;
+   if (*bytes >= TRACE_LIMIT)
+      rotate(flight);
+   if (!*file)
+      return;
+   int n = fprintf(*file,
+                   "ms=%" PRIu64 " pid=%" PRIu64 " tid=%" PRIu64 " ctx=%u dev=0x%" PRIx64
+                   " call=%" PRIu64 " %s op=%s %s %s\n",
+                   now_ms(), pid, c->tid, c->ctx, c->device, c->id, phase, c->op, c->args,
+                   extra);
+   if (n > 0)
+      *bytes += n;
+   fflush(*file);
+}
+static int watch(void *unused)
+{
+   (void)unused;
+   while (!atomic_load_explicit(&stop, memory_order_relaxed))
+   {
+      const struct timespec pause = {.tv_sec = 1};
+      thrd_sleep(&pause, NULL);
+      mtx_lock(&mutex);
+      uint64_t now = now_ms();
+      for (struct trace_call *trigger = calls; trigger; trigger = trigger->next)
+      {
+         if (trigger->reported || now - trigger->start <= 5000)
+            continue;
+         trigger->reported = true;
+         char detail[160];
+         snprintf(detail, sizeof(detail), "age_ms=%" PRIu64 " dump_trigger=%" PRIu64,
+                  now - trigger->start, trigger->id);
+         emit(false, trigger, "IN-FLIGHT", detail);
+         /* One complete open-call dump for each newly stuck call. */
+         for (struct trace_call *c = calls; c; c = c->next)
+         {
+            snprintf(detail, sizeof(detail), "age_ms=%" PRIu64 " dump_trigger=%" PRIu64,
+                     now - c->start, trigger->id);
+            emit(true, c, "IN-FLIGHT", detail);
+         }
+      }
+      mtx_unlock(&mutex);
+   }
+   return 0;
+}
+static void init(void)
+{
+   const char *flag = getenv("WINQ_VENUS_TRACE");
+   if (!flag || strcmp(flag, "1"))
+   {
+      atomic_store(&enabled, 0);
+      return;
+   }
+   if (mtx_init(&mutex, mtx_plain) != thrd_success)
+   {
+      atomic_store(&enabled, 0);
+      return;
+   }
+#ifdef _WIN32
+   pid = GetCurrentProcessId();
+   QueryPerformanceFrequency(&frequency);
+   wchar_t folder[32768];
+   DWORD len = GetEnvironmentVariableW(L"LOCALAPPDATA", folder, 32768);
+   if (!len || len > 32000)
+   {
+      atomic_store(&enabled, 0);
+      return;
+   }
+   wcscat(folder, L"\\winq-emu");
+   CreateDirectoryW(folder, NULL);
+   wcscat(folder, L"\\venus-trace");
+   CreateDirectoryW(folder, NULL);
+   swprintf(logpath, 32768, L"%ls\\venus-%llu-%llu.log", folder, (unsigned long long)pid,
+            (unsigned long long)now_ms());
+   swprintf(flightpath, 32768, L"%ls.inflight", logpath);
+   logfile = _wfopen(logpath, L"w");
+   flightfile = _wfopen(flightpath, L"w");
+#else
+   pid = getpid();
+   const char *base = getenv("LOCALAPPDATA");
+   char folder[4000];
+   if (!base)
+      base = "/tmp";
+   if (snprintf(folder, sizeof(folder), "%s/winq-emu", base) >= (int)sizeof(folder) - 32)
+   {
+      atomic_store(&enabled, 0);
+      return;
+   }
+   mkdir(folder, 0700);
+   strcat(folder, "/venus-trace");
+   mkdir(folder, 0700);
+   snprintf(logpath, sizeof(logpath), "%s/venus-%" PRIu64 "-%" PRIu64 ".log", folder, pid,
+            now_ms());
+   snprintf(flightpath, sizeof(flightpath), "%s.inflight", logpath);
+   logfile = fopen(logpath, "w");
+   flightfile = fopen(flightpath, "w");
+#endif
+   if (logfile)
+      setvbuf(logfile, NULL, _IOLBF, 0);
+   if (flightfile)
+      setvbuf(flightfile, NULL, _IOLBF, 0);
+   if (!logfile || !flightfile)
+   {
+      atomic_store(&enabled, 0);
+      return;
+   }
+#ifdef _WIN32
+   /* Never join from DLL_PROCESS_DETACH under the Windows loader lock.
+    * Pin the diagnostic DLL while its process-lifetime watcher is running.
+    * Windows terminates this thread along with the process.
+    */
+   HMODULE module;
+   GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                          GET_MODULE_HANDLE_EX_FLAG_PIN,
+                      (LPCWSTR)(uintptr_t)watch, &module);
+#endif
+   watchdog_started = thrd_create(&watchdog, watch, NULL) == thrd_success;
+   struct trace_call info = {.tid = thread_id()};
+   strcpy(info.op, "trace.init");
+   emit(false, &info, "INFO",
+        watchdog_started ? "watchdog=on cap_bytes=16777216 backups=3"
+                         : "watchdog=FAILED");
+   atomic_store(&enabled, 1);
+}
+bool winq_venus_trace_enabled(void)
+{
+   int current = atomic_load_explicit(&enabled, memory_order_relaxed);
+   if (current >= 0)
+      return current == 1;
+   int saved_errno = errno;
+#ifdef _WIN32
+   DWORD saved_error = GetLastError();
+#endif
+   if (atomic_load_explicit(&enabled, memory_order_relaxed) < 0)
+      call_once(&once, init);
+   bool on = atomic_load_explicit(&enabled, memory_order_relaxed) == 1;
+   errno = saved_errno;
+#ifdef _WIN32
+   SetLastError(saved_error);
+#endif
+   return on;
+}
+uint64_t winq_venus_trace_enter(uint32_t ctx, uint64_t device, const char *op,
+                                const char *fmt, ...)
+{
+   if (!winq_venus_trace_enabled())
+      return 0;
+   int saved_errno = errno;
+#ifdef _WIN32
+   DWORD saved_error = GetLastError();
+#endif
+   struct trace_call *c = calloc(1, sizeof(*c));
+   if (!c)
+   {
+      errno = saved_errno;
+#ifdef _WIN32
+      SetLastError(saved_error);
+#endif
+      return 0;
+   }
+   c->ctx = ctx;
+   c->device = device;
+   c->tid = thread_id();
+   c->start = now_ms();
+   snprintf(c->op, sizeof(c->op), "%s", op);
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(c->args, sizeof(c->args), fmt, ap);
+   va_end(ap);
+   clean_line(c->args);
+   mtx_lock(&mutex);
+   c->id = ++serial;
+   c->next = calls;
+   calls = c;
+   emit(false, c, "ENTER", "");
+   uint64_t id = c->id;
+   mtx_unlock(&mutex);
+   errno = saved_errno;
+#ifdef _WIN32
+   SetLastError(saved_error);
+#endif
+   return id;
+}
+void winq_venus_trace_exit(uint64_t id, const char *fmt, ...)
+{
+   if (!id || !winq_venus_trace_enabled())
+      return;
+   int saved_errno = errno;
+#ifdef _WIN32
+   DWORD saved_error = GetLastError();
+#endif
+   char detail[768];
+   va_list ap;
+   va_start(ap, fmt);
+   vsnprintf(detail, sizeof(detail), fmt, ap);
+   va_end(ap);
+   clean_line(detail);
+   mtx_lock(&mutex);
+   struct trace_call **prev = &calls;
+   while (*prev && (*prev)->id != id)
+      prev = &(*prev)->next;
+   if (*prev)
+   {
+      struct trace_call *c = *prev;
+      emit(false, c, "EXIT", detail);
+      *prev = c->next;
+      free(c);
+   }
+   mtx_unlock(&mutex);
+   errno = saved_errno;
+#ifdef _WIN32
+   SetLastError(saved_error);
+#endif
+}
+#ifndef _WIN32
+__attribute__((destructor)) static void fini(void)
+{
+   if (watchdog_started)
+   {
+      atomic_store(&stop, true);
+      thrd_join(watchdog, NULL);
+   }
+   if (logfile)
+      fclose(logfile);
+   if (flightfile)
+      fclose(flightfile);
+}
+
+#endif
