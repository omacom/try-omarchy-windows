+/*
+ * Socket transfers of a context worker.
+ *
+ * Only server_destroy_worker closes a worker's socket, after the worker has
+ * exited, so the handle value cannot be reused while the worker may still use
+ * it. To stop a worker, the server sets stop_event instead. Each transfer is
+ * overlapped and waits for its completion or for stop_event; a stopped
+ * transfer is cancelled, and waited for, before it returns. A worker that is
+ * busy in a command when the stop comes sees it before its next transfer.
+ * shutdown() is no substitute: on Windows it does not wake a blocked recv
+ * while QEMU's end of the socket is still open.
+ */
 static bool
-server_recv_with_fds(int fd, void *data, size_t size,
+server_worker_transfer(struct server_context_worker *w, bool out,
+                       void *data, size_t len)
+{
+   const SOCKET s = (SOCKET)w->socket_fd;
+   char *p = data;
+   while (len > 0) {
+      if (WaitForSingleObject(w->stop_event, 0) != WAIT_TIMEOUT)
+         return false;
+
+      WSABUF buf = { .len = (ULONG)len, .buf = p };
+      WSAOVERLAPPED ov = { .hEvent = w->io_event };
+      DWORD flags = 0;
+      WSAResetEvent(w->io_event);
+      const int ret = out ? WSASend(s, &buf, 1, NULL, 0, &ov, NULL)
+                          : WSARecv(s, &buf, 1, NULL, &flags, &ov, NULL);
+      if (ret == SOCKET_ERROR && WSAGetLastError() != WSA_IO_PENDING)
+         return false;
+
+      const HANDLE events[2] = { w->stop_event, w->io_event };
+      const DWORD woken = WaitForMultipleObjects(2, events, FALSE, INFINITE);
+      if (woken != WAIT_OBJECT_0 + 1)
+         CancelIoEx((HANDLE)s, (LPOVERLAPPED)&ov);
+
+      DWORD got = 0;
+      const BOOL done = WSAGetOverlappedResult(s, &ov, &got, TRUE, &flags);
+      if (!done || woken != WAIT_OBJECT_0 + 1 || got == 0)
+         return false;
+      p += got;
+      len -= got;
+   }
+   return true;
+}
