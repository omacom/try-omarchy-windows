+/*
+ * Stops a worker that has already been unlinked from state->workers.
+ *
+ * Call it without workers_mutex held. The worker's vkr_context_destroy joins
+ * the context's queue threads, and a queue thread retiring a fence takes
+ * workers_mutex in server_retire_fence_cb. Joining the worker with the mutex
+ * held deadlocks the server thread, and with it QEMU's main loop, which waits
+ * for the server's reply to the next context creation.
+ *
+ * The worker's socket is closed only here, once the worker has exited; see
+ * server_worker_transfer for how the worker is stopped. The worker used to
+ * close it as well, after the server had closed it to wake the worker, which
+ * could close an unrelated handle that reused the value.
+ */
 static void
-server_destroy_worker(struct server_thread_state *state,
-                      struct server_context_worker *w)
+server_destroy_worker(struct server_context_worker *w)
 {
-   /* Close our end; worker thread will exit when recv fails */
-   closesocket((SOCKET)w->socket_fd);
+   SetEvent(w->stop_event);
    thrd_join(w->thread, NULL);
-
-   list_del(&w->head);
+   closesocket((SOCKET)w->socket_fd);
+   CloseHandle(w->stop_event);
+   WSACloseEvent(w->io_event);
    free(w);
 }
 
+static void
+server_destroy_all_workers(struct server_thread_state *state)
+{
+   struct list_head doomed;
+   list_inithead(&doomed);
+
+   mtx_lock(&state->workers_mutex);
+   list_splicetail(&state->workers, &doomed);
+   list_inithead(&state->workers);
+   mtx_unlock(&state->workers_mutex);
+
+   list_for_each_entry_safe(struct server_context_worker, w, &doomed, head)
+      server_destroy_worker(w);
+}
