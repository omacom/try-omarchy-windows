+/* Whether imported images get a pitch copy (vrend_import_pitch_width).
+ * Linear textures made with GL_EXT_memory_object use the GL driver's own row
+ * pitch, not the one the image was laid out with. On Intel's Windows drivers a
+ * Venus image whose width is not a multiple of 64 pixels reads skewed (#394).
+ * TRYOMARCHY_PITCH_COPY=on uses the copy on any driver and =off never. */
+static bool vrend_pitch_copy_imports(bool intel_windows)
+{
+   const char *env = getenv("TRYOMARCHY_PITCH_COPY");
+   if (env && !strcmp(env, "on"))
+      return true;
+   if (env && !strcmp(env, "off"))
+      return false;
+   return intel_windows;
+}
