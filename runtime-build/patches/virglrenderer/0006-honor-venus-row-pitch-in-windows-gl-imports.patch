+/* Texture width that matches an imported image's row pitch when it is wider
+ * than the image, or 0 to import the image as is. */
+static GLsizei vrend_import_pitch_width(const struct vrend_resource *gr,
+                                        const struct vrend_renderer_resource_set_type_args *args,
+                                        uint64_t map_size)
+{
+   if (!vrend_state.pitch_copy_imports || !has_feature(feat_copy_image) ||
+       !has_feature(feat_texture_storage))
+      return 0;
+   if (gr->base.target != PIPE_TEXTURE_2D || gr->base.nr_samples > 1 ||
+       args->plane_count != 1 || !args->width || !args->height)
+      return 0;
+
+   const uint32_t block = util_format_get_blocksize(gr->base.format);
+   const uint32_t stride = args->plane_strides[0];
+   if (!block || stride % block || stride / block <= args->width ||
+       stride / block > args->width + 4096 ||
+       (uint64_t)stride * args->height > map_size)
+      return 0;
+   return (GLsizei)(stride / block);
+}
