#version 450
// Each invocation writes a value the probe recomputes on the CPU.
layout(local_size_x = 64) in;
layout(std430, binding = 0) buffer Data { uint v[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint x = i * 2654435761u;
    for (int k = 0; k < 64; k++)
        x = x * 1664525u + 1013904223u;
    v[i] = x;
}
