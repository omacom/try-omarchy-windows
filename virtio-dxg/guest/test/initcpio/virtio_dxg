#!/usr/bin/ash
# mkinitcpio late hook for virtio-dxg development boots (added by
# mkdevinitramfs.py; never part of a shipped image). Runs as root before
# the real root starts: loads the guest module, which stays loaded after
# switch_root, and mounts the shares the VM was started with:
#
#   wsllib      System32\lxss\lib (NVIDIA's dxgkrnl user-mode libraries)
#   wslcore     Program Files\WSL\lib (libdxcore, libd3d12)
#   wsldrivers  the DriverStore FileRepository, read-only, as under WSL2
#   vdxgshare   development files and results
#   vdxgdrivers NVIDIA's driver folder (Wine's DriverStore path)

mount_share() {
    mkdir -p "/new_root$2"
    # cache=mmap: Wine maps DLL images and ld.so maps libraries from these.
    if mount -t 9p -o trans=virtio,version=9p2000.L,msize=1048576,cache=mmap \
            "$1" "/new_root$2" 2>/dev/null; then
        echo ":: virtio-dxg: mounted $1 on $2"
    fi
}

run_latehook() {
    if insmod /virtio-dxg/dxgkrnl_virtio.ko; then
        echo ":: virtio-dxg: dxgkrnl_virtio loaded"
    else
        echo ":: virtio-dxg: loading dxgkrnl_virtio failed" >&2
    fi
    # Wine 11 makes one 32 GiB address-space reservation that the default
    # overcommit heuristic refuses in an 8 GiB guest.
    echo 1 >/proc/sys/vm/overcommit_memory
    modprobe -q 9pnet_virtio
    modprobe -q 9p
    mount_share wsllib /usr/lib/wsl/lib
    mount_share wslcore /usr/lib/wsl/core
    mount_share wsldrivers /usr/lib/wsl/drivers
    mount_share vdxgshare /mnt/vdxgshare
    mount_share vdxgdrivers /mnt/vdxgdrivers
    # virtio_dxg.desktop=1: the whole session renders on the host GPU.
    # Mesa's software path (which CPU mode already uses for Hyprland and
    # its apps) then runs its d3d12 driver, i.e. NVIDIA's D3D12 driver
    # over /dev/dxg, instead of llvmpipe; VA-API decodes and Dozen runs
    # Vulkan on it too. The compositor needs virtio-dxg's Mesa build (KMS
    # mirrors for scanout, guest/mesa/), unpacked from the development share.
    case " $(cat /proc/cmdline) " in
    *" virtio_dxg.desktop=1 "*)
        printf '%s\n' /usr/lib/wsl/lib /usr/lib/wsl/core \
            >/new_root/etc/ld.so.conf.d/virtio-dxg.conf
        chroot /new_root /usr/bin/ldconfig
        mkdir -p /new_root/etc/environment.d
        env=/new_root/etc/environment.d/90-virtio-dxg.conf
        # Clients take Mesa's software winsys (wl_shm buffers) with d3d12
        # rendering, as under WSLg; the compositor renders on d3d12 into
        # KMS-mirrored scanout buffers.
        printf '%s\n' GALLIUM_DRIVER=d3d12 LIBGL_ALWAYS_SOFTWARE=1 \
            MESA_D3D12_DEFAULT_ADAPTER_NAME=NVIDIA LIBVA_DRIVER_NAME=d3d12 \
            >"$env"
        m=/opt/virtio-dxg-mesa
        tarball=/mnt/vdxgshare/out/mesa-virtio-dxg.tar
        if [ -f "/new_root$tarball" ]; then
            mkdir -p "/new_root$m"
            chroot /new_root /usr/bin/tar -xf "$tarball" -C "$m"
            chroot /new_root /usr/bin/sed -i "s|/usr/lib/libvulkan_dzn.so|$m/lib/libvulkan_dzn.so|" \
                "$m/share/vulkan/icd.d/dzn_icd.x86_64.json"
            printf '%s\n' "LD_LIBRARY_PATH=$m/lib" \
                "LIBGL_DRIVERS_PATH=$m/lib/dri" "GBM_BACKENDS_PATH=$m/lib/gbm" \
                "LIBVA_DRIVERS_PATH=$m/lib/dri" \
                "VK_DRIVER_FILES=$m/share/vulkan/icd.d/dzn_icd.x86_64.json" \
                >>"$env"
            echo ":: virtio-dxg: Mesa $(cat "/new_root$m/lib/virtio-dxg-mesa-version")"
        fi
        echo ":: virtio-dxg: desktop renders through d3d12"
        ;;
    esac
    # virtio_dxg.root=1: run vdxgshare/root.sh as root once the network is
    # up (development boots of a snapshot disk only; output in out/root.log).
    case " $(cat /proc/cmdline) " in
    *" virtio_dxg.root=1 "*)
        cat >/new_root/etc/systemd/system/virtio-dxg-root.service <<'EOF'
[Unit]
Description=virtio-dxg development root script
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c '/bin/bash /mnt/vdxgshare/root.sh >/mnt/vdxgshare/out/root.log 2>&1'
EOF
        mkdir -p /new_root/etc/systemd/system/multi-user.target.wants
        ln -sf ../virtio-dxg-root.service \
            /new_root/etc/systemd/system/multi-user.target.wants/
        ;;
    esac
    # The account the launcher's per-boot SSH authorizes (same rule as its
    # request-sshd), so the host test knows whom to log in as.
    if [ -d /new_root/mnt/vdxgshare/out ]; then
        awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /nologin|false/ {
            print $1; exit }' /new_root/etc/passwd \
            >/new_root/mnt/vdxgshare/out/account
    fi
}
