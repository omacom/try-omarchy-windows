+   if (res->mirror_has_fd) {
+      sync.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_WRITE;
+      ioctl(res->mirror_fd, DMA_BUF_IOCTL_SYNC, &sync);
+   }
+#endif
+   pipe_buffer_unmap(&ctx->base, xfer);
