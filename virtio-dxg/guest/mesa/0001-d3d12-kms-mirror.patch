+void
+d3d12_mirror_sync(struct d3d12_context *ctx)
+{
+   unsigned count = util_dynarray_num_elements(&ctx->mirror_dirty,
+                                               struct pipe_resource *);
+   if (!count)
+      return;
+   struct pipe_resource **list = (struct pipe_resource **)
+      malloc(count * sizeof(*list));
+   if (!list)
+      return;
+   memcpy(list, ctx->mirror_dirty.data, count * sizeof(*list));
+   util_dynarray_clear(&ctx->mirror_dirty);
+
+   bool recorded = false;
+   for (unsigned i = 0; i < count; i++) {
+      struct d3d12_resource *res = d3d12_resource(list[i]);
+      if (!d3d12_mirror_record(ctx, res))
+         res->dt_mirror_dirty = false;
+      else
+         recorded = true;
+   }
+   if (recorded)
+      d3d12_flush_cmdlist_and_wait(ctx);
+   for (unsigned i = 0; i < count; i++) {
+      struct d3d12_resource *res = d3d12_resource(list[i]);
+      if (res->dt_mirror_dirty) {
+         res->dt_mirror_dirty = false;
+         d3d12_mirror_publish(ctx, res);
+      }
+      pipe_resource_reference(&list[i], NULL);
+   }
+   free(list);
+}
