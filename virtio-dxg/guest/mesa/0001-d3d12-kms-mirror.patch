+static bool
+d3d12_mirror_wanted(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ)
+{
+   return screen->winsys && screen->winsys->get_fd &&
+          templ->target == PIPE_TEXTURE_2D && templ->nr_samples <= 1 &&
+          templ->last_level == 0 && templ->array_size <= 1 &&
