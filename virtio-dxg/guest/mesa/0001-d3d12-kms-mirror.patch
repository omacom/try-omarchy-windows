+   struct pipe_transfer *xfer = NULL;
+   const uint8_t *src = (const uint8_t *)
+      pipe_buffer_map(&ctx->base, res->mirror_staging,
+                      PIPE_MAP_READ | PIPE_MAP_UNSYNCHRONIZED, &xfer);
+   if (!src)
+      return;
+   const D3D12_SUBRESOURCE_FOOTPRINT &fp = res->mirror_footprint.Footprint;
+   unsigned row = util_format_get_stride(res->base.b.format, res->base.b.width0);
+   unsigned rows = util_format_get_nblocksy(res->base.b.format, res->base.b.height0);
+   uint8_t *dst = (uint8_t *)res->dt_map;
+#ifndef _WIN32
+   struct dma_buf_sync sync = { DMA_BUF_SYNC_START | DMA_BUF_SYNC_WRITE };
+   if (res->mirror_has_fd)
+      ioctl(res->mirror_fd, DMA_BUF_IOCTL_SYNC, &sync);
+#endif
+   if (row == fp.RowPitch && row == res->dt_stride) {
+      memcpy(dst, src, (size_t)row * rows);
+   } else {
+      for (unsigned y = 0; y < rows; y++)
