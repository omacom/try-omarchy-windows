+/* Links res (a shared texture) to the virtio-gpu buffer gpu_resource. */
+static void
+d3d12_scanout_link(struct d3d12_screen *screen, struct d3d12_resource *res,
+                   uint32_t gpu_resource)
+{
+   ID3D12Resource *d3d12_res = d3d12_resource_resource(res);
+   HANDLE handle = nullptr;
