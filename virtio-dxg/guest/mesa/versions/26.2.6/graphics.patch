+
+void
+d3d12_mirror_reference(struct d3d12_context *ctx, struct d3d12_resource *res)
+{
+   util_dynarray_foreach(&ctx->mirror_dirty, struct pipe_resource *, pres) {
+      if (*pres == &res->base.b)
+         return;
+   }
+   struct pipe_resource *pres = NULL;
+   pipe_resource_reference(&pres, &res->base.b);
+   util_dynarray_append(&ctx->mirror_dirty, pres);
+}
+
+void
+d3d12_mirror_sync(struct d3d12_context *ctx)
+{
+   unsigned count = util_dynarray_num_elements(&ctx->mirror_dirty,
+                                               struct pipe_resource *);
+   if (!count)
+      return;
+   struct mirror_entry {
+      struct pipe_resource *resource;
+      bool copy;
+   } local[16];
+   struct mirror_entry *list = local;
+   if (count > ARRAY_SIZE(local)) {
+      list = (struct mirror_entry *)calloc(count, sizeof(*list));
+      if (!list)
+         return; /* Keep the references queued for a later flush. */
+   }
+   struct pipe_resource **queued = (struct pipe_resource **)ctx->mirror_dirty.data;
+   for (unsigned i = 0; i < count; i++) {
+      list[i].resource = queued[i];
+      list[i].copy = false;
+   }
+   util_dynarray_clear(&ctx->mirror_dirty);
+
+   bool recorded = false;
+   for (unsigned i = 0; i < count; i++) {
+      struct d3d12_resource *res = d3d12_resource(list[i].resource);
+      if (res->dxg_shared || res->dxg_window || d3d12_scanout_active(res)) {
+         /* The host shows the texture: finish GPU work before KMS commits. */
+         recorded = true;
+      } else if (d3d12_mirror_record(ctx, res)) {
+         list[i].copy = true;
+         recorded = true;
+      }
+   }
+   bool completed = false;
+   if (recorded) {
+      struct d3d12_batch *batch = d3d12_current_batch(ctx);
+      /* Close/Signal/allocation can fail before a fence exists. A reset
+       * without a submitted fence is not evidence of GPU completion. */
+      if (d3d12_flush_cmdlist(ctx) && !batch->has_errors && batch->fence)
+         completed = d3d12_reset_batch(ctx, batch, OS_TIMEOUT_INFINITE);
+   }
+   for (unsigned i = 0; i < count; i++) {
+      if (completed && list[i].copy)
+         d3d12_mirror_publish(ctx, d3d12_resource(list[i].resource));
+      pipe_resource_reference(&list[i].resource, NULL);
+   }
+   if (list != local)
+      free(list);
+}
