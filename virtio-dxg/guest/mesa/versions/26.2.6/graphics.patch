+static simple_mtx_t dzn_winbuf_lock = SIMPLE_MTX_INITIALIZER;
+static int dzn_winbuf_drm = -2, dzn_winbuf_dxg = -2;
+
+bool
+dzn_window_buffers_available(void)
+{
+   simple_mtx_lock(&dzn_winbuf_lock);
+   if (dzn_winbuf_drm == -2) {
+      char marker = 0;
+      int fd = open("/sys/module/dxgkrnl_virtio/parameters/winbuf",
+                    O_RDONLY | O_CLOEXEC);
+
+      dzn_winbuf_drm = dzn_winbuf_dxg = -1;
+      if (fd >= 0) {
+         if (read(fd, &marker, 1) != 1)
+            marker = 0;
+         close(fd);
+      }
+      if ((marker == 'Y' || marker == '1') &&
+          debug_get_bool_option("DZN_WINDOW_BUFFERS", true)) {
+         for (int i = 128; i < 136 && dzn_winbuf_drm < 0; i++) {
+            char path[32], name[32] = "";
+            struct drm_version version = { 0 };
+
+            snprintf(path, sizeof(path), "/dev/dri/renderD%d", i);
+            fd = open(path, O_RDWR | O_CLOEXEC);
+            if (fd < 0)
+               continue;
+            version.name = name;
+            version.name_len = sizeof(name) - 1;
+            if (!ioctl(fd, DRM_IOCTL_VERSION, &version) &&
+                !strcmp(name, "virtio_gpu"))
+               dzn_winbuf_drm = fd;
+            else
+               close(fd);
+         }
+         if (dzn_winbuf_drm >= 0) {
+            dzn_winbuf_dxg = open("/dev/dxg", O_RDWR | O_CLOEXEC);
+            if (dzn_winbuf_dxg < 0) {
+               close(dzn_winbuf_drm);
+               dzn_winbuf_drm = -1;
+            }
+         }
+      }
+   }
+   bool available = dzn_winbuf_drm >= 0;
+   simple_mtx_unlock(&dzn_winbuf_lock);
+   return available;
+}
+
+/* The dma-buf for a shared image resource, or -1. */
+static int
+dzn_window_buffer_create(struct dzn_device *device,
+                         const struct dzn_image *image, int resource_fd)
+{
+   D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint;
+   UINT64 row_size, total_size;
+   UINT num_rows;
+
+   if (resource_fd < 0 || !dzn_window_buffers_available())
+      return -1;
+   ID3D12Device1_GetCopyableFootprints(device->dev, &image->desc, 0, 1, 0,
+                                       &footprint, &num_rows, &row_size,
+                                       &total_size);
+   uint64_t size = (uint64_t)footprint.Footprint.RowPitch *
+                   footprint.Footprint.Height;
+   if (!size || size > UINT32_MAX)
+      return -1;
+
+   struct drm_virtgpu_resource_create create = {
+      .target = 2,
+      .format = 1,
+      /* a float16 texel is two 32-bit virtio-gpu texels */
+      .width = (uint32_t)image->desc.Width *
+               MAX2(1u, (uint32_t)(row_size / image->desc.Width) / 4),
+      .height = image->desc.Height,
+      .depth = 1,
+      .array_size = 1,
+      .size = (uint32_t)size,
+   };
+   if (ioctl(dzn_winbuf_drm, DRM_IOCTL_VIRTGPU_RESOURCE_CREATE, &create))
+      return -1;
+   struct drm_prime_handle prime = {
+      .handle = create.bo_handle,
+      .flags = DRM_CLOEXEC | DRM_RDWR,
+   };
+   int ret = ioctl(dzn_winbuf_drm, DRM_IOCTL_PRIME_HANDLE_TO_FD, &prime);
+   struct drm_gem_close gem = { .handle = create.bo_handle };
+   ioctl(dzn_winbuf_drm, DRM_IOCTL_GEM_CLOSE, &gem);   /* the dma-buf keeps it */
+   if (ret)
+      return -1;
+
+   struct dzn_virtio_winbuf pair = {
+      .op = 1,
+      .dmabuf_fd = prime.fd,
+      .resource_fd = resource_fd,
+   };
+   if (ioctl(dzn_winbuf_dxg, DZN_LX_DXVIRTIOWINBUF, &pair)) {
+      close(prime.fd);
+      return -1;
+   }
+   return prime.fd;
+}
