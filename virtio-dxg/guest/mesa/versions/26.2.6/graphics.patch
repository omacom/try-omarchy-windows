+static uint32_t
+d3d12_scanout_resource_id(int drm_fd, uint32_t gem_handle)
+{
+   struct drm_virtgpu_resource_info info = {};
+   info.bo_handle = gem_handle;
+   if (drm_fd < 0 || ioctl(drm_fd, DRM_IOCTL_VIRTGPU_RESOURCE_INFO, &info))
+      return 0;
+   return info.res_handle;
+}
