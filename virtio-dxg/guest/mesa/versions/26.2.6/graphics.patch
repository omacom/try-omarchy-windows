+      return;
+   D3D12_RESOURCE_DESC desc = GetDesc(d3d12_res);
+   struct d3d12_virtio_scanout link = {};
+   link.gpu_resource = gpu_resource;
+   link.resource_fd = (int)(intptr_t)handle;
