+   simple_mtx_lock(&d3d12_scanout_lock);
+   if (!d3d12_scanout_links)
+      d3d12_scanout_links = _mesa_hash_table_u64_create(NULL);
+   if (!d3d12_scanout_links) {
+      simple_mtx_unlock(&d3d12_scanout_lock);
+      close(link.resource_fd);
+      return;
+   }
+   link.cookie = ++d3d12_scanout_cookie | ((uint64_t)getpid() << 32);
+   if (ioctl(d3d12_scanout_dxg, D3D12_LX_DXVIRTIOSCANOUT, &link) == 0 &&
+       (link.flags & D3D12_VIRTIO_SCANOUT_ZERO_COPY)) {
+      if (!_mesa_hash_table_u64_search(d3d12_scanout_links, gpu_resource))
+         d3d12_scanout_count++;
+      _mesa_hash_table_u64_insert(d3d12_scanout_links, gpu_resource, res);
+      res->mirror_zero_copy = true;
+      res->mirror_gpu_resource = gpu_resource;
+      res->mirror_cookie = link.cookie;
+   }
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   close(link.resource_fd);
+}
+
+/* With d3d12_scanout_lock. */
+static void
+d3d12_scanout_unlink_locked(struct d3d12_resource *res)
+{
+   struct d3d12_virtio_scanout link = {};
+
+   if (!res->mirror_zero_copy)
+      return;
+   if (d3d12_scanout_links &&
+       _mesa_hash_table_u64_search(d3d12_scanout_links,
+                                   res->mirror_gpu_resource) == res) {
+      _mesa_hash_table_u64_remove(d3d12_scanout_links, res->mirror_gpu_resource);
+      d3d12_scanout_count--;
+   }
+   link.gpu_resource = res->mirror_gpu_resource;
+   link.resource_fd = -1;
+   link.cookie = res->mirror_cookie;
+   ioctl(d3d12_scanout_dxg, D3D12_LX_DXVIRTIOSCANOUT, &link);
+   res->mirror_zero_copy = false;
+}
+
+static void
+d3d12_scanout_unlink(struct d3d12_resource *res)
+{
+   simple_mtx_lock(&d3d12_scanout_lock);
+   d3d12_scanout_unlink_locked(res);
+   simple_mtx_unlock(&d3d12_scanout_lock);
+}
+
+/* The registry is weak. A last release can enter resource_destroy and
+ * wait for this mutex with count zero; never resurrect that resource. */
+static bool
+d3d12_scanout_try_reference(struct pipe_resource **target,
+                              struct pipe_resource *source)
+{
+   int count = p_atomic_read(&source->reference.count);
+   while (count > 0 && count < INT_MAX) {
+      int prior = p_atomic_cmpxchg(&source->reference.count, count, count + 1);
+      if (prior == count) {
+         *target = source;
+         return true;
+      }
+      count = prior;
+   }
+   return false;
+}
+
+/* A layout fallback on the owner also invalidates its borrowed wrappers. */
+static bool
+d3d12_scanout_active(struct d3d12_resource *res)
+{
+   simple_mtx_lock(&d3d12_scanout_lock);
+   bool active = res->mirror_zero_copy &&
+      (!res->mirror_link_owner ||
+       d3d12_resource(res->mirror_link_owner)->mirror_zero_copy);
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   return active;
+}
+
+/*
+ * The linked texture of the dma-buf's buffer, when this process linked it
+ * and the import matches it; NULL otherwise. On another screen of the
+ * process (compositors allocate on one GBM device and render on another),
+ * *borrowed instead becomes a resource of this screen wrapping the same
+ * D3D12 texture, and *gpu_resource its buffer. An import that does not
+ * match (another format or size) returns the buffer to copies, so every
+ * view of it stays correct.
+ */
+static struct pipe_resource *
+d3d12_scanout_lookup(struct d3d12_screen *screen,
+                     const struct pipe_resource *templ, int dmabuf_fd,
+                     struct pipe_resource **borrowed, uint32_t *gpu_resource)
+{
+   struct pipe_resource *found = NULL;
+   struct pipe_resource *owner = NULL;
+   ID3D12Resource *shared = NULL;
+   uint32_t borrowed_id = 0;
+   int drm_fd = screen->winsys->get_fd(screen->winsys);
+
+   *borrowed = NULL;
+
+   simple_mtx_lock(&d3d12_scanout_lock);
+   if (d3d12_scanout_count && drm_fd >= 0) {
+      /* Our own buffers already have this handle on drm_fd: not closed. */
+      struct drm_prime_handle prime = {};
+      prime.fd = dmabuf_fd;
+      if (ioctl(drm_fd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime) == 0) {
+         uint32_t id = d3d12_scanout_resource_id(drm_fd, prime.handle);
+         struct d3d12_resource *res = id ? (struct d3d12_resource *)
+            _mesa_hash_table_u64_search(d3d12_scanout_links, id) : NULL;
+         bool retained = res && d3d12_scanout_try_reference(&owner, &res->base.b);
+         bool match = retained && res->base.b.format == templ->format &&
+                      res->base.b.width0 == templ->width0 &&
+                      res->base.b.height0 == templ->height0;
+         if (match && res->base.b.screen == &screen->base) {
+            found = owner;
+            owner = NULL;
+         } else if (match) {
+            shared = d3d12_resource_resource(res);
+            shared->AddRef();
+            borrowed_id = id;
+         } else if (retained) {
+            d3d12_scanout_unlink_locked(res);
+         }
+      }
+   }
+   simple_mtx_unlock(&d3d12_scanout_lock);
+
+   if (shared) {
+      /* Import can reclaim other batches/resources and enter their
+       * destructors. Never hold the registry mutex across that call. The
+       * positive owner reference keeps our texture/link alive meanwhile. */
+      struct winsys_handle wh = {};
+      wh.type = WINSYS_HANDLE_TYPE_D3D12_RES;
+      wh.com_obj = shared; /* The import consumes this COM reference. */
+      wh.format = templ->format;
+      *borrowed = screen->base.resource_from_handle(
+         &screen->base, templ, &wh, PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+      if (*borrowed) {
+         d3d12_resource(*borrowed)->mirror_link_owner = owner;
+         owner = NULL;
+         *gpu_resource = borrowed_id;
+      } else {
+         simple_mtx_lock(&d3d12_scanout_lock);
+         d3d12_scanout_unlink_locked(d3d12_resource(owner));
+         simple_mtx_unlock(&d3d12_scanout_lock);
+      }
+   }
+   /* A final owner release can unlink, so it must happen outside the mutex. */
+   pipe_resource_reference(&owner, NULL);
+   return found;
+}
+
+#else
+static bool
+d3d12_scanout_active(struct d3d12_resource *)
+{
+   return false;
+}
+#endif /* !_WIN32 */
+
+static struct pipe_resource *
+d3d12_resource_create_or_place(struct d3d12_screen *screen,
+                               struct d3d12_resource *res,
+                               const struct pipe_resource *templ,
+                               ID3D12Heap *heap,
+                               uint64_t placed_offset);
+
+#ifndef _WIN32
+/* virtio-dxg zero-copy window buffers ------------------------------------
+ *
+ * On a render node a shared image (a Wayland window buffer) is a virtio-gpu
+ * buffer exported as a dma-buf, with a shared GPU texture registered for it
+ * in the dxg module (LX_DXVIRTIOWINBUF). An import of such a dma-buf, in
+ * any process, gets the texture. D3D12_ZERO_COPY_CLIENTS=false, or a
+ * kernel without the registry, leaves a mirror that is filled by a copy.
+ */
+struct d3d12_virtio_winbuf {
+   uint32_t op;         /* 1 register, 2 unregister, 3 lookup */
+   int32_t dmabuf_fd;
+   int32_t resource_fd;
+   uint32_t reserved;
+};
+#define D3D12_LX_DXVIRTIOWINBUF _IOWR(0x47, 0x81, struct d3d12_virtio_winbuf)
+
+static int
+d3d12_dxg_fd(void)
+{
+   simple_mtx_lock(&d3d12_scanout_lock);
+   if (d3d12_scanout_dxg == -2) {
+      d3d12_scanout_dxg = open("/dev/dxg", O_RDWR | O_CLOEXEC);
+      if (d3d12_scanout_dxg < 0)
+         d3d12_scanout_dxg = -1;
+   }
+   int fd = d3d12_scanout_dxg;
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   return fd;
+}
+
+static bool
+d3d12_on_render_node(struct d3d12_screen *screen)
+{
+   struct stat st;
+   int fd = screen->winsys && screen->winsys->get_fd ?
+            screen->winsys->get_fd(screen->winsys) : -1;
+
+   return fd >= 0 && fstat(fd, &st) == 0 && S_ISCHR(st.st_mode) &&
+          major(st.st_rdev) == 226 && minor(st.st_rdev) >= 128;
+}
+
+static uint32_t
+d3d12_virtio_gpu_format(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B8G8R8A8_UNORM: return 1;
+   case PIPE_FORMAT_B8G8R8X8_UNORM: return 2;
+   case PIPE_FORMAT_R8G8B8A8_UNORM: return 67;
+   case PIPE_FORMAT_R8G8B8X8_UNORM: return 134;
+   default: return 0;
+   }
+}
+
+static struct pipe_resource *
+d3d12_winbuf_create(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ)
+{
+   int drm_fd = screen->winsys->get_fd(screen->winsys);
+   uint32_t format = d3d12_virtio_gpu_format(templ->format);
+   unsigned stride = align(util_format_get_stride(templ->format, templ->width0), 64);
+   uint64_t size = (uint64_t)stride * templ->height0;
+   if (!format || size > UINT32_MAX)
+      return NULL;
+
+   /* The dma-buf: a 2D virtio-gpu buffer (render nodes may create them). */
+   struct drm_virtgpu_resource_create rc = {};
+   rc.target = 2;
+   rc.format = format;
+   rc.width = templ->width0;
+   rc.height = templ->height0;
+   rc.depth = 1;
+   rc.array_size = 1;
+   rc.size = (uint32_t)size;
+   if (ioctl(drm_fd, DRM_IOCTL_VIRTGPU_RESOURCE_CREATE, &rc))
+      return NULL;
+   struct drm_prime_handle prime = {};
+   prime.handle = rc.bo_handle;
+   prime.flags = DRM_CLOEXEC | DRM_RDWR;
+   int ret = ioctl(drm_fd, DRM_IOCTL_PRIME_HANDLE_TO_FD, &prime);
+   struct drm_gem_close gem = {};
+   gem.handle = rc.bo_handle;
+   if (ret) {
+      ioctl(drm_fd, DRM_IOCTL_GEM_CLOSE, &gem);
+      return NULL;
+   }
+   int fd = prime.fd;
+
+   struct d3d12_resource *res = CALLOC_STRUCT(d3d12_resource);
+   if (!res) {
+      ioctl(drm_fd, DRM_IOCTL_GEM_CLOSE, &gem);
+      close(fd);
+      return NULL;
+   }
+   struct pipe_resource tex_templ = *templ;
+   tex_templ.bind &= ~d3d12_mirror_binds;
+   tex_templ.bind |= PIPE_BIND_SHARED | PIPE_BIND_RENDER_TARGET |
+                     PIPE_BIND_SAMPLER_VIEW;
+   struct pipe_resource *pres =
+      d3d12_resource_create_or_place(screen, res, &tex_templ, nullptr, 0);
+   if (!pres) {
+      ioctl(drm_fd, DRM_IOCTL_GEM_CLOSE, &gem);
+      close(fd);
+      return NULL;
+   }
+   res->mirror_gem = rc.bo_handle;
+   pres->bind = templ->bind | PIPE_BIND_SHARED;
+   res->dt_mirror = true;
+   res->dt_stride = stride;
+   res->mirror_has_fd = true;
+   res->mirror_fd = fd;
+   res->mirror_map_size = size;
+
+   /* Pair the texture with the dma-buf for whoever imports it. */
+   HANDLE shared = nullptr;
+   int dxg = d3d12_dxg_fd();
+   ID3D12Resource *d3d12_res = d3d12_resource_resource(res);
+   if (dxg >= 0 && d3d12_res &&
+       SUCCEEDED(screen->dev->CreateSharedHandle(d3d12_res, nullptr, GENERIC_ALL,
+                                                 nullptr, &shared)) && shared) {
+      struct d3d12_virtio_winbuf reg = {};
+      reg.op = 1;
+      reg.dmabuf_fd = fd;
+      reg.resource_fd = (int)(intptr_t)shared;
+      res->dxg_shared = ioctl(dxg, D3D12_LX_DXVIRTIOWINBUF, &reg) == 0;
+      close(reg.resource_fd);
+   }
+   if (debug_get_bool_option("D3D12_WINBUF_DEBUG", false))
+      fprintf(stderr, "winbuf[%d]: create %ux%u %s bind 0x%x -> %s\n", getpid(),
+              templ->width0, templ->height0, util_format_short_name(templ->format),
+              templ->bind, res->dxg_shared ? "paired" : "NOT paired");
+   if (!res->dxg_shared) {
+      /* No pairing (an older dxg module): an importer could not see the
+       * image, so there is no window buffer; callers fall back. */
+      pipe_resource_reference(&pres, NULL);
+      return NULL;
+   }
+   return pres;
+}
+
+/* The pair is not taken back when the allocation goes: browsers allocate
+ * with GBM, import the dma-buf, free the allocation and only then hand the
+ * dma-buf to the compositor. The module drops a pair with its dma-buf. */
+static void
+d3d12_winbuf_release(struct d3d12_screen *screen, struct d3d12_resource *res)
+{
+   if (res->mirror_gem) {
+      struct drm_gem_close gem = {};
+      gem.handle = res->mirror_gem;
+      ioctl(screen->winsys->get_fd(screen->winsys), DRM_IOCTL_GEM_CLOSE, &gem);
+      res->mirror_gem = 0;
+   }
+}
+
+/* The texture paired with an imported window buffer, as a resource of this
+ * screen; NULL when the dma-buf has none. */
+static struct pipe_resource *
+d3d12_winbuf_import(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ, int dmabuf_fd)
+{
+   int dxg = d3d12_dxg_fd();
+   struct d3d12_virtio_winbuf look = {};
+   look.op = 3;
+   look.dmabuf_fd = dmabuf_fd;
+   look.resource_fd = -1;
+   if (dxg < 0 || !debug_get_bool_option("D3D12_ZERO_COPY_CLIENTS", true) ||
+       ioctl(dxg, D3D12_LX_DXVIRTIOWINBUF, &look) || look.resource_fd < 0) {
+      if (debug_get_bool_option("D3D12_WINBUF_DEBUG", false))
+         fprintf(stderr, "winbuf[%d]: import %ux%u %s: no pair (dxg fd %d)\n",
+                 getpid(), templ->width0, templ->height0,
+                 util_format_short_name(templ->format), dxg);
+      return NULL;
+   }
+   struct winsys_handle wh = {};
+   wh.type = WINSYS_HANDLE_TYPE_FD;
+   wh.handle = look.resource_fd;
+   wh.format = templ->format;
+   /* Not a dma-buf: the regular path opens the shared handle. */
+   struct pipe_resource *pres = screen->base.resource_from_handle(
+      &screen->base, templ, &wh, PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+   close(look.resource_fd);
+   if (pres) {
+      struct d3d12_resource *window = d3d12_resource(pres);
+
+      window->dxg_window = true;
+      /* Re-export (Xwayland presents a client's pixmap by its dma-buf)
+       * hands out the dma-buf itself, not the texture's handle. */
+      window->mirror_fd = os_dupfd_cloexec(dmabuf_fd);
+      window->mirror_has_fd = window->mirror_fd >= 0;
+   }
+   if (debug_get_bool_option("D3D12_WINBUF_DEBUG", false))
+      fprintf(stderr, "winbuf[%d]: import %ux%u %s bind 0x%x -> %s\n", getpid(),
+              templ->width0, templ->height0, util_format_short_name(templ->format),
+              templ->bind, pres ? "texture" : "FAILED to open");
+   return pres;
+}
+#endif /* !_WIN32 */
+
+static struct pipe_resource *
+d3d12_mirror_attach(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ,
+                    struct sw_displaytarget *dt, unsigned dt_stride)
+{
+   struct sw_winsys *winsys = screen->winsys;
+   struct d3d12_resource *res = CALLOC_STRUCT(d3d12_resource);
+   if (!res) {
+      winsys->displaytarget_destroy(winsys, dt);
+      return NULL;
+   }
+
+   /* The GPU copy is an ordinary optimal-layout texture; shared when the
+    * host display may show it (zero-copy scanout). */
+#ifndef _WIN32
+   bool zero_copy = d3d12_scanout_wanted(templ);
+#else
+   bool zero_copy = false;
+#endif
+   struct pipe_resource gpu_templ = *templ;
+   gpu_templ.bind &= ~d3d12_mirror_binds;
+   gpu_templ.bind |= PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+   if (zero_copy)
+      gpu_templ.bind |= PIPE_BIND_SHARED;
+   struct pipe_resource *pres =
+      d3d12_resource_create_or_place(screen, res, &gpu_templ, nullptr, 0);
+   if (!pres) {
+      winsys->displaytarget_destroy(winsys, dt);
+      return NULL;
+   }
+   pres->bind = templ->bind | PIPE_BIND_SHARED;
+   res->dt = dt;
+   res->dt_stride = dt_stride;
+   res->dt_refcount = 1;
+   res->dt_mirror = true;
+   /* Mapped for the resource's lifetime: no mmap/munmap per frame. */
+   res->dt_map = winsys->displaytarget_map(winsys, dt, PIPE_MAP_READ_WRITE);
+   if (!res->dt_map) {
+      pipe_resource_reference(&pres, NULL);
+      return NULL;
+   }
+#ifndef _WIN32
+   if (zero_copy) {
+      struct winsys_handle wh = {};
+      wh.type = WINSYS_HANDLE_TYPE_KMS;
+      if (winsys->displaytarget_get_handle(winsys, dt, &wh))
+         d3d12_scanout_link(screen, res,
+                            d3d12_scanout_resource_id(winsys->get_fd(winsys),
+                                                      wh.handle));
+   }
+#endif
+   return pres;
+}
+
+static struct pipe_resource *
+d3d12_mirror_create(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ)
+{
+   unsigned stride = 0;
+   struct sw_displaytarget *dt =
+      screen->winsys->displaytarget_create(screen->winsys, templ->bind,
+                                           templ->format, templ->width0,
+                                           templ->height0, 64, NULL, &stride);
+   if (!dt)
+      return NULL;
+   return d3d12_mirror_attach(screen, templ, dt, stride);
+}
+
+static struct pipe_resource *
+d3d12_mirror_gpu_texture(struct d3d12_screen *screen,
+                         const struct pipe_resource *templ)
+{
+   struct d3d12_resource *res = CALLOC_STRUCT(d3d12_resource);
+   if (!res)
+      return NULL;
+   struct pipe_resource gpu_templ = *templ;
+   gpu_templ.bind &= ~d3d12_mirror_binds;
+   gpu_templ.bind |= PIPE_BIND_RENDER_TARGET | PIPE_BIND_SAMPLER_VIEW;
+   struct pipe_resource *pres =
+      d3d12_resource_create_or_place(screen, res, &gpu_templ, nullptr, 0);
+   if (pres)
+      pres->bind = templ->bind | PIPE_BIND_SHARED;
+   return pres;
+}
+
+static struct pipe_resource *
+d3d12_mirror_import(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ,
+                    struct winsys_handle *handle)
+{
+   unsigned stride = 0;
+   if (handle->plane || handle->offset)
+      return NULL;
+#ifndef _WIN32
+   if (handle->type == WINSYS_HANDLE_TYPE_FD) {
+      /* A D3D12 shared-handle descriptor (not a dma-buf) has no size; the
+       * caller then takes the regular path. */
+      off_t size = lseek((int)handle->handle, 0, SEEK_END);
+      unsigned row = util_format_get_stride(templ->format, templ->width0);
+      stride = handle->stride ? handle->stride : row;
+      if (size <= 0 || stride < row ||
+          (uint64_t)stride * templ->height0 > (uint64_t)size)
+         return NULL;
+      struct pipe_resource *borrowed = NULL;
+      uint32_t gpu_resource = 0;
+      struct pipe_resource *linked =
+         d3d12_scanout_lookup(screen, templ, (int)handle->handle, &borrowed,
+                              &gpu_resource);
+      if (linked)
+         return linked;
+      if (!borrowed) {
+         struct pipe_resource *window =
+            d3d12_winbuf_import(screen, templ, (int)handle->handle);
+         if (window) {
+            d3d12_resource(window)->dt_stride = handle->stride;
+            return window;
+         }
+      }
+      int fd = os_dupfd_cloexec((int)handle->handle);
+      if (fd < 0) {
+         pipe_resource_reference(&borrowed, NULL);
+         return NULL;
+      }
+      void *map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+      if (map == MAP_FAILED) {
+         close(fd);
+         pipe_resource_reference(&borrowed, NULL);
+         return NULL;
+      }
+      struct pipe_resource *pres = borrowed ? borrowed :
+         d3d12_mirror_gpu_texture(screen, templ);
+      if (!pres) {
+         munmap(map, size);
+         close(fd);
+         return NULL;
+      }
+      struct d3d12_resource *res = d3d12_resource(pres);
+      if (borrowed) {
+         pres->bind = templ->bind | PIPE_BIND_SHARED;
+         res->mirror_zero_copy = true;
+         res->mirror_link_borrowed = true;
+         res->mirror_gpu_resource = gpu_resource;
+      }
+      res->dt_mirror = true;
+      res->dt_stride = stride;
+      res->dt_map = map;
+      res->mirror_has_fd = true;
+      res->mirror_fd = fd;
+      res->mirror_map_size = size;
+      return pres;
+   }
+#endif
+   struct sw_displaytarget *dt =
+      screen->winsys->displaytarget_from_handle(screen->winsys, templ,
+                                                handle, &stride);
+   if (!dt)
+      return NULL;
+   /* Its current contents become the GPU copy's starting point the first
+    * time a context syncs; until then the GPU copy is undefined, which is
+    * what a compositor's render target expects. */
+   return d3d12_mirror_attach(screen, templ, dt, stride);
+}
