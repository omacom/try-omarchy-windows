+static bool
+d3d12_mirror_record(struct d3d12_context *ctx, struct d3d12_resource *res)
+{
+   if (!d3d12_mirror_staging(res))
+      return false;
+   struct d3d12_resource *staging = d3d12_resource(res->mirror_staging);
+   uint64_t src_offset = 0, dst_offset = 0;
+   struct copy_info info = {};
+   info.src = res;
+   info.src_loc.pResource = d3d12_resource_underlying(res, &src_offset);
+   info.src_loc.Type = D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
+   info.src_loc.SubresourceIndex = 0;
+   info.dst = staging;
+   info.dst_loc.pResource = d3d12_resource_underlying(staging, &dst_offset);
+   info.dst_loc.Type = D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT;
+   info.dst_loc.PlacedFootprint = res->mirror_footprint;
+   info.dst_loc.PlacedFootprint.Offset = dst_offset;
+   info.src_box = nullptr;
+   copy_texture_region(ctx, info);
+   return true;
