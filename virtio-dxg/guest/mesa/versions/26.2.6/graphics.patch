+/* The DRM descriptor of an application's screen (a render node). */
+static int
+d3d12_fence_drm_fd(struct d3d12_screen *screen)
+{
+   struct stat st;
+   int fd = screen->winsys && screen->winsys->get_fd ?
+            screen->winsys->get_fd(screen->winsys) : -1;
+
+   if (fd < 0 || fstat(fd, &st) || !S_ISCHR(st.st_mode) ||
+       major(st.st_rdev) != 226 || minor(st.st_rdev) < 128)
+      return -1;
+   return fd;
+}
+
+/* A sync file that is signalled already. */
+static int
+d3d12_signaled_sync_file(struct d3d12_screen *screen)
+{
+   int drm = d3d12_fence_drm_fd(screen);
+   if (drm < 0)
+      return -1;
+   struct drm_syncobj_create create = {};
+   create.flags = DRM_SYNCOBJ_CREATE_SIGNALED;
+   if (ioctl(drm, DRM_IOCTL_SYNCOBJ_CREATE, &create))
+      return -1;
+   struct drm_syncobj_handle exported = {};
+   exported.handle = create.handle;
+   exported.flags = DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE;
+   exported.fd = -1;
+   int ret = ioctl(drm, DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD, &exported);
+   struct drm_syncobj_destroy destroy = {};
+   destroy.handle = create.handle;
+   ioctl(drm, DRM_IOCTL_SYNCOBJ_DESTROY, &destroy);
+   return ret ? -1 : exported.fd;
+}
