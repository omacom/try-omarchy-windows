+#ifndef _WIN32
+/* virtio-dxg zero-copy scanout -----------------------------------------
+ *
+ * In a virtio-dxg VM the host display can show a scanout buffer's GPU
+ * texture itself: LX_DXVIRTIOSCANOUT on /dev/dxg links the virtio-gpu
+ * buffer to the texture's shared handle. Nothing is then copied into the
+ * dumb buffer, nor into the host, nor uploaded to the display. Scanout
+ * mirrors are therefore created shared, and an import of a linked buffer
+ * in the same process (the compositor importing its own swapchain) gets
+ * the same texture, so the host shows what is rendered.
+ * D3D12_ZERO_COPY_SCANOUT=false keeps the copies.
+ */
+struct d3d12_virtio_scanout {
+   uint32_t gpu_resource;
+   int32_t resource_fd;
+   uint32_t width;
+   uint32_t height;
+   uint32_t drm_format;
+   uint32_t alloc_size;
+   uint32_t flags;
+   uint32_t reserved;
+   uint64_t cookie;
+};
+#define D3D12_LX_DXVIRTIOSCANOUT \
+   _IOWR(0x47, 0x80, struct d3d12_virtio_scanout)
+#define D3D12_VIRTIO_SCANOUT_ZERO_COPY 1u
+
+static simple_mtx_t d3d12_scanout_lock = SIMPLE_MTX_INITIALIZER;
+static int d3d12_scanout_dxg = -2;   /* /dev/dxg; -1: none, -2: not tried */
+static struct hash_table_u64 *d3d12_scanout_links; /* gpu resource -> res */
+static unsigned d3d12_scanout_count;
+static uint64_t d3d12_scanout_cookie;
+
+static uint32_t
+d3d12_scanout_fourcc(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B8G8R8X8_UNORM: return 0x34325258; /* XR24 */
+   case PIPE_FORMAT_B8G8R8A8_UNORM: return 0x34325241; /* AR24 */
+   case PIPE_FORMAT_R8G8B8X8_UNORM: return 0x34324258; /* XB24 */
+   case PIPE_FORMAT_R8G8B8A8_UNORM: return 0x34324241; /* AB24 */
+   default: return 0;
+   }
+}
+
+static bool
+d3d12_scanout_wanted(const struct pipe_resource *templ)
+{
+   if (!(templ->bind & PIPE_BIND_SCANOUT) || (templ->bind & PIPE_BIND_CURSOR) ||
+       !d3d12_scanout_fourcc(templ->format) ||
+       !debug_get_bool_option("D3D12_ZERO_COPY_SCANOUT", true))
+      return false;
+   simple_mtx_lock(&d3d12_scanout_lock);
+   if (d3d12_scanout_dxg == -2) {
+      d3d12_scanout_dxg = open("/dev/dxg", O_RDWR | O_CLOEXEC);
+      if (d3d12_scanout_dxg < 0)
+         d3d12_scanout_dxg = -1;
+   }
+   bool ok = d3d12_scanout_dxg >= 0;
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   return ok;
+}
