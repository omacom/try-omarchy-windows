+/* KMS mirror ------------------------------------------------------------
+ *
+ * With the kms_swrast winsys (a KMS device without a GPU driver, such as
+ * virtio-gpu in 2D mode) the display, other processes and dma-buf
+ * consumers only understand dumb buffers. Scanout, cursor and shared
+ * images therefore pair a GPU texture (where everything renders) with a
+ * dumb buffer (what handles, dma-bufs and KMS see). Each flush of a context
+ * that wrote a mirror copies it into the dumb buffer, so the frame is
+ * there before the compositor commits it.
+ */
+static const unsigned d3d12_mirror_binds =
+   PIPE_BIND_SCANOUT | PIPE_BIND_SHARED | PIPE_BIND_CURSOR |
+   PIPE_BIND_DISPLAY_TARGET | PIPE_BIND_LINEAR;
+
+static bool
+d3d12_mirror_wanted(struct d3d12_screen *screen,
+                    const struct pipe_resource *templ)
+{
+   return screen->winsys && screen->winsys->get_fd &&
+          templ->target == PIPE_TEXTURE_2D && templ->nr_samples <= 1 &&
+          templ->last_level == 0 && templ->array_size <= 1 &&
+          util_format_get_num_planes(templ->format) == 1 &&
+          !util_format_is_yuv(templ->format) &&
+          !util_format_is_depth_or_stencil(templ->format);
+}
