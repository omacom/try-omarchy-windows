+/* virtio-dxg: fold the extended dynamic state of a variant key into a copy
+ * of the pipeline-state stream (see dzn_graphics_pipeline_init_eds). */
+#define DZN_EDS_STENCIL_FACE(face, ops) do { \
+      (face).StencilFailOp = translate_stencil_op((VkStencilOp)(ops)[0]); \
+      (face).StencilPassOp = translate_stencil_op((VkStencilOp)(ops)[1]); \
+      (face).StencilDepthFailOp = translate_stencil_op((VkStencilOp)(ops)[2]); \
+      (face).StencilFunc = dzn_translate_compare_op((VkCompareOp)(ops)[3]); \
+   } while (0)
+
+#define DZN_EDS_APPLY_DS(ds) do { \
+      (ds)->DepthEnable = depth; \
+      if (depth) { \
+         (ds)->DepthWriteMask = k->depth_write ? \
+            D3D12_DEPTH_WRITE_MASK_ALL : D3D12_DEPTH_WRITE_MASK_ZERO; \
+         (ds)->DepthFunc = k->depth_test ? \
+            dzn_translate_compare_op((VkCompareOp)k->depth_compare) : \
+            D3D12_COMPARISON_FUNC_ALWAYS; \
+      } \
+      (ds)->DepthBoundsTestEnable = k->depth_bounds_test; \
+      (ds)->StencilEnable = stencil; \
+      if (stencil && (dyn & DZN_EDS_STENCIL_OP)) { \
+         DZN_EDS_STENCIL_FACE((ds)->FrontFace, k->stencil_front); \
+         DZN_EDS_STENCIL_FACE((ds)->BackFace, k->stencil_back); \
+      } \
+   } while (0)
