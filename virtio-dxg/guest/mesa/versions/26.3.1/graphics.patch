+struct writer {
+   std::vector<uint8_t> b;
+   void bytes(const void *p, size_t n)
+   {
+      const uint8_t *c = (const uint8_t *)p;
+      if (n)
+         b.insert(b.end(), c, c + n);
+   }
+   void u32(uint32_t v) { bytes(&v, sizeof(v)); }
+   void f32(float v) { bytes(&v, sizeof(v)); }
+   void blob(const void *p, size_t n)
+   {
+      u32((uint32_t)n);
+      bytes(p, n);
+   }
+};
+
+struct reader {
+   const uint8_t *p, *end;
+   bool ok = true;
+   reader(const uint8_t *data, size_t n) : p(data), end(data + n) {}
+   void take(void *d, size_t n)
+   {
+      if (!ok || (size_t)(end - p) < n) {
+         ok = false;
+         memset(d, 0, n);
+         return;
+      }
+      memcpy(d, p, n);
+      p += n;
+   }
+   uint32_t u32() { uint32_t v; take(&v, sizeof(v)); return v; }
+   float f32() { float v; take(&v, sizeof(v)); return v; }
+   const uint8_t *blob(uint32_t &n)
+   {
+      n = u32();
+      if (!ok || (size_t)(end - p) < n) {
+         ok = false;
+         n = 0;
+         return nullptr;
+      }
+      const uint8_t *r = p;
+      p += n;
+      return r;
+   }
+};
