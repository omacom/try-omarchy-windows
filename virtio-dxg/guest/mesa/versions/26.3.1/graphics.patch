+   w.u32(f.StencilFailOp); w.u32(f.StencilDepthFailOp);
+   w.u32(f.StencilPassOp); w.u32(f.StencilFunc);
+   w.u32(f.StencilReadMask); w.u32(f.StencilWriteMask);
