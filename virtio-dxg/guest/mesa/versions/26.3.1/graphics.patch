+      w.u32(e.AlignedByteOffset); w.u32(e.InputSlotClass); w.u32(e.InstanceDataStepRate);
+   }
+   w.u32((D3D12_INDEX_BUFFER_STRIP_CUT_VALUE)d.IBStripCutValue);
+   w.u32((D3D12_PRIMITIVE_TOPOLOGY_TYPE)d.PrimitiveTopologyType);
+
+   const D3D12_BLEND_DESC &b = (const D3D12_BLEND_DESC &)d.BlendState;
+   w.u32(b.AlphaToCoverageEnable);
+   w.u32(b.IndependentBlendEnable);
+   for (unsigned i = 0; i < 8; i++) {
+      const D3D12_RENDER_TARGET_BLEND_DESC &t = b.RenderTarget[i];
+      w.u32(t.BlendEnable); w.u32(t.LogicOpEnable); w.u32(t.SrcBlend); w.u32(t.DestBlend);
+      w.u32(t.BlendOp); w.u32(t.SrcBlendAlpha); w.u32(t.DestBlendAlpha); w.u32(t.BlendOpAlpha);
+      w.u32(t.LogicOp); w.u32(t.RenderTargetWriteMask);
+   }
+
+   const d3d12_depth_stencil_desc_type &ds = (const d3d12_depth_stencil_desc_type &)d.DepthStencilState;
+   w.u32(ds.DepthEnable); w.u32(ds.DepthWriteMask); w.u32(ds.DepthFunc); w.u32(ds.StencilEnable);
+   put_stencil_face(w, ds.FrontFace);
+   put_stencil_face(w, ds.BackFace);
+   w.u32(ds.DepthBoundsTestEnable);
+   w.u32((DXGI_FORMAT)d.DSVFormat);
+
+   const D3D12_RASTERIZER_DESC &r = (const D3D12_RASTERIZER_DESC &)d.RasterizerState;
+   w.u32(r.FillMode); w.u32(r.CullMode); w.u32(r.FrontCounterClockwise);
+   w.u32((uint32_t)r.DepthBias); w.f32(r.DepthBiasClamp); w.f32(r.SlopeScaledDepthBias);
+   w.u32(r.DepthClipEnable); w.u32(r.MultisampleEnable); w.u32(r.AntialiasedLineEnable);
+   w.u32(r.ForcedSampleCount); w.u32(r.ConservativeRaster);
+
+   const D3D12_RT_FORMAT_ARRAY &rt = d.RTVFormats;
+   w.u32(rt.NumRenderTargets);
+   for (unsigned i = 0; i < 8; i++)
+      w.u32(rt.RTFormats[i]);
+   const DXGI_SAMPLE_DESC &sd = d.SampleDesc;
+   w.u32(sd.Count); w.u32(sd.Quality);
+   w.u32((UINT)d.SampleMask);
+   w.u32((UINT)d.NodeMask);
+   w.u32((D3D12_PIPELINE_STATE_FLAGS)d.Flags);
+   return true;
+}
+
+/* A record made into a pipeline (on a worker): its root signature, created
+ * from the serialized form (the runtime gives back the root signature Mesa
+ * created from the same bytes), and the stream. */
+ID3D12PipelineState *
+create_from_record(struct d3d12_screen *screen, const std::vector<uint8_t> &rec, bool debug)
+{
+   reader r(rec.data(), rec.size());
+   if (r.u32() != RECORD_VERSION)
+      return nullptr;
+   bool stream = r.u32() != 0;
+   uint32_t n;
+   const uint8_t *rs_blob = r.blob(n);
+   if (!r.ok || !n)
+      return nullptr;
+   ID3D12RootSignature *rs = nullptr;
+   if (FAILED(screen->dev->CreateRootSignature(0, rs_blob, n, IID_PPV_ARGS(&rs))))
+      return nullptr;
+
+   CD3DX12_PIPELINE_STATE_STREAM3 d;
+   d.pRootSignature = rs;
+   D3D12_SHADER_BYTECODE *stages[] = {
+      &(D3D12_SHADER_BYTECODE &)d.VS, &(D3D12_SHADER_BYTECODE &)d.HS,
+      &(D3D12_SHADER_BYTECODE &)d.DS, &(D3D12_SHADER_BYTECODE &)d.GS,
+      &(D3D12_SHADER_BYTECODE &)d.PS,
+   };
+   for (D3D12_SHADER_BYTECODE *c : stages) {
+      const uint8_t *code = r.blob(n);
+      *c = D3D12_SHADER_BYTECODE{ n ? code : nullptr, n };
+   }
+   D3D12_STREAM_OUTPUT_DESC &so = d.StreamOutput;
+   so = D3D12_STREAM_OUTPUT_DESC{};
+   so.RasterizedStream = r.u32();
+
+   uint32_t num_elements = r.u32();
+   if (!r.ok || num_elements > D3D12_IA_VERTEX_INPUT_STRUCTURE_ELEMENT_COUNT) {
+      rs->Release();
+      return nullptr;
+   }
+   std::vector<std::string> names(num_elements);
+   std::vector<D3D12_INPUT_ELEMENT_DESC> elements(num_elements);
+   for (unsigned i = 0; i < num_elements; i++) {
+      const uint8_t *name = r.blob(n);
+      names[i].assign((const char *)name, n);
+      D3D12_INPUT_ELEMENT_DESC &e = elements[i];
+      e.SemanticIndex = r.u32();
+      e.Format = (DXGI_FORMAT)r.u32();
+      e.InputSlot = r.u32();
+      e.AlignedByteOffset = r.u32();
+      e.InputSlotClass = (D3D12_INPUT_CLASSIFICATION)r.u32();
+      e.InstanceDataStepRate = r.u32();
+   }
+   for (unsigned i = 0; i < num_elements; i++)
+      elements[i].SemanticName = names[i].c_str();
+   D3D12_INPUT_LAYOUT_DESC &il = d.InputLayout;
+   il.pInputElementDescs = num_elements ? elements.data() : nullptr;
+   il.NumElements = num_elements;
+   d.IBStripCutValue = (D3D12_INDEX_BUFFER_STRIP_CUT_VALUE)r.u32();
+   d.PrimitiveTopologyType = (D3D12_PRIMITIVE_TOPOLOGY_TYPE)r.u32();
+
+   D3D12_BLEND_DESC &b = (D3D12_BLEND_DESC &)d.BlendState;
+   b.AlphaToCoverageEnable = r.u32();
+   b.IndependentBlendEnable = r.u32();
+   for (unsigned i = 0; i < 8; i++) {
+      D3D12_RENDER_TARGET_BLEND_DESC &t = b.RenderTarget[i];
+      t.BlendEnable = r.u32();
+      t.LogicOpEnable = r.u32();
+      t.SrcBlend = (D3D12_BLEND)r.u32();
+      t.DestBlend = (D3D12_BLEND)r.u32();
+      t.BlendOp = (D3D12_BLEND_OP)r.u32();
+      t.SrcBlendAlpha = (D3D12_BLEND)r.u32();
+      t.DestBlendAlpha = (D3D12_BLEND)r.u32();
+      t.BlendOpAlpha = (D3D12_BLEND_OP)r.u32();
+      t.LogicOp = (D3D12_LOGIC_OP)r.u32();
+      t.RenderTargetWriteMask = (UINT8)r.u32();
+   }
+
+   d3d12_depth_stencil_desc_type &ds = (d3d12_depth_stencil_desc_type &)d.DepthStencilState;
+   ds.DepthEnable = r.u32();
+   ds.DepthWriteMask = (D3D12_DEPTH_WRITE_MASK)r.u32();
+   ds.DepthFunc = (D3D12_COMPARISON_FUNC)r.u32();
+   ds.StencilEnable = r.u32();
+   get_stencil_face(r, ds.FrontFace);
+   get_stencil_face(r, ds.BackFace);
+   ds.DepthBoundsTestEnable = r.u32();
+   d.DSVFormat = (DXGI_FORMAT)r.u32();
+
+   D3D12_RASTERIZER_DESC &ra = (D3D12_RASTERIZER_DESC &)d.RasterizerState;
+   ra.FillMode = (D3D12_FILL_MODE)r.u32();
+   ra.CullMode = (D3D12_CULL_MODE)r.u32();
+   ra.FrontCounterClockwise = r.u32();
+   ra.DepthBias = (INT)r.u32();
+   ra.DepthBiasClamp = r.f32();
+   ra.SlopeScaledDepthBias = r.f32();
+   ra.DepthClipEnable = r.u32();
+   ra.MultisampleEnable = r.u32();
+   ra.AntialiasedLineEnable = r.u32();
+   ra.ForcedSampleCount = r.u32();
+   ra.ConservativeRaster = (D3D12_CONSERVATIVE_RASTERIZATION_MODE)r.u32();
+
+   D3D12_RT_FORMAT_ARRAY &rt = d.RTVFormats;
+   rt.NumRenderTargets = r.u32();
+   for (unsigned i = 0; i < 8; i++)
+      rt.RTFormats[i] = (DXGI_FORMAT)r.u32();
+   DXGI_SAMPLE_DESC &sd = d.SampleDesc;
+   sd.Count = r.u32();
+   sd.Quality = r.u32();
+   d.SampleMask = r.u32();
+   d.NodeMask = r.u32();
+   d.Flags = (D3D12_PIPELINE_STATE_FLAGS)r.u32();
+   D3D12_CACHED_PIPELINE_STATE &cached = d.CachedPSO;
+   cached = D3D12_CACHED_PIPELINE_STATE{};
+
+   ID3D12PipelineState *pso = nullptr;
+   if (r.ok && r.p == r.end && rt.NumRenderTargets <= 8) {
+      HRESULT hr;
+      if (stream) {
+         D3D12_PIPELINE_STATE_STREAM_DESC sdesc{ sizeof(d), &d };
+         hr = screen->dev->CreatePipelineState(&sdesc, IID_PPV_ARGS(&pso));
+      } else {
+         D3D12_GRAPHICS_PIPELINE_STATE_DESC v0 = d.GraphicsDescV0();
+         hr = screen->dev->CreateGraphicsPipelineState(&v0, IID_PPV_ARGS(&pso));
+      }
+      if (FAILED(hr)) {
+         if (debug)
+            fprintf(stderr, "d3d12_pso_prewarm: a recorded pipeline failed (0x%08x)\n", (unsigned)hr);
+         pso = nullptr;
+      }
+   }
+   rs->Release();
+   return pso;
+}
+
+void
+hash_record(const std::vector<uint8_t> &rec, uint8_t out[BLAKE3_OUT_LEN])
+{
+   _mesa_blake3_compute(rec.data(), rec.size(), out);
+}
+
+} /* namespace */
+
+struct d3d12_pso_prewarm {
+   struct d3d12_screen *screen;
+   std::mutex lock;
+   std::condition_variable done;
+   std::unordered_map<std::string, pso_entry *> entries;
+   std::vector<pso_entry *> loaded;
+   struct util_queue queue;
+   bool queue_ok = false;
+   int fd = -1;
+   size_t file_size = 0;
+   bool debug = false;
+   int64_t start_ns = 0;
+   std::atomic<unsigned> hits{0}, waits{0}, claimed{0}, recorded{0};
+};
+
+static void
+prewarm_job(void *job, void *gdata, int thread_index)
+{
+   pso_entry *e = (pso_entry *)job;
+   d3d12_pso_prewarm *pw = (d3d12_pso_prewarm *)gdata;
+   int expected = PSO_PENDING;
+   if (!e->state.compare_exchange_strong(expected, PSO_BUSY))
+      return;
+   int64_t t0 = os_time_get_nano();
+   ID3D12PipelineState *pso = create_from_record(pw->screen, e->rec, pw->debug);
+   if (pw->debug)
+      fprintf(stderr, "d3d12_pso_prewarm: +%.1f ms: worker %d built one (%.2f ms)\n",
+              (t0 - pw->start_ns) / 1e6, thread_index, (os_time_get_nano() - t0) / 1e6);
+   {
+      std::lock_guard<std::mutex> g(pw->lock);
+      e->pso = pso;
+      e->state.store(PSO_READY);
+   }
+   pw->done.notify_all();
+}
+
+/* $MESA_SHADER_CACHE_DIR, $XDG_CACHE_HOME/mesa_shader_cache or
+ * ~/.cache/mesa_shader_cache, then d3d12_pso/<executable>-<id>.bin, where
+ * the id covers this Mesa build and the adapter and driver version. */
+static std::string
+record_path(struct d3d12_screen *screen)
+{
+   std::string dir;
+   const char *env = getenv("MESA_SHADER_CACHE_DIR");
+   if (env && *env) {
+      dir = env;
+   } else if ((env = getenv("XDG_CACHE_HOME")) && *env) {
+      dir = std::string(env) + "/mesa_shader_cache";
+   } else if ((env = getenv("HOME")) && *env) {
+      dir = std::string(env) + "/.cache/mesa_shader_cache";
+   } else {
+      return std::string();
+   }
+   std::string parent = dir.substr(0, dir.rfind('/'));
+   if (!parent.empty())
+      mkdir(parent.c_str(), 0755);
+   mkdir(dir.c_str(), 0755);
+   dir += "/d3d12_pso";
+   if (mkdir(dir.c_str(), 0755) && errno != EEXIST)
+      return std::string();
+
+   blake3_hasher h;
+   _mesa_blake3_init(&h);
+   const char *version = "Mesa " PACKAGE_VERSION MESA_GIT_SHA1;
+   _mesa_blake3_update(&h, version, strlen(version));
+   disk_cache_get_function_identifier((void *)d3d12_pso_prewarm_init, &h);
+   _mesa_blake3_update(&h, &screen->vendor_id, sizeof(screen->vendor_id));
+   _mesa_blake3_update(&h, &screen->device_id, sizeof(screen->device_id));
+   _mesa_blake3_update(&h, &screen->subsys_id, sizeof(screen->subsys_id));
+   _mesa_blake3_update(&h, &screen->revision, sizeof(screen->revision));
+   _mesa_blake3_update(&h, &screen->driver_version, sizeof(screen->driver_version));
+   uint8_t id[BLAKE3_OUT_LEN];
+   _mesa_blake3_final(&h, id);
+
+   std::string name;
+   const char *proc = util_get_process_name();
+   for (const char *c = proc ? proc : "unknown"; *c && name.size() < 64; c++)
+      name += (isalnum((unsigned char)*c) || *c == '.' || *c == '_' || *c == '-') ? *c : '_';
+   char hex[17];
+   for (unsigned i = 0; i < 8; i++)
+      snprintf(hex + i * 2, 3, "%02x", id[i]);
+   return dir + "/" + name + "-" + hex + ".bin";
+}
+
+/* Records: magic, size, BLAKE3 of the record, the record. */
+static void
+load_records(d3d12_pso_prewarm *pw)
+{
+   struct stat st;
+   if (fstat(pw->fd, &st) || st.st_size <= 0)
+      return;
+   size_t size = (size_t)st.st_size < MAX_FILE_SIZE ? (size_t)st.st_size : MAX_FILE_SIZE;
+   std::vector<uint8_t> data(size);
+   size_t got = 0;
+   while (got < size) {
+      ssize_t n = pread(pw->fd, data.data() + got, size - got, got);
+      if (n <= 0)
+         break;
+      got += n;
+   }
+   pw->file_size = (size_t)st.st_size;
+   size_t pos = 0;
+   while (pos + 8 + BLAKE3_OUT_LEN <= got && pw->loaded.size() < MAX_RECORDS) {
+      uint32_t magic, len;
+      memcpy(&magic, &data[pos], 4);
+      memcpy(&len, &data[pos + 4], 4);
+      if (magic != RECORD_MAGIC || len > MAX_RECORD_SIZE ||
+          pos + 8 + BLAKE3_OUT_LEN + len > got)
+         break;
+      const uint8_t *hash = &data[pos + 8];
+      pso_entry *e = new pso_entry;
+      e->rec.assign(data.begin() + pos + 8 + BLAKE3_OUT_LEN,
+                    data.begin() + pos + 8 + BLAKE3_OUT_LEN + len);
+      uint8_t check[BLAKE3_OUT_LEN];
+      hash_record(e->rec, check);
+      pos += 8 + BLAKE3_OUT_LEN + len;
+      std::string key((const char *)hash, BLAKE3_OUT_LEN);
+      if (memcmp(check, hash, BLAKE3_OUT_LEN) || pw->entries.count(key)) {
+         bool bad = memcmp(check, hash, BLAKE3_OUT_LEN) != 0;
+         delete e;
+         if (bad)
+            break;
+         continue;
+      }
+      util_queue_fence_init(&e->fence);
+      pw->entries.emplace(key, e);
+      pw->loaded.push_back(e);
+   }
+}
+
+static void
+append_record(d3d12_pso_prewarm *pw, const std::vector<uint8_t> &rec, const uint8_t *hash)
+{
+   if (pw->fd < 0 || pw->file_size + rec.size() + 8 + BLAKE3_OUT_LEN > MAX_FILE_SIZE)
+      return;
+   std::vector<uint8_t> out(8 + BLAKE3_OUT_LEN);
+   uint32_t magic = RECORD_MAGIC, len = (uint32_t)rec.size();
+   memcpy(&out[0], &magic, 4);
+   memcpy(&out[4], &len, 4);
+   memcpy(&out[8], hash, BLAKE3_OUT_LEN);
+   out.insert(out.end(), rec.begin(), rec.end());
+   /* One write: appends from processes of the same program do not mix. */
+   if (write(pw->fd, out.data(), out.size()) == (ssize_t)out.size())
+      pw->file_size += out.size();
+}
+
+void
+d3d12_pso_prewarm_init(struct d3d12_screen *screen)
+{
+   screen->pso_prewarm = nullptr;
+   if (!debug_get_bool_option("D3D12_PSO_PREWARM", true) ||
+       debug_get_bool_option("MESA_SHADER_CACHE_DISABLE", false))
+      return;
+   std::string path = record_path(screen);
+   if (path.empty())
+      return;
+   d3d12_pso_prewarm *pw = new d3d12_pso_prewarm;
+   pw->screen = screen;
+   pw->start_ns = os_time_get_nano();
+   pw->debug = debug_get_bool_option("D3D12_PSO_PREWARM_DEBUG", false);
+   pw->fd = open(path.c_str(), O_RDWR | O_APPEND | O_CREAT | O_CLOEXEC, 0644);
+   if (pw->fd < 0) {
+      delete pw;
+      return;
+   }
+   load_records(pw);
+   if (!pw->loaded.empty()) {
+      long cpus = sysconf(_SC_NPROCESSORS_ONLN);
+      unsigned threads = cpus > 2 ? (unsigned)(cpus / 2) : 1;
+      if (threads > 4)
+         threads = 4;
+      if (threads > pw->loaded.size())
+         threads = (unsigned)pw->loaded.size();
+      pw->queue_ok = util_queue_init(&pw->queue, "d3d12pso", (unsigned)pw->loaded.size() + 1,
+                                     threads, UTIL_QUEUE_INIT_RESIZE_IF_FULL |
+                                     UTIL_QUEUE_INIT_SET_FULL_THREAD_AFFINITY, pw);
+      /* In the order the program first needed them. */
+      if (pw->queue_ok) {
+         for (pso_entry *e : pw->loaded)
+            util_queue_add_job(&pw->queue, e, &e->fence, prewarm_job, nullptr, 0);
+      }
+   }
+   if (pw->debug)
+      fprintf(stderr, "d3d12_pso_prewarm: %s: %zu recorded pipelines\n", path.c_str(), pw->loaded.size());
+   screen->pso_prewarm = pw;
+}
+
+void
+d3d12_pso_prewarm_fini(struct d3d12_screen *screen)
+{
+   d3d12_pso_prewarm *pw = screen->pso_prewarm;
+   if (!pw)
+      return;
+   if (pw->queue_ok) {
+      /* Jobs not started yet find their entries taken and return. */
+      for (pso_entry *e : pw->loaded) {
+         int expected = PSO_PENDING;
+         e->state.compare_exchange_strong(expected, PSO_READY);
+      }
+      util_queue_finish(&pw->queue);
+      util_queue_destroy(&pw->queue);
+   }
+   if (pw->debug)
+      fprintf(stderr, "d3d12_pso_prewarm: %u prewarmed used, %u waited for, %u compiled on demand, "
+              "%u recorded\n", pw->hits.load(), pw->waits.load(), pw->claimed.load(),
+              pw->recorded.load());
+   for (auto &kv : pw->entries) {
+      if (kv.second->pso)
+         kv.second->pso->Release();
+      delete kv.second;
+   }
+   if (pw->fd >= 0)
+      close(pw->fd);
+   delete pw;
+   screen->pso_prewarm = nullptr;
+}
+
+static ID3D12PipelineState *
+create_direct(struct d3d12_screen *screen, const CD3DX12_PIPELINE_STATE_STREAM3 &desc, bool stream)
+{
+   ID3D12PipelineState *pso = nullptr;
+   if (stream) {
+      D3D12_PIPELINE_STATE_STREAM_DESC sdesc{ sizeof(desc), (void *)&desc };
+      if (FAILED(screen->dev->CreatePipelineState(&sdesc, IID_PPV_ARGS(&pso))))
+         return nullptr;
+   } else {
+      D3D12_GRAPHICS_PIPELINE_STATE_DESC v0 = desc.GraphicsDescV0();
+      if (FAILED(screen->dev->CreateGraphicsPipelineState(&v0, IID_PPV_ARGS(&pso))))
+         return nullptr;
+   }
+   return pso;
+}
+
+ID3D12PipelineState *
+d3d12_pso_prewarm_create_gfx(struct d3d12_screen *screen,
+                             const CD3DX12_PIPELINE_STATE_STREAM3 &desc, bool stream)
+{
+   d3d12_pso_prewarm *pw = screen->pso_prewarm;
+   writer w;
+   if (!pw || !serialize_gfx(desc, stream, w))
+      return create_direct(screen, desc, stream);
+
+   uint8_t hash[BLAKE3_OUT_LEN];
+   hash_record(w.b, hash);
+   std::string key((const char *)hash, BLAKE3_OUT_LEN);
+
+   pso_entry *e = nullptr;
+   {
+      std::lock_guard<std::mutex> g(pw->lock);
+      auto it = pw->entries.find(key);
+      if (it != pw->entries.end())
+         e = it->second;
+   }
+   int64_t t0 = pw->debug ? os_time_get_nano() : 0;
+   if (e) {
+      int expected = PSO_PENDING;
+      const char *how;
+      if (e->state.compare_exchange_strong(expected, PSO_BUSY)) {
+         how = "compiled on demand";
+         /* Not started: compiled here, from Mesa's own description. */
+         ID3D12PipelineState *pso = create_direct(screen, desc, stream);
+         {
+            std::lock_guard<std::mutex> g(pw->lock);
+            e->pso = pso;
+            e->state.store(PSO_READY);
+         }
+         pw->done.notify_all();
+         pw->claimed++;
+      } else if (expected == PSO_BUSY) {
+         how = "waited for";
+         std::unique_lock<std::mutex> g(pw->lock);
+         pw->done.wait(g, [e] { return e->state.load() == PSO_READY; });
+         pw->waits++;
+      } else {
+         how = "ready";
+         pw->hits++;
+      }
+      if (pw->debug)
+         fprintf(stderr, "d3d12_pso_prewarm: +%.1f ms: %s (%.2f ms)\n",
+                 (t0 - pw->start_ns) / 1e6, how, (os_time_get_nano() - t0) / 1e6);
+      ID3D12PipelineState *pso;
+      {
+         std::lock_guard<std::mutex> g(pw->lock);
+         pso = e->pso;
+         if (pso)
+            pso->AddRef();
+      }
+      /* The recorded one failed: as before. */
+      return pso ? pso : create_direct(screen, desc, stream);
+   }
+
+   ID3D12PipelineState *pso = create_direct(screen, desc, stream);
+   if (!pso)
+      return nullptr;
+   if (pw->debug)
+      fprintf(stderr, "d3d12_pso_prewarm: +%.1f ms: new pipeline (%.2f ms)\n",
+              (t0 - pw->start_ns) / 1e6, (os_time_get_nano() - t0) / 1e6);
+   e = new pso_entry;
+   e->rec = std::move(w.b);
+   e->pso = pso;
+   pso->AddRef();
+   e->state.store(PSO_READY);
+   util_queue_fence_init(&e->fence);
+   {
