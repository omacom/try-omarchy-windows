+{
+   f.StencilFailOp = (D3D12_STENCIL_OP)r.u32();
+   f.StencilDepthFailOp = (D3D12_STENCIL_OP)r.u32();
+   f.StencilPassOp = (D3D12_STENCIL_OP)r.u32();
+   f.StencilFunc = (D3D12_COMPARISON_FUNC)r.u32();
+   f.StencilReadMask = (UINT8)r.u32();
+   f.StencilWriteMask = (UINT8)r.u32();
