+   if (screen->format_cache[slot].valid && screen->format_cache[slot].key == key &&
+       screen->format_cache[slot].bind == bind) {
+      bool supported = screen->format_cache[slot].supported;
+      mtx_unlock(&screen->query_cache_lock);
+      return supported;
+   }
+   mtx_unlock(&screen->query_cache_lock);
+   bool supported = d3d12_is_format_supported_uncached(pscreen, format, target, sample_count,
+                                                       storage_sample_count, bind);
+   mtx_lock(&screen->query_cache_lock);
+   screen->format_cache[slot].key = key;
+   screen->format_cache[slot].bind = bind;
+   screen->format_cache[slot].supported = supported;
+   screen->format_cache[slot].valid = true;
+   mtx_unlock(&screen->query_cache_lock);
+   return supported;
