+uint64_t
+d3d12_resource_allocation_size(struct d3d12_screen *screen, const D3D12_RESOURCE_DESC *desc)
+{
+   uint64_t h = desc->Width * 0x9E3779B97F4A7C15ull;
+   h ^= ((uint64_t)desc->Height << 32 | desc->Format) * 0xC2B2AE3D27D4EB4Full;
+   h ^= ((uint64_t)desc->Flags << 40 | (uint64_t)desc->MipLevels << 24 |
+         (uint64_t)desc->DepthOrArraySize << 8 | desc->Dimension) * 0x165667B19E3779F9ull;
+   h ^= desc->Alignment ^ (uint64_t)desc->SampleDesc.Count << 4 ^ (uint64_t)desc->Layout << 12;
+   unsigned slot = (unsigned)((h ^ h >> 29) * 0xBF58476D1CE4E5B9ull >> 56);   /* 0..255 */
+   mtx_lock(&screen->query_cache_lock);
+   if (screen->alloc_size_cache[slot].valid &&
+       alloc_desc_equal(&screen->alloc_size_cache[slot].desc, desc)) {
+      uint64_t size = screen->alloc_size_cache[slot].size;
+      mtx_unlock(&screen->query_cache_lock);
+      return size;
+   }
+   mtx_unlock(&screen->query_cache_lock);
+   uint64_t size = GetResourceAllocationInfo(screen->dev, 0, 1, desc).SizeInBytes;
+   mtx_lock(&screen->query_cache_lock);
+   screen->alloc_size_cache[slot].desc = *desc;
+   screen->alloc_size_cache[slot].size = size;
+   screen->alloc_size_cache[slot].valid = true;
+   mtx_unlock(&screen->query_cache_lock);
+   return size;
+}
