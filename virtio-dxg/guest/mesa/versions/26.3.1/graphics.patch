+/*
+ * d3d12_texture_cache: textures kept for reuse. Creating a committed texture
+ * and freeing it again costs kernel calls (allocation, GPU virtual address,
+ * residency, destruction) that applications creating offscreen textures
+ * every frame, such as GTK 4's renderer, pay dozens of times per frame.
+ * Under virtualization each is a host round trip.
+ */
+struct d3d12_texture_cache_entry {
+   struct list_head link;          /* screen->texture_cache */
+   struct list_head bucket_link;   /* screen->texture_cache_buckets[] */
+   struct d3d12_texture_pool_slot pool;
+   ID3D12Resource *res;
+   D3D12_RESOURCE_DESC desc;
+   D3D12_HEAP_FLAGS heap_flags;
+   const DXGI_FORMAT *casts;
+   uint32_t num_casts;
+   struct d3d12_resource_state state;
+   enum d3d12_residency_status residency;
+   uint64_t size;
+   int64_t freed;
+};
+
+#define D3D12_TEXTURE_CACHE_AGE_NS 1000000000ll
+
+static bool
+texture_desc_equal(const D3D12_RESOURCE_DESC *a, const D3D12_RESOURCE_DESC *b)
+{
+   return a->Dimension == b->Dimension && a->Alignment == b->Alignment &&
+          a->Width == b->Width && a->Height == b->Height &&
+          a->DepthOrArraySize == b->DepthOrArraySize && a->MipLevels == b->MipLevels &&
+          a->Format == b->Format && a->SampleDesc.Count == b->SampleDesc.Count &&
+          a->SampleDesc.Quality == b->SampleDesc.Quality && a->Layout == b->Layout &&
+          a->Flags == b->Flags;
+}
+
+static unsigned
+texture_cache_bucket(const D3D12_RESOURCE_DESC *desc, D3D12_HEAP_FLAGS heap_flags,
+                     const DXGI_FORMAT *casts)
+{
+   uint64_t h = desc->Width * 0x9E3779B97F4A7C15ull;
+   h ^= ((uint64_t)desc->Height << 32 | desc->Format) * 0xC2B2AE3D27D4EB4Full;
+   h ^= ((uint64_t)desc->Flags << 32 | (uint64_t)desc->MipLevels << 16 |
+         desc->DepthOrArraySize) * 0x165667B19E3779F9ull;
+   h ^= ((uint64_t)heap_flags << 8 | desc->Dimension) ^ (uintptr_t)casts;
+   h ^= h >> 29;
+   return (unsigned)(h * 0xBF58476D1CE4E5B9ull >> 58);   /* 0..63 */
+}
+
+/* Lock held. */
+static void
+texture_cache_drop(struct d3d12_screen *screen, struct d3d12_texture_cache_entry *e)
+{
+   list_del(&e->link);
+   list_del(&e->bucket_link);
+   screen->texture_cache_bytes -= e->size;
+   d3d12_resource_state_cleanup(&e->state);
+   e->res->Release();
+   d3d12_texture_pool_free(screen, &e->pool);
+   FREE(e);
+}
+
+/* Lock held: drops what has not been reused for a while, oldest first. */
+static void
+texture_cache_expire(struct d3d12_screen *screen, int64_t now)
+{
+   list_for_each_entry_safe(struct d3d12_texture_cache_entry, e, &screen->texture_cache, link) {
+      if (now - e->freed < D3D12_TEXTURE_CACHE_AGE_NS)
+         break;
+      texture_cache_drop(screen, e);
+   }
+}
+
+/*
+ * d3d12_texture_pool: small textures placed in shared heaps. Creating a
+ * committed resource costs kernel calls (allocation, GPU virtual address,
+ * residency, and destruction later), host round trips under
+ * virtualization that sometimes take milliseconds; a placed resource is
+ * the user-mode driver's business only.
+ */
+#define D3D12_TEXTURE_POOL_HEAP_SIZE (16ull << 20)
+#define D3D12_TEXTURE_POOL_MAX_ALLOC (4ull << 20)
+#define D3D12_TEXTURE_POOL_ALIGN (64ull << 10)
+
+struct d3d12_texture_pool_heap {
+   ID3D12Heap *heap;
+   struct util_vma_heap vma;   /* offsets + D3D12_TEXTURE_POOL_ALIGN (0 is failure) */
+};
+
+void
+d3d12_texture_pool_init(struct d3d12_screen *screen)
+{
+   mtx_init(&screen->texture_pool_lock, mtx_plain);
+   screen->texture_pool_num_heaps = 0;
+   screen->texture_pool_max = debug_get_num_option("D3D12_TEXTURE_POOL_MB", 256) << 20;
+   screen->pool_init_list = NULL;
+   for (unsigned i = 0; i < ARRAY_SIZE(screen->pool_init_alloc); i++) {
+      screen->pool_init_alloc[i] = NULL;
+      screen->pool_init_fence[i] = 0;
+   }
+   screen->pool_init_cur = 0;
+   screen->pool_init_open = false;
+}
+
+void
+d3d12_texture_pool_destroy(struct d3d12_screen *screen)
+{
+   if (screen->pool_init_list)
+      screen->pool_init_list->Release();
+   screen->pool_init_list = NULL;
+   for (unsigned i = 0; i < ARRAY_SIZE(screen->pool_init_alloc); i++) {
+      if (screen->pool_init_alloc[i])
+         screen->pool_init_alloc[i]->Release();
+      screen->pool_init_alloc[i] = NULL;
+   }
+   for (unsigned i = 0; i < screen->texture_pool_num_heaps; i++) {
+      struct d3d12_texture_pool_heap *ph = screen->texture_pool_heaps[i];
+      util_vma_heap_finish(&ph->vma);
+      ph->heap->Release();
+      FREE(ph);
+   }
+   screen->texture_pool_num_heaps = 0;
+}
+
+/* texture_pool_lock held. */
+static bool
+texture_pool_alloc(struct d3d12_texture_pool_heap *ph, uint64_t size,
+                   struct d3d12_texture_pool_slot *slot)
+{
+   uint64_t addr = util_vma_heap_alloc(&ph->vma, size, D3D12_TEXTURE_POOL_ALIGN);
+   if (!addr)
+      return false;
+   slot->heap = ph;
+   slot->offset = addr - D3D12_TEXTURE_POOL_ALIGN;
+   slot->size = size;
+   return true;
+}
+
+bool
+d3d12_texture_pool_place(struct d3d12_screen *screen, const D3D12_RESOURCE_DESC *desc,
+                         struct d3d12_texture_pool_slot *slot, ID3D12Heap **heap)
+{
+   /* Tier 2: textures of any kind share a heap. */
+   if (!screen->texture_pool_max ||
+       screen->opts.ResourceHeapTier < D3D12_RESOURCE_HEAP_TIER_2)
+      return false;
+   if (desc->Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D ||
+       desc->SampleDesc.Count != 1 || desc->Layout != D3D12_TEXTURE_LAYOUT_UNKNOWN ||
+       (desc->Flags & (D3D12_RESOURCE_FLAG_ALLOW_SIMULTANEOUS_ACCESS |
+                       D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)))
+      return false;
+   /* Single-sample textures place at 64 KB alignment. */
+   uint64_t size = d3d12_resource_allocation_size(screen, desc);
+   if (!size || size == UINT64_MAX || size > D3D12_TEXTURE_POOL_MAX_ALLOC)
+      return false;
+   size = align64(size, D3D12_TEXTURE_POOL_ALIGN);
+
+   bool placed = false;
+   mtx_lock(&screen->texture_pool_lock);
+   for (unsigned i = 0; i < screen->texture_pool_num_heaps && !placed; i++)
+      placed = texture_pool_alloc(screen->texture_pool_heaps[i], size, slot);
+   if (!placed && screen->texture_pool_num_heaps < ARRAY_SIZE(screen->texture_pool_heaps) &&
+       (screen->texture_pool_num_heaps + 1) * D3D12_TEXTURE_POOL_HEAP_SIZE <=
+          screen->texture_pool_max) {
+      D3D12_HEAP_DESC hd = {};
+      hd.SizeInBytes = D3D12_TEXTURE_POOL_HEAP_SIZE;
+      hd.Properties = GetCustomHeapProperties(screen->dev, D3D12_HEAP_TYPE_DEFAULT);
+      hd.Alignment = D3D12_TEXTURE_POOL_ALIGN;
+      hd.Flags = D3D12_HEAP_FLAG_ALLOW_ALL_BUFFERS_AND_TEXTURES;
+      ID3D12Heap *h;
+      struct d3d12_texture_pool_heap *ph = CALLOC_STRUCT(d3d12_texture_pool_heap);
+      if (ph && SUCCEEDED(screen->dev->CreateHeap(&hd, IID_PPV_ARGS(&h)))) {
+         ph->heap = h;
+         util_vma_heap_init(&ph->vma, D3D12_TEXTURE_POOL_ALIGN, D3D12_TEXTURE_POOL_HEAP_SIZE);
+         ph->vma.alloc_high = false;
+         screen->texture_pool_heaps[screen->texture_pool_num_heaps++] = ph;
+         placed = texture_pool_alloc(ph, size, slot);
+      } else {
+         FREE(ph);
+      }
+   }
+   if (placed)
+      *heap = slot->heap->heap;
+   mtx_unlock(&screen->texture_pool_lock);
+   return placed;
+}
+
+void
+d3d12_texture_pool_free(struct d3d12_screen *screen, struct d3d12_texture_pool_slot *slot)
+{
+   if (!slot->heap)
+      return;
+   mtx_lock(&screen->texture_pool_lock);
+   util_vma_heap_free(&slot->heap->vma, slot->offset + D3D12_TEXTURE_POOL_ALIGN, slot->size);
+   mtx_unlock(&screen->texture_pool_lock);
+   slot->heap = NULL;
+}
+
+/* submit_mutex held: an open initialization list, its allocator idle. */
+static bool
+texture_pool_init_begin(struct d3d12_screen *screen)
+{
+   if (screen->pool_init_open)
+      return true;
+   unsigned i = (screen->pool_init_cur + 1) % ARRAY_SIZE(screen->pool_init_alloc);
+   if (!screen->pool_init_alloc[i] &&
+       FAILED(screen->dev->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                  IID_PPV_ARGS(&screen->pool_init_alloc[i]))))
+      return false;
+   uint64_t fence = screen->pool_init_fence[i];
+   if (fence && screen->fence->GetCompletedValue() < fence &&
+       FAILED(screen->fence->SetEventOnCompletion(fence, NULL)))
+      return false;
+   if (FAILED(screen->pool_init_alloc[i]->Reset()))
+      return false;
+   if (!screen->pool_init_list) {
+      if (FAILED(screen->dev->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT,
+                                                screen->pool_init_alloc[i], NULL,
+                                                IID_PPV_ARGS(&screen->pool_init_list))))
+         return false;
+   } else if (FAILED(screen->pool_init_list->Reset(screen->pool_init_alloc[i], NULL))) {
+      return false;
+   }
+   screen->pool_init_cur = i;
+   screen->pool_init_fence[i] = 0;
+   screen->pool_init_open = true;
+   return true;
+}
+
+void
+d3d12_texture_pool_initialize(struct d3d12_screen *screen, ID3D12Resource *res,
+                              D3D12_RESOURCE_FLAGS flags)
+{
+   mtx_lock(&screen->submit_mutex);
+   if (!texture_pool_init_begin(screen)) {
+      mtx_unlock(&screen->submit_mutex);
+      debug_printf("D3D12: cannot initialize a pooled texture\n");
+      return;
+   }
+   D3D12_RESOURCE_BARRIER b[2] = {};
+   b[0].Type = D3D12_RESOURCE_BARRIER_TYPE_ALIASING;
+   b[0].Aliasing.pResourceBefore = NULL;
+   b[0].Aliasing.pResourceAfter = res;
+   unsigned n = 1;
+   if (flags & D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET) {
+      b[1].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+      b[1].Transition.pResource = res;
+      b[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+      b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_COMMON;
+      b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_RENDER_TARGET;
+      n = 2;
+   }
+   screen->pool_init_list->ResourceBarrier(n, b);
+   if (n == 2) {
+      screen->pool_init_list->DiscardResource(res, NULL);
+      b[1].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+      b[1].Transition.StateAfter = D3D12_RESOURCE_STATE_COMMON;
+      screen->pool_init_list->ResourceBarrier(1, &b[1]);
+   }
+   mtx_unlock(&screen->submit_mutex);
+}
+
+ID3D12CommandList *
+d3d12_texture_pool_take_init(struct d3d12_screen *screen)
+{
+   if (!screen->pool_init_open)
+      return NULL;
+   screen->pool_init_open = false;
+   if (FAILED(screen->pool_init_list->Close())) {
+      debug_printf("D3D12: closing the texture pool initialization list failed\n");
+      return NULL;
+   }
+   return screen->pool_init_list;
+}
+
+void
+d3d12_texture_pool_submitted(struct d3d12_screen *screen, uint64_t fence_value)
+{
+   screen->pool_init_fence[screen->pool_init_cur] = fence_value;
+}
+
+void
+d3d12_texture_cache_init(struct d3d12_screen *screen)
+{
+   list_inithead(&screen->texture_cache);
+   for (unsigned i = 0; i < ARRAY_SIZE(screen->texture_cache_buckets); i++)
+      list_inithead(&screen->texture_cache_buckets[i]);
+   mtx_init(&screen->texture_cache_lock, mtx_plain);
+   screen->texture_cache_bytes = 0;
+   screen->texture_cache_max = debug_get_num_option("D3D12_TEXTURE_CACHE_MB", 128) << 20;
+}
+
+void
+d3d12_texture_cache_destroy(struct d3d12_screen *screen)
+{
+   if (!screen->texture_cache.next)
+      return;
+   mtx_lock(&screen->texture_cache_lock);
+   list_for_each_entry_safe(struct d3d12_texture_cache_entry, e, &screen->texture_cache, link)
+      texture_cache_drop(screen, e);
+   mtx_unlock(&screen->texture_cache_lock);
+}
+
+/* Takes bo's texture, state and residency into the cache; false if it does
+ * not fit (the caller releases it). */
+static bool
+texture_cache_put(struct d3d12_bo *bo)
+{
+   struct d3d12_screen *screen = bo->screen;
+   uint64_t size = bo->estimated_size;
+   if (!screen->texture_cache_max || !size || size > screen->texture_cache_max / 4)
+      return false;
+   /* Only a texture nobody else holds: another wrapper of the same D3D12
+    * resource (an alias or a batch's object reference) keeps using its
+    * memory, which a new texture must not get. */
+   bo->res->AddRef();
+   if (bo->res->Release() != 1)
+      return false;
+   struct d3d12_texture_cache_entry *e = MALLOC_STRUCT(d3d12_texture_cache_entry);
+   if (!e)
+      return false;
+   e->res = bo->res;
+   e->desc = GetDesc(bo->res);
+   e->heap_flags = bo->recycle_heap_flags;
+   e->casts = bo->recycle_casts;
+   e->num_casts = bo->recycle_num_casts;
+   e->state = bo->global_state;
+   e->residency = bo->residency_status;
+   e->pool = bo->pool;
+   bo->pool.heap = NULL;   /* the entry owns the slot now */
+   e->size = size;
+   e->freed = os_time_get_nano();
+
+   mtx_lock(&screen->texture_cache_lock);
+   texture_cache_expire(screen, e->freed);
+   while (screen->texture_cache_bytes + size > screen->texture_cache_max &&
+          !list_is_empty(&screen->texture_cache))
+      texture_cache_drop(screen, list_first_entry(&screen->texture_cache,
+                                                  struct d3d12_texture_cache_entry, link));
+   list_addtail(&e->link, &screen->texture_cache);
+   list_addtail(&e->bucket_link, &screen->texture_cache_buckets[
+      texture_cache_bucket(&e->desc, e->heap_flags, e->casts)]);
+   screen->texture_cache_bytes += size;
+   mtx_unlock(&screen->texture_cache_lock);
+   return true;
+}
+
+ID3D12Resource *
+d3d12_texture_cache_take(struct d3d12_screen *screen, const D3D12_RESOURCE_DESC *desc,
+                         D3D12_HEAP_FLAGS heap_flags, const DXGI_FORMAT *casts,
+                         uint32_t num_casts, struct d3d12_resource_state *state,
+                         enum d3d12_residency_status *residency,
+                         struct d3d12_texture_pool_slot *pool)
+{
+   ID3D12Resource *res = NULL;
+   if (!screen->texture_cache_max)
+      return NULL;
+   mtx_lock(&screen->texture_cache_lock);
+   texture_cache_expire(screen, os_time_get_nano());
+   /* Most recently freed first: the likeliest to be resident. */
+   struct list_head *bucket =
+      &screen->texture_cache_buckets[texture_cache_bucket(desc, heap_flags, casts)];
+   list_for_each_entry_rev(struct d3d12_texture_cache_entry, e, bucket, bucket_link) {
+      if (e->heap_flags == heap_flags && e->casts == casts && e->num_casts == num_casts &&
+          texture_desc_equal(&e->desc, desc)) {
+         list_del(&e->link);
+         list_del(&e->bucket_link);
+         screen->texture_cache_bytes -= e->size;
+         res = e->res;
+         *state = e->state;
+         *residency = e->residency;
+         *pool = e->pool;
+         FREE(e);
+         break;
+      }
+   }
+   mtx_unlock(&screen->texture_cache_lock);
+   return res;
+}
