+/* virtio-dxg: native fence descriptors ----------------------------------- */
+
+/* The DRM descriptor of an application's screen (a render node). */
+static int
+d3d12_fence_drm_fd(struct d3d12_screen *screen)
+{
+   struct stat st;
+   int fd = screen->winsys && screen->winsys->get_fd ?
+            screen->winsys->get_fd(screen->winsys) : -1;
+
+   if (fd < 0 || fstat(fd, &st) || !S_ISCHR(st.st_mode) ||
+       major(st.st_rdev) != 226 || minor(st.st_rdev) < 128)
+      return -1;
+   return fd;
+}
+
+/* A sync file that is signalled already. */
+static int
+d3d12_signaled_sync_file(struct d3d12_screen *screen)
+{
+   int drm = d3d12_fence_drm_fd(screen);
+   if (drm < 0)
+      return -1;
+   struct drm_syncobj_create create = {};
+   create.flags = DRM_SYNCOBJ_CREATE_SIGNALED;
+   if (ioctl(drm, DRM_IOCTL_SYNCOBJ_CREATE, &create))
+      return -1;
+   struct drm_syncobj_handle exported = {};
+   exported.handle = create.handle;
+   exported.flags = DRM_SYNCOBJ_HANDLE_TO_FD_FLAGS_EXPORT_SYNC_FILE;
+   exported.fd = -1;
+   int ret = ioctl(drm, DRM_IOCTL_SYNCOBJ_HANDLE_TO_FD, &exported);
+   struct drm_syncobj_destroy destroy = {};
+   destroy.handle = create.handle;
+   ioctl(drm, DRM_IOCTL_SYNCOBJ_DESTROY, &destroy);
+   return ret ? -1 : exported.fd;
+}
+
+bool
+d3d12_screen_native_fences(struct d3d12_screen *screen)
+{
+   if (!debug_get_bool_option("D3D12_NATIVE_FENCE", true))
+      return false;
+   /* The probe produces a permanently signaled sync_file. Keep it for
+    * this screen's lifetime. Each completed export gets its own fd. */
+   screen->completed_sync_fd = d3d12_signaled_sync_file(screen);
+   return screen->completed_sync_fd >= 0;
+}
+
+static int
+fence_get_fd(struct pipe_screen *pscreen, struct pipe_fence_handle *pfence)
+{
+   struct d3d12_fence *fence = d3d12_fence(pfence);
+
+   if (fence->sync_fd >= 0)
+      return os_dupfd_cloexec(fence->sync_fd);
+   int completed_fd = d3d12_screen(pscreen)->completed_sync_fd;
+   if (completed_fd < 0 || fence->type != PIPE_FD_TYPE_NATIVE_SYNC ||
+       !d3d12_fence_finish(fence, OS_TIMEOUT_INFINITE))
+      return -1;
+   return os_dupfd_cloexec(completed_fd);
+}
+
+void
+d3d12_create_fence_fd(struct pipe_context *pctx,
+                      struct pipe_fence_handle **pfence, int fd,
+                      enum pipe_fd_type type)
+{
+   *pfence = NULL;
+   if (type != PIPE_FD_TYPE_NATIVE_SYNC || fd < 0)
+      return;
+   struct d3d12_fence *fence = d3d12_create_fence_raw(NULL, 0);
+   if (!fence)
+      return;
+   fence->sync_fd = os_dupfd_cloexec(fd);
+   if (fence->sync_fd < 0) {
+      FREE(fence);
+      return;
+   }
+   *pfence = (struct pipe_fence_handle *)fence;
+}
