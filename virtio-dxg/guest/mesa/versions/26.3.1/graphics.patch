+/* d3d12_heap_pool: shader-visible descriptor heaps for batches. A batch
+ * takes its view and sampler heaps when it first starts and gives them back
+ * when it is destroyed (after waiting for its fence); a worker keeps
+ * HEAP_POOL_READY of each kind made in advance. Creating one is a GPU
+ * allocation the driver maps for the CPU: ~0.8 ms under virtualization. */
+#define BATCH_VIEW_DESCRIPTORS 8096
+#define BATCH_SAMPLER_DESCRIPTORS 1024
+#define HEAP_POOL_READY 2
+#define HEAP_POOL_MAX 16
+
+struct d3d12_heap_pool {
+   struct d3d12_screen *screen;
+   mtx_t lock;
+   struct util_dynarray views, samplers;   /* struct d3d12_descriptor_heap * */
+   struct util_queue queue;
+   struct util_queue_fence fence;
+   bool queue_ok;
+   bool refill_queued;
+};
+
+static struct d3d12_descriptor_heap *
+heap_pool_new(struct d3d12_screen *screen, bool sampler)
+{
+   return d3d12_descriptor_heap_new(screen->dev,
+                                    sampler ? D3D12_DESCRIPTOR_HEAP_TYPE_SAMPLER :
+                                              D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV,
+                                    D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE,
+                                    sampler ? BATCH_SAMPLER_DESCRIPTORS : BATCH_VIEW_DESCRIPTORS);
+}
+
+static void
+heap_pool_refill_job(void *job, void *gdata, int thread_index)
+{
+   struct d3d12_heap_pool *pool = (struct d3d12_heap_pool *)job;
+   for (;;) {
+      mtx_lock(&pool->lock);
+      bool view = util_dynarray_num_elements(&pool->views, struct d3d12_descriptor_heap *) < HEAP_POOL_READY;
+      bool sampler = util_dynarray_num_elements(&pool->samplers, struct d3d12_descriptor_heap *) < HEAP_POOL_READY;
+      mtx_unlock(&pool->lock);
+      if (!view && !sampler)
+         return;
+      struct d3d12_descriptor_heap *v = view ? heap_pool_new(pool->screen, false) : NULL;
+      struct d3d12_descriptor_heap *s = sampler ? heap_pool_new(pool->screen, true) : NULL;
+      if ((view && !v) || (sampler && !s)) {
+         if (v)
+            d3d12_descriptor_heap_free(v);
+         if (s)
+            d3d12_descriptor_heap_free(s);
+         return;
+      }
+      mtx_lock(&pool->lock);
+      if (v)
+         util_dynarray_append(&pool->views, v);
+      if (s)
+         util_dynarray_append(&pool->samplers, s);
+      mtx_unlock(&pool->lock);
+   }
+}
+
+static void
+heap_pool_refill_done(void *job, void *gdata, int thread_index)
+{
+   struct d3d12_heap_pool *pool = (struct d3d12_heap_pool *)job;
+   mtx_lock(&pool->lock);
+   pool->refill_queued = false;
+   mtx_unlock(&pool->lock);
+}
+
+static void
+heap_pool_refill(struct d3d12_heap_pool *pool)
+{
+   if (!pool->queue_ok)
+      return;
+   mtx_lock(&pool->lock);
+   bool need = !pool->refill_queued &&
+      (util_dynarray_num_elements(&pool->views, struct d3d12_descriptor_heap *) < HEAP_POOL_READY ||
+       util_dynarray_num_elements(&pool->samplers, struct d3d12_descriptor_heap *) < HEAP_POOL_READY);
+   if (need)
+      pool->refill_queued = true;
+   mtx_unlock(&pool->lock);
+   if (need)
+      util_queue_add_job(&pool->queue, pool, &pool->fence, heap_pool_refill_job,
+                         heap_pool_refill_done, 0);
+}
+
+static struct d3d12_descriptor_heap *
+heap_pool_take(struct d3d12_screen *screen, bool sampler)
+{
+   struct d3d12_heap_pool *pool = screen->heap_pool;
+   struct d3d12_descriptor_heap *heap = NULL;
+   if (pool) {
+      mtx_lock(&pool->lock);
+      struct util_dynarray *a = sampler ? &pool->samplers : &pool->views;
+      if (util_dynarray_num_elements(a, struct d3d12_descriptor_heap *))
+         heap = util_dynarray_pop(a, struct d3d12_descriptor_heap *);
+      mtx_unlock(&pool->lock);
+      heap_pool_refill(pool);
+   }
+   if (heap) {
+      d3d12_descriptor_heap_clear(heap);
+      return heap;
+   }
+   return heap_pool_new(screen, sampler);
+}
+
+static void
+heap_pool_give(struct d3d12_screen *screen, struct d3d12_descriptor_heap *heap, bool sampler)
+{
+   struct d3d12_heap_pool *pool = screen->heap_pool;
+   if (!heap)
+      return;
+   if (pool) {
+      mtx_lock(&pool->lock);
+      struct util_dynarray *a = sampler ? &pool->samplers : &pool->views;
+      bool kept = util_dynarray_num_elements(a, struct d3d12_descriptor_heap *) < HEAP_POOL_MAX;
+      if (kept)
+         util_dynarray_append(a, heap);
+      mtx_unlock(&pool->lock);
+      if (kept)
+         return;
+   }
+   d3d12_descriptor_heap_free(heap);
+}
+
+void
+d3d12_heap_pool_init(struct d3d12_screen *screen)
+{
+   struct d3d12_heap_pool *pool = CALLOC_STRUCT(d3d12_heap_pool);
+   if (!pool)
+      return;
+   pool->screen = screen;
+   mtx_init(&pool->lock, mtx_plain);
+   util_dynarray_init(&pool->views, NULL);
+   util_dynarray_init(&pool->samplers, NULL);
+   util_queue_fence_init(&pool->fence);
+   pool->queue_ok = util_queue_init(&pool->queue, "d3d12heap", 4, 1,
+                                    UTIL_QUEUE_INIT_RESIZE_IF_FULL, NULL);
+   screen->heap_pool = pool;
+   heap_pool_refill(pool);
+}
+
+void
+d3d12_heap_pool_fini(struct d3d12_screen *screen)
+{
+   struct d3d12_heap_pool *pool = screen->heap_pool;
+   if (!pool)
+      return;
+   if (pool->queue_ok) {
+      util_queue_finish(&pool->queue);
+      util_queue_destroy(&pool->queue);
+   }
+   util_dynarray_foreach(&pool->views, struct d3d12_descriptor_heap *, h)
+      d3d12_descriptor_heap_free(*h);
+   util_dynarray_foreach(&pool->samplers, struct d3d12_descriptor_heap *, h)
+      d3d12_descriptor_heap_free(*h);
+   util_dynarray_fini(&pool->views);
+   util_dynarray_fini(&pool->samplers);
+   mtx_destroy(&pool->lock);
+   FREE(pool);
+   screen->heap_pool = NULL;
+}
