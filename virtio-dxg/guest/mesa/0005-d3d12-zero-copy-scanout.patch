+#ifndef _WIN32
+/* virtio-dxg zero-copy scanout -----------------------------------------
+ *
+ * In a virtio-dxg VM the host display can show a scanout buffer's GPU
+ * texture itself: LX_DXVIRTIOSCANOUT on /dev/dxg links the virtio-gpu
+ * buffer to the texture's shared handle. Nothing is then copied into the
+ * dumb buffer, nor into the host, nor uploaded to the display. Scanout
+ * mirrors are therefore created shared, and an import of a linked buffer
+ * in the same process (the compositor importing its own swapchain) gets
+ * the same texture, so the host shows what is rendered.
+ * D3D12_ZERO_COPY_SCANOUT=false keeps the copies.
+ */
+struct d3d12_virtio_scanout {
+   uint32_t gpu_resource;
+   int32_t resource_fd;
+   uint32_t width;
+   uint32_t height;
+   uint32_t drm_format;
+   uint32_t alloc_size;
+   uint32_t flags;
+   uint32_t reserved;
+   uint64_t cookie;
+};
+#define D3D12_LX_DXVIRTIOSCANOUT \
+   _IOWR(0x47, 0x80, struct d3d12_virtio_scanout)
+#define D3D12_VIRTIO_SCANOUT_ZERO_COPY 1u
+
+static simple_mtx_t d3d12_scanout_lock = SIMPLE_MTX_INITIALIZER;
+static int d3d12_scanout_dxg = -2;   /* /dev/dxg; -1: none, -2: not tried */
+static struct hash_table_u64 *d3d12_scanout_links; /* gpu resource -> res */
+static unsigned d3d12_scanout_count;
+static uint64_t d3d12_scanout_cookie;
+
+static uint32_t
+d3d12_scanout_fourcc(enum pipe_format format)
+{
+   switch (format) {
+   case PIPE_FORMAT_B8G8R8X8_UNORM: return 0x34325258; /* XR24 */
+   case PIPE_FORMAT_B8G8R8A8_UNORM: return 0x34325241; /* AR24 */
+   case PIPE_FORMAT_R8G8B8X8_UNORM: return 0x34324258; /* XB24 */
+   case PIPE_FORMAT_R8G8B8A8_UNORM: return 0x34324241; /* AB24 */
+   default: return 0;
+   }
+}
+
+static bool
+d3d12_scanout_wanted(const struct pipe_resource *templ)
+{
+   if (!(templ->bind & PIPE_BIND_SCANOUT) || (templ->bind & PIPE_BIND_CURSOR) ||
+       !d3d12_scanout_fourcc(templ->format) ||
+       !debug_get_bool_option("D3D12_ZERO_COPY_SCANOUT", true))
+      return false;
+   simple_mtx_lock(&d3d12_scanout_lock);
+   if (d3d12_scanout_dxg == -2) {
+      d3d12_scanout_dxg = open("/dev/dxg", O_RDWR | O_CLOEXEC);
+      if (d3d12_scanout_dxg < 0)
+         d3d12_scanout_dxg = -1;
+   }
+   bool ok = d3d12_scanout_dxg >= 0;
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   return ok;
+}
+
+static uint32_t
+d3d12_scanout_resource_id(int drm_fd, uint32_t gem_handle)
+{
+   struct drm_virtgpu_resource_info info = {};
+   info.bo_handle = gem_handle;
+   if (drm_fd < 0 || ioctl(drm_fd, DRM_IOCTL_VIRTGPU_RESOURCE_INFO, &info))
+      return 0;
+   return info.res_handle;
+}
+
+/* Links res (a shared texture) to the virtio-gpu buffer gpu_resource. */
+static void
+d3d12_scanout_link(struct d3d12_screen *screen, struct d3d12_resource *res,
+                   uint32_t gpu_resource)
+{
+   ID3D12Resource *d3d12_res = d3d12_resource_resource(res);
+   HANDLE handle = nullptr;
+
+   if (!gpu_resource || !d3d12_res ||
+       FAILED(screen->dev->CreateSharedHandle(d3d12_res, nullptr, GENERIC_ALL,
+                                              nullptr, &handle)) || !handle)
+      return;
+   D3D12_RESOURCE_DESC desc = GetDesc(d3d12_res);
+   struct d3d12_virtio_scanout link = {};
+   link.gpu_resource = gpu_resource;
+   link.resource_fd = (int)(intptr_t)handle;
+   link.width = res->base.b.width0;
+   link.height = res->base.b.height0;
+   link.drm_format = d3d12_scanout_fourcc(res->base.b.format);
+   link.alloc_size = (uint32_t)
+      GetResourceAllocationInfo(screen->dev, 0, 1, &desc).SizeInBytes;
+
+   simple_mtx_lock(&d3d12_scanout_lock);
+   link.cookie = ++d3d12_scanout_cookie | ((uint64_t)getpid() << 32);
+   if (ioctl(d3d12_scanout_dxg, D3D12_LX_DXVIRTIOSCANOUT, &link) == 0 &&
+       (link.flags & D3D12_VIRTIO_SCANOUT_ZERO_COPY)) {
+      if (!d3d12_scanout_links)
+         d3d12_scanout_links = _mesa_hash_table_u64_create(NULL);
+      if (!_mesa_hash_table_u64_search(d3d12_scanout_links, gpu_resource))
+         d3d12_scanout_count++;
+      _mesa_hash_table_u64_insert(d3d12_scanout_links, gpu_resource, res);
+      res->mirror_zero_copy = true;
+      res->mirror_gpu_resource = gpu_resource;
+      res->mirror_cookie = link.cookie;
+   }
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   close(link.resource_fd);
+}
+
+/* With d3d12_scanout_lock. */
+static void
+d3d12_scanout_unlink_locked(struct d3d12_resource *res)
+{
+   struct d3d12_virtio_scanout link = {};
+
+   if (!res->mirror_zero_copy)
+      return;
+   if (d3d12_scanout_links &&
+       _mesa_hash_table_u64_search(d3d12_scanout_links,
+                                   res->mirror_gpu_resource) == res) {
+      _mesa_hash_table_u64_remove(d3d12_scanout_links, res->mirror_gpu_resource);
+      d3d12_scanout_count--;
+   }
+   link.gpu_resource = res->mirror_gpu_resource;
+   link.resource_fd = -1;
+   link.cookie = res->mirror_cookie;
+   ioctl(d3d12_scanout_dxg, D3D12_LX_DXVIRTIOSCANOUT, &link);
+   res->mirror_zero_copy = false;
+}
+
+static void
+d3d12_scanout_unlink(struct d3d12_resource *res)
+{
+   simple_mtx_lock(&d3d12_scanout_lock);
+   d3d12_scanout_unlink_locked(res);
+   simple_mtx_unlock(&d3d12_scanout_lock);
+}
+
+/*
+ * The linked texture of the dma-buf's buffer, when this process linked it
+ * and the import matches it; NULL otherwise. On another screen of the
+ * process (compositors allocate on one GBM device and render on another),
+ * *borrowed instead becomes a resource of this screen wrapping the same
+ * D3D12 texture, and *gpu_resource its buffer. An import that does not
+ * match (another format or size) returns the buffer to copies, so every
+ * view of it stays correct.
+ */
+static struct pipe_resource *
+d3d12_scanout_lookup(struct d3d12_screen *screen,
+                     const struct pipe_resource *templ, int dmabuf_fd,
+                     struct pipe_resource **borrowed, uint32_t *gpu_resource)
+{
+   struct pipe_resource *found = NULL;
+   int drm_fd = screen->winsys->get_fd(screen->winsys);
+
+   *borrowed = NULL;
+
+   simple_mtx_lock(&d3d12_scanout_lock);
+   if (d3d12_scanout_count && drm_fd >= 0) {
+      /* Our own buffers already have this handle on drm_fd: not closed. */
+      struct drm_prime_handle prime = {};
+      prime.fd = dmabuf_fd;
+      if (ioctl(drm_fd, DRM_IOCTL_PRIME_FD_TO_HANDLE, &prime) == 0) {
+         uint32_t id = d3d12_scanout_resource_id(drm_fd, prime.handle);
+         struct d3d12_resource *res = id ? (struct d3d12_resource *)
+            _mesa_hash_table_u64_search(d3d12_scanout_links, id) : NULL;
+         bool match = res && res->base.b.format == templ->format &&
+                      res->base.b.width0 == templ->width0 &&
+                      res->base.b.height0 == templ->height0;
+         if (match && res->base.b.screen == &screen->base) {
+            pipe_resource_reference(&found, &res->base.b);
+         } else if (match) {
+            /* The import consumes this reference. */
+            ID3D12Resource *d3d12_res = d3d12_resource_resource(res);
+            struct winsys_handle wh = {};
+            d3d12_res->AddRef();
+            wh.type = WINSYS_HANDLE_TYPE_D3D12_RES;
+            wh.com_obj = d3d12_res;
+            wh.format = templ->format;
+            *borrowed = screen->base.resource_from_handle(
+               &screen->base, templ, &wh, PIPE_HANDLE_USAGE_FRAMEBUFFER_WRITE);
+            if (*borrowed)
+               *gpu_resource = id;
+            else
+               d3d12_scanout_unlink_locked(res);
+         } else if (res) {
+            d3d12_scanout_unlink_locked(res);
+         }
+      }
+   }
+   simple_mtx_unlock(&d3d12_scanout_lock);
+   return found;
+}
+#endif /* !_WIN32 */
