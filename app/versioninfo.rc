// Windows resources for TryOmarchy.exe: the app icon and the version block that
// Explorer, Task Manager and the UAC consent prompt read.
//
// Regenerate the committed object after editing this file (needs llvm-rc and
// llvm-cvtres from the LLVM toolchain):
//
//   llvm-rc /FO rsrc.res versioninfo.rc
//   llvm-cvtres /MACHINE:X64 /OUT:rsrc_windows_amd64.syso rsrc.res
//   rm rsrc.res
//
// Keep FILEVERSION and the version strings in step with currentVersion in
// update.go; versioninfo_test.go fails the build if they drift.

// LoadIconW(hInst, 1) in winkey.go resolves this group.
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 0, 0, 8, 0
PRODUCTVERSION 0, 0, 8, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Brandon South"
            VALUE "FileDescription", "Try Omarchy"
            VALUE "FileVersion", "v0.0.8-preview"
            VALUE "InternalName", "TryOmarchy"
            VALUE "LegalCopyright", "Copyright (c) 2026 Brandon South"
            VALUE "OriginalFilename", "TryOmarchy.exe"
            VALUE "ProductName", "Try Omarchy"
            VALUE "ProductVersion", "v0.0.8-preview"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
