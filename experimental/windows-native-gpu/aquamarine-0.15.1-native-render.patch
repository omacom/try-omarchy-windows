+// Private compositor-startup experiment. No KMS or Windows presentation claim.
+#include "NativeRender.hpp"
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <dlfcn.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+
+bool Aquamarine::NativeRender::requested() {
+    const auto value = std::getenv("AQ_EXPERIMENTAL_NATIVE_RENDER");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+bool Aquamarine::NativeRender::supported(int fd) {
+    if (!requested())
+        return false;
+
+    struct SIdentity {
+        uint32_t version = 1, flags = 0;
+        uint64_t signature = 0;
+        uint32_t maxWidth = 0, maxHeight = 0, reserved[2] = {};
+    } identity;
+    static_assert(sizeof(SIdentity) == 32);
+    struct stat info = {};
+    if (fstat(fd, &info) != 0 || !S_ISCHR(info.st_mode) || ioctl(fd, _IOWR('d', 0x40, SIdentity), &identity) != 0 ||
+        identity.version != 1 || identity.flags != 1 || identity.signature != UINT64_C(0x3152444d444457) ||
+        identity.maxWidth != 4096 || identity.maxHeight != 4096 || identity.reserved[0] || identity.reserved[1])
+        return false;
+
+    const auto supported = reinterpret_cast<int (*)(void)>(dlsym(RTLD_DEFAULT, "wddm_bridge_native_buffer_supported"));
+    return supported && supported() == 1 && dlsym(RTLD_DEFAULT, "wddm_bridge_export_native_buffer") &&
+        dlsym(RTLD_DEFAULT, "wddm_bridge_native_buffer_info") && dlsym(RTLD_DEFAULT, "wddm_bridge_prepare_native_resource") &&
+        dlsym(RTLD_DEFAULT, "wddm_bridge_cancel_native_resource");
+}
