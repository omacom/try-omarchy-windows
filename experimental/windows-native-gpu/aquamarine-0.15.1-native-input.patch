 void Aquamarine::CBackend::log(eBackendLogLevel level, const std::string& msg) {
+    const auto input = std::getenv("WDDM_BRIDGE_NATIVE_INPUT");
+    if (input && !std::strcmp(input, "1") && msg.size() <= 4096 &&
+        (msg.find("libinput") != std::string::npos || msg.find("libseat") != std::string::npos ||
+         msg.find("native-render") != std::string::npos || msg.find("backend") != std::string::npos)) {
+        using Observer = void (*)(const char*, uint32_t);
+        const auto observer = reinterpret_cast<Observer>(dlsym(RTLD_DEFAULT, "wddm_bridge_native_input_log"));
+        if (observer)
+            observer(msg.data(), static_cast<uint32_t>(msg.size()));
+    }
     if (logger)
         logger->log(level, msg);
 }
