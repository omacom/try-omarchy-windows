+   if (!fence || fence->type != PIPE_FD_TYPE_NATIVE_SYNC ||
+       !d3d12_native_sync_file_enabled())
+      return -1;
+   if (fence->sync_file_fd >= 0)
+      return os_dupfd_cloexec(fence->sync_file_fd);
