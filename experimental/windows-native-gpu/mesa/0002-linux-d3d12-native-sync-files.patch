+   if (!ret) {
+      native_fence->Release();
+      return nullptr;
+   }
+   ret->type = PIPE_FD_TYPE_NATIVE_SYNC;
+   ret->cmdqueue_fence = native_fence;
+   ret->native_reference_owned = true;
+   ret->event_fd = -1;
+   ret->sync_file_fd = os_dupfd_cloexec(fd);
+   ret->value = value;
