+/* SPDX-License-Identifier: MIT */
+#ifndef D3D12_NATIVE_RENDER_H
+#define D3D12_NATIVE_RENDER_H
+#ifndef _WIN32
+#include "drm-uapi/drm.h"
+#include <stdint.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+struct d3d12_native_render_info {
+   uint32_t version, flags;
+   uint64_t signature;
+   uint32_t max_width, max_height, reserved[2];
+};
+static_assert(sizeof(d3d12_native_render_info) == 32, "native render identity ABI");
+static inline bool
+d3d12_native_render_fd_supported(int fd)
+{
+   struct stat info;
+   d3d12_native_render_info identity = {};
+   identity.version = 1;
+   return fstat(fd, &info) == 0 && S_ISCHR(info.st_mode) &&
+      ioctl(fd, DRM_IOWR(DRM_COMMAND_BASE, struct d3d12_native_render_info), &identity) == 0 &&
+      identity.version == 1 && identity.flags == 1 && identity.signature == UINT64_C(0x3152444d444457) &&
+      identity.max_width == 4096 && identity.max_height == 4096 && !identity.reserved[0] && !identity.reserved[1];
+}
+#endif
+#endif
