+
+// GBM scanout usage can select this owned opaque presentation route. This
+// does not advertise a KMS plane, a linear modifier or a foreign attachment.
+static inline bool
+d3d12_native_presentation_available()
+{
+   if (!debug_get_bool_option("D3D12_EXPERIMENTAL_NATIVE_PRESENTATION", false) ||
+       !d3d12_native_buffer_available())
+      return false;
+   auto supported = (int (*)(void))dlsym(RTLD_DEFAULT, "wddm_bridge_native_presentation_supported");
+   return supported && supported() == 1;
 }
 
