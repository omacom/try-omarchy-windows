--- a/src/microsoft/vulkan/dzn_device.c
+++ b/src/microsoft/vulkan/dzn_device.c
@@ -56,6 +56,10 @@
 #include <windows.h>
 #include <shlobj.h>
 #include "dzn_dxgi.h"
+#else
+#include "util/os_file.h"
+#include <errno.h>
+#include <limits.h>
 #endif
 
 #include <directx/d3d12sdklayers.h>
@@ -3736,16 +3740,23 @@
                    int *pFd)
 {
    VK_FROM_HANDLE(dzn_device_memory, mem, pGetFdInfo->memory);
-   if (!mem->export_handle)
+   const intptr_t fd = (intptr_t)mem->export_handle;
+   /* Descriptor zero is valid. Preserve the memory object's owned reference
+    * and hand each caller a fresh close-on-exec descriptor. */
+   if (fd < 0 || fd > INT_MAX)
       return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
 
    switch (pGetFdInfo->handleType) {
    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT:
    case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_RESOURCE_BIT:
-   case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_HEAP_BIT:
-      *pFd = (int)(intptr_t)mem->export_handle;
-      mem->export_handle = (HANDLE)(intptr_t)-1;
+   case VK_EXTERNAL_MEMORY_HANDLE_TYPE_D3D12_HEAP_BIT: {
+      const int exported = os_dupfd_cloexec((int)fd);
+      if (exported < 0)
+         return vk_error(device, (errno == EMFILE || errno == ENFILE) ?
+                         VK_ERROR_TOO_MANY_OBJECTS : VK_ERROR_OUT_OF_HOST_MEMORY);
+      *pFd = exported;
       return VK_SUCCESS;
+   }
    default:
       return vk_error(device, VK_ERROR_INVALID_EXTERNAL_HANDLE);
    }
