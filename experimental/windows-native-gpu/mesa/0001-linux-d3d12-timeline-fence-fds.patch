+#ifndef _WIN32
+static void
+d3d12_create_fence_fd(struct pipe_context *pipe,
+                      struct pipe_fence_handle **pfence, int fd,
+                      enum pipe_fd_type type)
+{
+   /* A native D3D12 shared fence is a timeline, not a binary semaphore or
+    * Linux sync_file. The GL frontend retains ownership of fd until success.
+    */
+   *pfence = nullptr;
+   if (fd < 0 || type != PIPE_FD_TYPE_TIMELINE_SEMAPHORE_VK)
+      return;
+   *pfence = (struct pipe_fence_handle *)d3d12_open_fence(
+      d3d12_screen(pipe->screen), (HANDLE)(intptr_t)fd, nullptr, type);
+}
+#endif
