+static bool
+d3d12_native_resource_get_param(struct pipe_screen *pscreen, struct pipe_context *context,
+                                 struct pipe_resource *pres, unsigned plane, unsigned layer,
+                                 unsigned level, enum pipe_resource_param param,
+                                 unsigned usage, uint64_t *value)
+{
+   if (!d3d12_screen(pscreen)->native_buffer_enabled || plane || layer || level ||
+       pres->target != PIPE_TEXTURE_2D || pres->last_level || pres->array_size != 1 ||
+       MAX2(pres->nr_samples, 1) != 1 || !pres->width0 || !pres->height0 ||
+       pres->width0 > UINT32_MAX / 4 || (pres->bind & PIPE_BIND_LINEAR) ||
+       !d3d12_native_buffer_format_supported(pscreen, pres->format))
+      return false;
+   switch (param) {
+   case PIPE_RESOURCE_PARAM_NPLANES: *value = 1; return true;
+   case PIPE_RESOURCE_PARAM_STRIDE: *value = pres->width0 * 4; return true;
+   case PIPE_RESOURCE_PARAM_LAYER_STRIDE: *value = (uint64_t)pres->width0 * pres->height0 * 4; return true;
+   case PIPE_RESOURCE_PARAM_OFFSET: *value = 0; return true;
+   case PIPE_RESOURCE_PARAM_MODIFIER: *value = DRM_FORMAT_MOD_INVALID; return true;
+   case PIPE_RESOURCE_PARAM_DISJOINT_PLANES: *value = 0; return true;
+   case PIPE_RESOURCE_PARAM_HANDLE_TYPE_FD: {
+      struct winsys_handle handle = {};
+      handle.type = WINSYS_HANDLE_TYPE_FD;
+      if (!d3d12_resource_get_handle(pscreen, context, pres, &handle, usage))
+         return false;
+      *value = handle.handle;
+      return true;
+   }
+   default: return false; /* No GEM/KMS handle or global flink name. */
+   }
+}
+#endif
 
