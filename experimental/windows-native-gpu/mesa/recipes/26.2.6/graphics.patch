+/* SPDX-License-Identifier: MIT
+ * Private opt-in native resource DMA-BUF interoperability. Implicit opaque
+ * layout only; never advertise CPU-linear or foreign-device attachment. */
+#ifndef D3D12_NATIVE_BUFFER_H
+#define D3D12_NATIVE_BUFFER_H
+#include "pipe/p_screen.h"
+#include "util/u_debug.h"
+#include <stdint.h>
+#ifndef _WIN32
+#include "drm-uapi/drm_fourcc.h"
+#include <dlfcn.h>
+#include <fcntl.h>
+#include <unistd.h>
+#endif
+
+static inline bool
+d3d12_native_buffer_format_supported(struct pipe_screen *, enum pipe_format format)
+{
+   return format == PIPE_FORMAT_R8G8B8A8_UNORM || format == PIPE_FORMAT_R8G8B8X8_UNORM ||
+          format == PIPE_FORMAT_B8G8R8A8_UNORM || format == PIPE_FORMAT_B8G8R8X8_UNORM;
+}
+
+#ifndef _WIN32
+static inline bool
+d3d12_native_buffer_available()
+{
+   if (!debug_get_bool_option("D3D12_EXPERIMENTAL_NATIVE_BUFFERS", false))
+      return false;
+   auto supported = (int (*)(void))dlsym(RTLD_DEFAULT, "wddm_bridge_native_buffer_supported");
+   return supported && dlsym(RTLD_DEFAULT, "wddm_bridge_export_native_buffer") &&
+          dlsym(RTLD_DEFAULT, "wddm_bridge_native_buffer_info") &&
+          dlsym(RTLD_DEFAULT, "wddm_bridge_prepare_native_resource") &&
+          dlsym(RTLD_DEFAULT, "wddm_bridge_cancel_native_resource") && supported() == 1;
+}
+
+// GBM scanout usage can select this owned opaque presentation route. This
+// does not advertise a KMS plane, a linear modifier or a foreign attachment.
+static inline bool
+d3d12_native_presentation_available()
+{
+   if (!debug_get_bool_option("D3D12_EXPERIMENTAL_NATIVE_PRESENTATION", false) ||
+       !d3d12_native_buffer_available())
+      return false;
+   auto supported = (int (*)(void))dlsym(RTLD_DEFAULT, "wddm_bridge_native_presentation_supported");
+   return supported && supported() == 1;
+}
+
+static inline bool
+d3d12_native_buffer_dxgi_matches(enum pipe_format format, uint32_t dxgi)
+{
+   /* BGRX has no sampleable native DXGI view. Store its RGB channels in BGRA
+    * and let Mesa's existing BGRX view swizzle supply alpha=1. */
+   switch (format) {
+   case PIPE_FORMAT_R8G8B8A8_UNORM:
+   case PIPE_FORMAT_R8G8B8X8_UNORM: return dxgi == 28;
+   case PIPE_FORMAT_B8G8R8A8_UNORM:
+   case PIPE_FORMAT_B8G8R8X8_UNORM: return dxgi == 87;
+   default: return false;
+   }
+}
+
+static inline int
+d3d12_native_buffer_export(int fd, uint64_t bytes)
+{
+   auto export_buffer = (int (*)(int, uint64_t))dlsym(RTLD_DEFAULT, "wddm_bridge_export_native_buffer");
+   return export_buffer ? export_buffer(fd, bytes) : -1;
+}
+
+static inline bool
+d3d12_native_buffer_info(int fd, uint64_t *bytes)
+{
+   auto info = (int (*)(int, uint64_t *))dlsym(RTLD_DEFAULT, "wddm_bridge_native_buffer_info");
+   return info && info(fd, bytes) == 0;
+}
+
+static inline bool
+d3d12_native_buffer_modifier_supported(struct pipe_screen *screen, uint64_t modifier,
+                                       enum pipe_format format, bool *external_only)
+{
+   if (external_only)
+      *external_only = false;
+   return modifier == DRM_FORMAT_MOD_INVALID && d3d12_native_buffer_format_supported(screen, format);
+}
+
+static inline void
+d3d12_native_buffer_query_modifiers(struct pipe_screen *, enum pipe_format, int,
+                                    uint64_t *, unsigned *, int *count)
+{
+   /* The implicit layout is implementation-defined. No explicit tiling or
+    * linear modifier is supported by this native-capability exporter. */
+   *count = 0;
+}
+#endif
+
+/* The SDK can fail before it issues a shared KMT allocation. Never leave a
+ * declaration behind for the next allocation on this thread. */
+struct d3d12_native_resource_preparation {
+   bool active = false;
+   bool begin(uint32_t width, uint32_t height, uint32_t format, uint32_t flags) {
+#ifndef _WIN32
+      auto prepare = (int (*)(uint32_t, uint32_t, uint32_t, uint32_t))
+         dlsym(RTLD_DEFAULT, "wddm_bridge_prepare_native_resource");
+      active = prepare && prepare(width, height, format, flags) == 0;
+      return active;
+#else
+      return false;
+#endif
+   }
+   void cancel() {
+#ifndef _WIN32
+      if (active) {
+         auto finish = (int (*)(void))dlsym(RTLD_DEFAULT, "wddm_bridge_cancel_native_resource");
+         if (finish)
+            finish();
+      }
+#endif
+      active = false;
+   }
+   ~d3d12_native_resource_preparation() { cancel(); }
+};
+#endif
